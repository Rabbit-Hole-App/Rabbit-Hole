{"indexing":"ready","catalogue":{"status":"ready","practicalRoutes":6},"catalogueDoc":{"summary":"Datasette is a tool for exploring and publishing data. It turns SQLite databases into an interactive website and a JSON API.","groups":[{"id":"main","label":"command-line tool and web server","path":"./","manifest":"pyproject.toml"}],"routes":[{"routeId":"get_json_cli","group":"main","recommended":true,"practical":true,"title":"Print Datasette's JSON answers in the terminal without a server","description":"Datasette runs a request against an in-memory instance and prints the JSON response, here showing which actor you are signed in as.","resultKind":"stdout","effort":"Quick — just Python","requirements":{"language":"Python 3.11+","docker":false,"gpu":false,"services":[],"downloadGB":0.1,"accounts":[]},"stepsSketch":[{"cmd":"pip install -e .","source":"pyproject.toml:1"},{"cmd":"datasette --memory --actor '{\"id\": \"root\"}' --get '/-/actor.json'","source":"docs/cli-reference.rst:221"}],"knobsHint":[{"flag":"--get","source":"datasette/cli.py:452"},{"flag":"--actor","source":"datasette/cli.py:465"},{"flag":"--memory","source":"datasette/cli.py:421"}],"prerequisites":[]},{"routeId":"serve_fixtures_web","group":"main","practical":true,"title":"Browse a sample database as an interactive website","description":"A sample SQLite database is generated from the test fixtures and served, so you can open the tables and the JSON API in a browser on port 8001.","resultKind":"http","effort":"Quick — just Python","requirements":{"language":"Python 3.11+","docker":false,"gpu":false,"services":[],"downloadGB":0.2,"accounts":[]},"stepsSketch":[{"cmd":"python3 -m pip install -e . --group dev","source":"docs/contributing.rst:46"},{"cmd":"python tests/fixtures.py fixtures.db","source":"docs/contributing.rst:146"},{"cmd":"datasette serve fixtures.db","source":"README.md:43"}],"knobsHint":[{"flag":"--port","source":"datasette/cli.py:378"},{"flag":"--host","source":"datasette/cli.py:368"},{"fl