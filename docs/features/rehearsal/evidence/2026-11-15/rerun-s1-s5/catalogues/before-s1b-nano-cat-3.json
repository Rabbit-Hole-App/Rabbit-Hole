    "routeId": "shakespeare_cpu",
    "group": "main",
    "title": "Train a tiny Shakespeare model on CPU and read what it writes",
    "description": "Downloads the Shakespeare text, trains a small character-level GPT on the CPU, then prints generated Shakespeare-like samples.",
    "resultKind": "stdout",
    "requirements": {
