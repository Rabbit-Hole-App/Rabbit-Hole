      {
        "routeId": "shakespeare_char_gpu",
        "rejected": "README.md:48 uses the full-size config (6 layers, 256 context) and expects a GPU. It would be far too slow on CPU."
      },
      {
        "routeId": "reproduce_gpt2_openwebtext",
        "rejected": "README.md:112-118 needs a 54GB dataset download, a 17GB train.bin, and an 8xA100 node for about 4 days."
      },
      {
        "routeId": "gpt2_baseline_evals",
        "rejected": "README.md:141-144 evaluates GPT-2 checkpoints on OpenWebText. That needs the prepared OWT data and downloads large GPT-2 weights, which is too heavy for CPU."
