{
  "version": 1,
  "diagram": {
    "kind": "block-stack",
    "title": "Llama-style decoder block",
    "blocks": [
      {
        "id": "an",
        "label": "Input scaling for attention",
        "role": "norm",
        "repeat": 32,
        "repeatTo": "ff"
      },
      {
        "id": "att",
        "label": "Attention to current and earlier tokens",
        "role": "attention"
      },
      {
        "id": "fn",
        "label": "Input scaling for token update",
        "role": "norm"
      },
      {
        "id": "ff",
        "label": "Per-token update",
        "role": "feedforward"
      }
    ],
    "edges": [
      {
        "kind": "residual",
        "from": "an",
        "to": "att"
      },
      {
        "kind": "residual",
        "from": "fn",
        "to": "ff"
      }
    ],
    "caption": "Attention reads the current token and earlier tokens. The final step updates each token on its own."
  }
}
