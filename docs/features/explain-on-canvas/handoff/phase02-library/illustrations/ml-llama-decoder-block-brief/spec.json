{
  "version": 1,
  "diagram": {
    "kind": "block-stack",
    "title": "Llama-style decoder block",
    "blocks": [
      {
        "id": "an",
        "label": "Normalize for attention",
        "role": "norm",
        "repeat": 32,
        "repeatTo": "ff"
      },
      {
        "id": "att",
        "label": "Look back at tokens",
        "role": "attention"
      },
      {
        "id": "fn",
        "label": "Normalize for feed-forward",
        "role": "norm"
      },
      {
        "id": "ff",
        "label": "Update token features",
        "role": "feedforward"
      }
    ],
    "edges": [
      {
        "kind": "residual",
        "from": "an",
        "to": "att"
      },
      {
        "kind": "residual",
        "from": "fn",
        "to": "ff"
      }
    ],
    "caption": "Attention reads the current token and earlier tokens. The final step updates each token on its own."
  }
}
