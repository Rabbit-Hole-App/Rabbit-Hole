{
  "version": 1,
  "diagram": {
    "kind": "block-stack",
    "title": "Original Transformer encoder",
    "caption": "Each sublayer returns $y=\\operatorname{LayerNorm}(x+F(x))$. 4 shown features stand in for 512.",
    "blocks": [
      {
        "id": "emb",
        "label": "Embeddings for “the cat sat on the mat”",
        "dims": "$d_{\\mathrm{model}}=512$",
        "role": "embedding"
      },
      {
        "id": "att",
        "label": "Multi-head self-attention",
        "role": "attention",
        "repeat": 6,
        "repeatTo": "fn"
      },
      {
        "id": "an",
        "label": "LayerNorm of attention sum",
        "role": "norm"
      },
      {
        "id": "ff",
        "label": "Position-wise feed-forward network",
        "role": "feedforward"
      },
      {
        "id": "fn",
        "label": "LayerNorm of feed-forward sum",
        "role": "norm"
      }
    ],
    "edges": [
      {
        "kind": "residual",
        "from": "att",
        "to": "att"
      },
      {
        "kind": "residual",
        "from": "ff",
        "to": "ff"
      }
    ]
  }
}
