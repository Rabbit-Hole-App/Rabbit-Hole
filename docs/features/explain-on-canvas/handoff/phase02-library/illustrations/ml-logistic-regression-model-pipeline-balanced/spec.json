{
  "version": 1,
  "diagram": {
    "kind": "flow",
    "title": "Score, probability, then class",
    "caption": "Illustrative values; keep the probability separate from the class.",
    "nodes": [
      {
        "id": "x",
        "role": "process",
        "label": "Take input $x$"
      },
      {
        "id": "z",
        "role": "process",
        "label": "Compute $z=wx+b$"
      },
      {
        "id": "p",
        "role": "process",
        "label": "Compute $p=1/(1+e^{-z})$"
      },
      {
        "id": "q",
        "role": "decision",
        "label": "Is $p≥0.5$?"
      },
      {
        "id": "yes",
        "role": "outcome",
        "label": "Predict $1$"
      },
      {
        "id": "no",
        "role": "outcome",
        "label": "Predict $0$"
      }
    ],
    "edges": [
      {
        "from": "x",
        "to": "z"
      },
      {
        "from": "z",
        "to": "p"
      },
      {
        "from": "p",
        "to": "q"
      },
      {
        "from": "q",
        "to": "yes",
        "label": "Yes"
      },
      {
        "from": "q",
        "to": "no",
        "label": "No"
      }
    ]
  }
}
