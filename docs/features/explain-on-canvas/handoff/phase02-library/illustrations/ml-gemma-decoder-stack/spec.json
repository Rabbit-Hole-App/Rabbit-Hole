      },
      {
        "id": "norm",
        "label": "Final RMSNorm",
        "role": "norm"
      },
      {
        "id": "out",
        "label": "Output linear",
        "role": "output"
      }
    ],
    "edges": [
      {
        "kind": "residual",
        "from": "att",
        "to": "att"
      },
      {
        "kind": "residual",
        "from": "ff",
        "to": "ff"
      }
