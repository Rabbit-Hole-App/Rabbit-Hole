{
  "version": 1,
  "diagram": {
    "kind": "block-stack",
    "title": "Llama-style decoder block",
    "blocks": [
      {
        "id": "an",
        "label": "Pre-RMSNorm 1 (input scaling)",
        "role": "norm",
        "repeat": 32,
        "repeatTo": "ff"
      },
      {
        "id": "att",
        "label": "Causal grouped-query attention (shared key and value heads)",
        "role": "attention"
      },
      {
        "id": "fn",
        "label": "Pre-RMSNorm 2 (feed-forward input scaling)",
        "role": "norm"
      },
      {
        "id": "ff",
        "label": "SwiGLU FFN (per-token update)",
        "role": "feedforward"
      }
    ],
    "edges": [
      {
        "kind": "residual",
        "from": "an",
        "to": "att"
      },
      {
        "kind": "residual",
        "from": "fn",
        "to": "ff"
      }
    ],
    "caption": "Each sublayer adds its result to the token stream."
  }
