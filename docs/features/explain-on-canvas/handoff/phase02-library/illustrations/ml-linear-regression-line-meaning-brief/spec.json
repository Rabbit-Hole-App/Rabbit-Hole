        "to": {
          "x": 4,
          "y": 4
        }
      },
      {
        "kind": "segment",
        "label": "Rise $0.6$",
        "from": {
          "x": 4,
          "y": 4
        },
        "to": {
          "x": 4,
          "y": 4.6
