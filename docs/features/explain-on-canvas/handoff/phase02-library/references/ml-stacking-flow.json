{
  "version": 1,
  "diagram": {
    "title": "Stacking learns how to combine base models",
    "caption": "Training the meta learner uses out-of-fold predictions; final test predictions use base models fit on training data.",
    "kind": "flow",
    "nodes": [
      {
        "id": "folds",
        "label": "Use shared training folds",
        "role": "fork"
      },
      {
        "id": "linear",
        "label": "Get linear model OOF scores",
        "role": "process"
      },
      {
        "id": "tree",
        "label": "Get tree model OOF scores",
        "role": "process"
      },
      {
        "id": "merge",
        "label": "Build the OOF feature matrix",
        "role": "merge"
      },
      {
        "id": "meta",
        "label": "Fit meta learner",
        "role": "process"
      },
      {
        "id": "out",
        "label": "Return combined predictor",
        "role": "outcome"
      }
    ],
    "edges": [
      {
        "from": "folds",
        "to": "linear"
      },
      {
        "from": "folds",
        "to": "tree"
      },
      {
        "from": "linear",
        "to": "merge"
      },
      {
        "from": "tree",
        "to": "merge"
      },
      {
        "from": "merge",
        "to": "meta"
      },
      {
        "from": "meta",
        "to": "out"
      }
    ]
  }
}
