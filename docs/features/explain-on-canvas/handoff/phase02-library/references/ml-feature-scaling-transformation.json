    "before": {
      "label": "Before",
      "diagram": {
        "title": "Original feature values",
        "kind": "coordinate-plot",
        "x": {
          "label": "Feature $x$",
          "min": 80,
          "max": 220,
          "scale": "linear"
        },
        "y": {
          "label": "Feature $y$",
          "min": 0,
          "max": 50,
          "scale": "linear"
        },
        "series": [
          {
            "label": "Samples",
            "kind": "scatter",
            "points": [
              {
                "x": 100,
                "y": 10,
                "id": "a",
                "label": "A"
              },
              {
                "x": 150,
                "y": 20,
                "id": "b",
                "label": "B"
              },
              {
                "x": 200,
                "y": 40,
                "id": "c",
                "label": "C"
              }
            ]
          }
        ]
      }
    },
    "after": {
      "label": "After",
      "diagram": {
        "title": "Centered and scaled values",
        "kind": "coordinate-plot",
        "x": {
          "label": "Scaled feature $x'$",
          "min": -2,
          "max": 2,
          "scale": "linear"
        },
        "y": {
          "label": "Scaled feature $y'$",
          "min": -2,
          "max": 3,
          "scale": "linear"
