        "series": [
          {
            "label": "Samples",
            "kind": "scatter",
            "points": [
              {
                "x": -1,
                "y": -1,
                "id": "a",
                "label": "A"
              },
              {
                "x": 0,
                "y": 0,
                "id": "b",
                "label": "B"
              },
              {
                "x": 1,
                "y": 2,
                "id": "c",
                "label": "C"
              }
            ]
          }
        ]
      }
    },
    "operation": "$x' = \\frac{x-150}{50}$ and $y' = \\frac{y-20}{10}$",
    "identity": {
      "mode": "preserved",
      "note": "A, B and C retain their sample IDs; only feature coordinates change."
