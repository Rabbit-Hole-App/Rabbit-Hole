{
  "version": 1,
  "diagram": {
    "title": "Four clocks for one training example",
    "caption": "The feature is available by prediction at day 5. The target arrives at day 9 and must not appear in prediction-time features.",
    "kind": "timeline",
    "layout": "scaled-lanes",
    "domain": {
      "min": 0,
      "max": 10,
      "unit": "day",
      "label": "Time"
    },
    "lanes": [
      {
        "id": "feature",
        "label": "Feature record",
        "events": [
          {
            "id": "occurred",
            "label": "Event occurred",
            "time": 2
          },
          {
            "id": "ingested",
            "label": "Created / available",
            "time": 4
          }
        ]
      },
      {
        "id": "target",
        "label": "Prediction and target",
        "events": [
          {
            "id": "predicted",
            "label": "Prediction",
            "time": 5
          },
          {
            "id": "labelled",
            "label": "Label available",
            "time": 9
          }
        ]
      }
    ],
    "cutoffs": [
      {
        "id": "snapshot",
        "label": "Feature snapshot",
        "time": 5
      }
    ]
  }
