{
  "version": 1,
  "diagram": {
    "title": "Churn scoring fallback",
    "caption": "Keep the nightly offer cap at 5% of eligible users on all three routes.",
    "kind": "flow",
    "nodes": [
      {
        "id": "batch",
        "label": "Did nightly scoring succeed?",
        "role": "decision"
      },
      {
        "id": "fresh",
        "label": "Use the new scores",
        "role": "outcome"
      },
      {
        "id": "usable",
        "label": "Can we reuse scores?",
        "role": "decision"
      },
      {
        "id": "last-good",
        "label": "Use last good scores",
        "role": "outcome"
      },
      {
        "id": "rule",
        "label": "Apply rule for users idle at least 14 days",
        "role": "outcome"
      }
    ],
    "edges": [
      {
        "from": "batch",
        "to": "fresh",
        "label": "Batch succeeded"
      },
      {
        "from": "batch",
        "to": "usable",
        "label": "Batch failed"
      },
      {
        "from": "usable",
        "to": "last-good",
        "label": "Present and at most 25 h old"
      },
      {
        "from": "usable",
        "to": "rule",
        "label": "Missing or over 25 h old"
      }
    ]
  }
}
