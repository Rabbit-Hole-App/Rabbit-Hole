{
  "version": 1,
  "diagram": {
    "title": "Batch and online inference",
    "caption": "The batch job runs on a schedule. At request time, the app reads a stored score for batch or sends current features for online.",
    "kind": "sequence",
    "actors": [
      {
        "id": "job",
        "label": "Batch job"
      },
      {
        "id": "model",
        "label": "Model"
      },
      {
        "id": "store",
        "label": "Score store"
      },
      {
        "id": "app",
        "label": "App"
      }
    ],
    "messages": [
      {
        "from": "job",
        "to": "model",
        "label": "Batch · score feature snapshot"
      },
      {
        "from": "model",
        "to": "job",
        "label": "Return batch scores"
      },
      {
        "from": "job",
        "to": "store",
        "label": "Store scores before requests"
      },
      {
        "from": "app",
        "to": "store",
        "label": "Batch request · read score"
      },
      {
        "from": "store",
        "to": "app",
        "label": "Return stored score"
      },
      {
        "from": "app",
        "to": "model",
        "label": "Online request · current features"
      },
      {
        "from": "model",
        "to": "app",
        "label": "Return fresh score"
      }
    ]
  }
}
