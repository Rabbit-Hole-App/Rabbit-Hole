      },
      {
        "from": "tile12",
        "to": "merge",
        "label": "$C_{12}$"
      },
      {
        "from": "tile21",
        "to": "merge",
        "label": "$C_{21}$"
      },
      {
        "from": "tile22",
        "to": "merge",
        "label": "$C_{22}$"
      },
