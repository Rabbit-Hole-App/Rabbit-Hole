      },
      {
        "id": "tile12",
        "label": "Compute $A_1 B_2$",
        "role": "process"
      },
      {
        "id": "tile21",
        "label": "Compute $A_2 B_1$",
        "role": "process"
      },
      {
        "id": "tile22",
        "label": "Compute $A_2 B_2$",
        "role": "process"
      },
      {
        "id": "merge",
        "label": "Assemble tiles in place",
