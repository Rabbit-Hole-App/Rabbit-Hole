    "fixed rate plateau",
    "training heldout gap"
  ],
  "useWhen": "Show an illustrative fixed-rate accuracy plateau and training heldout gap; not a learning-rate decay curve or a guarantee that a schedule improves generalization.",
  "illustrative": true,
  "spec": {
    "version": 1,
    "diagram": {
      "kind": "comparison",
      "variant": "panels",
      "title": "Fixed-rate diagnostics",
      "caption": "Illustrative predictions; fixed $\\eta=0.1$, no optimizer guarantee.",
      "panels": [
        {
          "heading": "Accuracy",
          "diagram": {
            "kind": "coordinate-plot",
            "title": "Accuracy",
            "x": {
              "label": "Epoch",
              "min": 1,
              "max": 4,
              "integerTicks": true
            },
            "y": {
              "label": "Accuracy",
              "min": 0,
              "max": 100,
              "unit": "%"
            },
            "series": [
              {
                "label": "Training",
                "kind": "line",
                "samples": {
                  "x": [
                    1,
                    2,
                    3,
                    4
                  ],
                  "y": [
                    50,
                    75,
                    100,
                    100
                  ]
                }
              },
              {
                "label": "Held-out",
                "kind": "line",
                "samples": {
                  "x": [
                    1,
                    2,
                    3,
                    4
                  ],
                  "y": [
                    50,
                    75,
                    75,
                    75
                  ]
                }
              }
            ],
            "annotations": [
              {
                "kind": "band",
                "axis": "x",
                "from": 2,
                "to": 4,
                "label": "Gap opens"
              }
            ]
          }
        },
        {
          "heading": "Training loss",
          "diagram": {
            "kind": "coordinate-plot",
            "title": "Training loss",
            "x": {
              "label": "Epoch",
              "min": 1,
              "max": 4,
              "integerTicks": true
            },
            "y": {
              "label": "BCE loss",
              "min": 0,
              "max": 1,
              "unit": "nats"
            },
            "series": [
              {
                "label": "Training",
                "kind": "line",
                "samples": {
                  "x": [
                    1,
                    2,
                    3,
                    4
                  ],
                  "y": [
                    0.714,
                    0.543,
                    0.382,
                    0.226
                  ]
                }
              }
            ]
          }
        }
      ],
      "sharedAxes": [
        "x"
      ]
    }
  },
