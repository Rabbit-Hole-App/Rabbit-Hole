{
  "version": 1,
  "diagram": {
    "kind": "block-stack",
    "title": "Original Transformer decoder layer",
    "caption": "Each sublayer returns $\\operatorname{LayerNorm}(x+F(x))$. Source keys and values enter only the middle sublayer.",
    "blocks": [
      {
        "id": "self",
        "label": "Masked self-attention",
        "role": "attention",
        "repeat": 6,
        "repeatTo": "n3"
      },
      {
        "id": "n1",
        "label": "Self-attention LayerNorm",
        "role": "norm"
      },
      {
        "id": "cross",
        "label": "Encoder–decoder attention",
        "role": "attention",
        "inputs": [
          {
            "label": "Encoder keys and values"
          }
        ]
      },
      {
        "id": "n2",
        "label": "Cross-attention LayerNorm",
        "role": "norm"
      },
      {
        "id": "ffn",
        "label": "Position-wise feed-forward",
        "role": "feedforward"
      },
      {
        "id": "n3",
        "label": "Feed-forward LayerNorm",
        "role": "norm"
      }
    ],
    "edges": [
      {
        "kind": "residual",
        "from": "self",
        "to": "self"
      },
      {
        "kind": "residual",
        "from": "cross",
        "to": "cross"
      },
      {
        "kind": "residual",
        "from": "ffn",
        "to": "ffn"
      }
    ]
  }
}
