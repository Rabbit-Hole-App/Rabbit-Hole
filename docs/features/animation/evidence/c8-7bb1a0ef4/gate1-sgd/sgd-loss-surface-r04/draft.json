  "assumptions": [
    "Illustration: a made-up two-setting loss bowl with simulated batch noise, not a real model trained on real data.",
    "Loss = (3x² + z²)/2, drawn at height 0.5 × loss with contour lines. It is 3 times steeper in x, so x overshoots first: steps grow without bound when learning rate > 2/3.",
    "Each step moves by −learning rate × (true slope + noise). The noise is Gaussian, with sd 2·√((64−B)/(63·B)) per axis for batch size B (sampling from 64 points), so it is exactly 0 at B = 64.",
    "Both arrows use the same scale: 2 × the step they show. Orange is the next mini-batch step (the way the ball moves). Grey is −learning rate × the true slope.",
    "A run ends at step 40 (finished), or it is diverged once loss > 6 or the ball leaves the drawn square. Off-bowl positions are drawn at the bowl edge.",
    "Noise comes from a fixed seed by run and step, so Reset replays the same noise. New run keeps the last path as the ghost and uses the next noise values."
  ],
  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.16,N=64,M=40,LIM=6,S=2,X0=-1.1,Z0=1.7;\nconst L=(x,z)=>0.5*(A*x*x+C*z*z);\nconst fr=v=>v-Math.floor(v);\nconst rnd=n=>fr(Math.sin(n*91.345+17.17)*43758.5453);\nconst gs=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(6.2832*rnd(n+0.37));\nconst sdv=b=>b>=N?0:2*Math.sqrt((N-b)/((N-1)*b));\nconst over=s=>s.bad||s.step>=M;\nconst word=s=>s.bad?'diverged':s.step>=M?'finished':s.on?'running':'paused';\nfunction grad(s,i,seed){const sd=sdv(Number(i.batchSize)),k=(s.run*41+s.step)*2+(seed||0)*0.013;return [A*s.x+sd*gs(k),C*s.z+sd*gs(k+1)];}\nfunction adv(s,i,seed){if(over(s))return s;const g=grad(s,i,seed),x=s.x-i.learningRate*g[0],z=s.z-i.learningRate*g[1];\nconst bad=L(x,z)>LIM||Math.abs(x)>2||Math.abs(z)>2;return {...s,x,z,bad,step:s.step+1,on:bad?false:s.on,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:X0,z:Z0,step:0,run,on:false,bad:false,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs:i,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:adv(s,i,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return adv({...s,on:false},i,seed);\nif(e.action==='newRun')return {...fresh(s.run+1,s.step>0?s.path:s.kept),on:true};\nreturn s;}\nconst cl=v=>Math.max(-2.1,Math.min(2.1,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return [x,Math.min(K*L(x,z),4)+0.05,z];};\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;\nreturn show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,S*l,1]}:{visible:false};}\nexport function evaluate({inputs:i,state,seed}){\nconst s=state||initialState(),live=!over(s),lr=i.learningRate,g=grad(s,i,seed),x=cl(s.x),z=cl(s.z);\nconst sx=-lr*g[0],sz=-lr*g[1];\nreturn {nodes:{ball:{position:[x,Math.min(K*L(x,z),4)+R,z]},\nstepArrow:aim(sx,sz,live),\nslopeArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&!!i.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L(s.x,s.z),stepLen:live?Math.hypot(sx,sz):0,status:word(s)}};}\n"
  }
}