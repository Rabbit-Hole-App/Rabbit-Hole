  "program": {
    "source": "const A=3,C=1,K=0.5,LIM=6,N=40,SIG=2,SC=2,X0=0.6,Z0=1.6;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sd=b=>b>=64?0:SIG*Math.sqrt((64-b)/(63*b));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=N?'finished':'running';\nfunction next(s,i,seed){const k=(seed||0)*7919+s.run*1009+s.step*2+1,d=sd(Number(i.batchSize)),lr=i.learningRate;return [-lr*(A*s.x+d*gauss(k)),-lr*(C*s.z+d*gauss(k+0.5))];}\nfunction advance(s,i,seed){if(word(s)!=='running')return s;const [dx,dz]=next(s,i,seed),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:X0,z:Z0,step:0,run,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\n if(e.type==='step')return e.tick%6?s:advance(s,inputs,seed);\n if(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\n return s;}\nconst cl=v=>Math.max(-2.1,Math.min(2.1,v));\nconst lift=p=>[cl(p[0]),Math.min(K*loss(p[0],p[1]),4)+0.04,cl(p[1])];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz)*SC,h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz*SC/l*h,0,-dx*SC/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\n const s=state||initialState(),L=loss(s.x,s.z),w=word(s),live=w==='running',[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate;\n return {nodes:{\n  ball:{position:[cl(s.x),Math.min(K*L,4)+0.16,cl(s.z)]},\n  stepArrow:aim(dx,dz,live),\n  trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),\n  trail:{points:s.path.map(lift)},\n  ghost:{points:s.kept.map(lift)}},\n  readouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:w}};}\n"
  },
