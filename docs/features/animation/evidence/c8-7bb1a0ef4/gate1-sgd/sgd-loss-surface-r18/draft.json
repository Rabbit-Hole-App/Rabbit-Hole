  "program": {
    "source": "const A=2.5,C=1,K=0.5,R=0.12,H=2,LIM=5,N=40,S=2.5,X0=0.3,Z0=1.6;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>2*Math.sqrt(Math.max(0,64-b)/(63*b));\nfunction est(s,inp,seed){const b=Math.round(inp.batchSize),d=sd(b),k=s.run*1009+s.step*2+seed+1;return[A*s.x+d*gauss(k),C*s.z+d*gauss(k+0.37)];}\nconst div=s=>Math.abs(s.x)>H||Math.abs(s.z)>H||loss(s.x,s.z)>LIM;\nconst done=s=>div(s)||s.step>=N;\nconst word=s=>div(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction adv(s,inp,seed){if(done(s))return s;const g=est(s,inp,seed),lr=inp.learningRate,x=s.x-lr*g[0],z=s.z-lr*g[1];return{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept,on)=>({x:X0,z:Z0,step:0,run,on,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return!s.on||done(s)||e.tick%6?s:adv(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return adv({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst cl=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return[x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!done(s),lr=inputs.learningRate,g=est(s,inputs,seed||0);\nconst dx=-lr*g[0],dz=-lr*g[1],x=cl(s.x),z=cl(s.z);\nreturn{nodes:{ball:{position:[x,K*loss(x,z)+R,z]},\nstepArrow:aim(S*dx,S*dz,live),\ntrueArrow:aim(-S*lr*A*s.x,-S*lr*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
