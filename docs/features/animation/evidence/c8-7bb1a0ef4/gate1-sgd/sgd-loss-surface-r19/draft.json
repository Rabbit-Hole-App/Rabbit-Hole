  "program": {
    "source": "const A=2.4,C=1,K=0.5,R=0.1,H=2,LIM=8,N=40,S0=1.5,X0=[1.2,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>S0*Math.sqrt(Math.max(0,64-b)/(63*b));\nfunction next(s,i){const k=s.run*1009+s.step*2+1,d=sd(Math.max(1,Number(i.batchSize))),r=i.learningRate;return [-r*(A*s.x+d*gauss(k)),-r*(C*s.z+d*gauss(k+0.25))];}\nconst word=s=>s.div?'diverged':s.step>=N?'finished':'running';\nfunction adv(s,i){if(s.div||s.step>=N)return s;const [dx,dz]=next(s,i),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,div:loss(x,z)>LIM,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:X0[0],z:X0[1],step:0,run,div:false,path:[X0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs:i}){\n if(e.type==='step')return e.tick%6?s:adv(s,i);\n if(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\n return s;}\nconst dc=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>[dc(p[0]),K*loss(dc(p[0]),dc(p[1]))+0.03,dc(p[1])];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs:i,state}){\n const s=state||initialState(),L=loss(s.x,s.z),[dx,dz]=next(s,i),r=i.learningRate,cx=dc(s.x),cz=dc(s.z);\n const ro={loss:L,steps:s.step,status:word(s)};\n if(!s.div)ro.stepLen=Math.hypot(dx,dz);\n return {nodes:{\n  ball:{position:[cx,K*loss(cx,cz)+R,cz]},\n  stepArrow:aim(dx,dz,!s.div),\n  trueArrow:aim(-r*A*s.x,-r*C*s.z,!s.div&&!!i.showTrueGradient),\n  trail:{points:s.path.map(lift)},\n  ghost:{points:s.kept.map(lift)}},\n  readouts:ro};}\n"
  },
