  "program": {
    "source": "const A=3,C=1,K=0.5,N=64,S0=2,LIM=6,MAXS=40,ST=[0.3,1.6],E=2.2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst sd=b=>b>=N?0:S0*Math.sqrt((N-b)/((N-1)*b));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nconst over=s=>{const w=word(s);return w==='diverged'||w==='finished';};\nfunction next(s,i,seed){const r=i.learningRate,d=sd(Math.round(i.batchSize)),k=(seed||0)*7+s.run*1009+s.step*2+1;return[-r*(A*s.x+d*gauss(k)),-r*(C*s.z+d*gauss(k+0.25))];}\nfunction adv(s,i,seed){if(over(s))return s;const[dx,dz]=next(s,i,seed),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,run,on:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs:i,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:adv(s,i,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return adv({...s,on:false},i,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-E,Math.min(E,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return[x,Math.min(K*loss(x,z),4.2)+0.05,z];};\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs:i,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,i,seed),x=cl(s.x),z=cl(s.z);\nreturn{nodes:{ball:{position:[x,K*loss(x,z)+0.16,z]},stepArrow:aim(dx,dz,live),trueArrow:aim(-i.learningRate*A*s.x,-i.learningRate*C*s.z,live&&i.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
