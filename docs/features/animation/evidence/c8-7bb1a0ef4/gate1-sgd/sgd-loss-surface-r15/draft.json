  "assumptions": [
    "Illustration: a made-up two-setting loss bowl with simulated batch noise, not a real model trained on real data.",
    "Loss = (3x² + z²)/2, drawn as a surface at 0.5 × loss over x, z from -2 to 2. It is 3 times steeper in x, so overshoot shows there first: with this bowl, learning rates above 2/3 make the x swings grow.",
    "Step = −learning rate × (true slope + noise). The noise is Gaussian and centred on zero, with spread 2·√((64−b)/(63·b)) for batch b: 2 at b=1 and exactly 0 at 64. A fixed seed sets it per run and step.",
    "The orange arrow is the mini-batch step the ball will take. The grey arrow is the full-data step (−learning rate × true slope). Both are drawn at 2 × their true length in bowl units.",
    "A run ends after 40 steps (finished), or when the loss goes above 6, the loss at the bowl's edge x = ±2 (diverged). Very large losses are capped on screen. The readout keeps the true value.",
    "The trail holds the start point plus one point per step. 'New run, keep last path' keeps that path as the ghost and uses the next noise values. Then press Run."
  ],
  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.12,N=64,MAXS=40,LIM=6,AS=2,ST=[0.8,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*91.345+17.17)*24634.6345;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.5));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=MAXS?'finished':s.on?'running':s.step===0?'ready':'paused';\nconst over=s=>{const w=word(s);return w==='diverged'||w==='finished';};\nfunction next(s,inp){const b=Math.round(Number(inp.batchSize)),sd=b>=N?0:2*Math.sqrt((N-b)/((N-1)*b)),k=s.run*1009+s.step*2+1,lr=inp.learningRate;\nreturn [-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+0.37))];}\nfunction advance(s,inp){if(over(s))return s;const [dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,run,on:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst lift=p=>[Math.max(-2,Math.min(2,p[0])),Math.min(K*loss(p[0],p[1]),4)+0.05,Math.max(-2,Math.min(2,p[1]))];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\nreturn {nodes:{\nball:{position:[s.x,K*L+R,s.z]},\nstepArrow:aim(dx*AS,dz*AS,live),\ntrueArrow:aim(-lr*A*s.x*AS,-lr*C*s.z*AS,live&&!!inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},\nghost:{points:s.kept.map(lift)}},\nreadouts:{loss:L,steps:s.step,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  }
}