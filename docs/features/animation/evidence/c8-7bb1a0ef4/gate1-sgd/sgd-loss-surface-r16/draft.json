  "program": {
    "source": "const A=3,C=0.5,K=0.4,R=0.14,H=2.5,LIM=9,N=40,S0=1.5,ST=[1.6,2],TOP=4.5;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sdev=b=>S0*Math.sqrt(Math.max(0,(64-b)/(63*b)));\nconst bad=s=>loss(s.x,s.z)>LIM||Math.abs(s.x)>H||Math.abs(s.z)>H;\nconst over=s=>bad(s)||s.step>=N;\nconst word=s=>bad(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction next(s,i,seed){const sd=sdev(i.batchSize),k=(seed||0)*7.1+s.run*1009+s.step*2+1,lr=i.learningRate;return [-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+0.71))];}\nfunction advance(s,i,seed){if(over(s))return s;const [dx,dz]=next(s,i,seed),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,run,on:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return [x,Math.min(K*loss(x,z),TOP)+0.05,z];};\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed);\nconst lr=inputs.learningRate,gx=2*K*A*s.x/2,gz=2*K*C*s.z/2;\nconst ro={steps:s.step,loss:L,status:word(s)};\nif(live)ro.stepLen=Math.hypot(dx,dz);\nreturn {nodes:{\nball:{position:[s.x,K*L+R*Math.sqrt(1+gx*gx+gz*gz),s.z]},\nstepArrow:aim(dx,dz,live),\ntrueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},\nghost:{points:s.kept.map(lift)}},\nreadouts:ro};}\n"
  },
