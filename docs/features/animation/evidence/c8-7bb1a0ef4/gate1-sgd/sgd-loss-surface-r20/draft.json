      "kind": "text"
    }
  ],
  "program": {
    "source": "const A=3,C=1,K=0.5,N=64,MAXS=40,LIM=8,S0=2,AS=3,ST=[1,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>b>=N?0:S0*Math.sqrt((N-b)/((N-1)*b));\nconst out=s=>Math.abs(s.x)>2||Math.abs(s.z)>2||loss(s.x,s.z)>LIM;\nconst word=s=>out(s)?'diverged':s.step>=MAXS?'finished':'running';\nfunction next(s,inp,seed){const d=sd(Math.round(inp.batchSize)),k=s.k*2+1+seed*101,lr=inp.learningRate;return[-lr*(A*s.x+d*gauss(k)),-lr*(C*s.z+d*gauss(k+0.37))];}\nfunction advance(s,inp,seed){if(word(s)!=='running')return s;const[dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,k:s.k+1,path:s.path.concat([[x,z]]).slice(-MAXS)};}\nconst fresh=(k,kept)=>({x:ST[0],z:ST[1],step:0,k,path:[],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){if(e.type==='step')return advance(s,inputs,seed);if(e.type==='action'&&e.action==='newRun')return fresh(s.k,s.path.length?s.path:s.kept);return s;}\nconst cl=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return[x,K*Math.min(loss(x,z),LIM)+0.05,z];};\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz)*AS,h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz*AS/l*h,0,-dx*AS/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){const s=state||initialState(),w=word(s),live=w==='running',[dx,dz]=next(s,inputs,seed||0),lr=inputs.learningRate,x=cl(s.x),z=cl(s.z);return{nodes:{ball:{position:[x,K*Math.min(loss(x,z),LIM)+0.14,z]},stepArrow:aim(dx,dz,live),trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:{steps:s.step,loss:loss(s.x,s.z),stepLen:live?Math.hypot(dx,dz):0,status:w}};}\n"
  },
