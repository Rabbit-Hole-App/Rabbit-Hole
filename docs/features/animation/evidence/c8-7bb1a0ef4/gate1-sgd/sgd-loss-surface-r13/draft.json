  "assumptions": [
    "Illustration: a made-up two-setting loss bowl with simulated batch noise, not a real model trained on real data.",
    "Loss = (2.5 x² + z²)/2, drawn at half height. It is steeper along x, so x overshoots once learning rate > 0.4 and swings grow once it is > 0.8. Start: x = 1.2, z = 1.6.",
    "Step = −learning rate × (true slope + noise). Noise sd = 2.5·√((64−b)/(63·b)), so it is largest at b = 1 and exactly zero at b = 64. It is random and centred on zero, so steps lower the loss only on average.",
    "Orange arrow: the next mini-batch step, the direction the ball moves. Grey arrow: −learning rate × true slope. Both are drawn at true step length (scale 1).",
    "The run ends after 40 updates (finished) or when the loss passes 10 (diverged). Off-bowl positions are drawn at the bowl's edge, but the loss readout keeps the true value.",
    "Noise comes from a fixed seed, so Reset replays the same sequence. Updates run at 5 per second at speed 1. 'One update' moves the run on by exactly one step."
  ],
  "program": {
    "source": "const A=2.5,C=1,K=0.5,R=0.16,H=2,LIM=10,N=40,S=2.5,X0=[1.2,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>b>=64?0:S*Math.sqrt((64-b)/(63*b));\nfunction next(s,inp,seed){const k=s.run*1009+s.step*2+(seed||0)+1,g=sd(Number(inp.batchSize)),lr=inp.learningRate;return [-lr*(A*s.x+g*gauss(k)),-lr*(C*s.z+g*gauss(k+0.25))];}\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=N?'finished':'running';\nfunction advance(s,inp,seed){if(word(s)!=='running')return s;const [dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:X0[0],z:X0[1],step:0,run,path:[X0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='stepOnce')return advance(s,inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return [x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-4?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),live=word(s)==='running',[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate,x=cl(s.x),z=cl(s.z);\nreturn {nodes:{ball:{position:[x,K*loss(x,z)+R,z]},stepArrow:aim(dx,dz,live),trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{loss:loss(s.x,s.z),steps:s.step,arrowLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  }
}