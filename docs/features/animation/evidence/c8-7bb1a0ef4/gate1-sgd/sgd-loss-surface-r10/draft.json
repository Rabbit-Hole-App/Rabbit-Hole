  "program": {
    "source": "const A=2.4,C=0.6,K=0.5,R=0.16,S=3,N=40,LIM=5,P0=[0.8,1.6],SD=1.5;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gs=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sdev=b=>SD*Math.sqrt(Math.max(0,64-b)/(63*b));\nfunction grads(s,inp){const sd=sdev(Number(inp.batchSize)),k=s.run*131+s.k*2+7.1,gx=A*s.x,gz=C*s.z;return [gx,gz,gx+sd*gs(k),gz+sd*gs(k+0.5)];}\nconst word=s=>s.dead?'diverged':s.k>=N?'finished':'running';\nconst over=s=>s.dead||s.k>=N;\nfunction advance(s,inp){if(over(s))return s;const g=grads(s,inp),lr=inp.learningRate,x=s.x-lr*g[2],z=s.z-lr*g[3];return {...s,x,z,k:s.k+1,dead:loss(x,z)>LIM,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:P0[0],z:P0[1],k:0,run,dead:false,path:[P0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\n if(e.type==='step')return e.tick%5?s:advance(s,inputs);\n if(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.k>0?s.path:s.kept);\n return s;}\nconst cl=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>[cl(p[0]),Math.min(K*loss(p[0],p[1]),3)+0.05,cl(p[1])];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\n const s=state||initialState(),L=loss(s.x,s.z),live=!over(s),g=grads(s,inputs),lr=inputs.learningRate;\n const p=lift([s.x,s.z]);\n return {nodes:{\n  ball:{position:[p[0],p[1]-0.05+R,p[2]]},\n  stepArrow:aim(-lr*g[2]*S,-lr*g[3]*S,live),\n  trueArrow:aim(-lr*g[0]*S,-lr*g[1]*S,live&&inputs.showTrueGradient),\n  trail:{points:s.path.map(lift)},\n  ghost:{points:s.kept.map(lift)}},\n readouts:{loss:L,status:word(s),steps:s.k,stepLen:live?lr*Math.hypot(g[2],g[3]):0}};}\n"
  },
