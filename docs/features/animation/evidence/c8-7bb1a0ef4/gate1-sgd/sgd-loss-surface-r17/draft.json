  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.12,N=64,S0=1.5,LIM=6,MAXS=40,START=[0.6,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>b>=N?0:S0*Math.sqrt((N-b)/((N-1)*b));\nconst over=s=>s.step>=MAXS||loss(s.x,s.z)>LIM;\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nfunction next(s,inputs,seed){\n  const lr=inputs.learningRate,d=sd(Number(inputs.batchSize)),k=(seed||0)*101+s.run*1009+s.step*2+1;\n  return [-lr*(A*s.x+d*gauss(k)),-lr*(C*s.z+d*gauss(k+0.25))];\n}\nfunction advance(s,inputs,seed){\n  if(over(s))return s;\n  const [dx,dz]=next(s,inputs,seed),x=s.x+dx,z=s.z+dz;\n  return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};\n}\nconst fresh=(run,kept,on)=>({x:START[0],z:START[1],step:0,run,on,path:[START],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs,seed}){\n  if(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\n  if(e.type!=='action')return s;\n  if(e.action==='run')return over(s)?s:{...s,on:true};\n  if(e.action==='pause')return {...s,on:false};\n  if(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\n  if(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,true);\n  return s;\n}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),4)+0.06,p[1]];\nfunction aim(dx,dz,shown){\n  const l=Math.hypot(dx,dz),h=Math.SQRT1_2;\n  return shown&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};\n}\nexport function evaluate({inputs,state,seed}){\n  const s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate;\n  return {\n    nodes:{\n      ball:{position:[s.x,K*L+R,s.z]},\n      stepArrow:aim(dx,dz,live),\n      trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),\n      trail:{points:s.path.map(lift)},\n      ghost:{points:s.kept.map(lift)}\n    },\n    readouts:{loss:L,status:word(s),steps:s.step,stepLen:live?Math.hypot(dx,dz):0}\n  };\n}\n"
  },
