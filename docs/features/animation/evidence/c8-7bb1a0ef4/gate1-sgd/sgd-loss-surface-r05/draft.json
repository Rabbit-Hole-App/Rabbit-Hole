  "program": {
    "source": "const A=3,C=1,K=0.4,R=0.12,S=2,MAXS=40,LIM=6,X0=1.2,Z0=1.6;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s)};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.5));\nconst sd=b=>1.5*Math.sqrt(Math.max(0,64-b)/(63*b));\nconst off=s=>loss(s.x,s.z)>LIM||Math.abs(s.x)>2||Math.abs(s.z)>2;\nconst over=s=>off(s)||s.step>=MAXS;\nconst word=s=>off(s)?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nfunction next(s,inp){const lr=inp.learningRate,d=sd(Number(inp.batchSize)),k=s.n*2+1;return[-lr*(A*s.x+d*gauss(k)),-lr*(C*s.z+d*gauss(k+0.25))]}\nfunction advance(s,inp){if(over(s))return s;const[dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;return{...s,x,z,n:s.n+1,step:s.step+1,path:s.path.concat([[x,z]])}}\nconst fresh=(n,kept)=>({x:X0,z:Z0,step:0,n,on:false,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[])}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step'){if(!s.on||e.tick%6)return s;const t=advance(s,inputs);return over(t)?{...t,on:false}:t}\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept);\nreturn s}\nconst cl=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>[cl(p[0]),Math.min(K*loss(p[0],p[1]),3.2)+0.05,cl(p[1])];\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,S*l,1]}:{visible:false}}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\nreturn{nodes:{ball:{position:[cl(s.x),Math.min(K*L,3.2)+R,cl(s.z)]},stepArrow:aim(dx,dz,live),slopeArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}}}\n"
  },
