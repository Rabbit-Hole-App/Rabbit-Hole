  "assumptions": [
    "Simplified simulation: no air resistance, ball starts at ground level on flat ground.",
    "Gravity is 9.8 m/s² straight down; horizontal speed stays constant, only vertical speed changes.",
    "Positions come exactly from the projectile formulas, so landing distance = speed² × sin(2 × angle) ÷ 9.8. The ball is a point; flight ends when it returns to ground height (drawn ball centre sits one radius up).",
    "Targets come in fixed order (30 m, 45 m, 18 m); Reset starts the same challenge again and clears score and trails.",
    "Each flight is shown over about two seconds, so screen time does not match the flight-time readout. Real balls are slowed by air and land shorter.",
    "The longest shot is about 64 m (25 m/s at 45°)."
  ],
  "program": {
    "source": "const G=9.8,TG=[30,45,18],N=40,D=Math.PI/180;\nfunction shotOf(a,v){const r=a*D,s=Math.sin(r);return{a,v,T:2*v*s/G,R:v*v*Math.sin(2*r)/G,H:v*v*s*s/(2*G)};}\nfunction pt(s,t){const r=s.a*D;return[s.v*Math.cos(r)*t,1.2+Math.max(0,s.v*Math.sin(r)*t-4.9*t*t),0];}\nfunction arc(s,f){const p=[];for(let i=0;i<=N;i++)p.push(pt(s,s.T*f*i/N));return p;}\nexport function initialState(){return{idx:0,hits:0,used:0,fly:false,p:0,shot:null,prev:null,res:null,status:'playing'};}\nexport function reduce({state,event,inputs}){\nif(event.type==='action'&&event.action==='launch'){if(state.fly||state.status!=='playing')return state;return{...state,fly:true,p:0,prev:state.shot,shot:shotOf(inputs.angle,inputs.speed),used:state.used+1};}\nif(event.type==='step'&&state.fly){const p=state.p+1/60;if(p<1)return{...state,p};const s=state.shot,d=s.R-TG[state.idx],hit=Math.abs(d)<=1.5+1e-9;const hits=state.hits+(hit?1:0),idx=hit?state.idx+1:state.idx;const status=hits>=3?'won':(state.used>=10?'lost':'playing');return{...state,fly:false,p:1,hits,idx,status,res:{R:s.R,miss:Math.abs(d),side:hit?'hit':(d<0?'short':'long'),T:s.T,H:s.H}};}\nreturn state;}\nexport function evaluate({inputs,state}){\nconst th=-(Math.PI/2-inputs.angle*D);const nodes={pivot:{quaternion:[0,0,Math.sin(th/2),Math.cos(th/2)]}};\nconst ti=Math.min(state.idx,2);nodes.target={position:[TG[ti],0,0]};\nconst s=state.shot;if(s){const f=state.fly?state.p:1;nodes.ball={position:pt(s,s.T*f)};nodes.trail={visible:true,points:arc(s,f)};}else{nodes.ball={position:[0,1.2,0]};nodes.trail={visible:false};}\nif(state.prev)nodes.ghost={visible:true,points:arc(state.prev,1)};else nodes.ghost={visible:false};\nconst ro={used:state.used,hits:state.hits};const r=state.res;if(r){ro.dist=r.R;ro.miss=r.miss;ro.side=r.side;ro.ftime=r.T;ro.height=r.H;}\nconst left=10-state.used;let msg;\nif(state.status==='won')msg='You win! All 3 targets hit in '+state.used+' launches.';\nelse if(state.status==='lost')msg='Out of launches: '+state.hits+' of 3 targets hit.';\nelse if(state.fly)msg='Ball in flight...';\nelse{const pre=r?(r.side==='hit'?'Hit! ':'Missed '+r.miss.toFixed(1)+' m '+r.side+'. '):'';msg=pre+'Target at '+TG[ti]+' m, '+left+' launches left.';}\nreturn{nodes,readouts:ro,goal:{status:state.status,message:msg}};}"
  }
}