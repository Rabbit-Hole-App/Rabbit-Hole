  "program": {
    "source": "const G=9.8,N=60,TG=[30,45,18],R=1.2,D=Math.PI/180;\nfunction pos(a,v,f){const r=a*D,T=2*v*Math.sin(r)/G,t=f*T;return [v*Math.cos(r)*t,R+v*Math.sin(r)*t-G*t*t/2,0];}\nfunction pts(a,v,k){const p=[];for(let i=0;i<=k;i++)p.push(pos(a,v,i/N));return p;}\nfunction over(s){return s.hits>=3||s.shots>=10;}\nexport function initialState(){return {fly:false,k:0,prev:null,cur:null,shots:0,hits:0,ti:0,last:null};}\nexport function reduce({state,event,inputs}){const s={...state};\nif(event.type==='action'&&event.action==='launch'){if(s.fly||over(s))return state;s.prev=s.cur;s.cur={a:inputs.angle,v:inputs.speed};s.fly=true;s.k=0;return s;}\nif(event.type==='step'&&s.fly){s.k++;if(s.k>=N){s.k=N;s.fly=false;const a=s.cur.a*D,v=s.cur.v,range=v*v*Math.sin(2*a)/G,miss=range-TG[s.ti],hit=Math.abs(miss)<=1.5;s.shots++;if(hit){s.hits++;if(s.ti<2)s.ti++;}s.last={range,miss,hit,T:2*v*Math.sin(a)/G,H:Math.pow(v*Math.sin(a),2)/(2*G)};}return s;}\nreturn state;}\nexport function evaluate({inputs,state}){const s=state,th=-(Math.PI/2-inputs.angle*D);\nconst nodes={pivot:{quaternion:[0,0,Math.sin(th/2),Math.cos(th/2)]},target:{position:[TG[s.ti],0,0]}};\nif(s.cur){nodes.ballN={position:pos(s.cur.a,s.cur.v,s.k/N)};nodes.trailN={visible:true,points:pts(s.cur.a,s.cur.v,s.k)};}else{nodes.ballN={position:[0,R,0]};nodes.trailN={visible:false};}\nnodes.ghostN=s.prev?{visible:true,points:pts(s.prev.a,s.prev.v,N)}:{visible:false};\nconst ro={shots:s.shots,hits:s.hits};const L=s.last;\nif(L){ro.range=L.range;ro.miss=Math.abs(L.miss);ro.side=L.hit?'hit':(L.miss<0?'short':'long');ro.ftime=L.T;ro.hmax=L.H;}\nlet st='playing',msg;if(s.hits>=3){st='won';msg='You hit all 3 targets in '+s.shots+' launches!';}else if(s.shots>=10){st='lost';msg='Out of launches: '+s.hits+' of 3 targets hit.';}else if(s.fly){msg='Ball in flight...';}else{msg=(L?(L.hit?'Hit! ':'Missed '+(L.miss<0?'short':'long')+' by '+Math.abs(L.miss).toFixed(1)+' m. '):'')+'Target at '+TG[s.ti]+' m. Launches left: '+(10-s.shots)+'.';}\nreturn {nodes,readouts:ro,goal:{status:st,message:msg}};}"
  }
