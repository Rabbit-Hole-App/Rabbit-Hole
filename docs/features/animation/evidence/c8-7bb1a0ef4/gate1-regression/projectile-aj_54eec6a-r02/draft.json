{
  "title": "Projectile Target Challenge: Pick Angle and Speed",
  "description": "A launcher sits at the left end of a flat 70 m field with marks every 10 m. A red-flagged target zone (1.5 m radius) sits down the field. Set the launch angle and speed, then press Launch: the orange ball flies its arc and leaves a trail, and your previous arc stays as a faded grey line. Readouts give landing distance, miss distance and side, flight time, highest point, launches used and targets hit. Hit targets at 30 m, 45 m and 18 m within 10 launches.",
  "experience": "game",
  "behavior": "rules",
  "controlProfile": "inspect",
  "stepped": true,
  "game": {
    "objective": "Hit 3 targets (30 m, 45 m, then 18 m) using no more than 10 launches. A hit lands within 1.5 m of the target centre.",
    "hint": "With the same speed, angles that add up to 90° (like 30° and 60°) land at the same distance, and 45° goes farthest. Doubling the speed makes the shot go four times as far."
  },
  "parameters": [
    {
      "type": "number",
      "id": "angle",
      "label": "Launch angle",
      "unit": "°",
      "min": 10,
      "max": 80,
      "step": 1,
      "default": 45
    },
    {
      "type": "number",
      "id": "speed",
