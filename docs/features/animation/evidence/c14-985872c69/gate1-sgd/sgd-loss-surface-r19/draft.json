  "program": {
    "source": "const A=2.4,C=0.4,K=0.4,R=0.16,H=2,N=40,LIM=4.8,SC=5,S0=[0.5,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst fr=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s)};\nconst gs=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,fr(n))))*Math.cos(2*Math.PI*fr(n+0.37));\nconst sd=b=>b>=64?0:Math.sqrt((64-b)/(63*b));\nfunction steps(s,i,seed){const gx=A*s.x,gz=C*s.z,r=i.learningRate,d=sd(Number(i.batchSize)),k=(seed||0)*131+s.run*997+s.step*3+1;return{mb:[-r*(gx+d*gs(k)),-r*(gz+d*gs(k+1.5))],fd:[-r*gx,-r*gz]}}\nconst off=s=>Math.abs(s.x)>H||Math.abs(s.z)>H||loss(s.x,s.z)>LIM;\nconst over=s=>off(s)||s.step>=N;\nconst word=s=>off(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction adv(s,i,seed){if(over(s))return s;const[dx,dz]=steps(s,i,seed).mb,x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])}}\nconst fresh=(run,kept)=>({x:S0[0],z:S0[1],step:0,run,on:false,path:[S0],kept});\nexport function initialState(){return fresh(0,[])}\nexport function reduce({state:s,event:e,inputs:i,seed}){\nif(e.type==='step')return!s.on||over(s)||e.tick%6?s:adv(s,i,seed);\nif(e.type!=='action')return s;\nif(e.action==='play')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return adv({...s,on:false},i,seed);\nif(e.action==='newRun')return{...fresh(s.run+1,s.step>0?s.path:s.kept),on:true};\nreturn s}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return[x,K*loss(x,z)+0.05,z]};\nfunction aim(d,show){const v=Math.hypot(d[0],d[1]),h=Math.SQRT1_2;return show&&v>0?{visible:true,quaternion:[d[1]/v*h,0,-d[0]/v*h,h],scale:[1,v*SC,1]}:{visible:false}}\nexport function evaluate({inputs:i,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),st=steps(s,i,seed),p=lift([s.x,s.z]);\nreturn{nodes:{ball:{position:[p[0],p[1]-0.05+R,p[2]]},stepArrow:aim(st.mb,live),fullArrow:aim(st.fd,live&&!!i.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(st.mb[0],st.mb[1]):0,status:word(s)}}}\n"
  },
