  "program": {
    "source": "const A=2.4,C=0.4,K=0.5,R=0.12,N=40,LIM=4.8,S=0.6,SC=8,ST=[0.3,1.8];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=(n,q)=>{const s=Math.sin(n*12.9898+q*78.233+1.7)*43758.5453;return s-Math.floor(s);};\nconst gauss=(n,q)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n,q))))*Math.cos(2*Math.PI*rnd(n+0.37,q));\nconst out=s=>loss(s.x,s.z)>LIM||Math.abs(s.x)>2||Math.abs(s.z)>2;\nconst over=s=>out(s)||s.step>=N;\nconst word=s=>out(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction grads(s,inp,q){const b=inp.batchSize,sd=S*Math.sqrt(Math.max(0,64-b)/(63*b)),k=s.run*1009+s.step*3,gx=A*s.x,gz=C*s.z;return [gx,gz,gx+sd*gauss(k,q),gz+sd*gauss(k+1,q)];}\nfunction advance(s,inp,q){if(over(s))return s;const g=grads(s,inp,q),r=inp.learningRate,x=s.x-r*g[2],z=s.z-r*g[3];return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept,on)=>({x:ST[0],z:ST[1],step:0,run,on,path:[ST],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='play')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst rim=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,show){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&v>1e-9?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),g=grads(s,inputs,seed),r=inputs.learningRate,dx=-r*g[2],dz=-r*g[3],bx=rim(s.x),bz=rim(s.z);\nconst ro={loss:L,steps:s.step,status:word(s)};if(live)ro.stepLen=Math.hypot(dx,dz);\nreturn {nodes:{ball:{position:[bx,K*loss(bx,bz)+R,bz]},stepArrow:aim(dx,dz,live),fullArrow:aim(-r*g[0],-r*g[1],live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:ro};}\n"
  },
