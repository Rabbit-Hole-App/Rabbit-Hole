  "program": {
    "source": "const A=2.5,C=0.5,K=0.4,S=0.8,N=64,MAXS=40,LIM=5,R=0.14,SC=4,START=[0.3,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gau=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sdOf=b=>S*Math.sqrt(Math.max(0,(N-b)/((N-1)*b)));\nconst off=s=>Math.abs(s.x)>2||Math.abs(s.z)>2||loss(s.x,s.z)>LIM;\nconst word=s=>off(s)?'diverged':s.step>=MAXS?'finished':'running';\nfunction next(s,inp,seed){const sd=sdOf(Number(inp.batchSize)),k=(seed||0)*31+s.run*1009+s.step*2+1,lr=inp.learningRate;return [-lr*(A*s.x+sd*gau(k)),-lr*(C*s.z+sd*gau(k+500.5))];}\nfunction advance(s,inp,seed){if(word(s)!=='running')return s;const [dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:START[0],z:START[1],step:0,run,path:[START],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return e.tick%5?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='stepOnce')return advance(s,inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst rim=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.04,z];};\nfunction aim(s,dx,dz,show){const v=Math.hypot(dx,dz);if(!show||v<1e-6)return {visible:false};const dy=K*(A*s.x*dx+C*s.z*dz),d=Math.hypot(dx,dy,dz),q=[dz,0,-dx,d+dy],n=Math.hypot(...q);return {visible:true,quaternion:q.map(c=>c/n),scale:[1,v*SC,1]};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=word(s)==='running',[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate,p=lift([s.x,s.z]);\nreturn {nodes:{ball:{position:[p[0],K*L+R,p[2]]},stepArrow:aim(s,dx,dz,live),fullArrow:aim(s,-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
