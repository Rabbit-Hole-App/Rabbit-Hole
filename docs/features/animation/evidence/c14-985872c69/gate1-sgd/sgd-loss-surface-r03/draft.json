  "program": {
    "source": "const A=2.4,C=0.4,K=0.5,R=0.14,HALF=2,LIMIT=5,MAXS=40,NS=1.2,SC=0.6,START=[0.6,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>NS*Math.sqrt(Math.max(0,64-b)/(63*b));\nfunction grad(s,inputs,seed){const b=Math.max(1,Number(inputs.batchSize)||1),d=sd(b),k=(seed||0)*31+s.run*1009+s.step*2+1;return[A*s.x+d*gauss(k),C*s.z+d*gauss(k+0.27)];}\nconst div=s=>loss(s.x,s.z)>LIMIT||Math.abs(s.x)>HALF||Math.abs(s.z)>HALF;\nconst over=s=>div(s)||s.step>=MAXS;\nconst word=s=>div(s)?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nfunction adv(s,inputs,seed){if(over(s))return s;const g=grad(s,inputs,seed),r=inputs.learningRate,x=s.x-r*g[0],z=s.z-r*g[1];return{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept,on)=>({x:START[0],z:START[1],step:0,run,on,path:[START],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:adv(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return adv({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst rim=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return[x,K*loss(x,z)+0.04,z];};\nfunction aim(gx,gz,show){const v=Math.hypot(gx,gz),h=Math.SQRT1_2;if(!show||v<1e-6)return{visible:false};return{visible:true,quaternion:[-gz/v*h,0,gx/v*h,h],scale:[1,v*SC,1]};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),g=grad(s,inputs,seed),x=rim(s.x),z=rim(s.z);\nreturn{nodes:{ball:{position:[x,K*loss(x,z)+R,z]},miniArrow:aim(g[0],g[1],live),fullArrow:aim(A*s.x,C*s.z,live&&!!inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,slope:Math.hypot(g[0],g[1]),status:word(s)}};}\n"
  },
