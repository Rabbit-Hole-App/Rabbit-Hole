  "program": {
    "source": "const A=2.4,C=0.6,K=1/2.4,R=0.16,HALF=2.4,LIMIT=7,N=40,S=0.8,SCALE=5,START=[0.25,2];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=(n,sd)=>{const v=Math.sin(n*12.9898+sd*78.233+1.7)*43758.5453;return v-Math.floor(v);};\nconst gauss=(n,sd)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n,sd))))*Math.cos(2*Math.PI*rand(n+0.37,sd));\nconst spread=b=>b>=64?0:S*Math.sqrt((64-b)/(63*b));\nfunction next(s,inputs,seed){const lr=inputs.learningRate,d=spread(Number(inputs.batchSize));\nconst gx=A*s.x+d*gauss(2*s.k,seed),gz=C*s.z+d*gauss(2*s.k+1,seed);return[-lr*gx,-lr*gz];}\nconst word=s=>s.div?'diverged':s.step>=N?'finished':'running';\nconst over=s=>s.div||s.step>=N;\nfunction advance(s,inputs,seed){if(over(s))return s;const[dx,dz]=next(s,inputs,seed),x=s.x+dx,z=s.z+dz;\nconst div=loss(x,z)>LIMIT||Math.abs(x)>HALF||Math.abs(z)>HALF;\nreturn{...s,x,z,div,k:s.k+1,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(k,kept)=>({x:START[0],z:START[1],step:0,k,div:false,path:[START],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return e.tick%3?s:advance(s,inputs,seed);\nif(e.type==='action'&&e.action==='newRun')return fresh(s.k,s.step>0?s.path:s.kept);\nreturn s;}\nconst rim=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return[x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,shown){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;\nreturn shown&&v>1e-6?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SCALE,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){const s=state||initialState(),L=loss(s.x,s.z),[dx,dz]=next(s,inputs,seed),live=!s.div,lr=inputs.learningRate;\nreturn{nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(dx,dz,live),\nfullArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
