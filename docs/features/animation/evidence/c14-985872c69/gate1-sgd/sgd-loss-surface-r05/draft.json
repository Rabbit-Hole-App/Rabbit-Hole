  "program": {
    "source": "const A=2.4,C=0.6,K=0.5,R=0.16,HALF=2,LIM=5,N=40,S0=[0.5,1.7],SIG=1.5,SCALE=3,EVERY=4;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sd=b=>b>=64?0:SIG*Math.sqrt((64-b)/(63*b));\nfunction noisy(s,inp,seed){const d=sd(Number(inp.batchSize)),k=(seed||0)*7919+s.run*1009+s.step*3+11;return [A*s.x+d*gauss(k),C*s.z+d*gauss(k+1.5)];}\nconst word=s=>s.div?'diverged':s.step>=N?'finished':s.step===0?'ready':'running';\nconst live=s=>!s.div&&s.step<N;\nfunction advance(s,inp,seed){if(!live(s))return s;const g=noisy(s,inp,seed),r=inp.learningRate,x=s.x-r*g[0],z=s.z-r*g[1];return {...s,x,z,step:s.step+1,div:loss(x,z)>LIM||Math.abs(x)>HALF||Math.abs(z)>HALF,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:S0[0],z:S0[1],step:0,run,div:false,path:[S0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\n if(e.type==='step')return e.tick%EVERY?s:advance(s,inputs,seed);\n if(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\n return s;}\nconst rim=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,show){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&v>1e-9?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SCALE,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\n const s=state||initialState(),L=loss(s.x,s.z),on=live(s),r=inputs.learningRate,g=noisy(s,inputs,seed),dx=-r*g[0],dz=-r*g[1];\n return {nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(dx,dz,on),fullArrow:aim(-r*A*s.x,-r*C*s.z,on&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\n readouts:{steps:s.step,loss:L,stepLen:on?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
