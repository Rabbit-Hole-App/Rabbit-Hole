  "assumptions": [
    "Illustration: a made-up two-setting loss bowl with simulated batch noise, not a real model trained on real data.",
    "Loss = (2.4 x^2 + 0.6 z^2) / 2, drawn at 0.4 times the loss. x is the steep direction: without noise each x step multiplies x by 1 - 2.4 x rate, so rates above 0.83 overshoot with growing swings.",
    "Each step moves the ball by -rate x (slope + noise). Noise is Gaussian on both slope parts with spread 1.5 x sqrt((64 - b) / (63 b)), like sampling b of 64 points; it is exactly zero at 64.",
    "Both arrows are steps drawn at 4 times their true length, one scale for both. Mini-batch step is the move the ball will make next; Full-data step is -rate x true slope. They are hidden once a run ends.",
    "A run finishes after 40 steps, or is marked diverged when the loss passes 5. Points off the drawn bowl are shown at its rim; the Loss readout keeps the true value.",
    "Noise comes from a fixed seed, so Reset replays the same sequence; a new run uses the next values. The trail holds the start plus up to 40 steps (41 points)."
  ],
  "program": {
    "source": "const A=2.4,C=0.6,K=0.4,R=0.12,H=2,N=40,S=1.5,LIM=5,SC=4,ST=[0.4,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gs=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(6.2832*rnd(n+0.37));\nconst sd=b=>b>=64?0:S*Math.sqrt((64-b)/(63*b));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nconst over=s=>{const w=word(s);return w==='diverged'||w==='finished';};\nfunction est(s,inp,seed){const e=sd(Number(inp.batchSize)),k=s.run*1009+s.step*2+(seed||0)*7.1+3;return [A*s.x+e*gs(k),C*s.z+e*gs(k+1)];}\nfunction advance(s,inp,seed){if(over(s))return s;const g=est(s,inp,seed),r=inp.learningRate,x=s.x-r*g[0],z=s.z-r*g[1];return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,run,on:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return {...fresh(s.run+1,s.step>0?s.path:s.kept),on:true};\nreturn s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,shown){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&v>1e-6?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),r=inputs.learningRate,g=est(s,inputs,seed);\nconst dx=-r*g[0],dz=-r*g[1],x=rim(s.x),z=rim(s.z);\nreturn {nodes:{ball:{position:[x,K*loss(x,z)+R,z]},stepArrow:aim(dx,dz,live),fullArrow:aim(-r*A*s.x,-r*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,arrowLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  }
}