  "program": {
    "source": "const A=2.4,C=0.5,K=0.5,R=0.16,HALF=2,LIM=4.8,MAXS=40,X0=0.4,Z0=1.7,S=1,SCALE=4;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst off=s=>Math.abs(s.x)>HALF||Math.abs(s.z)>HALF||loss(s.x,s.z)>LIM;\nconst over=s=>off(s)||s.step>=MAXS;\nconst word=s=>off(s)?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nfunction grads(s,inp){const b=Math.round(inp.batchSize),sd=S*Math.sqrt(Math.max(0,64-b)/(63*b)),gx=A*s.x,gz=C*s.z,k=s.n*2+3;return [gx,gz,gx+sd*gauss(k),gz+sd*gauss(k+1)];}\nfunction advance(s,inp){if(over(s))return s;const g=grads(s,inp),r=inp.learningRate,x=s.x-r*g[2],z=s.z-r*g[3];return {...s,x,z,step:s.step+1,n:s.n+1,path:s.path.concat([[x,z]]).slice(-41)};}\nconst fresh=(n,kept)=>({x:X0,z:Z0,step:0,n,on:false,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return {...fresh(s.n,s.step>0?s.path:s.kept),on:true};\nreturn s;}\nconst rim=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,shown){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&v*SCALE>0.02?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SCALE,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),g=grads(s,inputs),r=inputs.learningRate;\nconst sx=-r*g[2],sz=-r*g[3],len=live?Math.hypot(sx,sz):0,x=rim(s.x),z=rim(s.z);\nreturn {nodes:{ball:{position:[x,K*loss(x,z)+R,z]},stepArrow:aim(sx,sz,live),fullArrow:aim(-r*g[0],-r*g[1],live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,arrowLen:len,status:word(s)}};}\n"
  },
