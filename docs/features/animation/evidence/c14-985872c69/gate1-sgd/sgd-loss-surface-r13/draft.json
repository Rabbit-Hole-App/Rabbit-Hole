  "program": {
    "source": "const A=2.2,C=0.6,K=0.5,R=0.14,HALF=2,LIM=4.4,MAXS=40,ST=[0.6,1.7],SC=3;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=(n,sd)=>{const s=Math.sin(n*12.9898+sd*78.233+1)*43758.5453;return s-Math.floor(s);};\nconst gauss=(n,sd)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n,sd))))*Math.cos(2*Math.PI*rnd(n+0.5,sd));\nconst sdev=b=>b>=64?0:Math.sqrt((64-b)/(63*b));\nfunction grads(s,inp,seed){const gx=A*s.x,gz=C*s.z,d=sdev(Number(inp.batchSize));return{gx,gz,nx:gx+d*gauss(s.k,seed),nz:gz+d*gauss(s.k+7.3,seed)};}\nconst out=s=>Math.abs(s.x)>HALF||Math.abs(s.z)>HALF||loss(s.x,s.z)>LIM;\nconst over=s=>out(s)||s.step>=MAXS;\nconst word=s=>out(s)?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nfunction adv(s,inp,seed){if(over(s))return s;const g=grads(s,inp,seed),r=inp.learningRate,x=s.x-r*g.nx,z=s.z-r*g.nz;const n={...s,x,z,step:s.step+1,k:s.k+1,path:s.path.concat([[x,z]])};return over(n)?{...n,on:false}:n;}\nconst fresh=(k,kept)=>({x:ST[0],z:ST[1],step:0,k,on:false,path:[],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:adv(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return adv({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.k,s.path.length?s.path:s.kept);\nreturn s;}\nconst rim=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return[x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,show){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;if(!show||v*SC<0.01)return{visible:false};return{visible:true,position:[dx/v*R,0,dz/v*R],quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),g=grads(s,inputs,seed),r=inputs.learningRate;\nreturn{nodes:{ball:{position:[s.x,K*L+R,s.z]},\nstepArrow:aim(-r*g.nx,-r*g.nz,live),\nfullArrow:aim(-r*g.gx,-r*g.gz,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{loss:L,status:word(s),steps:s.step,stepLen:r*Math.hypot(g.nx,g.nz)}};}\n"
  },
