  "assumptions": [
    "Illustration: a made-up two-setting loss bowl with simulated batch noise, not a real model trained on real data.",
    "Loss = (2.4 x^2 + 0.4 z^2)/2, drawn at half its value as a surface with contours. Steep along x: plain steps multiply x by 1 - 2.4 x rate, so swings grow above rate 0.83 (2/2.4).",
    "Each step: estimate = true slope + noise; ball moves by -rate x estimate. Noise is Gaussian with spread sqrt((64-b)/(63 b)) per axis: 1 at batch 1, exactly 0 at 64. A step lowers the loss only on average.",
    "Purple arrow: this step (-rate x noisy slope). Dark arrow: the full-data step (-rate x true slope). Both drawn at 2.5 times true length, one scale; hidden when the run has ended.",
    "A run ends at 40 steps (finished) or when the loss passes 6 (diverged). The ball and path points outside the bowl are drawn at its rim; the Loss readout keeps the true value.",
    "The trail holds the start point plus one point per step (up to 41). Noise comes from a fixed seed: Reset replays the same sequence; a new run uses the next noise values.",
    "The ball steps about 6 times a second at 1x speed (every 5th host tick)."
  ],
  "program": {
    "source": "const A=2.4,C=0.4,K=0.5,R=0.12,H=2,N=40,LIM=6,S0=[0.5,1.8],SC=2.5;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>b>=64?0:Math.sqrt((64-b)/(63*b));\nfunction next(s,inp,seed){const r=inp.learningRate,d=sd(Number(inp.batchSize)),k=s.run*1009+s.step*2+(seed||0)*31+3;return[-r*(A*s.x+d*gauss(k)),-r*(C*s.z+d*gauss(k+500.25))];}\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=N?'finished':'running';\nfunction advance(s,inp,seed){if(word(s)!=='running')return s;const[dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:S0[0],z:S0[1],step:0,run,path:[S0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){if(e.type==='step')return e.tick%5?s:advance(s,inputs,seed);if(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);return s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return[x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,on){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&v>1e-6?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){const s=state||initialState(),L=loss(s.x,s.z),live=word(s)==='running',[dx,dz]=next(s,inputs,seed),r=inputs.learningRate,x=rim(s.x),z=rim(s.z);\nreturn{nodes:{ball:{position:[x,K*loss(x,z)+R,z]},stepArrow:aim(dx,dz,live),fullArrow:aim(-r*A*s.x,-r*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{visible:s.kept.length>1,points:s.kept.map(lift)}},readouts:{loss:L,steps:s.step,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  }
}