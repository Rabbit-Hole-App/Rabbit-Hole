  "program": {
    "source": "const A=2.4,C=0.5,K=0.5,R=0.12,LIM=5,N=40,S=1.2,SC=3,X0=[0.4,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>b>=64?0:S*Math.sqrt((64-b)/(63*b));\nfunction grads(s,inp,seed){const k=2*(s.run*1009+s.step)+(seed||0)*7919,d=sd(Number(inp.batchSize));return [A*s.x+d*gauss(k+1),C*s.z+d*gauss(k+2)];}\nconst over=s=>s.bad||s.step>=N;\nconst word=s=>s.bad?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction advance(s,inp,seed){if(over(s))return s;const g=grads(s,inp,seed),r=inp.learningRate,x=s.x-r*g[0],z=s.z-r*g[1];return {...s,x,z,step:s.step+1,bad:loss(x,z)>LIM,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:X0[0],z:X0[1],step:0,run,on:false,bad:false,path:[X0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\n if(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\n if(e.type!=='action')return s;\n if(e.action==='run')return over(s)?s:{...s,on:true};\n if(e.action==='pause')return {...s,on:false};\n if(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\n if(e.action==='newRun')return {...fresh(s.run+1,s.step>0?s.path:s.kept),on:true};\n return s;\n}\nconst rim=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,shown){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&v>0?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\n const s=state||initialState(),L=loss(s.x,s.z),live=!over(s),r=inputs.learningRate,g=grads(s,inputs,seed);\n const dx=-r*g[0],dz=-r*g[1],gx=K*A*s.x,gz=K*C*s.z;\n const ro={loss:L,steps:s.step,status:word(s)};\n if(live)ro.stepLen=Math.hypot(dx,dz);\n return {nodes:{\n  ball:{position:[s.x,K*L+R*Math.sqrt(1+gx*gx+gz*gz),s.z]},\n  stepArrow:aim(dx,dz,live),\n  fullArrow:aim(-r*A*s.x,-r*C*s.z,live&&inputs.showTrueGradient),\n  trail:{points:s.path.map(lift)},\n  ghost:{points:s.kept.map(lift)}\n },readouts:ro};\n}\n"
  },
