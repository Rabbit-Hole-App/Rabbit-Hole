  "program": {
    "source": "const A=2.2,C=0.6,K=0.5,R=0.15,N=64,SIG=1.5,MAXS=40,LIM=4.4,S=[0.8,1.6],SC=4,H=2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sd=b=>b>=N?0:SIG*Math.sqrt((N-b)/(b*(N-1)));\nfunction next(s,i){const e=sd(Math.round(i.batchSize)),k=s.run*1009+s.step*2+3,r=i.learningRate;return[-r*(A*s.x+e*gauss(k)),-r*(C*s.z+e*gauss(k+501))];}\nconst over=s=>s.div||s.step>=MAXS;\nconst word=s=>s.div?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nfunction adv(s,i){if(over(s))return s;const[dx,dz]=next(s,i),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,div:loss(x,z)>LIM,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:S[0],z:S[1],step:0,run,on:false,div:false,path:[S],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return!s.on||over(s)||e.tick%6?s:adv(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return adv({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return[x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,show){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&v>1e-9?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),r=inputs.learningRate;\nconst ro={steps:s.step,loss:L,status:word(s)};if(live)ro.stepLen=Math.hypot(dx,dz);\nreturn{nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(dx,dz,live),fullArrow:aim(-r*A*s.x,-r*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:ro};}\n"
  },
