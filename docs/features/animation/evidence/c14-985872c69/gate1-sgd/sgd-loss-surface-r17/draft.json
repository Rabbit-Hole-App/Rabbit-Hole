  "program": {
    "source": "const A=2.2,C=0.5,K=0.5,R=0.16,H=2,LIM=5,N=40,S0=[0.8,1.6],SC=5;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n+0.31))))*Math.cos(2*Math.PI*rand(n+0.77));\nconst sd=b=>b>=64?0:Math.sqrt((64-b)/(63*b));\nfunction moves(s,inp){const lr=inp.learningRate,d=sd(Number(inp.batchSize)),gx=A*s.x,gz=C*s.z;return{full:[-lr*gx,-lr*gz],mb:[-lr*(gx+d*gauss(2*s.n)),-lr*(gz+d*gauss(2*s.n+1))]};}\nconst word=s=>s.div?'diverged':s.step>=N?'finished':'running';\nconst over=s=>s.div||s.step>=N;\nfunction advance(s,inp){if(over(s))return s;const m=moves(s,inp).mb,x=s.x+m[0],z=s.z+m[1];return{...s,x,z,n:s.n+1,step:s.step+1,div:loss(x,z)>LIM||Math.abs(x)>H||Math.abs(z)>H,path:s.path.concat([[x,z]])};}\nconst fresh=(n,kept)=>({x:S0[0],z:S0[1],step:0,n,div:false,path:[S0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\n if(e.type==='step')return e.tick%6?s:advance(s,inputs);\n if(e.type!=='action')return s;\n if(e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept);\n if(e.action==='stepOnce')return advance(s,inputs);\n return s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return[x,K*loss(x,z)+0.05,z];};\nfunction aim(d,show){const v=Math.hypot(d[0],d[1]),h=Math.SQRT1_2;if(!show||v<1e-6)return{visible:false};return{visible:true,quaternion:[d[1]/v*h,0,-d[0]/v*h,h],scale:[1,v*SC,1]};}\nexport function evaluate({inputs,state}){\n const s=state||initialState(),L=loss(s.x,s.z),live=!over(s),m=moves(s,inputs);\n const r={steps:s.step,loss:L,status:word(s)};\n if(live)r.stepLen=Math.hypot(m.mb[0],m.mb[1]);\n return{nodes:{ball:{position:[rim(s.x),K*L+R,rim(s.z)]},stepArrow:aim(m.mb,live),fullArrow:aim(m.full,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
