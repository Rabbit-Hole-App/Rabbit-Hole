  "program": {
    "source": "const A=2.4,C=0.6,K=0.5,R=0.13,HALF=2,MAXS=40,LIMIT=5,START=[0.7,1.7],SCALE=2.5,N=1.5;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst sdOf=b=>N*Math.sqrt(Math.max(0,64-b)/(63*b));\nconst off=s=>loss(s.x,s.z)>LIMIT||Math.abs(s.x)>HALF||Math.abs(s.z)>HALF;\nconst word=s=>off(s)?'diverged':s.step>=MAXS?'finished':s.step===0?'ready':'running';\nconst done=s=>off(s)||s.step>=MAXS;\nfunction steps(s,inputs,seed){const r=inputs.learningRate,sd=sdOf(Number(inputs.batchSize)),k=(seed||0)*7919+s.run*1009+s.step*2+1;const gx=A*s.x,gz=C*s.z;return{b:[-r*(gx+sd*gauss(k)),-r*(gz+sd*gauss(k+1))],f:[-r*gx,-r*gz]};}\nfunction advance(s,inputs,seed){if(done(s))return s;const{b}=steps(s,inputs,seed),x=s.x+b[0],z=s.z+b[1];return{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:START[0],z:START[1],step:0,run,path:[START],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){if(e.type==='step')return e.tick%4?s:advance(s,inputs,seed);if(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);return s;}\nconst rim=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return[x,K*loss(x,z)+0.05,z];};\nfunction aim(d,shown){const v=Math.hypot(d[0],d[1]),h=Math.SQRT1_2;if(!shown||v<1e-9)return{visible:false};const ux=d[0]/v,uz=d[1]/v;return{visible:true,position:[ux*R,0,uz*R],quaternion:[uz*h,0,-ux*h,h],scale:[1,v*SCALE,1]};}\nexport function evaluate({inputs,state,seed}){const s=state||initialState(),L=loss(s.x,s.z),bad=off(s),{b,f}=steps(s,inputs,seed);const sx=K*A*s.x,sz=K*C*s.z;const ro={loss:L,steps:s.step,status:word(s)};if(!bad)ro.stepLen=Math.hypot(b[0],b[1]);return{nodes:{ball:{position:[s.x,K*L+R*Math.sqrt(1+sx*sx+sz*sz),s.z]},stepArrow:aim(b,!bad),fullArrow:aim(f,!bad&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:ro};}\n"
  },
