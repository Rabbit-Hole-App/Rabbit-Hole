  "program": {
    "source": "const A=2.5,C=0.5,K=0.4,R=0.15,N=64,MAXS=40,LIM=5,S=1,SC=3,X0=0.5,Z0=1.7,H=2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gau=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sd=b=>b>=N?0:S*Math.sqrt((N-b)/(b*(N-1)));\nfunction steps(s,inp,seed){const lr=inp.learningRate,gx=A*s.x,gz=C*s.z,d=sd(Number(inp.batchSize)),k=(seed||0)*7919+s.run*1009+s.step*2+1;return{full:[-lr*gx,-lr*gz],mini:[-lr*(gx+d*gau(k)),-lr*(gz+d*gau(k+0.5))]};}\nconst over=s=>s.div||s.step>=MAXS;\nconst word=s=>s.div?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nfunction advance(s,inp,seed){if(over(s))return s;const[dx,dz]=steps(s,inp,seed).mini,x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,div:loss(x,z)>LIM,last:Math.hypot(dx,dz),path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:X0,z:Z0,step:0,run,on:false,div:false,last:0,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return[x,K*loss(x,z)+0.04,z];};\nfunction aim(d,shown){const v=Math.hypot(d[0],d[1]),h=Math.SQRT1_2;return shown&&v>1e-6?{visible:true,quaternion:[d[1]/v*h,0,-d[0]/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),st=steps(s,inputs,seed);\nreturn{nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(st.mini,live),fullArrow:aim(st.full,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(st.mini[0],st.mini[1]):s.last,status:word(s)}};}\n"
  },
