  "program": {
    "source": "const A=2.5,C=0.5,K=0.4,R=0.15,N=64,S=1.5,LIM=5,MAXS=40,ST=[0.6,1.7],SC=3,H=2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gs=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sd=b=>S*Math.sqrt(Math.max(0,(N-b)/((N-1)*b)));\nfunction nxt(s,inp,seed){const b=Math.round(inp.batchSize),k=seed*7919+s.run*1009+s.step*2+3,e=sd(b),r=inp.learningRate;return [-r*(A*s.x+e*gs(k)),-r*(C*s.z+e*gs(k+1))];}\nconst over=s=>s.div||s.step>=MAXS;\nconst word=s=>s.div?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nfunction adv(s,inp,seed){if(over(s))return s;const [dx,dz]=nxt(s,inp,seed),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,div:!(loss(x,z)<=LIM),path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,run,on:false,div:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\n if(e.type==='step')return !s.on||over(s)||e.tick%6?s:adv(s,inputs,seed||0);\n if(e.type!=='action')return s;\n if(e.action==='run')return over(s)?s:{...s,on:true};\n if(e.action==='pause')return {...s,on:false};\n if(e.action==='stepOnce')return adv({...s,on:false},inputs,seed||0);\n if(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\n return s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,show){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&v>1e-9?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\n const s=state||initialState(),live=!over(s),[dx,dz]=nxt(s,inputs,seed||0),r=inputs.learningRate;\n const bx=rim(s.x),bz=rim(s.z),ro={steps:s.step,loss:loss(s.x,s.z),status:word(s)};\n if(live)ro.stepLen=Math.hypot(dx,dz);\n return {nodes:{ball:{position:[bx,K*loss(bx,bz)+R,bz]},stepArrow:aim(dx,dz,live),fullArrow:aim(-r*A*s.x,-r*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:ro};}\n"
  },
