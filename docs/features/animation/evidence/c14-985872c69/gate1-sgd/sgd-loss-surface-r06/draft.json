      "id": "status",
      "label": "Status",
      "kind": "text"
    }
  ],
  "program": {
    "source": "const A=2.4,C=0.4,K=0.5,R=0.12,H=2,N=64,LIM=5,MAXS=40,SC=3,X0=0.5,Z0=1.7;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>b>=N?0:Math.sqrt((N-b)/((N-1)*b));\nfunction next(s,inp,seed){const lr=inp.learningRate,d=sd(Number(inp.batchSize)),k=s.run*997+s.n*2+seed*31.7;return [-lr*(A*s.x+d*gauss(k)),-lr*(C*s.z+d*gauss(k+1))];}\nconst word=s=>s.div?'diverged':s.n>=MAXS?'finished':'running';\nconst done=s=>s.div||s.n>=MAXS;\nfunction advance(s,inp,seed){if(done(s))return s;const [dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;return {...s,x,z,n:s.n+1,div:loss(x,z)>LIM,path:s.path.concat([[x,z]]).slice(-MAXS)};}\nconst fresh=(run,kept)=>({x:X0,z:Z0,n:0,run,div:false,path:[],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='stepOnce')return advance(s,inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.n>0?s.path:s.kept);\nreturn s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,on){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&v>1e-9?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),live=!done(s),[dx,dz]=next(s,inputs,seed||0),lr=inputs.learningRate,bx=rim(s.x),bz=rim(s.z);\nreturn {nodes:{ball:{position:[bx,K*loss(bx,bz)+R,bz]},stepArrow:aim(dx,dz,live),fullArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.n,loss:loss(s.x,s.z),stepLength:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
