  "program": {
    "source": "const A=2.4,C=0.5,K=0.5,R=0.16,H=2,LIM=5,N=40,S0=[0.6,1.7],SIG=0.6,SC=0.5;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>SIG*Math.sqrt(Math.max(0,64-b)/(63*b));\nfunction grad(s,inputs){const d=sd(Number(inputs.batchSize)),k=s.run*1009+s.step*2+3;return [A*s.x+d*gauss(k),C*s.z+d*gauss(k+1)];}\nconst bad=s=>loss(s.x,s.z)>LIM||Math.abs(s.x)>H||Math.abs(s.z)>H;\nconst over=s=>bad(s)||s.step>=N;\nconst word=s=>bad(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction advance(s,inputs){if(over(s))return s;const g=grad(s,inputs),r=inputs.learningRate,x=s.x-r*g[0],z=s.z-r*g[1];return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept,on)=>({x:S0[0],z:S0[1],step:0,run,on,path:[S0],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,shown){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&v>1e-9?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),g=grad(s,inputs),x=rim(s.x),z=rim(s.z);\nreturn {nodes:{ball:{position:[x,K*loss(x,z)+R,z]},stepArrow:aim(-g[0],-g[1],live),fullArrow:aim(-A*s.x,-C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,slope:Math.hypot(g[0],g[1]),status:word(s)}};}\n"
  },
