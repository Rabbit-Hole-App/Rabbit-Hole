  "assumptions": [
    "Simplified simulation: no air resistance, the ball starts at ground level on flat ground.",
    "Gravity is 9.8 m/s² straight down; horizontal speed stays constant and only vertical speed changes.",
    "Each frame is computed exactly from the projectile formulas, so landing distance = speed² × sin(2 × angle) ÷ 9.8. The ball is a point drawn with its bottom on the path; flight ends when it returns to ground height.",
    "A hit is a landing within 1.5 m of the target centre, both edges counted (the red disk shows this zone). Targets come in a fixed order: 30 m, 45 m, 18 m.",
    "Reset starts the same challenge again and clears score and both arcs. Every flight is shown over about two seconds, so screen time does not match the flight-time readout.",
    "Real balls are slowed by air and land shorter, especially fast shots. The longest shot is about 64 m (25 m/s at 45°)."
  ],
  "program": {
    "source": "const G=9.8,TG=[30,45,18],N=40,R=1.5;\nconst rad=d=>d*Math.PI/180;\nfunction pos(s,u){const a=rad(s.a),T=2*s.v*Math.sin(a)/G,t=u*T;return [s.v*Math.cos(a)*t,s.v*Math.sin(a)*t-G*t*t/2];}\nfunction path(s,u){const p=[],n=Math.max(1,Math.ceil(u*N));for(let k=0;k<=n;k++){const q=pos(s,k/n*u);p.push([q[0],Math.max(0,q[1])+R,0]);}return p;}\nconst over=s=>s.hits>=3||s.n>=10;\nexport function initialState(){return {shot:null,prev:null,u:0,fly:false,n:0,hits:0,ti:0,res:null};}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='action'&&e.action==='launch'){if(s.fly||over(s))return s;return {...s,prev:s.shot,shot:{a:inputs.angle,v:inputs.speed},u:0,fly:true};}\nif(e.type==='step'&&s.fly){const u=s.u+1/60;if(u<1)return {...s,u};\nconst a=rad(s.shot.a),v=s.shot.v,D=v*v*Math.sin(2*a)/G,tg=TG[s.ti],m=D-tg,hit=Math.abs(m)<=1.5+1e-9;\nconst hits=s.hits+(hit?1:0),ti=hit&&hits<3?s.ti+1:s.ti;\nreturn {...s,u:1,fly:false,n:s.n+1,hits,ti,res:{D,m,hit,tg,T:2*v*Math.sin(a)/G,H:v*v*Math.sin(a)**2/(2*G)}};}\nreturn s;}\nexport function evaluate({inputs,state:s}){\nconst th=-(Math.PI/2-rad(inputs.angle));\nconst b=s.shot?pos(s.shot,s.u):[0,0];\nconst nodes={gun:{quaternion:[0,0,Math.sin(th/2),Math.cos(th/2)]},ballN:{position:[b[0],Math.max(0,b[1])+R,0]},target:{position:[TG[s.ti],0,0]},tLabel:{text:'Target '+TG[s.ti]+' m'},trail:{visible:!!s.shot,points:s.shot?path(s.shot,s.u):[]},ghostN:{visible:!!s.prev,points:s.prev?path(s.prev,1):[]}};\nconst ro={used:s.n,hitsR:s.hits};const r=s.res;\nif(r){ro.dist=r.D;ro.miss=Math.abs(r.m);ro.side=r.hit?'hit':(r.m<0?'short':'long');ro.ftime=r.T;ro.peak=r.H;}\nlet st='playing',msg;\nif(s.hits>=3){st='won';msg='You hit all 3 targets in '+s.n+' launches!';}\nelse if(s.n>=10&&!s.fly){st='lost';msg='Out of launches: '+s.hits+' of 3 targets hit.';}\nelse if(s.fly)msg='Ball in flight...';\nelse if(r){msg=(r.hit?'Hit! ':(r.m<0?'Short':'Long')+' by '+Math.abs(r.m).toFixed(1)+' m. ')+'Next target: '+TG[s.ti]+' m. Launches left: '+(10-s.n)+'.';}\nelse msg='Target at '+TG[s.ti]+' m. Set angle and speed, then Launch.';\nreturn {nodes,readouts:ro,goal:{status:st,message:msg}};}"
  }
}