    {
      "type": "number",
      "id": "angle",
      "label": "Launch angle",
      "unit": "°",
      "min": 10,
      "max": 80,
      "step": 1,
      "default": 45
    },
    {
      "type": "number",
      "id": "speed",
      "label": "Launch speed",
      "unit": "m/s",
      "min": 5,
      "max": 25,
      "step": 0.5,
