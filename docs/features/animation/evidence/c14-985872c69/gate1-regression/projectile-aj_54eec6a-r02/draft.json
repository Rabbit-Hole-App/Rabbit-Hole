  "program": {
    "source": "const G=9.8,TG=[30,45,18],N=60;\nconst rad=d=>d*Math.PI/180;\nconst ft=(a,v)=>2*v*Math.sin(rad(a))/G;\nfunction p(a,v,t){const r=rad(a);return [v*Math.cos(r)*t,Math.max(0,v*Math.sin(r)*t-0.5*G*t*t)+1,0];}\nfunction arc(a,v,n,upto){const T=ft(a,v),o=[];for(let i=0;i<=upto;i++)o.push(p(a,v,T*i/n));return o;}\nexport function initialState(){return {fly:false,k:0,a:45,v:15,shots:0,hits:0,ti:0,last:null,prev:null};}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='action'&&e.action==='launch'){if(s.fly||s.hits>=3||s.shots>=10)return s;return {...s,fly:true,k:0,a:inputs.angle,v:inputs.speed,prev:s.last?{a:s.last.a,v:s.last.v}:null};}\nif(e.type==='step'&&s.fly){const k=s.k+1;if(k<N)return {...s,k};\nconst a=s.a,v=s.v,R=v*v*Math.sin(2*rad(a))/G,tg=TG[s.ti],miss=R-tg,hit=Math.abs(miss)<=1.5,r=rad(a);\nconst last={a,v,R,miss,hit,T:ft(a,v),H:Math.pow(v*Math.sin(r),2)/(2*G)};\nreturn {...s,fly:false,k:N,last,shots:s.shots+1,hits:s.hits+(hit?1:0),ti:hit?Math.min(s.ti+1,2):s.ti};}\nreturn s;}\nexport function evaluate({inputs,state:s}){\nconst th=rad(inputs.angle-90),nodes={pivot:{quaternion:[0,0,Math.sin(th/2),Math.cos(th/2)]}};\nlet bp=[0,1,0];\nif(s.fly){const T=ft(s.a,s.v);bp=p(s.a,s.v,T*s.k/N);const pts=arc(s.a,s.v,30,Math.floor(s.k/2));pts.push(bp);nodes.trail={points:pts,visible:true};\nif(s.prev)nodes.ghost={visible:true,points:arc(s.prev.a,s.prev.v,30,30)};else nodes.ghost={visible:false};}\nelse{nodes.ghost={visible:false};if(s.last){bp=[s.last.R,1,0];nodes.trail={visible:true,points:arc(s.last.a,s.last.v,30,30)};}else nodes.trail={visible:false,points:[]};}\nnodes.ball={position:bp};\nconst won=s.hits>=3,lost=!won&&!s.fly&&s.shots>=10;\nnodes.target={position:[TG[s.ti],0,0],visible:!won};\nconst ro={shots:s.shots,hits:s.hits};\nif(s.last){const L=s.last;ro.dist=L.R;ro.miss=Math.abs(L.miss);ro.side=L.hit?'hit':(L.miss<0?'short':'long');ro.ftime=L.T;ro.hmax=L.H;}\nconst left=10-s.shots;\nlet msg=won?'You hit all 3 targets in '+s.shots+' launches!':lost?'Out of launches: '+s.hits+' of 3 targets hit.':(s.last?(s.last.hit?'Hit! ':'Missed '+(s.last.miss<0?'short':'long')+' by '+Math.abs(s.last.miss).toFixed(1)+' m. '):'')+'Target at '+TG[s.ti]+' m. Launches left: '+left+'.';\nreturn {nodes,readouts:ro,goal:{status:won?'won':lost?'lost':'playing',message:msg}};}\n"
  }
