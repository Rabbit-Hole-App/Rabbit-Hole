  "assumptions": [
    "This is a simplified simulation: no air resistance, and the ball starts at ground level on flat ground.",
    "Gravity is 9.8 m/s² straight down. The ball keeps the same sideways speed and only its vertical speed changes.",
    "Each position is computed exactly from the projectile formulas, so the landing distance equals speed² × sin(2 × angle) ÷ 9.8 (at most about 63.8 m at 25 m/s and 45°).",
    "The ball is treated as a point and the flight ends when it returns to ground height. It is drawn resting on the ground, one radius above that point.",
    "A hit is a landing within 1.5 m of the target centre, both edges counted; the red pad shows exactly that zone. Reset starts the same challenge again and clears the score and the arcs.",
    "Every flight is shown over 2 seconds, so the screen time does not match the flight-time readout. Real balls slowed by air land shorter."
  ],
  "program": {
    "source": "const G=9.8,TG=[30,45,18],D=Math.PI/180,B=1.1;\nfunction arc(s,u){const a=s.a*D,T=2*s.v*Math.sin(a)/G,t=u*T;return [s.v*Math.cos(a)*t,B+Math.max(0,s.v*Math.sin(a)*t-G*t*t/2),0];}\nfunction pts(s,u){const p=[];for(let i=0;i<=40;i++)p.push(arc(s,u*i/40));return p;}\nexport function initialState(){return {ti:0,hits:0,shots:0,cur:null,prev:null,tau:0,fly:false,last:null};}\nexport function reduce({state,event,inputs}){const s=state;\nif(event.type==='action'&&event.action==='launch'){if(s.fly||s.hits>=3||s.shots>=10)return s;return {...s,prev:s.cur,cur:{v:inputs.speed,a:inputs.angle},shots:s.shots+1,fly:true,tau:0};}\nif(event.type==='step'&&s.fly){const tau=Math.min(1,s.tau+1/60);if(tau<1)return {...s,tau};\nconst a=s.cur.a*D,v=s.cur.v,d=v*v*Math.sin(2*a)/G,T=2*v*Math.sin(a)/G,h=Math.pow(v*Math.sin(a),2)/(2*G),tg=TG[s.ti],m=d-tg,hit=Math.abs(m)<=1.5+1e-9;\nconst hits=s.hits+(hit?1:0);return {...s,tau:1,fly:false,hits,ti:hit&&hits<3?s.ti+1:s.ti,last:{d,T,h,m,tg,hit}};}\nreturn s;}\nexport function evaluate({inputs,state}){const s=state,th=(inputs.angle-90)*D/2;\nconst n={pivot:{quaternion:[0,0,Math.sin(th),Math.cos(th)]},target:{position:[TG[s.ti],0,0]}};\nn.ball={position:s.cur?arc(s.cur,s.fly?s.tau:1):[0,B,0]};\nn.trail=s.cur?{visible:true,points:pts(s.cur,s.fly?s.tau:1)}:{visible:false};\nn.ghost=s.prev?{visible:true,points:pts(s.prev,1)}:{visible:false};\nconst r={shots:s.shots,hits:s.hits},L=s.last;\nif(L){r.dist=L.d;r.miss=Math.abs(L.m);r.side=L.hit?'Hit':L.m<0?'Short':'Long';r.tof=L.T;r.hmax=L.h;}\nlet st='playing',msg;const left=10-s.shots;\nif(s.hits>=3){st='won';msg='All 3 targets hit in '+s.shots+' launches!';}\nelse if(s.shots>=10&&!s.fly){st='lost';msg='Out of launches: '+s.hits+' of 3 targets hit.';}\nelse if(s.fly)msg='In flight...';\nelse{const pre=L?(L.hit?'Hit! ':(L.m<0?'Short':'Long')+' by '+Math.abs(L.m).toFixed(1)+' m. '):'';msg=pre+'Target at '+TG[s.ti]+' m. Launches left: '+left+'.';}\nreturn {nodes:n,readouts:r,goal:{status:st,message:msg}};}"
  }
}