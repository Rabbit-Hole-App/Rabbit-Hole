  "assumptions": [
    "Simplified simulation: no air resistance, flat ground, and the ball starts at ground level.",
    "Gravity is 9.8 m/s² straight down; sideways speed stays constant. Landing distance = speed² × sin(2 × angle) ÷ 9.8, so the longest shot is about 63.8 m (25 m/s at 45°).",
    "The ball is a point for the physics; it is drawn 1.4 m in radius, raised so it rests on the ground. The flight ends when it returns to ground height.",
    "A hit is a landing within 1.5 m of the target centre, both edges counted. Targets come in fixed order 30 m, 45 m, 18 m; Reset clears score and trails.",
    "Every flight is shown over 2 seconds of steps whatever its real duration, so the on-screen time differs from the flight-time readout. Real balls with air drag land shorter."
  ],
  "program": {
    "source": "const G=9.8,N=60,BR=1.4,T=[30,45,18];\nfunction sh(a,v){const r=a*Math.PI/180,vx=v*Math.cos(r),vy=v*Math.sin(r),tf=2*vy/G;return{vx,vy,tf,R:vx*tf,H:vy*vy/(2*G)}}\nfunction pts(a,v,k){const s=sh(a,v),p=[];for(let i=0;i<=k;i++){const t=s.tf*i/N;p.push([s.vx*t,Math.max(0,s.vy*t-G*t*t/2)+BR,0])}return p}\nfunction over(s){return s.hits>=3||s.shots>=10}\nexport function initialState(){return{fly:false,k:0,sa:45,sv:15,has:false,ghost:false,ga:45,gv:15,shots:0,hits:0,res:null}}\nexport function reduce({state:s,event:e,inputs}){\nif(over(s))return s;\nif(e.type==='action'&&e.action==='launch'&&!s.fly)return{...s,fly:true,k:0,sa:inputs.angle,sv:inputs.speed,ghost:s.has,ga:s.sa,gv:s.sv};\nif(e.type==='step'&&s.fly){const k=s.k+1;if(k<N)return{...s,k};\nconst o=sh(s.sa,s.sv),tg=T[s.hits],m=o.R-tg,hit=Math.abs(m)<=1.5;\nreturn{...s,fly:false,k:N,has:true,shots:s.shots+1,hits:s.hits+(hit?1:0),res:{R:o.R,m,hit,tf:o.tf,H:o.H}}}\nreturn s}\nexport function evaluate({inputs,state:s}){\nconst a=(90-inputs.angle)*Math.PI/180,nodes={};\nnodes.pivot={quaternion:[0,0,-Math.sin(a/2),Math.cos(a/2)]};\nconst won=s.hits>=3,tx=T[Math.min(s.hits,2)];\nnodes.targetG={position:[tx,0,0],visible:!won};\nlet bp=[0,BR,0];\nif(s.fly||s.has){const p=pts(s.sa,s.sv,s.fly?s.k:N);bp=p[p.length-1];nodes.trail={points:p,visible:true}}else nodes.trail={points:[],visible:false};\nnodes.ball={position:bp};\nnodes.ghost=s.ghost?{visible:true,points:pts(s.ga,s.gv,N)}:{visible:false,points:[]};\nconst ro={shots:s.shots,hits:s.hits};\nif(s.res){const r=s.res;ro.dist=r.R;ro.miss=Math.abs(r.m);ro.side=r.hit?'hit':(r.m<0?'short':'long');ro.tflight=r.tf;ro.hmax=r.H}\nlet goal;\nif(won)goal={status:'won',message:'All 3 targets hit in '+s.shots+' launches!'};\nelse if(s.shots>=10)goal={status:'lost',message:'Out of launches: '+s.hits+' of 3 targets hit.'};\nelse{let pre='';if(s.res&&!s.fly)pre=s.res.hit?'Hit! ':(s.res.m<0?'Short by ':'Long by ')+Math.abs(s.res.m).toFixed(1)+' m. ';goal={status:'playing',message:pre+'Target at '+tx+' m, '+(10-s.shots)+' launches left.'}}\nreturn{nodes,readouts:ro,goal}}"
  }
}