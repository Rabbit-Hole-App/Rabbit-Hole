  "program": {
    "source": "const A=2.5,C=1,K=0.5,R=0.14,LIM=7,N=40,S0=3,ST=[1.2,1.6],W=2.1;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst sd=B=>S0*Math.sqrt(Math.max(0,64-B)/(63*B));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nconst over=s=>{const w=word(s);return w==='diverged'||w==='finished';};\nfunction next(s,inp,noisy){\n const lr=inp.learningRate,B=Number(inp.batchSize),k=s.run*997+s.step*2+1,d=noisy?sd(B):0;\n return [-lr*(A*s.x+d*gauss(k)),-lr*(C*s.z+d*gauss(k+0.5))];\n}\nfunction advance(s,inp){\n if(over(s))return s;\n const [dx,dz]=next(s,inp,true),x=s.x+dx,z=s.z+dz;\n const n={...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};\n return over(n)?{...n,on:false}:n;\n}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,run,on:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\n if(e.type==='step')return !s.on||e.tick%6?s:advance(s,inputs);\n if(e.type!=='action')return s;\n if(e.action==='run')return over(s)?s:{...s,on:true};\n if(e.action==='pause')return {...s,on:false};\n if(e.action==='stepOnce')return advance({...s,on:false},inputs);\n if(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\n return s;\n}\nconst cl=v=>Math.max(-W,Math.min(W,v));\nconst lift=p=>[cl(p[0]),Math.min(K*loss(p[0],p[1]),3.5)+0.05,cl(p[1])];\nfunction aim(dx,dz,on){\n const l=Math.hypot(dx,dz),h=Math.SQRT1_2;\n return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};\n}\nexport function evaluate({inputs,state}){\n const s=state||initialState(),L=loss(s.x,s.z),live=!over(s);\n const [dx,dz]=next(s,inputs,true),[tx,tz]=next(s,inputs,false);\n const len=live?Math.hypot(dx,dz):0;\n return {\n  nodes:{\n   ball:{position:[cl(s.x),Math.min(K*L,3.5)+R,cl(s.z)]},\n   stepArrow:aim(dx,dz,live),\n   trueArrow:aim(tx,tz,live&&inputs.showTrueGradient),\n   trail:{points:s.path.map(lift)},\n   ghost:{points:s.kept.map(lift)}\n  },\n  readouts:{loss:L,status:word(s),steps:s.step,stepLen:len}\n };\n}\n"
  },
