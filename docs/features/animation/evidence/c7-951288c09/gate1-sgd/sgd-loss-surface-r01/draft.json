  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.16,S0=1.5,N=64,MAXS=40,LIM=6,SC=3,X0=0.6,Z0=1.6;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sdOf=b=>b>=N?0:S0*Math.sqrt((N-b)/((N-1)*b));\nconst word=s=>s.div?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nconst over=s=>s.div||s.step>=MAXS;\nfunction next(s,inp){const sd=sdOf(Math.round(inp.batchSize)),k=(s.run*97+s.step+1)*2,lr=inp.learningRate;\nreturn[-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+1))];}\nfunction advance(s,inp){if(over(s))return s;const[dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;\nreturn{...s,x,z,step:s.step+1,div:loss(x,z)>LIM,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:X0,z:Z0,step:0,run,on:false,div:false,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return!s.on||over(s)||e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return[x,Math.min(K*loss(x,z),4)+0.05,z];};\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;\nreturn show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,SC*l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){const s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\nconst r={loss:L,steps:s.step,status:word(s)};if(live)r.stepLen=Math.hypot(dx,dz);\nreturn{nodes:{ball:{position:[cl(s.x),K*L+R,cl(s.z)]},stepArrow:aim(dx,dz,live),\ntrueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
