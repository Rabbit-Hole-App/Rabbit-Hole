  "program": {
    "source": "const A=3,C=1,K=0.4,R=0.12,H=2,TOP=3.2,LIM=6,N=40,X0=1,Z0=1.7,SIG=1.5;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nfunction word(s){const L=loss(s.x,s.z);if(!(L<=LIM)||Math.abs(s.x)>H||Math.abs(s.z)>H)return 'diverged';if(s.step>=N)return 'finished';return s.on?'running':s.step?'paused':'ready';}\nconst over=s=>{const w=word(s);return w==='diverged'||w==='finished';};\nfunction next(s,inp){const b=Number(inp.batchSize),sd=SIG*Math.sqrt(Math.max(0,64-b)/(63*b)),k=s.run*997+s.step*3+1,lr=inp.learningRate;\nreturn [-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+1.5))];}\nfunction advance(s,inp){if(over(s))return s;const d=next(s,inp),x=s.x+d[0],z=s.z+d[1];return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept,on)=>({x:X0,z:Z0,step:0,run,on,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),TOP)+0.05,p[1]];\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),d=next(s,inputs),lr=inputs.learningRate;\nreturn {nodes:{\nball:{position:[s.x,K*L+R,s.z]},\nstepArrow:aim(d[0],d[1],live),\ntrueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},\nghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(d[0],d[1]):0,status:word(s)}};}\n"
  },
