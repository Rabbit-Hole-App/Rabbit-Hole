  "program": {
    "source": "const A=2.4,C=1,K=0.5,R=0.13,H=2,N=40,S0=2,ST=[1.2,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*91.345+17.17)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(6.2832*rnd(n+0.37));\nconst sd=b=>b>=64?0:S0*Math.sqrt((64-b)/(63*b));\nconst out=s=>Math.abs(s.x)>H||Math.abs(s.z)>H;\nconst word=s=>out(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nconst over=s=>out(s)||s.step>=N;\nfunction next(s,inp){const q=sd(Math.round(inp.batchSize)),k=s.run*1009+s.step*2+1,r=inp.learningRate;return [-r*(A*s.x+q*gauss(k)),-r*(C*s.z+q*gauss(k+0.5))];}\nfunction adv(s,inp){if(over(s))return s;const [dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,run,on:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:adv(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return adv({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-2.1,Math.min(2.1,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return [x,Math.min(K*loss(x,z),3.6)+0.05,z];};\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),r=inputs.learningRate;\nconst x=cl(s.x),z=cl(s.z);\nreturn {nodes:{ball:{position:[x,K*loss(x,z)+R,z]},stepArrow:aim(dx,dz,live),trueArrow:aim(-r*A*s.x,-r*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
