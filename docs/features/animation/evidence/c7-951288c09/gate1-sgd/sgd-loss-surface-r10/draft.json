  "program": {
    "source": "const A=2.4,C=0.5,K=0.5,R=0.12,H=2,LIM=4.8,N=40,X0=1.2,Z0=1.6,SIG=1.5,SC=2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sdOf=b=>SIG*Math.sqrt(Math.max(0,64-b)/(63*b));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=N?'finished':'running';\nconst done=s=>word(s)!=='running';\nfunction next(s,inp,seed){const sd=sdOf(Number(inp.batchSize)),k=(seed||0)*7919+s.run*1009+s.step*2+1,lr=inp.learningRate;return [-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+0.37))];}\nfunction advance(s,inp,seed){if(done(s))return s;const [dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:X0,z:Z0,step:0,run,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\n if(e.type==='step')return e.tick%3?s:advance(s,inputs,seed);\n if(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\n return s;}\nconst cl=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return [x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,SC*l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\n const s=state||initialState(),L=loss(s.x,s.z),live=!done(s),[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate;\n const bx=cl(s.x),bz=cl(s.z);\n return {nodes:{\n  ball:{position:[bx,K*loss(bx,bz)+R,bz]},\n  stepArrow:aim(dx,dz,live),\n  trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&!!inputs.showTrueGradient),\n  trail:{points:s.path.map(lift)},\n  ghost:{points:s.kept.map(lift)}},\n  readouts:{steps:s.step,loss:L,stepLength:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
