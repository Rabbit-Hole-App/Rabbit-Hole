  "program": {
    "source": "const A=2.5,C=1,K=0.4,R=0.16,H=2,TOP=2.8,LIM=8,MX=40,S=2,N=64,S0=1.5,ST=[1.2,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>b>=N?0:S0*Math.sqrt((N-b)/((N-1)*b));\nconst off=(x,z)=>Math.abs(x)>H||Math.abs(z)>H||loss(x,z)>LIM;\nconst over=s=>s.div||s.step>=MX;\nconst word=s=>s.div?'diverged':s.step>=MX?'finished':s.on?'running':'paused';\nfunction next(s,inp,seed){const d=sd(Number(inp.batchSize)),k=(seed||0)+s.run*1009+s.step*2+1,lr=inp.learningRate;\nreturn[-lr*(A*s.x+d*gauss(k)),-lr*(C*s.z+d*gauss(k+0.25))];}\nfunction adv(s,inp,seed){if(over(s))return s;const[dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;\nreturn{...s,x,z,step:s.step+1,div:off(x,z),on:s.on&&!off(x,z)&&s.step+1<MX,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,run,on:false,div:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return!s.on||over(s)||e.tick%6?s:adv(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return adv({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),TOP)+0.05,p[1]];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz)*S,h=Math.SQRT1_2;\nreturn on&&l>1e-6?{visible:true,quaternion:[dz*S/l*h,0,-dx*S/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate;\nreturn{nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(dx,dz,live),\nslopeArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{loss:L,steps:s.step,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
