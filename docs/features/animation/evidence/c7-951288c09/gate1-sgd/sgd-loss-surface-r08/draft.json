  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.13,MAXS=40,LIM=8,SIG=2,S=2,START=[1.2,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const v=Math.sin(n*91.345+47.853)*24634.6345;return v-Math.floor(v);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sd=b=>b>=64?0:SIG*Math.sqrt((64-b)/(63*b));\nfunction next(s,inp){const n=sd(Number(inp.batchSize)),k=s.run*997+s.step*3+1,lr=inp.learningRate;\nreturn [-lr*(A*s.x+n*gauss(k)),-lr*(C*s.z+n*gauss(k+1.5))];}\nconst done=s=>s.div||s.step>=MAXS;\nconst word=s=>s.div?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nfunction advance(s,inp){if(done(s))return s;const [dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;\nreturn {...s,x,z,step:s.step+1,div:loss(x,z)>LIM,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:START[0],z:START[1],step:0,run,on:false,div:false,path:[START],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return !s.on||done(s)||e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return done(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return {...fresh(s.run+1,s.step>0?s.path:s.kept),on:true};\nreturn s;}\nconst cl=v=>Math.max(-2,Math.min(2,v));\nconst disp=p=>{const x=cl(p[0]),z=cl(p[1]);return [x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;\nreturn show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,S*l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){const s=state||initialState(),live=!done(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\nconst x=cl(s.x),z=cl(s.z),r={loss:loss(s.x,s.z),status:word(s),steps:s.step};\nif(live)r.stepLen=Math.hypot(dx,dz);\nreturn {nodes:{ball:{position:[x,K*loss(x,z)+R,z]},stepArrow:aim(dx,dz,live),\ntrueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(disp)},ghost:{points:s.kept.map(disp)}},readouts:r};}\n"
  },
