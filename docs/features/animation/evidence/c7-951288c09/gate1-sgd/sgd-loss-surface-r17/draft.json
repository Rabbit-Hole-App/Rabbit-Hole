  "assumptions": [
    "Illustration: a made-up two-setting loss bowl with simulated batch noise, not a real model trained on real data.",
    "Loss = (2.5 x^2 + z^2) / 2, drawn at 0.5 x loss. Without noise, x overshoots for learning rate above 0.4 and diverges above 0.8; z never overshoots in this range.",
    "Step = -learning rate x (slope + noise). Noise is Gaussian per setting with sd 1.5 x sqrt((64 - b) / (63 b)) for batch size b: largest at 1, exactly zero at 64.",
    "Arrows are horizontal and drawn at 2 x the true step length (one scale for both). The orange arrow is the next mini-batch step; the grey one is the full-data step at the same rate. A hidden arrow means 0.",
    "A run ends after 40 steps (finished) or when the loss exceeds 10 (diverged). A diverged ball and path are drawn at the bowl's edge; the Loss readout keeps the true value.",
    "Noise comes from a fixed seed by run and step, so Reset replays the same sequence; a new run uses the next values. Changing a setting mid-run affects the following steps."
  ],
  "program": {
    "source": "const A=2.5,C=1,K=0.5,R=0.16,N=64,MS=40,LIM=10,S0=1.5,SC=2,E=2.1,ST=[1.2,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=MS?'finished':s.on?'running':'paused';\nconst over=s=>{const w=word(s);return w==='diverged'||w==='finished';};\nfunction next(s,inp,seed){const b=Number(inp.batchSize),sd=b>=N?0:S0*Math.sqrt((N-b)/((N-1)*b)),k=seed*7.31+s.run*1009+s.step*2+1,lr=inp.learningRate;\nreturn [-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+0.25))];}\nfunction adv(s,inp,seed){if(over(s))return s;const [dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,run,on:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:adv(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return adv({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-E,Math.min(E,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return [x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz)*SC,h=Math.SQRT1_2;\nreturn on&&l>1e-6?{visible:true,quaternion:[dz*SC/l*h,0,-dx*SC/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed||0),x=cl(s.x),z=cl(s.z),lr=inputs.learningRate;\nreturn {nodes:{ball:{position:[x,K*loss(x,z)+R,z]},stepArrow:aim(dx,dz,live),\ntrueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&!!inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{loss:L,steps:s.step,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  }
}