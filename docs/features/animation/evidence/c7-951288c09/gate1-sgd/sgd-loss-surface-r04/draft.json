  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.12,H=2,N=64,MS=40,S=1.5,G=2,LIM=6,ST=[0.3,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>S*Math.sqrt(Math.max(0,(N-b)/((N-1)*b)));\nconst div=s=>loss(s.x,s.z)>LIM||Math.abs(s.x)>H||Math.abs(s.z)>H;\nconst over=s=>div(s)||s.step>=MS;\nconst word=s=>div(s)?'diverged':s.step>=MS?'finished':s.on?'running':'paused';\nfunction grad(s,inp,seed){const d=sd(Math.round(inp.batchSize)),k=seed*7919+s.run*1009+s.step*2+1;return [A*s.x+d*gauss(k),C*s.z+d*gauss(k+0.25)];}\nfunction advance(s,inp,seed){if(over(s))return {...s,on:false};const g=grad(s,inp,seed),x=s.x-inp.learningRate*g[0],z=s.z-inp.learningRate*g[1];const n={...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};return over(n)?{...n,on:false}:n;}\nconst fresh=(run,kept,on)=>({x:ST[0],z:ST[1],step:0,run,on,path:[ST],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst cl=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>[cl(p[0]),Math.min(K*loss(p[0],p[1]),4)+0.04,cl(p[1])];\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,G*l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),lr=inputs.learningRate,g=grad(s,inputs,seed);\nconst dx=-lr*g[0],dz=-lr*g[1],r={loss:L,steps:s.step,status:word(s)};\nif(live)r.stepLen=Math.hypot(dx,dz);\nconst bx=cl(s.x),bz=cl(s.z);\nreturn {nodes:{ball:{position:[bx,K*loss(bx,bz)+R,bz]},stepArrow:aim(dx,dz,live),trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
