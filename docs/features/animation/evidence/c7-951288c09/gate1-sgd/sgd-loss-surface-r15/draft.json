  "program": {
    "source": "const A=2.5,C=0.5,K=0.5,R=0.13,HALF=2,LIM=10,MAXS=40,N=64,S0=1.5,X0=1.3,Z0=1.7;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>S0*Math.sqrt(Math.max(0,(N-b)/(b*(N-1))));\nconst word=s=>(Math.abs(s.x)>HALF||Math.abs(s.z)>HALF||loss(s.x,s.z)>LIM)?'diverged':s.step>=MAXS?'finished':'running';\nfunction grads(s,inp){const d=sd(Number(inp.batchSize)),k=s.n*2+1;return{gx:A*s.x,gz:C*s.z,nx:A*s.x+d*gauss(k),nz:C*s.z+d*gauss(k+0.25)};}\nfunction advance(s,inp){if(word(s)!=='running')return s;const g=grads(s,inp),lr=inp.learningRate,x=s.x-lr*g.nx,z=s.z-lr*g.nz;return{...s,x,z,step:s.step+1,n:s.n+1,path:s.path.concat([[x,z]]).slice(-MAXS)};}\nconst fresh=(n,kept)=>({x:X0,z:Z0,step:0,n,path:[],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\n if(e.type==='step')return e.tick%6?s:advance(s,inputs);\n if(e.type==='action'&&e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept);\n return s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),3)+0.05,p[1]];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\n const s=state||initialState(),L=loss(s.x,s.z),w=word(s),live=w==='running',g=grads(s,inputs),lr=inputs.learningRate;\n const dx=-lr*g.nx,dz=-lr*g.nz,len=live?Math.hypot(dx,dz):0;\n return{nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(dx,dz,live),trueArrow:aim(-lr*g.gx,-lr*g.gz,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\n readouts:{loss:L,status:w,steps:s.step,stepLen:len}};}\n"
  },
