  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.12,LIM=6,N=40,S=1.5,ARW=2,ST=[1.2,1.5];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>S*Math.sqrt(Math.max(0,64-b)/(63*b));\nconst done=s=>s.div||s.step>=N;\nconst word=s=>s.div?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction grads(s,inp,seed){const b=Math.round(inp.batchSize),d=sd(b),k=s.n*2+1+seed*0.731;\nconst tx=A*s.x,tz=C*s.z;return [tx,tz,tx+d*gauss(k),tz+d*gauss(k+0.37)];}\nfunction advance(s,inp,seed){if(done(s))return s;const g=grads(s,inp,seed),lr=inp.learningRate;\nconst x=s.x-lr*g[2],z=s.z-lr*g[3],div=loss(x,z)>LIM||Math.abs(x)>2||Math.abs(z)>2;\nreturn {...s,x,z,div,n:s.n+1,step:s.step+1,on:div?false:s.on,path:s.path.concat([[x,z]])};}\nconst fresh=(n,kept,on)=>({x:ST[0],z:ST[1],step:0,n,div:false,on,path:[ST],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||done(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return done(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst cl=v=>Math.max(-2.1,Math.min(2.1,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return [x,Math.min(K*loss(x,z),4)+0.05,z];};\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;\nreturn show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l*ARW,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){const s=state||initialState(),L=loss(s.x,s.z),live=!done(s),lr=inputs.learningRate;\nconst g=grads(s,inputs,seed||0),sx=-lr*g[2],sz=-lr*g[3];\nconst p=lift([s.x,s.z]);const ro={loss:L,steps:s.step,status:word(s)};if(live)ro.stepLen=Math.hypot(sx,sz);\nreturn {nodes:{ball:{position:[p[0],p[1]+R,p[2]]},stepArrow:aim(sx,sz,live),\ntrueArrow:aim(-lr*g[0],-lr*g[1],live&&!!inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:ro};}\n"
  },
