  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.16,H=2,LIM=6,N=40,S0=2,ST=[1.2,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>S0*Math.sqrt(Math.max(0,64-b)/(63*b));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=N?'finished':'running';\nfunction next(s,inp){const lr=inp.learningRate,n=sd(Math.round(inp.batchSize)),k=s.run*1009+s.step*2+1;return[-lr*(A*s.x+n*gauss(k)),-lr*(C*s.z+n*gauss(k+0.25))];}\nfunction advance(s,inp){if(word(s)!=='running')return s;const[dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,run,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\n if(e.type==='step')return e.tick%6?s:advance(s,inputs);\n if(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\n return s;}\nconst cl=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return[x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\n const s=state||initialState(),L=loss(s.x,s.z),live=word(s)==='running',[dx,dz]=next(s,inputs),x=cl(s.x),z=cl(s.z),lr=inputs.learningRate;\n const r={loss:L,steps:s.step,status:word(s)};if(live)r.stepLen=Math.hypot(dx,dz);\n return{nodes:{ball:{position:[x,K*loss(x,z)+R,z]},stepArrow:aim(dx,dz,live),trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
