  "program": {
    "source": "const A=4,C=1,K=0.25,R=0.12,H=2,N=40,S0=2,ST=[1.2,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst out=s=>Math.abs(s.x)>H||Math.abs(s.z)>H;\nconst done=s=>out(s)||s.step>=N;\nconst word=s=>out(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction next(s,inp){const b=Number(inp.batchSize),sd=S0*Math.sqrt(Math.max(0,64-b)/(63*b)),k=s.run*1009+s.step*2+1,lr=inp.learningRate;\nreturn [-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+0.37))];}\nfunction advance(s,inp){if(done(s))return s;const[dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;\nconst n={...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};if(done(n))n.on=false;return n;}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,run,on:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return !s.on||done(s)||e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return done(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst lift=p=>{const x=Math.max(-H,Math.min(H,p[0])),z=Math.max(-H,Math.min(H,p[1]));return [x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;\nreturn show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!done(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\nreturn{nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(dx,dz,live),\ntrueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&!!inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
