  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.14,H=2,LIM=6,MAX=40,N=64,S0=2,SC=3,X0=1,Z0=-1.6;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*91.317+17.71)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst off=s=>Math.abs(s.x)>H||Math.abs(s.z)>H||loss(s.x,s.z)>LIM;\nconst over=s=>off(s)||s.step>=MAX;\nconst word=s=>off(s)?'diverged':s.step>=MAX?'finished':s.on?'running':'paused';\nconst sd=b=>b>=N?0:S0*Math.sqrt((N-b)/(b*(N-1)));\nfunction next(s,i){const d=sd(Number(i.batchSize)),lr=i.learningRate;return[-lr*(A*s.x+d*gauss(s.k)),-lr*(C*s.z+d*gauss(s.k+0.25))];}\nfunction advance(s,i){if(over(s))return s;const[dx,dz]=next(s,i),x=s.x+dx,z=s.z+dz;return{...s,x,z,k:s.k+1,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(k,kept,on)=>({x:X0,z:Z0,step:0,k,on,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(1,[],false);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.k,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst cl=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return[x,Math.min(K*loss(x,z),4)+0.06,z];};\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,SC*l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),x=cl(s.x),z=cl(s.z),lr=inputs.learningRate;\nconst r={loss:L,steps:s.step,status:word(s)};if(live)r.stepLen=Math.hypot(dx,dz);\nreturn{nodes:{ball:{position:[x,K*loss(x,z)+R,z]},stepArrow:aim(dx,dz,live),trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
