  "program": {
    "source": "const A=2.5,K=0.4,N=64,S0=3,MAXS=40,LIM=8,ST=[1.3,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>b>=N?0:S0*Math.sqrt((N-b)/(b*(N-1)));\nfunction next(s,inp){const lr=inp.learningRate,d=sd(Math.round(inp.batchSize)),k=s.n*2+1;return[-lr*(A*s.x+d*gauss(k)),-lr*(s.z+d*gauss(k+0.37))];}\nconst bad=s=>loss(s.x,s.z)>LIM;\nconst over=s=>bad(s)||s.step>=MAXS;\nconst word=s=>bad(s)?'diverged':s.step>=MAXS?'finished':s.step===0?'ready':'running';\nfunction advance(s,inp){if(over(s))return s;const[dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,n:s.n+1,path:s.path.concat([[x,z]])};}\nconst fresh=(n,kept)=>({x:ST[0],z:ST[1],step:0,n,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return e.tick%5?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='stepOnce')return advance(s,inputs);\nif(e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return[x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\nconst p=lift([s.x,s.z]);\nreturn{nodes:{ball:{position:[p[0],p[1]+0.09,p[2]]},stepArrow:aim(dx,dz,live),trueArrow:aim(-lr*A*s.x,-lr*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{loss:L,steps:s.step,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
