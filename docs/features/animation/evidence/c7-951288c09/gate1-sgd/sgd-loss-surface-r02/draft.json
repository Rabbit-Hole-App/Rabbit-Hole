  "program": {
    "source": "const A=2.5,C=1,K=0.5,R=0.12,H=2,S=2,MX=40,LIM=8,ST=[1.4,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const v=Math.sin(n*12.9898+78.233)*43758.5453;return v-Math.floor(v)};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sdOf=b=>1.5*Math.sqrt(Math.max(0,64-b)/(63*b));\nfunction grad(s,inp,seed){const sd=sdOf(Number(inp.batchSize)),k=s.n*2+1+seed*101;return [A*s.x+sd*gauss(k),C*s.z+sd*gauss(k+0.5)]}\nconst word=s=>s.div?'diverged':s.step>=MX?'finished':'running';\nfunction adv(s,inp,seed){if(word(s)!=='running')return s;const g=grad(s,inp,seed),lr=inp.learningRate,x=s.x-lr*g[0],z=s.z-lr*g[1];return {...s,x,z,n:s.n+1,step:s.step+1,div:loss(x,z)>LIM,path:s.path.concat([[x,z]])}}\nconst fresh=(n,kept)=>({x:ST[0],z:ST[1],n,step:0,div:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[])}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return e.tick%6?s:adv(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='stepOnce')return adv(s,inputs,seed);\nif(e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept);\nreturn s}\nconst cl=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return [x,Math.min(K*loss(x,z),3.5)+0.05,z]};\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz)*S,h=Math.SQRT1_2;if(!on||l<1e-4)return {visible:false};const u=l/S;return {visible:true,quaternion:[dz/u*h,0,-dx/u*h,h],scale:[1,l,1]}}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),w=word(s),live=w==='running',lr=inputs.learningRate,g=grad(s,inputs,seed||0),cx=cl(s.x),cz=cl(s.z);\nconst r={loss:loss(s.x,s.z),steps:s.step,status:w};if(live)r.stepLen=lr*Math.hypot(g[0],g[1]);\nreturn {nodes:{ball:{position:[cx,K*loss(cx,cz)+R,cz]},stepArrow:aim(-lr*g[0],-lr*g[1],live),trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&!!inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r}}\n"
  },
