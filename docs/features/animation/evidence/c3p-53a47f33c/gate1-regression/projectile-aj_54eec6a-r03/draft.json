  "assumptions": [
    "This is a simplified simulation: no air resistance, and the ball starts at ground level on flat ground.",
    "Gravity is 9.8 m/s² straight down; sideways speed stays constant and only vertical speed changes, so landing distance = speed² × sin(2 × angle) ÷ 9.8.",
    "The ball is a point for the physics; it is drawn 1.4 m in radius so it is easy to see, and its drawn centre rides 1.4 m above the computed path.",
    "Each flight is shown in 60 steps (about two seconds), so the time on screen does not match the flight-time readout.",
    "Targets come in a fixed order (30 m, 45 m, 18 m); a hit is a landing within 1.5 m of the centre, edges included. Reset starts the same challenge and clears the score and trails.",
    "Real balls are slowed by air and land shorter; the longest shot here is about 64 m (25 m/s at 45°)."
  ],
  "program": {
    "source": "const G=9.8,R=1.4,TG=[30,45,18],N=60;\nfunction fl(v,a){const r=a*Math.PI/180,vx=v*Math.cos(r),vy=v*Math.sin(r),T=2*vy/G;return{vx,vy,T,d:vx*T,H:vy*vy/(2*G)};}\nfunction pts(s,p){const f=fl(s.v,s.a),o=[];for(let k=0;k<=N;k++){const t=f.T*p*k/N;o.push([f.vx*t,f.vy*t-G*t*t/2+R,0]);}return o;}\nexport function initialState(){return{fly:false,p:0,shots:0,hits:0,ti:0,cur:null,prev:null,res:null};}\nexport function reduce({state,event,inputs}){const s=state;\nif(event.type==='action'&&event.action==='launch'){if(s.fly||s.hits>=3||s.shots>=10)return s;return{...s,fly:true,p:0,prev:s.cur,cur:{v:inputs.speed,a:inputs.angle}};}\nif(event.type==='step'&&s.fly){const p=Math.min(1,s.p+1/N);if(p<1)return{...s,p};const f=fl(s.cur.v,s.cur.a),miss=f.d-TG[s.ti],hit=Math.abs(miss)<=1.5;return{...s,fly:false,p:1,shots:s.shots+1,hits:s.hits+(hit?1:0),ti:hit?s.ti+1:s.ti,res:{d:f.d,miss,T:f.T,H:f.H,hit}};}\nreturn s;}\nexport function evaluate({inputs,state}){const s=state,h=-(90-inputs.angle)*Math.PI/360,n={};\nn.pivot={quaternion:[0,0,Math.sin(h),Math.cos(h)]};\nif(s.cur){const f=fl(s.cur.v,s.cur.a),t=f.T*s.p;n.ball={position:[f.vx*t,f.vy*t-G*t*t/2+R,0]};n.trail={visible:true,points:pts(s.cur,s.p)};}else{n.ball={position:[0,R,0]};n.trail={visible:false};}\nn.ghost=s.prev?{visible:true,points:pts(s.prev,1)}:{visible:false};\nconst won=s.hits>=3,lost=!won&&s.shots>=10&&!s.fly;\nn.tgt={visible:!won,position:[TG[Math.min(s.ti,2)],0,0]};\nconst ro={shots:s.shots,hits:s.hits};\nif(s.res){ro.dist=s.res.d;ro.miss=Math.abs(s.res.miss);ro.side=s.res.hit?'hit':(s.res.miss<0?'short':'long');ro.ftime=s.res.T;ro.height=s.res.H;}\nlet msg;if(won)msg='You hit all 3 targets in '+s.shots+' launches!';else if(lost)msg='Out of launches: '+s.hits+' of 3 targets hit.';else if(s.fly)msg='In flight...';else if(s.res)msg=(s.res.hit?'Hit! ':'Miss: '+Math.abs(s.res.miss).toFixed(1)+' m '+(s.res.miss<0?'short. ':'long. '))+'Next target at '+TG[Math.min(s.ti,2)]+' m. '+(10-s.shots)+' launches left.';else msg='Target at '+TG[0]+' m. Set angle and speed, then Launch.';\nreturn{nodes:n,readouts:ro,goal:{status:won?'won':lost?'lost':'playing',message:msg}};}"
  }
