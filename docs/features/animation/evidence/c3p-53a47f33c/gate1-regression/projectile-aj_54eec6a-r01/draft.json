  "assumptions": [
    "This is a simplified simulation: no air resistance, and the ball starts at ground level on flat ground.",
    "Gravity is 9.8 m/s² straight down; sideways speed stays constant and only the vertical speed changes.",
    "Each step uses the exact projectile formulas, so the landing distance is speed² × sin(2 × angle) ÷ 9.8 (at most about 63.8 m at 25 m/s and 45°).",
    "The ball is a point for the physics; it is drawn 1.3 m above its true height so it sits on the ground, and the flight ends when it returns to ground height.",
    "Every flight is shown over 2 seconds whatever its real flight time. Real balls are slowed by air and land shorter, especially at high speed.",
    "Targets come in a fixed order (30 m, 45 m, 18 m); Reset starts the same challenge again and clears the score and both trails."
  ],
  "program": {
    "source": "const G=9.8,TG=[30,45,18],R=1.5,N=60,OY=1.3;\nconst rad=d=>d*Math.PI/180;\nfunction pos(s,t){const a=rad(s.a);return [s.v*Math.cos(a)*t,s.v*Math.sin(a)*t-G*t*t/2];}\nfunction status(s){return s.hits>=3?'won':(s.shots>=10&&!s.fly?'lost':'playing');}\nexport function initialState(){return {fly:false,k:0,shots:0,hits:0,ti:0,a:45,v:15,tf:0,cur:[],last:[],res:null};}\nexport function reduce({state,event,inputs}){const s=state;\nif(event.type==='action'&&event.action==='launch'){if(s.fly||status(s)!=='playing')return s;const a=inputs.angle,v=inputs.speed;return {...s,fly:true,k:0,a,v,tf:2*v*Math.sin(rad(a))/G,shots:s.shots+1,last:s.cur,cur:[[0,OY,0]]};}\nif(event.type==='step'&&s.fly){const k=s.k+1,t=k/N*s.tf,p=pos(s,t),y=k>=N?0:Math.max(0,p[1]);let cur=s.cur;if(k%2===0||k>=N)cur=cur.concat([[p[0],y+OY,0]]);if(k<N)return {...s,k,cur};\nconst d=s.v*s.v*Math.sin(2*rad(s.a))/G,tx=TG[s.ti],m=Math.abs(d-tx),h=m<=R,ar=rad(s.a);\nconst res={d,m,side:h?'Hit':(d<tx?'Short':'Long'),tf:s.tf,hm:Math.pow(s.v*Math.sin(ar),2)/(2*G)};\nconst hits=s.hits+(h?1:0);return {...s,k,cur,fly:false,res,hits,ti:h?Math.min(hits,2):s.ti};}\nreturn s;}\nfunction q(deg){const h=rad(deg)/2;return [0,0,Math.sin(h),Math.cos(h)];}\nexport function evaluate({inputs,state}){const s=state,st=status(s);let bx=0,by=OY;\nif(s.fly){const p=pos(s,s.k/N*s.tf);bx=p[0];by=Math.max(0,p[1])+OY;}\nconst cur=s.fly?s.cur.concat([[bx,by,0]]):s.cur;\nconst f={nodes:{pivot:{quaternion:q(inputs.angle-90)},ballN:{position:[bx,by,0]},target:{position:[TG[s.ti],0,0],visible:st!=='won'},curTrail:{points:cur,visible:cur.length>1},lastTrail:{points:s.last,visible:s.last.length>1}},readouts:{used:s.shots,hit:s.hits}};\nif(s.res){const r=s.res;Object.assign(f.readouts,{dist:r.d,miss:r.m,side:r.side,tf:r.tf,hmax:r.hm});}\nconst left=10-s.shots;const msg=st==='won'?'All 3 targets hit in '+s.shots+' launches. You win!':st==='lost'?'Out of launches: '+s.hits+' of 3 targets hit.':(s.res&&!s.fly?(s.res.side==='Hit'?'Hit! ':s.res.side+' by '+s.res.m.toFixed(1)+' m. '):'')+'Target at '+TG[s.ti]+' m, '+left+' launches left.';\nf.goal={status:st,message:msg};return f;}"
  }
