  "assumptions": [
    "Simplified simulation: no air resistance, flat ground, the ball starts at ground level.",
    "Gravity is 9.8 m/s² straight down; sideways speed stays constant. Landing distance = speed² × sin(2 × angle) ÷ 9.8, and the hit test uses that exact value.",
    "A hit lands within 1.5 m of the target centre, edges included. The ball is drawn 1.2 m above its point path so it sits on the ground at landing.",
    "Every flight plays over 60 steps (about 2 s), so the on-screen time does not match the flight-time readout. Reset clears score and trails and starts again at 30 m.",
    "Real balls are slowed by air and land shorter. The longest shot is about 64 m (25 m/s at 45°)."
  ],
  "program": {
    "source": "const G=9.8,N=60,TG=[30,45,18],R=1.2,D=Math.PI/180;\nfunction arc(a,v,k){const r=a*D,vx=v*Math.cos(r),vy=v*Math.sin(r),T=2*vy/G,p=[];for(let i=0;i<=k;i++){const t=T*i/N;p.push([vx*t,Math.max(0,vy*t-G*t*t/2)+R,0]);}return p;}\nexport function initialState(){return{mode:'ready',k:0,cur:null,prev:null,shots:0,hits:0,ti:0,res:null};}\nexport function reduce({state,event,inputs}){const s=state;if(event.type==='action'&&event.action==='launch'){if(s.mode!=='ready'||s.hits>=3||s.shots>=10)return s;return{...s,mode:'flying',k:0,prev:s.cur,cur:{a:inputs.angle,v:inputs.speed}};}\nif(event.type==='step'&&s.mode==='flying'){const k=s.k+1;if(k<N)return{...s,k};const {a,v}=s.cur,r=a*D,d=v*v*Math.sin(2*r)/G,m=d-TG[s.ti],hit=Math.abs(m)<=1.5,hits=s.hits+(hit?1:0);return{...s,mode:'ready',k:N,shots:s.shots+1,hits,ti:hit&&hits<3?s.ti+1:s.ti,res:{d,m,hit,T:2*v*Math.sin(r)/G,H:v*v*Math.sin(r)**2/(2*G)}};}\nreturn s;}\nexport function evaluate({inputs,state:s}){const th=(inputs.angle-90)*D/2,n={pivot:{quaternion:[0,0,Math.sin(th),Math.cos(th)]},target:{position:[TG[s.ti],0,0]}};\nif(s.cur){const p=arc(s.cur.a,s.cur.v,s.k);n.ballN={position:p[p.length-1]};n.trailN={visible:p.length>1,points:p};}else{n.trailN={visible:false,points:[]};n.ballN={position:[0,R,0]};}\nif(s.prev){n.ghostN={visible:true,points:arc(s.prev.a,s.prev.v,N)};}else n.ghostN={visible:false,points:[]};\nconst ro={shots:s.shots,hits:s.hits};let msg='Target at '+TG[s.ti]+' m. Set angle and speed, then Launch.';\nif(s.res){const r=s.res;ro.dist=r.d;ro.miss=Math.abs(r.m);ro.side=r.hit?'hit':(r.m<0?'short':'long');ro.tof=r.T;ro.hmax=r.H;msg=r.hit?'Hit! '+(s.hits<3?'Next target at '+TG[s.ti]+' m.':''):'Missed: '+Math.abs(r.m).toFixed(1)+' m '+ro.side+'. Target at '+TG[s.ti]+' m.';}\nif(s.mode==='flying')msg='In flight...';let st='playing';if(s.hits>=3){st='won';msg='All 3 targets hit in '+s.shots+' launches!';}else if(s.shots>=10&&s.mode==='ready'){st='lost';msg='Out of launches: '+s.hits+' of 3 targets hit.';}\nreturn{nodes:n,readouts:ro,goal:{status:st,message:msg}};}"
  }
}