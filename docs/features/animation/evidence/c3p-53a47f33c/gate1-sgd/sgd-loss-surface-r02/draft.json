  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.16,H=2,LIM=6,N=40,S0=2,ST=[1.2,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=(n,sd)=>{const s=Math.sin(n*12.9898+sd*78.233+1.7)*43758.5453;return s-Math.floor(s);};\nconst gauss=(n,sd)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n,sd))))*Math.cos(2*Math.PI*rnd(n+0.5,sd));\nconst sdev=b=>b>=64?0:S0*Math.sqrt((64-b)/(63*b));\nconst div=s=>Math.abs(s.x)>H||Math.abs(s.z)>H||loss(s.x,s.z)>LIM;\nconst over=s=>div(s)||s.step>=N;\nconst word=s=>div(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction next(s,i,seed){const d=sdev(i.batchSize),k=2*s.n;return [-i.learningRate*(A*s.x+d*gauss(k,seed)),-i.learningRate*(C*s.z+d*gauss(k+1,seed))];}\nfunction advance(s,i,seed){if(over(s))return {...s,on:false};const [dx,dz]=next(s,i,seed),x=s.x+dx,z=s.z+dz;const t={...s,x,z,n:s.n+1,step:s.step+1,path:s.path.concat([[x,z]])};return over(t)?{...t,on:false}:t;}\nconst fresh=(n,kept,on)=>({x:ST[0],z:ST[1],n,step:0,on,path:[ST],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),4)+0.05,p[1]];\nfunction aim(dx,dz,shown){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),d=div(s),[dx,dz]=next(s,inputs,seed),r={loss:L,steps:s.step,status:word(s)};\nif(!d)r.stepLen=Math.hypot(dx,dz);\nreturn {nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(dx,dz,!d),trueArrow:aim(-inputs.learningRate*A*s.x,-inputs.learningRate*C*s.z,!d&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
