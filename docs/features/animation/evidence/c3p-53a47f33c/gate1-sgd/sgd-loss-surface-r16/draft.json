  "stepped": true,
  "program": {
    "source": "const A=2.5,K=0.5,R=0.12,HALF=2,LIM=5,MAX=40,S=2,G=1.5,X0=1.2,Z0=1.7;\nconst loss=(x,z)=>0.5*(A*x*x+z*z);\nconst rand=(n,sd)=>{const v=Math.sin(n*12.9898+sd*78.233+1.7)*43758.5453;return v-Math.floor(v);};\nconst gauss=(n,sd)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n,sd))))*Math.cos(2*Math.PI*rand(n+1000.5,sd));\nconst bad=s=>Math.abs(s.x)>HALF||Math.abs(s.z)>HALF||loss(s.x,s.z)>LIM;\nconst done=s=>bad(s)||s.step>=MAX;\nconst word=s=>bad(s)?'diverged':s.step>=MAX?'finished':s.on?'running':'paused';\nfunction next(s,inp,seed){const b=inp.batchSize,sd=S*Math.sqrt(Math.max(0,64-b)/(63*b)),k=s.n*2,lr=inp.learningRate;\nreturn [-lr*(A*s.x+sd*gauss(k,seed)),-lr*(s.z+sd*gauss(k+1,seed))];}\nfunction advance(s,inp,seed){if(done(s))return s;const [dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;\nreturn {...s,x,z,step:s.step+1,n:s.n+1,path:s.path.concat([[x,z]])};}\nconst fresh=(n,kept)=>({x:X0,z:Z0,step:0,n,on:false,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||done(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return done(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept);\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),3.5)+0.04,p[1]];\nfunction aim(dx,dz,shown){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;\nreturn shown&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!done(s),[dx,dz]=next(s,inputs,seed);\nconst gx=K*A*s.x,gz=K*s.z,lr=inputs.learningRate;\nreturn {nodes:{\nball:{position:[s.x,K*L+R*Math.sqrt(1+gx*gx+gz*gz),s.z]},\nstepArrow:aim(dx*G,dz*G,live),\nslopeArrow:aim(-lr*A*s.x*G,-lr*s.z*G,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},\nghost:{points:s.kept.map(lift)}},\nreadouts:{loss:L,steps:s.step,arrowLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
