  "stepped": true,
  "program": {
    "source": "const A=4,C=1,K=0.4,R=0.16,HALF=2,LMAX=10,N=40,X0=1.2,Z0=1.7,H=Math.SQRT1_2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst sd=b=>b>=64?0:2*Math.sqrt((64-b)/(63*b));\nfunction grad(s,inputs,seed){const k=seed*7919+s.run*1009+s.step*2+1,d=sd(Number(inputs.batchSize));return [A*s.x+d*gauss(k),C*s.z+d*gauss(k+0.5)];}\nconst word=s=>s.div?'diverged':s.step>=N?'finished':'running';\nfunction advance(s,inputs,seed){\n if(word(s)!=='running')return s;\n const g=grad(s,inputs,seed),lr=inputs.learningRate,x=s.x-lr*g[0],z=s.z-lr*g[1];\n const div=loss(x,z)>LMAX||Math.abs(x)>HALF||Math.abs(z)>HALF;\n return {...s,x,z,step:s.step+1,div,path:s.path.concat([[x,z]]).slice(-N)};\n}\nconst fresh=(run,kept)=>({x:X0,z:Z0,step:0,run,div:false,path:[],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\n if(e.type==='step')return e.tick%6?s:advance(s,inputs,seed||0);\n if(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.path.length?s.path:s.kept);\n return s;\n}\nconst cl=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return [x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,show){\n const l=Math.hypot(dx,dz);\n return show&&l>1e-6?{visible:true,position:[dx/l*R,0,dz/l*R],quaternion:[dz/l*H,0,-dx/l*H,H],scale:[1,l,1]}:{visible:false};\n}\nexport function evaluate({inputs,state,seed}){\n const s=state||initialState(),live=word(s)==='running',lr=inputs.learningRate;\n const g=grad(s,inputs,seed||0),dx=-lr*g[0],dz=-lr*g[1];\n const bx=cl(s.x),bz=cl(s.z),hx=2*K*A*bx/2*2,hz=K*C*bz;\n const r={steps:s.step,loss:loss(s.x,s.z),status:word(s)};\n if(live)r.stepLength=Math.hypot(dx,dz);\n return {\n  nodes:{\n   ball:{position:[bx,K*loss(bx,bz)+R*Math.sqrt(1+hx*hx+hz*hz),bz]},\n   stepArrow:aim(dx,dz,live),\n   trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&!!inputs.showTrueGradient),\n   trail:{points:s.path.map(lift)},\n   ghost:{points:s.kept.map(lift)}\n  },\n  readouts:r\n };\n}\n"
  },
