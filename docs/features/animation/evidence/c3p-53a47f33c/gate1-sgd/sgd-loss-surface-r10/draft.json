  "program": {
    "source": "const A=2.5,C=0.5,K=0.4,R=0.12,H=2,LIM=5,MAXS=40,ST=[1.1,1.7],S=1.5,AS=2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>S*Math.sqrt(Math.max(0,64-b)/(63*b));\nfunction next(s,i){const d=sd(Number(i.batchSize)),lr=i.learningRate;return[-lr*(A*s.x+d*gauss(s.n*2+1)),-lr*(C*s.z+d*gauss(s.n*2+1.37))];}\nconst div=s=>Math.abs(s.x)>H||Math.abs(s.z)>H||loss(s.x,s.z)>LIM;\nconst word=s=>div(s)?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nconst over=s=>div(s)||s.step>=MAXS;\nfunction advance(s,i){if(over(s))return s;const[dx,dz]=next(s,i),x=s.x+dx,z=s.z+dz;return{...s,x,z,n:s.n+1,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(n,kept)=>({x:ST[0],z:ST[1],step:0,n,on:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return!s.on||over(s)||e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return{...fresh(s.n,s.step>0?s.path:s.kept),on:true};\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),2.4)+0.04,p[1]];\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,AS*l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\nconst gx=K*A*s.x,gz=K*C*s.z;\nreturn{nodes:{\nball:{position:[s.x,K*L+R*Math.sqrt(1+gx*gx+gz*gz),s.z]},\nbatchArrow:aim(dx,dz,live),\ntrueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},\nghost:{visible:s.kept.length>1,points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
