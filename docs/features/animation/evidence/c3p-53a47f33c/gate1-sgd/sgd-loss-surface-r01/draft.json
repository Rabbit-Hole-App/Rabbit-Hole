  "program": {
    "source": "const A=3,K=0.5,R=0.14,TOP=4,LIM=6,MAXS=40,S0=2,SC=3,START=[0.6,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst sd=b=>b>=64?0:S0*Math.sqrt((64-b)/(63*b));\nconst word=s=>s.div?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nconst over=s=>s.div||s.step>=MAXS;\nfunction noisy(s,inp){const d=sd(Number(inp.batchSize)),k=2*s.k+1;return[A*s.x+d*gauss(k),s.z+d*gauss(k+0.5)];}\nfunction advance(s,inp){if(over(s))return s;const g=noisy(s,inp),lr=inp.learningRate,x=s.x-lr*g[0],z=s.z-lr*g[1];return{...s,x,z,step:s.step+1,k:s.k+1,div:loss(x,z)>LIM,path:s.path.concat([[x,z]])};}\nconst fresh=(k,kept,on)=>({x:START[0],z:START[1],step:0,k,on,div:false,path:[START],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.k,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),TOP)+0.05,p[1]];\nfunction aim(dx,dz,shown){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),lr=inputs.learningRate,g=noisy(s,inputs),dx=-lr*g[0],dz=-lr*g[1];\nconst gx=K*A*s.x,gz=K*s.z;\nreturn{nodes:{ball:{position:[s.x,K*L+R*Math.sqrt(1+gx*gx+gz*gz),s.z]},stepArrow:aim(SC*dx,SC*dz,live),slopeArrow:aim(-SC*lr*A*s.x,-SC*lr*s.z,live&&!!inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:Math.hypot(dx,dz),status:word(s)}};}\n"
  },
