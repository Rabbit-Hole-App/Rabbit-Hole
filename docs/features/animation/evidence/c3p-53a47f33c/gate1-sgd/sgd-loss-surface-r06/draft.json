  "stepped": true,
  "program": {
    "source": "const A=4,C=1,K=0.25,R=0.16,H=2,LIM=10,N=40,S=2,ST=[0.4,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst bad=s=>!(loss(s.x,s.z)<=LIM);\nconst over=s=>s.step>=N||bad(s);\nconst word=s=>bad(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction next(s,i){const b=Number(i.batchSize),lr=i.learningRate,sd=b>=64?0:3*Math.sqrt((64-b)/(63*b)),k=s.run*1009+s.step*2+1;return [-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+0.25))];}\nfunction advance(s,i){if(over(s))return s;const [dx,dz]=next(s,i),x=s.x+dx,z=s.z+dz,n={...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};return over(n)?{...n,on:false}:n;}\nconst fresh=(run,kept,on)=>({x:ST[0],z:ST[1],step:0,run,on,path:[ST],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs}){\n if(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs);\n if(e.type!=='action')return s;\n if(e.action==='run')return over(s)?s:{...s,on:true};\n if(e.action==='pause')return {...s,on:false};\n if(e.action==='stepOnce')return advance({...s,on:false},inputs);\n if(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,true);\n return s;}\nconst cl=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return [x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,S*l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\n const s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),b=lift([s.x,s.z]),lr=inputs.learningRate;\n return {nodes:{ball:{position:[b[0],b[1]-0.04+R,b[2]]},stepArrow:aim(dx,dz,live),trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\n readouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
