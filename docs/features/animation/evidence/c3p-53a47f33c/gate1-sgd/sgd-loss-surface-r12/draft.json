  "assumptions": [
    "Illustration: a made-up loss bowl with simulated batch noise, not a real model trained on real data.",
    "Loss = (3x² + z²)/2, drawn at height 0.5 × loss. It is steep along x, so overshooting shows there first. With no noise, x diverges when the learning rate is above 2/3.",
    "Noise: the slope estimate gets Gaussian noise with spread 2·√((64−b)/(63·b)) for batch size b. That is 2 at b = 1 and exactly 0 at b = 64. The noise comes from a fixed seed, so Reset replays the same sequence.",
    "Arrows are drawn at their true length in the bowl's units (scale 1). Orange is the actual move: minus the learning rate times the noisy slope. Grey is minus the learning rate times the true slope.",
    "A run stops after 40 steps (finished) or when the loss goes above 8 (diverged). The ball is then held at the bowl's top while the readout keeps the true loss. Each run does 5 steps per second at 1× speed.",
    "With noise, a step lowers the loss only on average. Changing a setting during a run affects the next steps."
  ],
  "program": {
    "source": "const A=3,K=0.5,R=0.16,N=64,MAXS=40,LIM=8,ST=[-1.2,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nconst over=s=>{const w=word(s);return w==='diverged'||w==='finished';};\nfunction next(s,inputs,seed){const b=Math.round(inputs.batchSize),sd=2*Math.sqrt(Math.max(0,(N-b)/(b*(N-1)))),k=(seed||0)*31+s.run*1009+s.step*2+1,lr=inputs.learningRate;\nreturn [-lr*(A*s.x+sd*gauss(k)),-lr*(s.z+sd*gauss(k+0.37))];}\nfunction advance(s,inputs,seed){if(over(s))return s;const [dx,dz]=next(s,inputs,seed),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept,on)=>({x:ST[0],z:ST[1],step:0,run,on,path:[ST],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),4)+0.05,p[1]];\nfunction aim(dx,dz,shown){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed);\nconst gx=K*A*s.x,gz=K*s.z,lr=inputs.learningRate;\nreturn {nodes:{ball:{position:[s.x,K*L+R*Math.sqrt(1+gx*gx+gz*gz),s.z]},\nstepArrow:aim(dx,dz,live),\ntrueArrow:aim(-lr*A*s.x,-lr*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  }
}