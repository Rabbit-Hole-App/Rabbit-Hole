  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.12,HALF=2,LIM=6,MAXS=40,S0=[0.6,1.7],SC=2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*91.345+17.17)*24634.6345;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sdOf=b=>2*Math.sqrt(Math.max(0,(64-b)/(63*b)));\nfunction next(s,inp){const sd=sdOf(Number(inp.batchSize)),k=s.n*2+1,lr=inp.learningRate;return[-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+0.37))];}\nconst word=s=>s.div?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nconst over=s=>s.div||s.step>=MAXS;\nfunction advance(s,inp){if(over(s))return{...s,on:false};const[dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;const div=loss(x,z)>LIM||Math.abs(x)>HALF||Math.abs(z)>HALF;const r={...s,x,z,n:s.n+1,step:s.step+1,div,path:s.path.concat([[x,z]])};if(over(r))r.on=false;return r;}\nconst fresh=(n,kept)=>({x:S0[0],z:S0[1],step:0,n,on:false,div:false,path:[S0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>[cl(p[0]),Math.min(K*loss(p[0],p[1]),4)+0.05,cl(p[1])];\nfunction aim(dx,dz,shown){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,SC*l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\nconst gx=K*A*s.x,gz=K*C*s.z;\nconst ro={steps:s.step,loss:L,status:word(s)};if(live)ro.stepLen=Math.hypot(dx,dz);\nreturn{nodes:{\nball:{position:[cl(s.x),Math.min(K*L,4)+R*Math.sqrt(1+gx*gx+gz*gz),cl(s.z)]},\nstepArrow:aim(dx,dz,live),\ntrueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},\nghost:{points:s.kept.map(lift)}},\nreadouts:ro};}\n"
  },
