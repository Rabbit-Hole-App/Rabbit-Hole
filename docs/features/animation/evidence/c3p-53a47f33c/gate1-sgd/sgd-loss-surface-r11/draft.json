  "stepped": true,
  "program": {
    "source": "const A=2.5,C=0.5,K=0.5,R=0.12,LIM=6,MAXS=40,ST=[1.5,1.6],SC=2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst sd=b=>2*Math.sqrt(Math.max(0,64-b)/(63*b));\nconst bad=s=>loss(s.x,s.z)>LIM||Math.abs(s.x)>2||Math.abs(s.z)>2;\nconst over=s=>bad(s)||s.step>=MAXS;\nconst word=s=>bad(s)?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nfunction next(s,i){const d=sd(Number(i.batchSize)),k=s.n*2+1,lr=i.learningRate;return[-lr*(A*s.x+d*gauss(k)),-lr*(C*s.z+d*gauss(k+0.5))];}\nfunction advance(s,i){if(over(s))return s;const[dx,dz]=next(s,i),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,n:s.n+1,path:s.path.concat([[x,z]])};}\nconst fresh=(n,kept)=>({x:ST[0],z:ST[1],step:0,n,on:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-2.1,Math.min(2.1,v));\nconst lift=p=>[cl(p[0]),Math.min(K*loss(p[0],p[1]),3)+0.04,cl(p[1])];\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\nreturn{nodes:{\nball:{position:[cl(s.x),Math.min(K*L,3)+R,cl(s.z)]},\nstepArrow:aim(dx,dz,live),\nslopeArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&!!inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},\nghost:{points:s.kept.map(lift)}},\nreadouts:{loss:L,steps:s.step,stepLen:Math.hypot(dx,dz),status:word(s)}};}\n"
  },
