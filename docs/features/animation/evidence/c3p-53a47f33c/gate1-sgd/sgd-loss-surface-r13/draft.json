      "decimals": 3
    },
    {
      "id": "steps",
      "label": "Step (of 40)",
      "decimals": 0
    },
    {
      "id": "arrowLen",
      "label": "Mini-batch step length",
      "decimals": 3
    },
    {
      "id": "status",
      "label": "Run status",
      "kind": "text"
    }
  ],
  "program": {
    "source": "const A=4,K=0.4,R=0.14,TOP=4,LIM=8,N=40,S=2,X0=[0.9,1.7],E=2.2;\nconst loss=(x,z)=>0.5*(A*x*x+z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(6.2832*rnd(n+0.37));\nconst sd=b=>b>=64?0:S*Math.sqrt((64-b)/(63*b));\nfunction grad(s,inp,noisy){const g=[A*s.x,s.z];if(!noisy)return g;const k=s.run*1009+s.step*2+1,d=sd(Number(inp.batchSize));return [g[0]+d*gauss(k),g[1]+d*gauss(k+0.5)];}\nconst done=s=>s.div||s.step>=N;\nconst word=s=>s.div?'diverged':s.step>=N?'finished':s.step?'running':'ready';\nfunction adv(s,inp){if(done(s))return s;const g=grad(s,inp,true),lr=inp.learningRate,x=s.x-lr*g[0],z=s.z-lr*g[1];return {...s,x,z,step:s.step+1,div:loss(x,z)>LIM,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:X0[0],z:X0[1],step:0,run,div:false,path:[X0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\n if(e.type==='step')return adv(s,inputs);\n if(e.type==='action'&&e.action==='keepPath')return fresh(s.run+1,s.step>0?s.path:s.kept);\n return s;\n}\nconst cl=v=>Math.max(-E,Math.min(E,v));\nconst lift=p=>[cl(p[0]),Math.min(K*loss(p[0],p[1]),TOP)+0.05,cl(p[1])];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\n const s=state||initialState(),L=loss(s.x,s.z),live=!done(s),lr=inputs.learningRate;\n const g=grad(s,inputs,true),t=grad(s,inputs,false),dx=-lr*g[0],dz=-lr*g[1];\n const sx=K*A*s.x,sz=K*s.z;\n return {nodes:{\n  ball:{position:[cl(s.x),Math.min(K*L,TOP)+R*Math.sqrt(1+sx*sx+sz*sz),cl(s.z)]},\n  stepArrow:aim(dx,dz,live),\n  slopeArrow:aim(-lr*t[0],-lr*t[1],live&&inputs.showTrueGradient),\n  trail:{points:s.path.map(lift)},\n  ghost:{points:s.kept.map(lift)}},\n  readouts:{loss:L,steps:s.step,arrowLen:live?Math.hypot(dx,dz):0,status:word(s)}};\n}\n"
  },
  "seed": 7,
