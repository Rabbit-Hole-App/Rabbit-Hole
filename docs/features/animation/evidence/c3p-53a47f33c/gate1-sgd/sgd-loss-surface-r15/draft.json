  "stepped": true,
  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.16,S=3,N=40,LIM=6,X0=0.9,Z0=1.6;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=(n,sd)=>{const v=Math.sin(n*12.9898+(sd+1)*78.233)*43758.5453;return v-Math.floor(v);};\nconst gauss=(n,sd)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n,sd))))*Math.cos(2*Math.PI*rand(n+0.37,sd));\nconst noise=b=>b>=64?0:1.5*Math.sqrt((64-b)/(63*b));\nfunction est(s,inp,sd){const n=noise(inp.batchSize);return[A*s.x+n*gauss(2*s.k+1,sd),C*s.z+n*gauss(2*s.k+2,sd)];}\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=N?'finished':'running';\nconst done=s=>word(s)!=='running';\nfunction advance(s,inp,sd){const g=est(s,inp,sd),lr=inp.learningRate,x=s.x-lr*g[0],z=s.z-lr*g[1];return{...s,x,z,step:s.step+1,k:s.k+1,path:s.path.concat([[x,z]])};}\nconst fresh=(k,kept)=>({x:X0,z:Z0,step:0,k,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return done(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type==='action'&&e.action==='newRun')return fresh(s.k,s.step>0?s.path:s.kept);\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),4)+0.05,p[1]];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,S*l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),w=word(s),live=w!=='diverged',lr=inputs.learningRate,g=est(s,inputs,seed);\nconst dx=-lr*g[0],dz=-lr*g[1],gx=K*A*s.x,gz=K*C*s.z;\nconst ro={loss:L,steps:s.step,status:w};if(live)ro.stepLen=Math.hypot(dx,dz);\nreturn{nodes:{ball:{position:[s.x,K*L+R*Math.sqrt(1+gx*gx+gz*gz),s.z]},stepArrow:aim(dx,dz,live),trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:ro};}\n"
  },
  "seed": 11,
