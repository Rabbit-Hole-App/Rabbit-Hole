  "stepped": true,
  "program": {
    "source": "const A=2.5,C=1,K=0.5,R=0.12,HALF=2,LIM=5,N=64,MAXS=40,S0=2,START=[0.6,1.7],AS=2,TOP=3.6;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst sd=b=>b>=N?0:S0*Math.sqrt((N-b)/((N-1)*b));\nconst off=s=>Math.abs(s.x)>HALF||Math.abs(s.z)>HALF||loss(s.x,s.z)>LIM;\nconst word=s=>off(s)?'diverged':s.step>=MAXS?'finished':'running';\nfunction next(s,inp,seed){const d=sd(Math.round(inp.batchSize)),k=s.k*2+1+(seed||0)*101,lr=inp.learningRate;return [-lr*(A*s.x+d*gauss(k)),-lr*(C*s.z+d*gauss(k+0.5))];}\nfunction advance(s,inp,seed){if(word(s)!=='running')return s;const [dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,k:s.k+1,path:s.path.concat([[x,z]])};}\nconst fresh=(k,kept)=>({x:START[0],z:START[1],step:0,k,path:[START],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='stepOnce')return advance(s,inputs,seed);\nif(e.action==='newRun')return fresh(s.k,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-HALF-0.1,Math.min(HALF+0.1,v));\nconst lift=p=>[cl(p[0]),Math.min(K*loss(p[0],p[1]),TOP)+0.05,cl(p[1])];\nfunction aim(dx,dz,shown){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;if(!shown||l<1e-6)return {visible:false};const ux=dx/l,uz=dz/l;return {visible:true,position:[ux*R,0,uz*R],quaternion:[uz*h,0,-ux*h,h],scale:[1,l,1]};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=word(s)==='running',[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate;\nconst p=lift([s.x,s.z]);\nconst r={loss:L,status:word(s),steps:s.step};if(live)r.stepLen=Math.hypot(dx,dz);\nreturn {nodes:{ball:{position:[p[0],p[1]+R,p[2]]},stepArrow:aim(dx*AS,dz*AS,live),slopeArrow:aim(-lr*A*s.x*AS,-lr*C*s.z*AS,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
