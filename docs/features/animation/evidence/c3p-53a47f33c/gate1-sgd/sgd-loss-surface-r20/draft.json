  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.12,H=2,LIM=6,N=40,X0=1,Z0=1.7,SC=2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*91.345+17.17)*24634.6345;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sdOf=b=>1.5*Math.sqrt(Math.max(0,64-b)/(63*b));\nconst out=s=>Math.abs(s.x)>H||Math.abs(s.z)>H||loss(s.x,s.z)>LIM;\nconst word=s=>out(s)?'diverged':s.step>=N?'finished':'running';\nfunction next(s,inp){const sd=sdOf(inp.batchSize),k=s.run*997+s.step*2+1,lr=inp.learningRate;return[-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+0.37))];}\nfunction advance(s,inp){const[dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:X0,z:Z0,step:0,run,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return word(s)==='running'?advance(s,inputs):s;\nif(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return[x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),w=word(s),live=w==='running',[dx,dz]=next(s,inputs),lr=inputs.learningRate;\nconst gx=K*A*s.x,gz=K*C*s.z;\nconst r={steps:s.step,loss:L,status:w};if(live)r.stepLen=Math.hypot(dx,dz);\nreturn{nodes:{ball:{position:[s.x,K*L+R*Math.sqrt(1+gx*gx+gz*gz),s.z]},stepArrow:aim(dx,dz,live),trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
