  "stepped": true,
  "program": {
    "source": "const A=4,C=1,K=0.5,R=0.14,LIM=8,N=40,ST=[0.6,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=(n,q)=>{const s=Math.sin(n*12.9898+q*0.731+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=(n,q)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n,q))))*Math.cos(2*Math.PI*rand(n+0.5,q));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=N?'finished':'running';\nfunction next(s,inp,q){const B=inp.batchSize,sd=2*Math.sqrt(Math.max(0,64-B)/(63*B)),k=s.run*1009+s.step*2+1,lr=inp.learningRate;return [-lr*(A*s.x+sd*gauss(k,q)),-lr*(C*s.z+sd*gauss(k+0.25,q))];}\nfunction adv(s,inp,q){if(word(s)!=='running')return s;const [dx,dz]=next(s,inp,q),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,run,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return e.tick%6?s:adv(s,inputs,seed||0);\nif(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return [x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),w=word(s),live=w==='running',[dx,dz]=next(s,inputs,seed||0),lr=inputs.learningRate;\nconst bx=cl(s.x),bz=cl(s.z);\nreturn {nodes:{ball:{position:[bx,K*loss(bx,bz)+R,bz]},stepArrow:aim(dx,dz,live),trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{loss:L,steps:s.step,stepLen:live?Math.hypot(dx,dz):0,status:w}};}\n"
  },
