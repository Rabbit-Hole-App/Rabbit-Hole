  "program": {
    "source": "const G=9.8,TG=[30,45,18],N=60,D=Math.PI/180;\nfunction fl(s){const r=s.a*D;const vx=s.v*Math.cos(r),vy=s.v*Math.sin(r);return{vx,vy,T:2*vy/G,H:vy*vy/(2*G),R:vx*2*vy/G};}\nfunction pts(s,frac){const f=fl(s);const o=[];const n=Math.max(2,Math.ceil(60*frac));for(let i=0;i<=n;i++){const t=f.T*frac*i/n;o.push([f.vx*t,Math.max(0,f.vy*t-G*t*t/2)+0.3,0]);}return o;}\nfunction over(s){return s.hits>=3||(s.used>=10&&!s.flying);}\nexport function initialState(){return{shot:null,prev:null,k:0,flying:false,used:0,hits:0,ti:0,res:null};}\nexport function reduce({state,event,inputs}){const s=state;\nif(event.type==='action'&&event.action==='launch'){if(s.flying||over(s))return s;return{...s,prev:s.shot,shot:{v:inputs.speed,a:inputs.angle},k:0,flying:true,used:s.used+1};}\nif(event.type==='step'&&s.flying){const k=s.k+1;if(k<N)return{...s,k};const f=fl(s.shot);const tg=TG[s.ti];const m=f.R-tg;const hit=Math.abs(m)<=1.5;return{...s,k:N,flying:false,hits:s.hits+(hit?1:0),ti:s.ti+(hit?1:0),res:{R:f.R,m,T:f.T,H:f.H,hit}};}\nreturn s;}\nexport function evaluate({inputs,state}){const s=state;const th=-(90-inputs.angle)*D;const nodes={pivot:{quaternion:[0,0,Math.sin(th/2),Math.cos(th/2)]}};\nconst done=s.hits>=3;nodes.tgt={position:[TG[Math.min(s.ti,2)],0,0],visible:!done};\nif(s.shot){const frac=s.k/N;const f=fl(s.shot);const t=f.T*frac;nodes.ballN={visible:true,position:[f.vx*t,Math.max(0,f.vy*t-G*t*t/2)+1.4,0]};nodes.trailN={visible:true,points:pts(s.shot,Math.max(frac,0.02))};}else{nodes.ballN={visible:false};nodes.trailN={visible:false};}\nif(s.prev){nodes.ghostN={visible:true,points:pts(s.prev,1)};}else nodes.ghostN={visible:false};\nconst readouts={used:s.used,hits:s.hits};const r=s.res;\nif(r){readouts.dist=r.R;readouts.miss=Math.abs(r.m);readouts.side=r.hit?'hit':(r.m<0?'short':'long');readouts.ftime=r.T;readouts.hmax=r.H;}\nlet goal;if(done)goal={status:'won',message:'All 3 targets hit in '+s.used+' launches!'};\nelse if(over(s))goal={status:'lost',message:'Out of launches: '+s.hits+' of 3 targets hit.'};\nelse goal={status:'playing',message:(s.flying?'In flight... ':(r?(r.hit?'Hit! ':'Miss ('+(r.m<0?'short':'long')+'). '):''))+'Target at '+TG[s.ti]+' m. Launches left: '+(10-s.used)+'.'};\nreturn{nodes,readouts,goal};}"
  },
