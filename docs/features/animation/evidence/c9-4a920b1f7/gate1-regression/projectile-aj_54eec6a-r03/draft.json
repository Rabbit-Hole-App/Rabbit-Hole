  "assumptions": [
    "Simplified simulation: no air resistance, ball starts at ground level on flat ground.",
    "Gravity is 9.8 m/s² straight down; sideways speed stays constant. Landing distance = speed² × sin(2 × angle) ÷ 9.8, flight time = 2 × speed × sin(angle) ÷ 9.8, highest point = (speed × sin(angle))² ÷ 19.6.",
    "The ball is a point for the physics; it is drawn with its centre 1.2 m above the computed point so it never sinks into the field. Trails follow the ball's centre.",
    "Targets come in a fixed order (30 m, 45 m, 18 m); Reset starts the same challenge again, clearing score and both trails.",
    "Every flight is shown over 2 seconds regardless of its real flight time, which the readout gives. Real balls slowed by air land shorter."
  ],
  "program": {
    "source": "const G=9.8,TG=[30,45,18],N=60,R=1.2,D=Math.PI/180;\nfunction pt(a,v,s){const th=a*D,T=2*v*Math.sin(th)/G,t=s*T;return [v*Math.cos(th)*t,Math.max(0,v*Math.sin(th)*t-G*t*t/2)+R,0];}\nfunction arc(a,v,s){const p=[];for(let i=0;i<=40;i++)p.push(pt(a,v,s*i/40));return p;}\nfunction over(s){return s.hits>=3||s.shots>=10;}\nexport function initialState(){return {fly:false,k:0,a:45,v:15,shots:0,hits:0,ti:0,res:null,ga:null,gv:null};}\nexport function reduce({state,event,inputs}){\nif(event.type==='action'&&event.action==='launch'){if(state.fly||over(state))return state;return {...state,fly:true,k:0,a:inputs.angle,v:inputs.speed,ga:state.shots>0?state.a:null,gv:state.shots>0?state.v:null};}\nif(event.type==='step'&&state.fly){const k=state.k+1;if(k<N)return {...state,k};\nconst th=state.a*D,v=state.v,Rg=v*v*Math.sin(2*th)/G,d=Rg-TG[state.ti],hit=Math.abs(d)<=1.5;\nconst res={R:Rg,m:Math.abs(d),side:hit?'hit':d<0?'short':'long',T:2*v*Math.sin(th)/G,H:Math.pow(v*Math.sin(th),2)/(2*G),tx:TG[state.ti]};\nreturn {...state,fly:false,k:N,res,shots:state.shots+1,hits:state.hits+(hit?1:0),ti:Math.min(2,state.ti+(hit?1:0))};}\nreturn state;}\nexport function evaluate({inputs,state}){\nconst s=state,phi=(90-inputs.angle)*D,nodes={};\nnodes.pivot={quaternion:[0,0,Math.sin(-phi/2),Math.cos(-phi/2)]};\nconst shown=s.fly||s.shots>0,f=s.fly?s.k/N:1;\nnodes.ball={position:shown?pt(s.a,s.v,f):[0,R,0]};\nnodes.trail={visible:shown,points:shown?arc(s.a,s.v,f):[]};\nconst g=s.ga!==null;nodes.ghost={visible:g,points:g?arc(s.ga,s.gv,1):[]};\nnodes.target={position:[TG[s.ti],0,0]};\nconst ro={shots:s.shots,hits:s.hits};\nif(s.res){ro.dist=s.res.R;ro.miss=s.res.m;ro.side=s.res.side;ro.ftime=s.res.T;ro.peak=s.res.H;}\nlet st='playing',msg;const left=10-s.shots,nt=TG[s.ti]+' m';\nif(s.hits>=3){st='won';msg='All 3 targets hit in '+s.shots+' launches!';}\nelse if(s.shots>=10){st='lost';msg='Out of launches: '+s.hits+' of 3 targets hit.';}\nelse if(s.fly)msg='In flight...';\nelse if(s.res){msg=(s.res.side==='hit'?'Hit! ':'Missed '+s.res.m.toFixed(1)+' m '+s.res.side+'. ')+'Target at '+nt+', '+left+' launches left.';}\nelse msg='Target at '+nt+'. Set angle and speed, then Launch.';\nreturn {nodes,readouts:ro,goal:{status:st,message:msg}};}\n"
  }
}