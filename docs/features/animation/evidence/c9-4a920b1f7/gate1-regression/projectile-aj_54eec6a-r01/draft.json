  "assumptions": [
    "Simplified simulation: no air resistance, ball starts at ground level on flat ground and is treated as a point.",
    "Gravity is 9.8 m/s² straight down; sideways speed stays constant. Landing distance = speed² × sin(2 × angle) ÷ 9.8, computed exactly.",
    "A hit is a landing within 1.5 m of the target centre, both edges counted. Targets come in fixed order 30 m, 45 m, 18 m; Reset restores this challenge and clears score and arcs.",
    "Every flight is shown over 2 seconds of screen time, so on-screen time does not match the flight-time readout. The ball is drawn larger than real so it is easy to see.",
    "Real balls are slowed by air and land shorter, especially at high speed. The longest shot is about 64 m (25 m/s at 45°)."
  ],
  "program": {
    "source": "const G=9.8,TG=[30,45,18],N=60,R0=1.4;\nconst rad=d=>d*Math.PI/180;\nfunction shot(s){const a=rad(s.a),sa=Math.sin(a);return{a,T:2*s.v*sa/G,R:s.v*s.v*Math.sin(2*a)/G,H:(s.v*sa)**2/(2*G)};}\nfunction pos(s,f){const k=shot(s),t=f*k.T;return[s.v*Math.cos(k.a)*t,s.v*Math.sin(k.a)*t-G*t*t/2+R0,0];}\nfunction arc(s,f){const p=[],n=Math.max(2,Math.ceil(50*f)+1);for(let i=0;i<n;i++)p.push(pos(s,f*i/(n-1)));return p;}\nfunction status(s){if(s.hits>=3)return'won';if(s.shots>=10&&!s.fly)return'lost';return'playing';}\nexport function initialState(){return{shots:0,hits:0,ti:0,fly:false,p:0,cur:null,prev:null,res:null};}\nexport function reduce({state,event,inputs}){const s=state;\nif(event.type==='action'&&event.action==='launch'){if(s.fly||status(s)!=='playing')return s;return{...s,prev:s.cur,cur:{a:inputs.angle,v:inputs.speed},fly:true,p:0};}\nif(event.type==='step'&&s.fly){const p=Math.min(1,s.p+1/N);if(p<1)return{...s,p};\nconst k=shot(s.cur),T=TG[s.ti],m=k.R-T,hit=Math.abs(m)<=1.5;\nreturn{...s,p:1,fly:false,shots:s.shots+1,hits:s.hits+(hit?1:0),ti:hit?Math.min(s.ti+1,2):s.ti,res:{R:k.R,m,hit,T:k.T,H:k.H}};}\nreturn s;}\nexport function evaluate({inputs,state}){const s=state,th=rad(inputs.angle-90)/2;\nconst f=s.fly?s.p:1;\nconst nodes={pivot:{quaternion:[0,0,Math.sin(th),Math.cos(th)]},\nballN:{position:s.cur?pos(s.cur,f):[0,R0,0]},\ncurTrail:{visible:!!s.cur,points:s.cur?arc(s.cur,f):[]},\nprevTrail:{visible:!!s.prev,points:s.prev?arc(s.prev,1):[]},\ntarget:{position:[TG[s.ti],0,0]}};\nconst readouts={shots:s.shots,hits:s.hits};const r=s.res;\nif(r){readouts.dist=r.R;readouts.miss=Math.abs(r.m);readouts.side=r.hit?'hit':(r.m<0?'short':'long');readouts.ftime=r.T;readouts.peak=r.H;}\nconst st=status(s);let msg;\nif(st==='won')msg='You hit all 3 targets in '+s.shots+' launches!';\nelse if(st==='lost')msg='Out of launches: '+s.hits+' of 3 targets hit.';\nelse if(s.fly)msg='Ball in flight...';\nelse msg=(r?(r.hit?'Hit! ':'Missed: '+Math.abs(r.m).toFixed(1)+' m '+(r.m<0?'short. ':'long. ')):'')+'Target at '+TG[s.ti]+' m. '+(10-s.shots)+' launches left.';\nreturn{nodes,readouts,goal:{status:st,message:msg}};}"
  }
