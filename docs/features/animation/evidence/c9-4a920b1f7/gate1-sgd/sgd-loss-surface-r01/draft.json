  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.12,N=64,SIG=2,MAXS=40,LIM=6,S0=[1.2,1.6];\nconst L=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst out=s=>Math.abs(s.x)>2||Math.abs(s.z)>2||L(s.x,s.z)>LIM;\nconst word=s=>out(s)?'diverged':s.step>=MAXS?'finished':'running';\nfunction grad(s,inp,seed){const b=Math.max(1,Math.min(N,inp.batchSize)),sd=SIG*Math.sqrt((N-b)/(N*b)),k=(seed||0)*7919+s.run*1009+s.step*2+1;return [A*s.x+sd*gauss(k),C*s.z+sd*gauss(k+0.5)];}\nfunction advance(s,inp,seed){if(word(s)!=='running')return s;const g=grad(s,inp,seed),lr=inp.learningRate,x=s.x-lr*g[0],z=s.z-lr*g[1];return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:S0[0],z:S0[1],step:0,run,path:[S0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\n if(e.type==='step')return e.tick%6?s:advance(s,inputs,seed);\n if(e.type!=='action')return s;\n if(e.action==='stepOnce')return advance(s,inputs,seed);\n if(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\n return s;}\nconst lift=p=>[p[0],Math.min(K*L(p[0],p[1]),4)+0.05,p[1]];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\n const s=state||initialState(),lr=inputs.learningRate,live=word(s)==='running',g=grad(s,inputs,seed),dx=-lr*g[0],dz=-lr*g[1];\n return {nodes:{ball:{position:[s.x,K*L(s.x,s.z)+R,s.z]},stepArrow:aim(dx,dz,live),trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\n readouts:{steps:s.step,loss:L(s.x,s.z),arrowLen:Math.hypot(dx,dz),status:word(s)}};}\n"
  },
