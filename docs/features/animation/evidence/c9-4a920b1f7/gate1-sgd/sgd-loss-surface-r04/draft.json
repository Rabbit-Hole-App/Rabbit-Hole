  "program": {
    "source": "const A=2.5,C=1,K=0.4,R=0.16,H=2,LIM=5,N=40,S=2,SD=2,ST=[0.6,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst word=s=>(Math.abs(s.x)>H||Math.abs(s.z)>H||loss(s.x,s.z)>LIM?'diverged':s.step>=N?'finished':s.on?'running':'paused');\nconst over=s=>{const w=word(s);return w==='diverged'||w==='finished';};\nfunction next(s,inp){const b=Math.max(1,Math.min(64,Math.round(inp.batchSize))),sd=SD*Math.sqrt((64-b)/(63*b)),k=s.run*1009+s.step*2+7.3,lr=inp.learningRate;\nreturn [-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+0.25))];}\nfunction advance(s,inp){if(over(s))return s;const [dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,run,on:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst lift=p=>[Math.max(-H,Math.min(H,p[0])),Math.min(K*loss(p[0],p[1]),2.8)+0.03,Math.max(-H,Math.min(H,p[1]))];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz)*S,h=Math.SQRT1_2;if(!on||l<1e-6)return {visible:false};const u=l/S;return {visible:true,quaternion:[dz/u*h,0,-dx/u*h,h],scale:[1,l,1]};}\nexport function evaluate({inputs,state}){const s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\nreturn {nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(dx,dz,live),trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{loss:L,steps:s.step,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
