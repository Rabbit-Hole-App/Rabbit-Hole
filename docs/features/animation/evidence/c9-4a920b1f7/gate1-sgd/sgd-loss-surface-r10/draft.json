  "assumptions": [
    "Illustration: a made-up two-setting loss bowl with simulated batch noise, not a real model trained on real data.",
    "Loss = (2.5 x² + z²)/2, drawn at 0.4 × loss over x, z in [-2, 2]. It is steeper along x, so overshoot shows there first: zig-zag above learning rate 0.4, divergence above 0.8.",
    "Step = −learning rate × (true slope + noise). Noise is Gaussian, centred, with size 2·√((64−b)/(63·b)) for batch b: largest at 1, exactly zero at 64.",
    "Arrows are drawn at 2 × their true step length (same scale for both). Orange is the actual mini-batch step; grey is the step the full-data slope would give.",
    "A run ends after 40 steps (finished) or when loss passes 10 (diverged). Running, the ball updates 5 times a second; One update does a single update.",
    "Noise comes from a fixed sequence, so Reset replays it from the start; each new run uses the next noise values."
  ],
  "program": {
    "source": "const A=2.5,C=1,K=0.4,R=0.1,LIM=10,N=40,P0=[1.2,1.6],TOP=2.8,SC=2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s)};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sd=b=>2*Math.sqrt(Math.max(0,64-b)/(63*b));\nconst over=s=>s.div||s.step>=N;\nconst word=s=>s.div?'diverged':s.step>=N?'finished':'running';\nfunction steps(s,inp){const k=s.run*997+s.step*2+1,d=sd(Number(inp.batchSize)),lr=inp.learningRate;\nreturn{m:[-lr*(A*s.x+d*gauss(k)),-lr*(C*s.z+d*gauss(k+0.5))],t:[-lr*A*s.x,-lr*C*s.z]};}\nfunction adv(s,inp){if(over(s))return s;const m=steps(s,inp).m,x=s.x+m[0],z=s.z+m[1];\nreturn{...s,x,z,step:s.step+1,div:loss(x,z)>LIM,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:P0[0],z:P0[1],step:0,run,div:false,path:[P0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return e.tick%6?s:adv(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='stepOnce')return adv(s,inputs);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),TOP)+0.03,p[1]];\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;\nreturn show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,SC*l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),st=steps(s,inputs);\nconst ro={loss:L,steps:s.step,status:word(s)};if(live)ro.stepLen=Math.hypot(st.m[0],st.m[1]);\nreturn{nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(st.m[0],st.m[1],live),\ntrueArrow:aim(st.t[0],st.t[1],live&&!!inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:ro};}\n"
  }
}