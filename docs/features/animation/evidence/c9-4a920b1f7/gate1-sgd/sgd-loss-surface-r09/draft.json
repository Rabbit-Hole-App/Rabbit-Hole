  "program": {
    "source": "const A=3,C=1,K=0.4,R=0.13,S=3,N=40,LIM=6,SIG=2,ST=[1,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>SIG*Math.sqrt(Math.max(0,64-b)/(63*b));\nfunction grads(s,inp,seed){const n=2*(s.k+(seed||0)*101)+1,q=sd(Number(inp.batchSize));return [A*s.x,C*s.z,A*s.x+q*gauss(n),C*s.z+q*gauss(n+0.25)];}\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=N?'finished':'running';\nfunction adv(s,inp,seed){if(word(s)!=='running')return s;const g=grads(s,inp,seed),lr=inp.learningRate,x=s.x-lr*g[2],z=s.z-lr*g[3];return {...s,x,z,step:s.step+1,k:s.k+1,path:s.path.concat([[x,z]])};}\nconst fresh=(k,kept)=>({x:ST[0],z:ST[1],step:0,k,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\n if(e.type==='step')return e.tick%6?s:adv(s,inputs,seed);\n if(e.type!=='action')return s;\n if(e.action==='stepOnce')return adv(s,inputs,seed);\n if(e.action==='newRun')return fresh(s.k,s.step>0?s.path:s.kept);\n return s;\n}\nconst clp=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>[clp(p[0]),Math.min(K*loss(p[0],p[1]),3.2)+0.05,clp(p[1])];\nfunction aim(dx,dz,shown){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l*S,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\n const s=state||initialState(),L=loss(s.x,s.z),live=word(s)==='running',g=grads(s,inputs,seed),lr=inputs.learningRate;\n return {nodes:{ball:{position:[clp(s.x),Math.min(K*L,3.2)+R,clp(s.z)]},stepArrow:aim(-lr*g[2],-lr*g[3],live),trueArrow:aim(-lr*g[0],-lr*g[1],live&&!!inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\n readouts:{steps:s.step,loss:L,stepLen:live?lr*Math.hypot(g[2],g[3]):0,status:word(s)}};\n}\n"
  },
