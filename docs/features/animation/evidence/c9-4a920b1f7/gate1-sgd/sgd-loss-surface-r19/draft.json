  "program": {
    "source": "const A=2.5,C=1,K=0.5,R=0.17,LIM=5,N=40,X0=1.3,Z0=1.7,SC=2.5;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst out=s=>loss(s.x,s.z)>LIM||Math.abs(s.x)>2||Math.abs(s.z)>2;\nconst over=s=>out(s)||s.step>=N;\nconst word=s=>out(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nconst cl=v=>Math.max(-2,Math.min(2,v));\nfunction next(s,inp,seed){const B=Number(inp.batchSize),lr=Number(inp.learningRate),sd=2.5*Math.sqrt(Math.max(0,64-B)/(63*B)),k=(seed||0)*101+s.run*1009+s.step*2+1;return[-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+0.5))];}\nfunction advance(s,inp,seed){if(over(s))return s;const[dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept,on)=>({x:X0,z:Z0,step:0,run,on,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs,seed}){\n if(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\n if(e.type!=='action')return s;\n if(e.action==='run')return over(s)?s:{...s,on:true};\n if(e.action==='pause')return{...s,on:false};\n if(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\n if(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,true);\n return s;}\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return[x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz)*SC,h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[dz*SC/l*h,0,-dx*SC/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\n const s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed),lr=Number(inputs.learningRate),x=cl(s.x),z=cl(s.z);\n const r={steps:s.step,loss:L,status:word(s)};if(live)r.arrowLen=Math.hypot(dx,dz);\n return{nodes:{ball:{position:[x,K*loss(x,z)+R,z]},stepArrow:aim(dx,dz,live),trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&!!inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
