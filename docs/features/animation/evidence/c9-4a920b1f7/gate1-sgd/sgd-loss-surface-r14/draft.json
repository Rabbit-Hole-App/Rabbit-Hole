  "program": {
    "source": "const A=2.5,C=1,K=0.5,R=0.12,S=2,LIM=10,N=40,X0=1.6,Z0=1.6,S0=1.5;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sdOf=b=>b>=64?0:S0*Math.sqrt((64-b)/(63*b));\nfunction next(s,inp){const lr=inp.learningRate,sd=sdOf(Math.round(inp.batchSize)),k=s.run*1009+s.n*2+1;return[-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+0.25))];}\nconst over=s=>s.div||s.n>=N;\nconst word=s=>s.div?'diverged':s.n>=N?'finished':s.on?'running':'paused';\nfunction advance(s,inp){if(over(s))return s;const[dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;return{...s,x,z,n:s.n+1,div:loss(x,z)>LIM,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept,on)=>({x:X0,z:Z0,n:0,run,on,div:false,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.run+1,s.n>0?s.path:s.kept,true);\nreturn s;}\nconst cl=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return[x,Math.min(K*loss(x,z),3.5)+0.04,z];};\nfunction aim(dx,dz,shown){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\nconst bx=cl(s.x),bz=cl(s.z);\nreturn{nodes:{ball:{position:[bx,K*loss(bx,bz)+R,bz]},stepArrow:aim(S*dx,S*dz,live),trueArrow:aim(-S*lr*A*s.x,-S*lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{loss:L,steps:s.n,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
