  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.12,N=40,LIM=8,H=2.3,S0=[1.2,1.8];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+7.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sd=b=>2*Math.sqrt(Math.max(0,64-b)/(63*b));\nfunction moves(s,i){const lr=i.learningRate,k=s.run*997+s.step*3+1,d=sd(i.batchSize),gx=A*s.x,gz=C*s.z;return{t:[-lr*gx,-lr*gz],m:[-lr*(gx+d*gauss(k)),-lr*(gz+d*gauss(k+1.5))]};}\nconst div=s=>loss(s.x,s.z)>LIM;\nconst over=s=>div(s)||s.step>=N;\nconst word=s=>div(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction advance(s,i){if(over(s))return s;const m=moves(s,i).m,x=s.x+m[0],z=s.z+m[1];return{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept,on)=>({x:S0[0],z:S0[1],step:0,run,on,path:[S0],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return !s.on||over(s)||(e.tick||0)%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst cl=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>[cl(p[0]),Math.min(K*loss(p[0],p[1]),4.2)+0.05,cl(p[1])];\nfunction aim(d,show){const l=Math.hypot(d[0],d[1]),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[d[1]/l*h,0,-d[0]/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),mv=moves(s,inputs),len=live?Math.hypot(mv.m[0],mv.m[1]):0;\nreturn{nodes:{ball:{position:[cl(s.x),K*Math.min(L,LIM)+R,cl(s.z)]},stepArrow:aim(mv.m,live),trueArrow:aim(mv.t,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,arrowLen:len,status:word(s)}};}\n"
  },
