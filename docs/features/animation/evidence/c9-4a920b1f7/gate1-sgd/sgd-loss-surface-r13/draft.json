  "program": {
    "source": "const A=2.5,C=1,K=0.5,R=0.12,HALF=2,N=40,SIG=1.5,S=2,START=[-1.2,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst out=s=>Math.abs(s.x)>HALF||Math.abs(s.z)>HALF;\nconst over=s=>out(s)||s.step>=N;\nconst word=s=>out(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nconst sdOf=b=>SIG*Math.sqrt(Math.max(0,(64-b)/(63*b)));\nfunction next(s,inp){const lr=inp.learningRate,sd=sdOf(Number(inp.batchSize)),k=s.run*1009+s.step*2+7.1;\nreturn [-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+0.25))];}\nfunction advance(s,inp){if(over(s))return s;const [dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;\nreturn {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:START[0],z:START[1],step:0,run,on:false,path:[START],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step'){if(!s.on||over(s)||e.tick%6)return s;const n=advance(s,inputs);return over(n)?{...n,on:false}:n;}\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),3.5)+0.04,p[1]];\nfunction aim(dx,dz,shown){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;\nreturn shown&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l*S,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\nconst r={steps:s.step,loss:L,status:word(s)};if(live)r.stepLen=Math.hypot(dx,dz);\nreturn {nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(dx,dz,live),\nfullArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&!!inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
