  "program": {
    "source": "const A=2.5,C=1,K=0.5,R=0.16,HALF=2,LIM=10,N=40,S0=1.5,START=[1.4,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>S0*Math.sqrt(Math.max(0,64-b)/(63*b));\nconst out=s=>Math.abs(s.x)>HALF||Math.abs(s.z)>HALF||loss(s.x,s.z)>LIM;\nconst over=s=>out(s)||s.step>=N;\nconst word=s=>out(s)?'diverged':s.step>=N?'finished':s.step?'running':'ready';\nfunction next(s,inp){const d=sd(Number(inp.batchSize)),k=s.n*2+1,lr=inp.learningRate;return[-lr*(A*s.x+d*gauss(k)),-lr*(C*s.z+d*gauss(k+0.25))];}\nfunction advance(s,inp){if(over(s))return s;const[dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;return{...s,x,z,n:s.n+1,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(n,kept)=>({x:START[0],z:START[1],step:0,n,path:[START],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='stepOnce')return advance(s,inputs);\nif(e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept);\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),3.5)+0.04,p[1]];\nfunction aim(dx,dz,shown){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\nconst gx=K*A*s.x,gz=K*C*s.z,r={steps:s.step,loss:L,status:word(s)};\nif(live)r.stepLen=Math.hypot(dx,dz);\nreturn{nodes:{ball:{position:[s.x,K*L+R*Math.sqrt(1+gx*gx+gz*gz),s.z]},stepArrow:aim(dx,dz,live),trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
