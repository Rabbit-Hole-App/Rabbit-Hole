  "assumptions": [
    "Illustration: a made-up two-setting loss bowl with simulated batch noise, not a real model trained on real data.",
    "The bowl is loss = (2.5 x^2 + z^2) / 2, drawn at 0.4 times the loss over x, z in [-2, 2]. It is steeper along x, so overshoot shows there first; without noise steps diverge along x for learning rates above 0.8.",
    "Each step: ball moves by minus learning rate times (true slope + noise). Noise per component has spread 2*sqrt((64-b)/(63 b)) for batch b, like sampling b of 64 points; exactly 0 at b = 64.",
    "Arrows are drawn at 2 times the true step length (same scale for both). Orange: the mini-batch step the ball takes next. Grey: the step full data would give. Both are hidden when the run has ended.",
    "A run ends as finished after 40 steps, or as diverged when the loss exceeds 6. The trail shows the start plus each of up to 40 landings. Noise comes from a fixed seed, so Reset replays the same sequence.",
    "With noise a step lowers the loss only on average; small batches can raise it on single steps. Very large positions are drawn capped at the bowl's height; the loss readout keeps the true value."
  ],
  "program": {
    "source": "const A=2.5,C=1,K=0.4,R=0.16,N=64,S0=2,MS=40,LIM=6,ST=[1.2,1.5],SC=2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.5));\nconst sdOf=b=>S0*Math.sqrt(Math.max(0,N-b)/((N-1)*b));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=MS?'finished':s.on?'running':'paused';\nconst over=s=>{const w=word(s);return w==='diverged'||w==='finished';};\nfunction grads(s,inp,seed){const sd=sdOf(Number(inp.batchSize)),k=(seed||0)*7.31+s.run*1009+s.step*2+1,gx=A*s.x,gz=C*s.z;return [gx,gz,gx+sd*gauss(k),gz+sd*gauss(k+0.25)];}\nfunction advance(s,inp,seed){if(over(s))return s;const g=grads(s,inp,seed),lr=inp.learningRate,x=s.x-lr*g[2],z=s.z-lr*g[3];return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,run,on:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return {...fresh(s.run+1,s.step>0?s.path:s.kept),on:true};\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),3)+0.04,p[1]];\nfunction aim(dx,dz,shown){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),g=grads(s,inputs,seed),lr=inputs.learningRate;\nconst ro={steps:s.step,loss:L,status:word(s)};\nif(live)ro.stepLen=lr*Math.hypot(g[2],g[3]);\nreturn {nodes:{\nball:{position:[s.x,K*L+R,s.z]},\nstepArrow:aim(-lr*g[2]*SC,-lr*g[3]*SC,live),\nslopeArrow:aim(-lr*g[0]*SC,-lr*g[1]*SC,live&&!!inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},\nghost:{points:s.kept.map(lift)}},readouts:ro};}\n"
  }
}