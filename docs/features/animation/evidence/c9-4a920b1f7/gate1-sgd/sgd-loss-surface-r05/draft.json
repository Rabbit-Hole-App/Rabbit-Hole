  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.12,HALF=2,LIM=8,N=40,S=2,START=[1.2,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=(n,sd)=>{const s=Math.sin(n*12.9898+sd*78.233+1.7)*43758.5453;return s-Math.floor(s);};\nconst gauss=(n,sd)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n,sd))))*Math.cos(2*Math.PI*rand(n+0.5,sd));\nconst noise=b=>b>=64?0:2*Math.sqrt((64-b)/(63*b));\nconst div=s=>loss(s.x,s.z)>LIM||Math.abs(s.x)>HALF||Math.abs(s.z)>HALF;\nconst over=s=>div(s)||s.step>=N;\nconst word=s=>div(s)?'diverged':s.step>=N?'finished':'running';\nfunction next(s,inp,seed){const sd=noise(Math.round(inp.batchSize)),k=s.run*1009+s.step*2+1,lr=inp.learningRate;return[-lr*(A*s.x+sd*gauss(k,seed)),-lr*(C*s.z+sd*gauss(k+0.25,seed))];}\nfunction advance(s,inp,seed){if(over(s))return s;const[dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:START[0],z:START[1],step:0,run,path:[START],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return e.tick%6?s:advance(s,inputs,seed);\nif(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>[cl(p[0]),Math.min(K*loss(p[0],p[1]),4)+0.04,cl(p[1])];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,S*l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate;\nconst px=cl(s.x),pz=cl(s.z),gx=K*A*px,gz=K*C*pz;\nreturn{nodes:{ball:{position:[px,K*loss(px,pz)+R*Math.sqrt(1+gx*gx+gz*gz),pz]},stepArrow:aim(dx,dz,live),slopeArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{loss:L,status:word(s),steps:s.step,stepLen:live?Math.hypot(dx,dz):0}};}\n"
  },
