  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.16,H=2,N=40,LIM=6,S=[0.6,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sdOf=b=>2*Math.sqrt(Math.max(0,64-b)/(63*b));\nfunction step(s,inp,noisy){const sd=noisy?sdOf(Number(inp.batchSize)):0,k=s.run*1000+s.step*2+1,lr=inp.learningRate;return[-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+0.25))];}\nconst off=s=>loss(s.x,s.z)>LIM||Math.abs(s.x)>H||Math.abs(s.z)>H;\nconst word=s=>off(s)?'diverged':s.step>=N?'finished':'running';\nfunction advance(s,inp){if(word(s)!=='running')return s;const[dx,dz]=step(s,inp,true),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:S[0],z:S[1],step:0,run,path:[S],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){if(e.type==='step')return e.tick%4?s:advance(s,inputs);if(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);return s;}\nconst clip=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=clip(p[0]),z=clip(p[1]);return[x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,shown){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){const s=state||initialState(),live=word(s)==='running',[dx,dz]=step(s,inputs,true),[tx,tz]=step(s,inputs,false),cx=clip(s.x),cz=clip(s.z);\nreturn{nodes:{ball:{position:[cx,K*loss(cx,cz)+R,cz]},stepArrow:aim(dx,dz,live),trueArrow:aim(tx,tz,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:{steps:s.step,loss:loss(s.x,s.z),stepLength:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
