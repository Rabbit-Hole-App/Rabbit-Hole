  "assumptions": [
    "Illustration: a made-up two-setting loss bowl with simulated batch noise, not a real model trained on real data.",
    "Loss = (2.5 x^2 + z^2) / 2, drawn at 0.4 times the loss, over x and z from -2 to 2. It is steeper along x, so overshoot shows there first: zig-zag above learning rate 0.4, growing swings above 0.8.",
    "Each step = -learning rate × (true slope + noise). The noise is Gaussian with spread 1.5 × sqrt((64 − b) / (63 b)) for batch size b, so it is 1.5 at b = 1 and exactly 0 at b = 64.",
    "Both arrows are drawn at their true length (scale 1): the orange one is the actual next step, the grey one is the step the full data would give. With noise a step lowers the loss only on average.",
    "Diverged means the ball has left the drawn bowl. That is how the plan's loss limit is applied here. A run also ends as finished after 40 steps. The trail holds the start plus up to 40 steps.",
    "While playing, the ball takes 10 steps per second. Noise comes from the fixed seed, the run number and the step number, so Reset replays the same sequence."
  ],
  "program": {
    "source": "const A=2.5,C=1,K=0.4,R=0.16,HALF=2,N=40,S0=[1.5,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.5));\nconst off=s=>Math.abs(s.x)>HALF||Math.abs(s.z)>HALF;\nconst word=s=>off(s)?'diverged':s.step>=N?'finished':'running';\nfunction next(s,inp,seed){const b=Number(inp.batchSize),sd=1.5*Math.sqrt(Math.max(0,64-b)/(63*b)),k=(seed||0)*131+s.run*997+s.step*2+1,lr=inp.learningRate;\nreturn [-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+0.25)),-lr*A*s.x,-lr*C*s.z];}\nfunction advance(s,inp,seed){if(word(s)!=='running')return s;const d=next(s,inp,seed),x=s.x+d[0],z=s.z+d[1];\nreturn {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:S0[0],z:S0[1],step:0,run,path:[S0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return e.tick%3?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='stepOnce')return advance(s,inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),3)+0.04,p[1]];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;\nreturn on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),w=word(s),live=w==='running',d=next(s,inputs,seed);\nconst ro={loss:L,status:w,steps:s.step};if(live)ro.stepLen=Math.hypot(d[0],d[1]);\nreturn {nodes:{\nball:{position:[s.x,K*L+R*Math.sqrt(1+s.x*s.x+0.16*s.z*s.z),s.z]},\nstepArrow:aim(d[0],d[1],live),\ntrueArrow:aim(d[2],d[3],live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},\nghost:{points:s.kept.map(lift)}},readouts:ro};}\n"
  }
}