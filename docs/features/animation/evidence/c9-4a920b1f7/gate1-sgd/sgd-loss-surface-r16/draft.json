  "assumptions": [
    "Illustration: a made-up two-setting loss bowl with simulated batch noise, not a real model trained on real data.",
    "Loss = (3x² + z²)/2, drawn at height 0.5 × loss over x, z in [-2, 2]. It is 3 times steeper along x, so overshoot shows there first; with no noise, rates above 2/3 diverge.",
    "Step = −learning rate × (true slope + noise). Noise per component is Gaussian with sd 2·√((64−b)/(63·b)) for batch size b: largest at 1, exactly zero at 64.",
    "Arrows are drawn at their true length in bowl units (scale 1): orange is the mini-batch step the ball will take, grey is −learning rate × true slope. Both are hidden when the run has ended.",
    "A run ends after 40 steps (finished) or when the loss exceeds 6, the loss at the bowl's steep edge x = ±2, or the ball leaves the drawn square (diverged).",
    "Noise comes from the fixed seed, run number and step number, so Reset replays the same sequence; each new run uses the next noise values.",
    "The ball moves 5 steps per second while running. Off-surface points are drawn capped at the bowl's edge; the loss readout keeps the true value."
  ],
  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.12,LIM=6,N=40,S0=[1.2,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst sd=b=>b>=64?0:2*Math.sqrt((64-b)/(63*b));\nconst word=s=>s.div?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nconst over=s=>s.div||s.step>=N;\nfunction next(s,inp,seed){const lr=inp.learningRate,d=sd(Math.round(inp.batchSize)),k=(seed||0)*7919+s.run*1009+s.step*2+1;\nreturn [-lr*(A*s.x+d*gauss(k)),-lr*(C*s.z+d*gauss(k+0.25))];}\nfunction advance(s,inp,seed){if(over(s))return s;const [dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;\nconst div=loss(x,z)>LIM||Math.abs(x)>2||Math.abs(z)>2;\nreturn {...s,x,z,div,on:div||s.step+1>=N?false:s.on,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:S0[0],z:S0[1],step:0,run,on:false,div:false,path:[S0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return [x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;\nreturn show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed);\nconst x=cl(s.x),z=cl(s.z),gx=K*A*x,gz=K*C*z,lr=inputs.learningRate;\nreturn {nodes:{ball:{position:[x,K*loss(x,z)+R*Math.sqrt(1+gx*gx+gz*gz),z]},\nstepArrow:aim(dx,dz,live),\ntrueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  }
}