  "program": {
    "source": "const A = 2.5, C = 1, K = 0.5, R = 0.12, N = 40, LIMIT = 6, SIG = 2, START = [1.2, 1.6], TOP = 3.5;\nconst loss = (x, z) => 0.5 * (A * x * x + C * z * z);\nconst rand = n => { const s = Math.sin(n * 12.9898 + 78.233) * 43758.5453; return s - Math.floor(s); };\nconst gauss = n => Math.sqrt(-2 * Math.log(Math.max(1e-9, rand(n)))) * Math.cos(2 * Math.PI * rand(n + 0.5));\nconst word = s => s.div ? 'diverged' : s.step >= N ? 'finished' : s.step === 0 ? 'ready' : 'running';\nconst over = s => s.div || s.step >= N;\nfunction next(s, inputs, seed) {\n  const b = Math.round(inputs.batchSize), sd = SIG * Math.sqrt(Math.max(0, 64 - b) / (63 * b)), k = seed * 7 + s.run * 1009 + s.step * 2 + 1, lr = inputs.learningRate;\n  return [-lr * (A * s.x + sd * gauss(k)), -lr * (C * s.z + sd * gauss(k + 0.25))];\n}\nfunction advance(s, inputs, seed) {\n  if (over(s)) return s;\n  const [dx, dz] = next(s, inputs, seed), x = s.x + dx, z = s.z + dz;\n  return { ...s, x, z, step: s.step + 1, div: loss(x, z) > LIMIT, path: s.path.concat([[x, z]]) };\n}\nconst fresh = (run, kept) => ({ x: START[0], z: START[1], step: 0, run, div: false, path: [START], kept });\nexport function initialState() { return fresh(0, []); }\nexport function reduce({ state: s, event: e, inputs, seed }) {\n  if (e.type === 'step') return e.tick % 4 ? s : advance(s, inputs, seed);\n  if (e.type === 'action' && e.action === 'newRun') return fresh(s.run + 1, s.step > 0 ? s.path : s.kept);\n  return s;\n}\nconst lift = p => [p[0], Math.min(K * loss(p[0], p[1]), TOP) + 0.04, p[1]];\nfunction aim(dx, dz, shown) {\n  const l = Math.hypot(dx, dz), h = Math.SQRT1_2;\n  return shown && l > 1e-6 ? { visible: true, quaternion: [dz / l * h, 0, -dx / l * h, h], scale: [1, l, 1] } : { visible: false };\n}\nexport function evaluate({ inputs, state, seed }) {\n  const s = state || initialState(), L = loss(s.x, s.z), live = !over(s), [dx, dz] = next(s, inputs, seed || 0);\n  const readouts = { loss: L, steps: s.step, status: word(s) };\n  if (live) readouts.stepLen = Math.hypot(dx, dz);\n  return {\n    nodes: {\n      ball: { position: [s.x, K * L + R, s.z] },\n      stepArrow: aim(dx, dz, live),\n      trueArrow: aim(-inputs.learningRate * A * s.x, -inputs.learningRate * C * s.z, live && inputs.showTrueGradient),\n      trail: { points: s.path.map(lift) },\n      ghost: { points: s.kept.map(lift) }\n    },\n    readouts\n  };\n}\n"
  },
  "seed": 7,
