  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.12,S=2,LIM=6,N=40,X0=[0.4,1.7];\nconst L=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*91.345+17.17)*24634.6345;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(6.2832*rnd(n+0.37));\nconst sd=b=>1.5*Math.sqrt(Math.max(0,64-b)/(63*b));\nfunction grads(s,inp,seed){const k=seed*7919+s.run*997+s.step*3+1,d=sd(Number(inp.batchSize)),gx=A*s.x,gz=C*s.z;return{gx,gz,nx:gx+d*gauss(k),nz:gz+d*gauss(k+1.5)};}\nconst done=s=>s.div||s.step>=N;\nconst word=s=>s.div?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction adv(s,inp,seed){if(done(s))return s;const g=grads(s,inp,seed),lr=inp.learningRate,x=s.x-lr*g.nx,z=s.z-lr*g.nz,div=L(x,z)>LIM,step=s.step+1;return{...s,x,z,step,div,on:s.on&&!div&&step<N,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:X0[0],z:X0[1],step:0,run,on:false,div:false,path:[X0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||e.tick%6?s:adv(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return done(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return adv({...s,on:false},inputs,seed);\nif(e.action==='newRun')return{...fresh(s.run+1,s.step>0?s.path:s.kept),on:true};\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*L(p[0],p[1]),4)+0.04,p[1]];\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz)*S,h=Math.SQRT1_2;if(!show||l<1e-6)return{visible:false};const u=dx*S/l,w=dz*S/l;return{visible:true,quaternion:[w*h,0,-u*h,h],scale:[1,l,1]};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),live=!done(s),g=grads(s,inputs,seed),lr=inputs.learningRate,Lv=L(s.x,s.z);\nconst r={loss:Lv,status:word(s),steps:s.step};\nif(live)r.stepLen=lr*Math.hypot(g.nx,g.nz);\nreturn{nodes:{ball:{position:[s.x,K*Lv+R,s.z]},batchArrow:aim(-lr*g.nx,-lr*g.nz,live),fullArrow:aim(-lr*g.gx,-lr*g.gz,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
