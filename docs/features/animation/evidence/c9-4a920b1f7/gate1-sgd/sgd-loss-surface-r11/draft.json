  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.13,S=3,N=40,LIM=6,ST=[0.3,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=(n,sd)=>{const s=Math.sin((n+sd*101)*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=(n,sd)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n,sd))))*Math.cos(2*Math.PI*rand(n+0.5,sd));\nconst noiseSd=b=>b>=64?0:2*Math.sqrt((64-b)/(63*b));\nconst off=s=>Math.abs(s.x)>2||Math.abs(s.z)>2||loss(s.x,s.z)>LIM;\nconst done=s=>off(s)||s.step>=N;\nconst word=s=>off(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction est(s,inp,sd){const b=Math.round(inp.batchSize),k=2*(s.run*N+s.step),d=noiseSd(b),lr=inp.learningRate;\nreturn[-lr*(A*s.x+d*gauss(k,sd)),-lr*(C*s.z+d*gauss(k+1,sd))];}\nfunction advance(s,inp,sd){if(done(s))return s;const[dx,dz]=est(s,inp,sd),x=s.x+dx,z=s.z+dz;\nreturn{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept,on)=>({x:ST[0],z:ST[1],step:0,run,on,path:[ST],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return!s.on||done(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),4)+0.04,p[1]];\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;\nif(!show||l<1e-6)return{visible:false};const ux=dx/l,uz=dz/l;\nreturn{visible:true,position:[ux*R,0,uz*R],quaternion:[uz*h,0,-ux*h,h],scale:[1,S*l,1]};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!done(s),[dx,dz]=est(s,inputs,seed),lr=inputs.learningRate;\nconst ro={loss:L,steps:s.step,status:word(s)};if(live)ro.stepLen=Math.hypot(dx,dz);\nreturn{nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(dx,dz,live),\ntrueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:ro};}\n"
  },
