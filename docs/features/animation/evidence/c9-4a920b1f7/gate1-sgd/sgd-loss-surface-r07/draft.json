  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.16,HALF=2,LIM=8,N=40,S0=[1.2,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst div=s=>Math.abs(s.x)>HALF||Math.abs(s.z)>HALF||loss(s.x,s.z)>LIM;\nconst word=s=>div(s)?'diverged':s.step>=N?'finished':'running';\nconst over=s=>word(s)!=='running';\nfunction next(s,inp,seed){const b=inp.batchSize,lr=inp.learningRate,sd=2*Math.sqrt(Math.max(0,64-b)/(63*b)),k=(seed||0)*7919+s.run*1009+s.step*2+1;return [-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+0.5))];}\nfunction advance(s,inp,seed){if(over(s))return s;const [dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:S0[0],z:S0[1],step:0,run,path:[S0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\n if(e.type==='step')return e.tick%6?s:advance(s,inputs,seed);\n if(e.type!=='action')return s;\n if(e.action==='stepOnce')return advance(s,inputs,seed);\n if(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\n return s;}\nconst cl=v=>Math.max(-2.2,Math.min(2.2,v));\nconst lift=p=>[cl(p[0]),Math.min(K*loss(p[0],p[1]),4)+0.04,cl(p[1])];\nfunction aim(dx,dz,shown){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\n const s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate;\n return {nodes:{\n  ball:{position:[cl(s.x),Math.min(K*L,4)+R,cl(s.z)]},\n  stepArrow:aim(dx,dz,live),\n  fullArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),\n  trail:{points:s.path.map(lift)},\n  ghost:{points:s.kept.map(lift)}},\n readouts:{loss:L,steps:s.step,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
