  "assumptions": [
    "Illustration: a made-up two-setting loss bowl with simulated batch noise, not a real model trained on real data.",
    "Loss = (4x² + z²)/2, drawn at 0.25 × loss over x, z in [-2, 2]. It is 4 times steeper in x, so learning rates above 0.5 overshoot and grow in x (diverge); below 0.5 the bowl is stable without noise.",
    "Noise is Gaussian, centred on the true slope, with size 2·sqrt((64−b)/(63·b)) per setting for batch b: 2 at b=1, exactly 0 at 64 (the whole simulated set). A step lowers the loss only on average.",
    "Both arrows are drawn at 0.3 × the slope size: orange = minus the noisy mini-batch slope (the way the ball moves), grey = minus the true slope. The ball moves learning rate × the orange estimate.",
    "A run ends after 40 steps (finished) or when the ball leaves the drawn bowl or the loss passes 8 (diverged). The ball and trail are held at the bowl edge on screen; the loss readout keeps the true value.",
    "Noise values come from the fixed seed, so Reset replays the same sequence; a new run uses the next noise values. Running advances 5 steps per second at 1× speed."
  ],
  "program": {
    "source": "const A=4,C=1,K=0.25,R=0.13,H=2,TOP=2.5,LIM=8,MAXS=40,S0=[0.6,1.7],AS=0.3;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst bad=s=>Math.abs(s.x)>H||Math.abs(s.z)>H||loss(s.x,s.z)>LIM;\nconst over=s=>bad(s)||s.step>=MAXS;\nconst word=s=>bad(s)?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nfunction grads(s,inputs,seed){const b=Number(inputs.batchSize),sd=2*Math.sqrt(Math.max(0,64-b)/(63*b)),k=(seed||0)*7919+s.run*1009+s.step*2+1,gx=A*s.x,gz=C*s.z;return [gx,gz,gx+sd*gauss(k),gz+sd*gauss(k+0.5)];}\nfunction advance(s,inputs,seed){if(over(s))return s;const g=grads(s,inputs,seed),lr=inputs.learningRate,x=s.x-lr*g[2],z=s.z-lr*g[3];return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:S0[0],z:S0[1],step:0,run,on:false,path:[S0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\n if(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\n if(e.type!=='action')return s;\n if(e.action==='run')return over(s)?s:{...s,on:true};\n if(e.action==='pause')return {...s,on:false};\n if(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\n if(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\n return s;}\nconst cl=v=>Math.max(-2.2,Math.min(2.2,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return [x,Math.min(K*loss(x,z),TOP)+0.05,z];};\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\n const s=state||initialState(),L=loss(s.x,s.z),live=!over(s),g=grads(s,inputs,seed),x=cl(s.x),z=cl(s.z);\n return {nodes:{ball:{position:[x,K*loss(x,z)+R,z]},stepArrow:aim(-AS*g[2],-AS*g[3],live),slopeArrow:aim(-AS*g[0],-AS*g[1],live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\n readouts:{steps:s.step,loss:L,batchSlope:Math.hypot(g[2],g[3]),status:word(s)}};}\n"
  }
}