  "program": {
    "source": "const A=2.5,C=0.5,K=0.5,R=0.16,S=1.5,LIM=5,MAX=40,ST=[1.2,1.7],AS=2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>b>=64?0:S*Math.sqrt((64-b)/(63*b));\nconst word=s=>s.div?'diverged':s.step>=MAX?'finished':s.on?'running':'paused';\nconst over=s=>s.div||s.step>=MAX;\nfunction next(s,inp,seed){const d=sd(Number(inp.batchSize)),k=(seed||0)*7919+s.run*1009+s.step*2+1,lr=inp.learningRate;return [-lr*(A*s.x+d*gauss(k)),-lr*(C*s.z+d*gauss(k+0.25))];}\nfunction advance(s,inp,seed){if(over(s))return s;const [dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;const div=loss(x,z)>LIM||Math.abs(x)>2||Math.abs(z)>2;const t={...s,x,z,div,step:s.step+1,path:s.path.concat([[x,z]]).slice(-MAX)};if(over(t))t.on=false;return t;}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,run,on:false,div:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),3)+0.05,p[1]];\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l*AS,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate;\nconst gx=K*A*s.x,gz=K*C*s.z;\nreturn {nodes:{\nball:{position:[s.x,K*L+R*Math.sqrt(1+gx*gx+gz*gz),s.z]},\nstepArrow:aim(dx,dz,live),\nslopeArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},\nghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
