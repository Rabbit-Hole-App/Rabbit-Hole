  "program": {
    "source": "const A=4,C=1,K=0.4,R=0.16,TOP=4,LIM=12,N=40,S0=2.5,X0=1.2,Z0=1.7;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s)};\nconst gau=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(6.2832*rnd(n+0.37));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=N?'finished':s.step?'running':'ready';\nconst live=s=>word(s)==='running'||word(s)==='ready';\nconst sd=b=>S0*Math.sqrt(Math.max(0,64-b)/(63*b));\nfunction move(s,i,seed){const lr=i.learningRate,d=sd(Number(i.batchSize)),k=(seed||0)*0.013+s.run*997+s.step*3+1;\nreturn{sx:-lr*(A*s.x+d*gau(k)),sz:-lr*(C*s.z+d*gau(k+0.5)),tx:-lr*A*s.x,tz:-lr*C*s.z}}\nconst fresh=(run,kept)=>({x:X0,z:Z0,step:0,run,path:[],kept});\nexport function initialState(){return fresh(0,[])}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step'){if(!live(s)||e.tick%6)return s;const m=move(s,inputs,seed),x=s.x+m.sx,z=s.z+m.sz;\nreturn{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]]).slice(-N)}}\nif(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.path.length?s.path:s.kept);\nreturn s}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),TOP)+0.05,p[1]];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;\nreturn on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false}}\nexport function evaluate({inputs,state,seed}){const s=state||initialState(),L=loss(s.x,s.z),on=live(s),m=move(s,inputs,seed);\nconst gx=K*A*s.x,gz=K*C*s.z,len=on?Math.hypot(m.sx,m.sz):0;\nreturn{nodes:{ball:{position:[s.x,K*L+R*Math.sqrt(1+gx*gx+gz*gz),s.z]},\nstepArrow:aim(m.sx,m.sz,on),trueArrow:aim(m.tx,m.tz,on&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,arrowLen:len,status:word(s)}}}\n"
  },
