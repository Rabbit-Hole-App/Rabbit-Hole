  "assumptions": [
    "Illustration: a made-up two-setting loss bowl with simulated batch noise, not a real model trained on real data.",
    "Loss = (3x² + z²)/2, drawn at half its value as a surface with contours. It is 3 times steeper along x, so overshoot shows there first. Exactly, a step multiplies x by (1 − 3·rate) on average, so rates above 0.67 make it grow and diverge.",
    "Each step = −rate × (true slope + noise). The noise is Gaussian with mean 0 and size 2·√((64−b)/(63·b)) for batch size b, so it is 2 at b=1 and exactly 0 at b=64. Each step lowers the loss only on average.",
    "The orange arrow is the mini-batch step the ball takes. The grey arrow is −rate × the true slope. Both are drawn 2× their true length in bowl units.",
    "A run ends after 40 steps (finished), or as diverged when the loss goes above 8 or the ball leaves the drawn bowl. The ball updates 5 times a second at 1× speed.",
    "Noise comes from a fixed seed and the run number. Reset replays run 0. A new run uses fresh noise values."
  ],
  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.12,N=64,MS=40,LIM=8,S0=2,ST=[0.6,1.7],AS=2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst div=s=>loss(s.x,s.z)>LIM||Math.abs(s.x)>2||Math.abs(s.z)>2;\nconst word=s=>div(s)?'diverged':s.step>=MS?'finished':'running';\nfunction next(s,inp,seed){const b=Number(inp.batchSize),sd=S0*Math.sqrt(Math.max(0,N-b)/((N-1)*b)),k=(seed||0)*7919+s.run*1009+s.step*2+1;\nreturn[-inp.learningRate*(A*s.x+sd*gauss(k)),-inp.learningRate*(C*s.z+sd*gauss(k+0.5))];}\nfunction advance(s,inp,seed){const[dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,run,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return word(s)!=='running'||e.tick%6?s:advance(s,inputs,seed);\nif(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),4)+0.05,p[1]];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;\nreturn on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,AS*l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),w=word(s),live=w==='running',[dx,dz]=next(s,inputs,seed);\nconst gx=K*A*s.x,gz=K*C*s.z,r=inputs.learningRate;\nconst ro={steps:s.step,loss:L,status:w};if(live)ro.arrowLen=Math.hypot(dx,dz);\nreturn{nodes:{ball:{position:[s.x,K*L+R*Math.sqrt(1+gx*gx+gz*gz),s.z]},\nstepArrow:aim(dx,dz,live),trueArrow:aim(-r*A*s.x,-r*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:ro};}\n"
  }
}