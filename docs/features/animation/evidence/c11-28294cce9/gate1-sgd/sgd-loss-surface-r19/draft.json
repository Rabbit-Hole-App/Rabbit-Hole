  "program": {
    "source": "const A=3,C=1,K=0.5,N=40,LIM=6,S0=[0.9,1.7],SC=2.5,SIG=2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sd=b=>b>=64?0:SIG*Math.sqrt((64-b)/(63*b));\nconst over=s=>s.div||s.step>=N;\nconst word=s=>s.div?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction next(s,inp,seed){const k=(seed||0)*7919+s.run*997+s.step*3+1,d=sd(Number(inp.batchSize)),lr=inp.learningRate;return [-lr*(A*s.x+d*gauss(k)),-lr*(C*s.z+d*gauss(k+0.5))];}\nfunction adv(s,inp,seed){if(over(s))return s;const [dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz,div=loss(x,z)>LIM;return {...s,x,z,div,step:s.step+1,on:div||s.step+1>=N?false:s.on,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:S0[0],z:S0[1],step:0,run,on:false,div:false,path:[S0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\n if(e.type==='step')return !s.on||over(s)||e.tick%6?s:adv(s,inputs,seed);\n if(e.type!=='action')return s;\n if(e.action==='run')return over(s)?s:{...s,on:true};\n if(e.action==='pause')return {...s,on:false};\n if(e.action==='stepOnce')return adv({...s,on:false},inputs,seed);\n if(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\n return s;}\nconst rim=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>[rim(p[0]),Math.min(K*loss(p[0],p[1]),4)+0.05,rim(p[1])];\nfunction aim(dx,dz,show){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&v>0?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\n const s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate;\n const r={steps:s.step,loss:L,status:word(s)};if(live)r.stepLen=Math.hypot(dx,dz);\n return {nodes:{ball:{position:[s.x,K*L+0.16,s.z]},stepArrow:aim(dx,dz,live),fullArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
