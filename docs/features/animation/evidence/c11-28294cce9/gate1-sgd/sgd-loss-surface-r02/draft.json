  "program": {
    "source": "const A=4,C=1,K=0.4,R=0.16,H=2,LIM=8,N=40,S0=[1.5,1.7],SC=1.2,SIG=3;\nconst L=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=(n,sd)=>{const s=Math.sin(n*12.9898+sd*78.233+1.7)*43758.5453;return s-Math.floor(s);};\nconst gau=(n,sd)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n,sd))))*Math.cos(2*Math.PI*rnd(n+0.37,sd));\nconst sdv=b=>b>=64?0:SIG*Math.sqrt((64-b)/(63*b));\nfunction nxt(s,i,sd){const lr=i.learningRate,d=sdv(i.batchSize);return [-lr*(A*s.x+d*gau(2*s.k,sd)),-lr*(C*s.z+d*gau(2*s.k+1,sd))];}\nconst div=s=>L(s.x,s.z)>LIM||Math.abs(s.x)>H||Math.abs(s.z)>H;\nconst done=s=>div(s)||s.step>=N;\nconst word=s=>div(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction adv(s,i,sd){if(done(s))return s;const [dx,dz]=nxt(s,i,sd),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,k:s.k+1,path:s.path.concat([[x,z]])};}\nconst fresh=(k,kept)=>({x:S0[0],z:S0[1],step:0,k,on:false,path:[S0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\n if(e.type==='step'){if(!s.on||done(s)||e.tick%6)return s;const n=adv(s,inputs,seed);return done(n)?{...n,on:false}:n;}\n if(e.type!=='action')return s;\n if(e.action==='run')return done(s)?s:{...s,on:true};\n if(e.action==='pause')return {...s,on:false};\n if(e.action==='stepOnce')return adv({...s,on:false},inputs,seed);\n if(e.action==='newRun')return fresh(s.k,s.step>0?s.path:s.kept);\n return s;\n}\nconst cl=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>[cl(p[0]),Math.min(K*L(p[0],p[1]),4)+0.05,cl(p[1])];\nfunction aim(dx,dz,show){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&v>1e-6?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\n const s=state||initialState(),l=L(s.x,s.z),d=div(s),[dx,dz]=nxt(s,inputs,seed),lr=inputs.learningRate;\n const r={loss:l,steps:s.step,status:word(s)};\n if(!d)r.stepLen=Math.hypot(dx,dz);\n return {nodes:{ball:{position:[s.x,K*l+R,s.z]},stepArrow:aim(dx,dz,!d),fullArrow:aim(-lr*A*s.x,-lr*C*s.z,!d&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};\n}\n"
  },
