  "program": {
    "source": "const A=2.5,K=0.4,R=0.12,HALF=2,LIM=6,N=40,S0=1.5,SC=2.5,X0=1.2,Z0=1.6;\nconst loss=(x,z)=>0.5*(A*x*x+z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst out=s=>Math.abs(s.x)>HALF||Math.abs(s.z)>HALF||loss(s.x,s.z)>LIM;\nconst over=s=>out(s)||s.step>=N;\nconst word=s=>out(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nconst sdOf=b=>b>=64?0:S0*Math.sqrt((64-b)/(63*b));\nfunction next(s,inp){const sd=sdOf(Number(inp.batchSize)),k=s.k*2+1,lr=inp.learningRate;return [-lr*(A*s.x+sd*gauss(k)),-lr*(s.z+sd*gauss(k+0.5))];}\nfunction advance(s,inp){if(over(s))return s;const [dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,k:s.k+1,path:s.path.concat([[x,z]])};}\nconst fresh=(k,kept,on)=>({x:X0,z:Z0,step:0,k,on,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs}){\n if(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs);\n if(e.type!=='action')return s;\n if(e.action==='run')return over(s)?s:{...s,on:true};\n if(e.action==='pause')return {...s,on:false};\n if(e.action==='stepOnce')return advance({...s,on:false},inputs);\n if(e.action==='newRun')return fresh(s.k,s.step>0?s.path:s.kept,true);\n return s;}\nconst rim=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>[rim(p[0]),K*loss(rim(p[0]),rim(p[1]))+0.05,rim(p[1])];\nfunction aim(dx,dz,shown){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&v>0?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\n const s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\n return {nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(dx,dz,live),fullArrow:aim(-lr*A*s.x,-lr*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\n readouts:{loss:L,steps:s.step,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
