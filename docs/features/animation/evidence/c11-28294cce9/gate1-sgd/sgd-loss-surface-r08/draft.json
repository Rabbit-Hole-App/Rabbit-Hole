  "program": {
    "source": "const A=2.5,B=1,K=0.2,R=0.16,H=2,LIM=8,N=40,S0=[1.6,1.8],SC=2,SIG=1.5;\nconst loss=(x,z)=>0.5*(A*x*x+B*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nconst over=s=>{const w=word(s);return w==='diverged'||w==='finished';};\nfunction next(s,inp,seed){const b=Math.round(inp.batchSize),sd=b>=64?0:SIG*Math.sqrt((64-b)/(63*b)),k=s.run*1009+s.step*2+1+(seed||0)*0.37;\nreturn [-inp.learningRate*(A*s.x+sd*gauss(k)),-inp.learningRate*(B*s.z+sd*gauss(k+0.25))];}\nfunction advance(s,inp,seed){if(over(s))return s;const d=next(s,inp,seed),x=s.x+d[0],z=s.z+d[1];return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:S0[0],z:S0[1],step:0,run,on:false,path:[S0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step'){if(!s.on||over(s))return s.on&&over(s)?{...s,on:false}:s;return e.tick%6?s:advance(s,inputs,seed);}\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>[rim(p[0]),Math.min(K*loss(p[0],p[1]),2.9)+0.05,rim(p[1])];\nfunction aim(dx,dz,shown){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;\nreturn shown&&v>0?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),d=next(s,inputs,seed),lr=inputs.learningRate;\nreturn {nodes:{ball:{position:[rim(s.x),K*L+R,rim(s.z)]},\nstepArrow:aim(d[0],d[1],live),\nfullArrow:aim(-lr*A*s.x,-lr*B*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{loss:L,steps:s.step,stepLen:live?Math.hypot(d[0],d[1]):0,status:word(s)}};}\n"
  },
