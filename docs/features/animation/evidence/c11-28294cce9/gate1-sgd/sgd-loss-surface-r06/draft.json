  "program": {
    "source": "const A=3,C=1,K=0.25,R=0.1,HALF=2,LIM=6,N=40,S0=2,SC=1.5,ST=[1.3,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=(n,sd)=>{const s=Math.sin(n*12.9898+sd*78.233+1.3)*43758.5453;return s-Math.floor(s);};\nconst gauss=(n,sd)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n,sd))))*Math.cos(2*Math.PI*rnd(n+0.37,sd));\nconst off=s=>Math.abs(s.x)>HALF||Math.abs(s.z)>HALF||loss(s.x,s.z)>LIM;\nconst done=s=>off(s)||s.step>=N;\nconst word=s=>off(s)?'diverged':s.step>=N?'finished':'running';\nconst noiseSd=b=>S0*Math.sqrt(Math.max(0,64-b)/(63*b));\nfunction next(s,inp,seed){const sd=noiseSd(inp.batchSize),k=2*s.n+1,lr=inp.learningRate;return [-lr*(A*s.x+sd*gauss(k,seed)),-lr*(C*s.z+sd*gauss(k+0.5,seed))];}\nfunction advance(s,inp,seed){if(done(s))return s;const [dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,n:s.n+1,path:s.path.concat([[x,z]])};}\nconst fresh=(n,kept)=>({x:ST[0],z:ST[1],step:0,n,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\n if(e.type==='step')return e.tick%6?s:advance(s,inputs,seed);\n if(e.type!=='action')return s;\n if(e.action==='stepOnce')return advance(s,inputs,seed);\n if(e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept);\n return s;\n}\nconst rim=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>[rim(p[0]),Math.min(K*loss(p[0],p[1]),2)+0.04,rim(p[1])];\nfunction aim(dx,dz,show){const v=Math.hypot(dx,dz),len=v*SC,h=Math.SQRT1_2;return show&&len>=0.12?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,len,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\n const s=state||initialState(),L=loss(s.x,s.z),live=!done(s),[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate;\n const r={steps:s.step,loss:L,status:word(s)};\n if(live)r.stepLen=Math.hypot(dx,dz);\n return {nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(dx,dz,live),fullArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};\n}\n"
  },
