  "assumptions": [
    "Illustration: a made-up two-setting loss bowl with simulated batch noise, not a real model trained on real data.",
    "Loss = (3x² + 0.5z²)/2, drawn at half height. It is steeper in x (left-right), so overshoot starts there: x swings grow once learning rate > 2/3.",
    "Each step = −learning rate × (true slope + noise). Noise is random and centred on zero, with spread 1.5·√((64−b)/(63b)): largest at b=1, exactly 0 at b=64.",
    "Both arrows are steps (rate × slope estimate), drawn at 2× their true length with one shared scale. The full-data step is the step all 64 points would give. Arrows hide when the run ends.",
    "A run ends as finished after 40 steps, or as diverged when the loss exceeds 6 or the ball leaves the drawn bowl. Path points off the bowl are drawn at its rim; the loss readout keeps the true value.",
    "Noise comes from a fixed seed, the run number and the step number. Reset replays the same sequence; a new run uses different noise values."
  ],
  "program": {
    "source": "const A=3,C=0.5,K=0.5,R=0.14,H=2,LIM=6,N=40,X0=1,Z0=1.7,SC=2,SIG=1.5;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst out=s=>Math.abs(s.x)>H||Math.abs(s.z)>H||loss(s.x,s.z)>LIM;\nconst over=s=>out(s)||s.step>=N;\nconst word=s=>out(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction steps(s,i,seed){const b=Math.max(1,Number(i.batchSize)),sd=SIG*Math.sqrt(Math.max(0,64-b)/(63*b)),k=(seed||0)*7.1+s.run*101.3+s.step*2.3,lr=Number(i.learningRate);return{m:[-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+1.1))],f:[-lr*A*s.x,-lr*C*s.z]};}\nfunction advance(s,i,seed){if(over(s))return s;const d=steps(s,i,seed).m,x=s.x+d[0],z=s.z+d[1];const n={...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};return over(n)?{...n,on:false}:n;}\nconst fresh=(run,kept)=>({x:X0,z:Z0,step:0,run,on:false,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\n if(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\n if(e.type!=='action')return s;\n if(e.action==='run')return over(s)?s:{...s,on:true};\n if(e.action==='pause')return {...s,on:false};\n if(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\n if(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\n return s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.05,z];};\nfunction aim(d,show){const v=Math.hypot(d[0],d[1]),h=Math.SQRT1_2;if(!show||v<1e-6)return{visible:false};return{visible:true,quaternion:[d[1]/v*h,0,-d[0]/v*h,h],scale:[1,v*SC,1]};}\nexport function evaluate({inputs,state,seed}){\n const s=state||initialState(),L=loss(s.x,s.z),live=!over(s),g=steps(s,inputs,seed);\n const len=live?Math.hypot(g.m[0],g.m[1]):0;\n return{nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(g.m,live),fullArrow:aim(g.f,live&&!!inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\n readouts:{loss:L,status:word(s),steps:s.step,stepLen:len}};}\n"
  }
}