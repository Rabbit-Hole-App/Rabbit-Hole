  "program": {
    "source": "const A=4,C=1,K=0.3,R=0.13,H=2,LIM=10,N=40,S0=[1,1.6],SC=2,SIG=3;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.5));\nconst sdOf=b=>SIG*Math.sqrt(Math.max(0,64-b)/(63*b));\nfunction next(s,inp){const sd=sdOf(Number(inp.batchSize)),k=s.seed*31+s.run*997+s.step*3+1,lr=inp.learningRate;return [-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+1.5))];}\nconst div=s=>loss(s.x,s.z)>LIM;\nconst over=s=>div(s)||s.step>=N;\nconst word=s=>div(s)?'diverged':s.step>=N?'finished':s.on?'running':s.step?'paused':'ready';\nfunction adv(s,inp){if(over(s))return {...s,on:false};const [dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;const t={...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};if(over(t))t.on=false;return t;}\nconst fresh=(seed,run,kept,on)=>({seed,run,kept,on,x:S0[0],z:S0[1],step:0,path:[S0]});\nexport function initialState({seed}){return fresh(seed||0,0,[],false);}\nexport function reduce({state:s,event:e,inputs}){\n if(e.type==='step')return !s.on||e.tick%6?s:adv(s,inputs);\n if(e.type!=='action')return s;\n if(e.action==='run')return over(s)?s:{...s,on:true};\n if(e.action==='pause')return {...s,on:false};\n if(e.action==='stepOnce')return adv({...s,on:false},inputs);\n if(e.action==='newRun')return fresh(s.seed,s.run+1,s.step?s.path:s.kept,true);\n return s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,show){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&v>1e-9?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\n const s=state||initialState({seed:0}),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\n const x=rim(s.x),z=rim(s.z);\n return {nodes:{ball:{position:[x,K*loss(x,z)+R,z]},stepArrow:aim(dx,dz,live),fullArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\n readouts:{loss:L,status:word(s),steps:s.step,stepLen:live?Math.hypot(dx,dz):0}};}\n"
  },
