  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.12,H=2,LIM=8,N=64,MAXS=40,S0=[1.5,1.7],SCALE=2,SD=2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst over=s=>s.div||s.step>=MAXS;\nconst word=s=>s.div?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nconst sdOf=b=>b>=N?0:SD*Math.sqrt((N-b)/(b*(N-1)));\nfunction next(s,inp,seed){const lr=inp.learningRate,sd=sdOf(Math.round(inp.batchSize)),k=s.k*2+seed;return[-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+1))];}\nfunction advance(s,inp,seed){if(over(s))return s;const[dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz,step=s.step+1,div=loss(x,z)>LIM;return{...s,x,z,step,k:s.k+1,div,on:s.on&&!div&&step<MAXS,path:s.path.concat([[x,z]])};}\nconst fresh=(k,kept)=>({x:S0[0],z:S0[1],step:0,k,on:false,div:false,path:[S0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return!s.on||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return{...fresh(s.k,s.step>0?s.path:s.kept),on:true};\nreturn s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>[rim(p[0]),Math.min(K*loss(p[0],p[1]),4)+0.05,rim(p[1])];\nfunction aim(dx,dz,shown){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&v>1e-6?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SCALE,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed||0),lr=inputs.learningRate;\nconst gx=K*A*s.x,gz=K*C*s.z,y=Math.min(K*L,4)+R*Math.sqrt(1+gx*gx+gz*gz);\nconst ro={steps:s.step,loss:L,status:word(s)};if(live)ro.arrowLen=Math.hypot(dx,dz);\nreturn{nodes:{ball:{position:[rim(s.x),y,rim(s.z)]},stepArrow:aim(dx,dz,live),fullArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:ro};}\n"
  },
