  "program": {
    "source": "const A=3,K=0.5,R=0.15,LIM=6,N=40,S0=2,SC=3,X0=[0.5,2.4];\nconst L=(x,z)=>0.5*(A*x*x+z*z);\nconst rnd=(n,sd)=>{const s=Math.sin(n*12.9898+sd*78.233+1.7)*43758.5453;return s-Math.floor(s);};\nconst gs=(n,sd)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n,sd))))*Math.cos(2*Math.PI*rnd(n+0.37,sd));\nconst sdev=b=>b>=64?0:S0*Math.sqrt((64-b)/(63*b));\nconst off=s=>L(s.x,s.z)>LIM||Math.abs(s.x)>2||Math.abs(s.z)>3;\nconst over=s=>off(s)||s.step>=N;\nconst word=s=>off(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction next(s,i,seed){const sd=sdev(Number(i.batchSize)),lr=i.learningRate;return[-lr*(A*s.x+sd*gs(s.k*2+1,seed)),-lr*(s.z+sd*gs(s.k*2+2,seed))];}\nfunction adv(s,i,seed){if(over(s))return s;const d=next(s,i,seed),x=s.x+d[0],z=s.z+d[1];return{...s,x,z,step:s.step+1,k:s.k+1,path:s.path.concat([[x,z]])};}\nconst fresh=(k,kept,on)=>({x:X0[0],z:X0[1],step:0,k,on,path:[X0],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs:i,seed}){\n if(e.type==='step')return !s.on||over(s)||e.tick%6?s:adv(s,i,seed);\n if(e.type!=='action')return s;\n if(e.action==='run')return over(s)?s:{...s,on:true};\n if(e.action==='pause')return{...s,on:false};\n if(e.action==='stepOnce')return adv({...s,on:false},i,seed);\n if(e.action==='newRun')return fresh(s.k,s.step>0?s.path:s.kept,true);\n return s;}\nconst cl=(v,m)=>Math.max(-m,Math.min(m,v));\nconst lift=p=>[cl(p[0],2),Math.min(K*L(p[0],p[1]),5.3)+0.05,cl(p[1],3)];\nfunction aim(dx,dz,shown){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&v>1e-9?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs:i,state,seed}){\n const s=state||initialState(),live=!over(s),d=next(s,i,seed),lr=i.learningRate;\n return{nodes:{ball:{position:[s.x,K*L(s.x,s.z)+R,s.z]},stepArrow:aim(d[0],d[1],live),fullArrow:aim(-lr*A*s.x,-lr*s.z,live&&i.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\n readouts:{loss:L(s.x,s.z),status:word(s),steps:s.step,stepLen:live?Math.hypot(d[0],d[1]):0}};}\n"
  },
