  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.13,LIM=6,N=40,S0=2,SC=2,ST=[1.4,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=(n,sd)=>{const s=Math.sin(n*12.9898+sd*78.233+1.7)*43758.5453;return s-Math.floor(s);};\nconst gauss=(n,sd)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n,sd))))*Math.cos(2*Math.PI*rnd(n+0.37,sd));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nconst over=s=>{const w=word(s);return w==='diverged'||w==='finished';};\nconst sdOf=b=>S0*Math.sqrt(Math.max(0,64-b)/(63*b));\nfunction steps(s,inp,seed){const lr=inp.learningRate,sd=sdOf(Number(inp.batchSize)),gx=A*s.x,gz=C*s.z;return{mb:[-lr*(gx+sd*gauss(2*s.k,seed)),-lr*(gz+sd*gauss(2*s.k+1,seed))],full:[-lr*gx,-lr*gz]};}\nfunction advance(s,inp,seed){if(over(s))return s;const d=steps(s,inp,seed).mb,x=s.x+d[0],z=s.z+d[1];return{...s,x,z,step:s.step+1,k:s.k+1,path:s.path.concat([[x,z]])};}\nconst fresh=(k,kept)=>({x:ST[0],z:ST[1],step:0,k,on:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step'){if(!s.on||e.tick%6)return s;const n=advance(s,inputs,seed);return over(n)?{...n,on:false}:n;}\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.k,s.step>0?s.path:s.kept);\nreturn s;}\nconst rim=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>[rim(p[0]),Math.min(K*loss(p[0],p[1]),4)+0.05,rim(p[1])];\nfunction aim(d,shown){const v=Math.hypot(d[0],d[1]),h=Math.SQRT1_2;return shown&&v>1e-9?{visible:true,quaternion:[d[1]/v*h,0,-d[0]/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),st=steps(s,inputs,seed),v=Math.hypot(st.mb[0],st.mb[1]);\nreturn{nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(st.mb,live),fullArrow:aim(st.full,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{loss:L,steps:s.step,stepLength:live?v:0,status:word(s)}};}\n"
  },
