  "program": {
    "source": "const A=2.5,K=0.4,R=0.13,H=2.5,N=40,S0=1.5,SC=3,ST=[1.2,2];\nconst loss=(x,z)=>0.5*(A*x*x+z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gs=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sd=b=>S0*Math.sqrt(Math.max(0,64-b)/(63*b));\nconst out=s=>Math.abs(s.x)>H||Math.abs(s.z)>H;\nconst over=s=>out(s)||s.step>=N;\nconst word=s=>out(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction next(s,i){const d=sd(Number(i.batchSize)),k=s.n*3+1;return [-i.learningRate*(A*s.x+d*gs(k)),-i.learningRate*(s.z+d*gs(k+1.5))];}\nfunction advance(s,i){if(over(s))return s;const [dx,dz]=next(s,i),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,n:s.n+1,path:s.path.concat([[x,z]])};}\nconst fresh=(n,kept)=>({x:ST[0],z:ST[1],step:0,n,on:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\n if(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs);\n if(e.type!=='action')return s;\n if(e.action==='run')return over(s)?s:{...s,on:true};\n if(e.action==='pause')return {...s,on:false};\n if(e.action==='stepOnce')return advance({...s,on:false},inputs);\n if(e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept);\n return s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,show){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&v>1e-6?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\n const s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\n const r={steps:s.step,loss:L,status:word(s)};if(live)r.stepLen=Math.hypot(dx,dz);\n return {nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(dx,dz,live),fullArrow:aim(-lr*A*s.x,-lr*s.z,live&&!!inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
