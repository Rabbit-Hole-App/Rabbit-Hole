  "program": {
    "source": "const A=4,C=1,K=0.3,R=0.12,HALF=2,TOP=3,LIM=10,N=40,S0=[1.2,1.6],SC=2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst sd=b=>2*Math.sqrt(Math.max(0,64-b)/(63*b));\nfunction next(s,i){const d=sd(Number(i.batchSize)),k=s.run*997+s.step*3+1,lr=i.learningRate;return [-lr*(A*s.x+d*gauss(k)),-lr*(C*s.z+d*gauss(k+1.5))];}\nconst bad=s=>loss(s.x,s.z)>LIM;\nconst over=s=>bad(s)||s.step>=N;\nconst word=s=>bad(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction advance(s,i){if(over(s))return s;const [dx,dz]=next(s,i),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:S0[0],z:S0[1],step:0,run,on:false,path:[S0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\n if(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs);\n if(e.type!=='action')return s;\n if(e.action==='run')return over(s)?s:{...s,on:true};\n if(e.action==='pause')return {...s,on:false};\n if(e.action==='stepOnce')return advance({...s,on:false},inputs);\n if(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\n return s;}\nconst rim=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>[rim(p[0]),Math.min(K*loss(p[0],p[1]),TOP)+0.04,rim(p[1])];\nfunction aim(dx,dz,shown){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&v>1e-9?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\n const s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\n const r={steps:s.step,loss:L,status:word(s)};if(live)r.stepLen=Math.hypot(dx,dz);\n return {nodes:{\n ball:{position:[rim(s.x),Math.min(K*L,TOP)+R,rim(s.z)]},\n stepArrow:aim(dx,dz,live),\n fullArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),\n trail:{points:s.path.map(lift)},\n ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
