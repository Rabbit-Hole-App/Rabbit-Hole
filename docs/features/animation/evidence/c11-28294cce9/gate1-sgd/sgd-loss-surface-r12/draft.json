  "program": {
    "source": "const A=4,K=0.3,R=0.12,HALF=2,LIM=8,N=40,SIG=3,SC=2,S0=[1.5,1.5];\nconst loss=(x,z)=>0.5*(A*x*x+z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst sd=b=>b>=64?0:SIG*Math.sqrt((64-b)/(63*b));\nconst off=s=>Math.abs(s.x)>HALF||Math.abs(s.z)>HALF||loss(s.x,s.z)>LIM;\nconst word=s=>off(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nconst over=s=>off(s)||s.step>=N;\nfunction next(s,inp){const d=sd(Number(inp.batchSize)),k=s.n*2+1,lr=inp.learningRate;return[-lr*(A*s.x+d*gauss(k)),-lr*(s.z+d*gauss(k+0.5))];}\nfunction advance(s,inp){if(over(s))return s;const[dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,n:s.n+1,path:s.path.concat([[x,z]])};}\nconst fresh=(n,kept,on)=>({x:S0[0],z:S0[1],step:0,n,on,path:[S0],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return!s.on||over(s)||e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst rim=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>[rim(p[0]),Math.min(K*loss(p[0],p[1]),3)+0.05,rim(p[1])];\nfunction aim(dx,dz,shown){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&v>1e-6?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\nconst r={loss:L,steps:s.step,status:word(s)};\nif(live)r.stepLen=Math.hypot(dx,dz);\nreturn{nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(dx,dz,live),fullArrow:aim(-lr*A*s.x,-lr*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
  "seed": 7,
