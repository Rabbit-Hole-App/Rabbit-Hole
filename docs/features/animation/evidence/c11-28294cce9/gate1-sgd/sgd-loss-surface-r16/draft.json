  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.12,H=2,LIM=6,N=40,SX=0.8,SZ=1.6,SC=3;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.5));\nconst div=s=>loss(s.x,s.z)>LIM;\nconst over=s=>div(s)||s.step>=N;\nconst word=s=>div(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction next(s,i){const b=Math.round(i.batchSize),sd=2*Math.sqrt(Math.max(0,64-b)/(63*b)),k=s.run*1009+s.step*2+1;\nreturn[-i.learningRate*(A*s.x+sd*gauss(k)),-i.learningRate*(C*s.z+sd*gauss(k+0.25))];}\nfunction adv(s,i){if(over(s))return s;const[dx,dz]=next(s,i),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:SX,z:SZ,step:0,run,on:false,path:[[SX,SZ]],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs:i}){\nif(e.type==='step'){if(!s.on||e.tick%6)return s;const n=adv(s,i);return over(n)?{...n,on:false}:n;}\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return adv({...s,on:false},i);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>[rim(p[0]),Math.min(K*loss(p[0],p[1]),4)+0.05,rim(p[1])];\nfunction aim(dx,dz,show){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;\nreturn show&&v>1e-6?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs:i,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,i);\nreturn{nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(dx,dz,live),\nfullArrow:aim(-i.learningRate*A*s.x,-i.learningRate*C*s.z,live&&i.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{loss:L,steps:s.step,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
