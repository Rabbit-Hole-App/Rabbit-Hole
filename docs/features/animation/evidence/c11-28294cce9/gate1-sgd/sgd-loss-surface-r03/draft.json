  "stepped": true,
  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.12,H=2,LIM=8,MAXS=40,S0=1.5,N=64,SC=2,ST=[-1.2,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=(n,sd)=>{const s=Math.sin(n*12.9898+sd*78.233+1.3)*43758.5453;return s-Math.floor(s);};\nconst gauss=(n,sd)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n,sd))))*Math.cos(2*Math.PI*rnd(n+0.5,sd));\nconst div=s=>Math.abs(s.x)>H||Math.abs(s.z)>H||loss(s.x,s.z)>LIM;\nconst over=s=>div(s)||s.step>=MAXS;\nconst word=s=>div(s)?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nconst noiseSd=b=>S0*Math.sqrt(Math.max(0,N-b)/((N-1)*b));\nfunction next(s,inp,seed){const sd=noiseSd(Number(inp.batchSize)),k=s.n*2+1,lr=inp.learningRate;return [-lr*(A*s.x+sd*gauss(k,seed)),-lr*(C*s.z+sd*gauss(k+0.25,seed))];}\nfunction advance(s,inp,seed){if(over(s))return s;const [dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,n:s.n+1,path:s.path.concat([[x,z]])};}\nconst fresh=(kept,n)=>({x:ST[0],z:ST[1],step:0,n,on:false,path:[ST],kept});\nexport function initialState(){return fresh([],0);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.step>0?s.path:s.kept,s.n);\nreturn s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>[rim(p[0]),Math.min(K*loss(p[0],p[1]),4)+0.05,rim(p[1])];\nfunction aim(dx,dz,show){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&v>1e-6?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate;\nreturn {nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(dx,dz,live),fullArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
