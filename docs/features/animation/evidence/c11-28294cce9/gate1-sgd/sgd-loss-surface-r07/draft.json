  "assumptions": [
    "Illustration: a made-up loss bowl with simulated batch noise, not a real model trained on real data.",
    "Loss = (3x² + z²)/2, drawn at height 0.5 × loss. It is 3 times steeper in x, so with learning rate above 0.67 the x swings grow and the run diverges; above 0.33 it zig-zags.",
    "Step = −learning rate × (slope + noise). Noise is Gaussian, centred on 0, with spread 2·√((64−b)/(63·b)) for batch size b: 2 at b=1, exactly 0 at 64 (all simulated points).",
    "Purple arrow: the mini-batch step the ball takes next. Dark arrow: the full-data step (−learning rate × true slope). Both are drawn 2.5 × their true length, one scale. An arrow shorter than the ball's radius is hidden.",
    "A run ends after 40 steps (finished) or when loss passes 6 (diverged). The trail holds the start plus up to 40 steps. Path points beyond the bowl are drawn at its rim.",
    "Noise comes from a fixed sequence; a new run continues it, so its noise differs. Reset replays it from the start."
  ],
  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.12,H=2,LIM=6,N=40,SC=2.5,SIG=2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sd=b=>SIG*Math.sqrt(Math.max(0,(64-b)/(63*b)));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nconst over=s=>word(s)!=='running'&&word(s)!=='paused';\nfunction next(s,i){const d=sd(Number(i.batchSize)),k=s.n*2+1,lr=i.learningRate;return[-lr*(A*s.x+d*gauss(k)),-lr*(C*s.z+d*gauss(k+0.5))];}\nfunction advance(s,i){if(over(s))return s;const[dx,dz]=next(s,i),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,n:s.n+1,path:s.path.concat([[x,z]])};}\nconst fresh=(n,kept)=>({x:1,z:1.7,step:0,n,on:false,path:[[1,1.7]],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\n if(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs);\n if(e.type!=='action')return s;\n if(e.action==='run')return over(s)?s:{...s,on:true};\n if(e.action==='pause')return{...s,on:false};\n if(e.action==='stepOnce')return advance({...s,on:false},inputs);\n if(e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept);\n return s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return[x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,shown){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&v*SC>R?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\n const s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\n return{nodes:{ball:{position:[rim(s.x),Math.min(K*L,4)+R,rim(s.z)]},stepArrow:aim(dx,dz,live),fullArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\n readouts:{loss:L,steps:s.step,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  }
}