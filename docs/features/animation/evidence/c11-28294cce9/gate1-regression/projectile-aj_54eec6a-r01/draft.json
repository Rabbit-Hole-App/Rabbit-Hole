  "assumptions": [
    "This is a simplified simulation: no air resistance, and the ball starts at ground level on flat ground.",
    "Gravity is 9.8 m/s² straight down; horizontal speed stays constant and only vertical speed changes.",
    "Positions come exactly from the projectile formulas, so landing distance = speed² × sin(2 × angle) ÷ 9.8. The ball is a point; its drawn sphere rests on the ground at that point.",
    "A hit is a landing within 1.5 m of the target centre, both edges counted. Targets come in fixed order 30 m, 45 m, 18 m; Reset clears score and trails.",
    "Each flight is shown over 2 seconds whatever its real flight time; the readout gives the real time. Real balls slowed by air land shorter."
  ],
  "program": {
    "source": "const G=9.8,TG=[30,45,18],N=48,R=1.2,K=60;\nconst rad=d=>d*Math.PI/180;\nconst fT=s=>2*s.v*Math.sin(rad(s.a))/G;\nfunction arc(s,t1){const c=Math.cos(rad(s.a))*s.v,u=Math.sin(rad(s.a))*s.v,p=[];for(let i=0;i<=N;i++){const t=t1*i/N;p.push([c*t,Math.max(0,u*t-G*t*t/2)+R,0]);}return p;}\nconst over=s=>s.hits>=3||(s.shots>=10&&!s.fly);\nexport function initialState(){return{hits:0,shots:0,fly:null,prev:null,last:null};}\nexport function reduce({state,event,inputs}){const s=state;\nif(event.type==='action'&&event.action==='launch'){if(s.fly||over(s))return s;return{...s,fly:{v:inputs.speed,a:inputs.angle,k:0},shots:s.shots+1,prev:s.last?{v:s.last.v,a:s.last.a}:s.prev};}\nif(event.type==='step'&&s.fly){const k=s.fly.k+1;if(k<K)return{...s,fly:{...s.fly,k}};const f=s.fly,d=f.v*f.v*Math.sin(2*rad(f.a))/G,tg=TG[Math.min(s.hits,2)],miss=d-tg,hit=Math.abs(miss)<=1.5;const vy=f.v*Math.sin(rad(f.a));return{...s,fly:null,hits:s.hits+(hit?1:0),last:{v:f.v,a:f.a,d,miss,hit,T:fT(f),H:vy*vy/(2*G)}};}\nreturn s;}\nexport function evaluate({inputs,state}){const s=state,ph=-rad(90-inputs.angle)/2;const nodes={gun:{quaternion:[0,0,Math.sin(ph),Math.cos(ph)]},target:{position:[TG[Math.min(s.hits,2)],0,0]}};\nconst cur=s.fly||s.last;let pts=[[0,R,0]];if(cur){const t1=s.fly?fT(cur)*s.fly.k/K:fT(cur);pts=arc(cur,t1);}\nnodes.ballN={position:pts[pts.length-1]};nodes.trail={visible:!!cur,points:cur?pts:[[0,R,0],[0,R,0]]};\nnodes.ghostTrail={visible:!!s.prev,points:s.prev?arc(s.prev,fT(s.prev)):[[0,R,0],[0,R,0]]};\nconst ro={shots:s.shots,hits:s.hits},L=s.last;if(L){ro.dist=L.d;ro.miss=Math.abs(L.miss);ro.side=L.hit?'hit':(L.miss<0?'short':'long');ro.ft=L.T;ro.h=L.H;}\nlet goal;if(s.hits>=3)goal={status:'won',message:'All 3 targets hit in '+s.shots+' launches!'};else if(over(s))goal={status:'lost',message:'Out of launches: '+s.hits+' of 3 targets hit.'};else goal={status:'playing',message:(L&&!s.fly?(L.hit?'Hit! ':'Missed '+(L.miss<0?'short':'long')+' by '+Math.abs(L.miss).toFixed(1)+' m. '):'')+'Target at '+TG[s.hits]+' m. Launches left: '+(10-s.shots)};\nreturn{nodes,readouts:ro,goal};}"
  }
