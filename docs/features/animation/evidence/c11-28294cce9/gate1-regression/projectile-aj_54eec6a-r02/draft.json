  "assumptions": [
    "Simplified simulation: no air resistance, and the ball starts at ground level on flat ground.",
    "Gravity is 9.8 m/s² straight down; the sideways speed stays constant and only the vertical speed changes.",
    "Positions come exactly from the projectile formulas, so landing distance = speed² × sin(2 × angle) ÷ 9.8. The ball is drawn with its centre one radius above the computed point so it rests on the ground.",
    "A hit is a landing within 1.5 m of the target centre, both edges counted. Targets come in fixed order 30 m, 45 m, 18 m; Reset clears the score and both paths.",
    "Each flight is shown over about two seconds of screen time, so screen time does not match the flight-time readout. Real balls are slowed by air and land shorter."
  ],
  "program": {
    "source": "const G=9.8,TG=[30,45,18],R=1.4,N=60,D=Math.PI/180;\nfunction pts(a,v,p){const r=a*D,c=Math.cos(r),s=Math.sin(r),T=2*v*s/G,k=Math.max(1,Math.ceil(p*N)),o=[];for(let i=0;i<=k;i++){const t=T*p*i/k;o.push([v*c*t,R+Math.max(0,v*s*t-G*t*t/2),0]);}return o;}\nfunction over(s){return s.hits>=3||s.shots>=10;}\nexport function initialState(){return {shots:0,hits:0,fly:false,p:0,shot:null,last:null,res:null};}\nexport function reduce({state,event,inputs}){const s=state;\nif(event.type==='action'&&event.action==='launch'){if(s.fly||over(s))return s;return {...s,fly:true,p:0,last:s.shot,shot:{a:inputs.angle,v:inputs.speed}};}\nif(event.type==='step'&&s.fly){const p=Math.min(1,s.p+1/N);if(p<1)return {...s,p};const a=s.shot.a*D,v=s.shot.v,d=v*v*Math.sin(2*a)/G,tg=TG[s.hits],miss=d-tg,hit=Math.abs(miss)<=1.5+1e-9;return {...s,p:1,fly:false,shots:s.shots+1,hits:s.hits+(hit?1:0),res:{d,miss,hit,tg,T:2*v*Math.sin(a)/G,H:v*v*Math.sin(a)**2/(2*G)}};}\nreturn s;}\nexport function evaluate({inputs,state}){const s=state,a=(s.fly&&s.shot?s.shot.a:inputs.angle),ph=(a-90)*D/2,nodes={pivot:{quaternion:[0,0,Math.sin(ph),Math.cos(ph)]}};\nlet bp=[0,R,0];if(s.shot){const P=pts(s.shot.a,s.shot.v,s.p);bp=P[P.length-1];nodes.trail={visible:true,points:P};}else nodes.trail={visible:false};\nnodes.ball={position:bp};\nif(s.last){nodes.ghost={visible:true,points:pts(s.last.a,s.last.v,1)};}else nodes.ghost={visible:false};\nnodes.target={position:[TG[Math.min(s.hits,2)],0,0]};\nconst ro={shots:s.shots,hits:s.hits},r=s.res;let msg='Target at '+TG[Math.min(s.hits,2)]+' m. Set angle and speed, then Launch.';\nif(r){ro.dist=r.d;ro.miss=Math.abs(r.miss);ro.side=r.hit?'hit':(r.miss<0?'short':'long');ro.ftime=r.T;ro.hmax=r.H;msg=r.hit?'Hit! Landed at '+r.d.toFixed(1)+' m.':'Missed '+ro.side+' by '+ro.miss.toFixed(1)+' m (target '+r.tg+' m).';if(!over(s))msg+=' Next target at '+TG[s.hits]+' m, '+(10-s.shots)+' launches left.';}\nif(s.fly)msg='Ball in flight...';\nlet status='playing';if(!s.fly&&s.hits>=3){status='won';msg='All 3 targets hit in '+s.shots+' launches!';}else if(!s.fly&&s.shots>=10){status='lost';msg='Out of launches: '+s.hits+' of 3 targets hit.';}\nreturn {nodes,readouts:ro,goal:{status,message:msg}};}"
  }
