  "assumptions": [
    "Simplified simulation: no air resistance, and the ball starts at ground level on flat, level ground.",
    "Gravity is 9.8 m/s² straight down; horizontal speed stays constant. Landing distance = speed² × sin(2 × angle) ÷ 9.8, exact in this model; real balls land shorter because of air drag.",
    "The ball is a point for the physics; it is drawn as a 1 m sphere whose centre (and trail) is lifted 1 m so it rests on the ground. Flight ends when it returns to ground height.",
    "Each flight is replayed over 2 seconds of screen time regardless of the flight-time readout. A hit is a landing within 1.5 m of the target centre, both edges counted.",
    "Targets come in a fixed order (30 m, 45 m, 18 m). The longest possible shot is about 63.8 m (25 m/s at 45°). Reset clears score, trails and settings."
  ],
  "program": {
    "source": "const G=9.8,TG=[30,45,18],N=60;\nconst rad=d=>d*Math.PI/180;\nfunction arc(v,a,s,n){const r=rad(a),T=2*v*Math.sin(r)/G,p=[];for(let i=0;i<=n;i++){const t=T*s*i/n;p.push([v*Math.cos(r)*t,1+v*Math.sin(r)*t-G*t*t/2,0]);}return p;}\nexport function initialState(){return {shots:0,hits:0,k:0,fly:false,v:15,a:45,tx:30,last:null,prev:null};}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='action'&&e.action==='launch'){if(s.fly||s.hits>=3||s.shots>=10)return s;return {...s,fly:true,k:0,v:inputs.speed,a:inputs.angle,tx:TG[s.hits],prev:s.last,shots:s.shots+1};}\nif(e.type==='step'&&s.fly){const k=s.k+1;if(k<N)return {...s,k};const r=rad(s.a),d=s.v*s.v*Math.sin(2*r)/G,miss=d-s.tx,hit=Math.abs(miss)<=1.5,vy=s.v*Math.sin(r);return {...s,k:N,fly:false,hits:s.hits+(hit?1:0),last:{v:s.v,a:s.a,d,miss,hit,T:2*vy/G,H:vy*vy/(2*G)}};}\nreturn s;}\nfunction q(a){const t=-(Math.PI/2-rad(a))/2;return [0,0,Math.sin(t),Math.cos(t)];}\nexport function evaluate({inputs,state:s}){\nconst n={},R={shots:s.shots,hits:s.hits},L=s.last;\nn.pivot={quaternion:q(inputs.angle)};\nconst tx=TG[Math.min(s.hits,2)];n.tgt={position:[tx,0,0]};\nlet cur=null;\nif(s.fly){cur=arc(s.v,s.a,s.k/N,40);n.ball={position:cur[cur.length-1]};}\nelse if(L){cur=arc(L.v,L.a,1,40);n.ball={position:[L.d,1,0]};}\nelse n.ball={position:[0,1,0]};\nn.trail=cur&&s.k>0?{visible:true,points:cur}:{visible:false};\nconst pv=s.fly?s.prev:(L?s.prev:null);\nn.ghost=pv?{visible:true,points:arc(pv.v,pv.a,1,40)}:{visible:false};\nif(L){R.dist=L.d;R.miss=Math.abs(L.miss);R.result=L.hit?'Hit':(L.miss<0?'Short':'Long');R.ftime=L.T;R.peak=L.H;}\nlet status='playing',msg;\nif(s.hits>=3){status='won';msg='All 3 targets hit in '+s.shots+' launches!';}\nelse if(s.shots>=10&&!s.fly){status='lost';msg='Out of launches: '+s.hits+' of 3 targets hit.';}\nelse msg=(s.fly?'In flight… ':(L?(L.hit?'Hit! ':(L.miss<0?'Short by ':'Long by ')+Math.abs(L.miss).toFixed(1)+' m. '):''))+'Target at '+tx+' m, '+(10-s.shots)+' launches left.';\nreturn {nodes:n,readouts:R,goal:{status,message:msg}};}"
  }
}