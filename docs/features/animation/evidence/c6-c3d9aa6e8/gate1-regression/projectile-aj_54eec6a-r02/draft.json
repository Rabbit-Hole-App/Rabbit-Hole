  "program": {
    "source": "const G=9.8,D=Math.PI/180,TG=[30,45,18],BR=1.5;\nfunction arc(a,v,t){const r=a*D;return [v*Math.cos(r)*t,Math.max(0,v*Math.sin(r)*t-G*t*t/2)+BR,0];}\nfunction pts(c,t){const p=[];for(let i=0;i<=40;i++)p.push(arc(c.a,c.v,t*i/40));return p;}\nfunction over(s){return s.hits>=3||s.shots>=10;}\nexport function initialState(){return {fly:false,t:0,shots:0,hits:0,cur:null,prev:null,res:null};}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='action'&&e.action==='launch'){if(s.fly||over(s))return s;const a=inputs.angle,v=inputs.speed;const T=2*v*Math.sin(a*D)/G;return {...s,fly:true,t:0,prev:s.cur,cur:{a,v,T}};}\nif(e.type==='step'&&s.fly){const c=s.cur;const t=s.t+c.T/60;if(t<c.T-1e-9)return {...s,t};\nconst R=c.v*c.v*Math.sin(2*c.a*D)/G;const miss=R-TG[s.hits];const hit=Math.abs(miss)<=1.5+1e-9;const sv=c.v*Math.sin(c.a*D);\nreturn {...s,fly:false,t:c.T,shots:s.shots+1,hits:s.hits+(hit?1:0),res:{R,miss,hit,T:c.T,H:sv*sv/(2*G)}};}\nreturn s;}\nexport function evaluate({inputs,state:s}){\nconst th=(inputs.angle-90)*D;const n={pivot:{quaternion:[0,0,Math.sin(th/2),Math.cos(th/2)]}};\nn.target={position:[TG[Math.min(s.hits,2)],0,0],visible:s.hits<3};\nn.ballN={position:s.cur?arc(s.cur.a,s.cur.v,s.t):[0,BR,0]};\nn.trailN=s.cur?{visible:true,points:pts(s.cur,s.t)}:{visible:false,points:[]};\nn.ghostN=s.prev?{visible:true,points:pts(s.prev,s.prev.T)}:{visible:false,points:[]};\nconst r={};const q=s.res;\nif(q){r.range=q.R;r.miss=Math.abs(q.miss);r.side=q.hit?'Hit':(q.miss<0?'Short':'Long');r.ftime=q.T;r.height=q.H;}\nr.shots=s.shots;r.hits=s.hits;\nlet goal;if(s.hits>=3)goal={status:'won',message:'All 3 targets hit in '+s.shots+' launches!'};\nelse if(s.shots>=10)goal={status:'lost',message:'Out of launches: '+s.hits+' of 3 targets hit.'};\nelse goal={status:'playing',message:(q?(q.hit?'Hit! ':q.miss<0?'Short. ':'Long. '):'')+'Target at '+TG[s.hits]+' m. Launches left: '+(10-s.shots)+'.'};\nreturn {nodes:n,readouts:r,goal};}"
  }
