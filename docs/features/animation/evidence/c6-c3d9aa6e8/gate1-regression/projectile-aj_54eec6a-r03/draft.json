  "assumptions": [
    "Simplified simulation: no air resistance, and the ball starts at ground level on flat, level ground.",
    "Gravity is 9.8 m/s² straight down; horizontal speed stays constant. Landing distance = speed² × sin(2 × angle) ÷ 9.8, computed exactly.",
    "The ball is a point for the physics (drawn raised by its radius so it rests on the ground); the flight ends when it returns to ground height.",
    "A hit is a landing within 1.5 m of the target centre, both edges counted. Targets come in fixed order 30 m, 45 m, 18 m; Reset clears score and arcs.",
    "Every flight is shown in 2 seconds of screen time, so screen time does not match the flight-time readout. Longest shot is about 64 m (25 m/s at 45°)."
  ],
  "program": {
    "source": "const G=9.8,TG=[30,45,18],D=Math.PI/180,N=48,BR=1.2;\nfunction shot(a,v){const r=a*D;return{vx:v*Math.cos(r),vy:v*Math.sin(r),T:2*v*Math.sin(r)/G}}\nfunction pt(s,t){return[s.vx*t,s.vy*t-0.5*G*t*t+BR,0]}\nfunction arc(f,p){const s=shot(f.a,f.v),k=Math.max(2,Math.ceil(N*p)),o=[];for(let i=0;i<=k;i++)o.push(pt(s,s.T*p*i/k));return o}\nfunction over(s){return s.hits>=3||s.shots>=10}\nexport function initialState(){return{fly:null,p:0,prev:null,last:null,shots:0,hits:0,ti:0}}\nexport function reduce({state,event,inputs}){const s=state;\nif(event.type==='action'&&event.action==='launch'){if(s.fly||over(s))return s;return{...s,fly:{a:inputs.angle,v:inputs.speed},p:0}}\nif(event.type==='step'&&s.fly){const p=s.p+1/60;if(p<1)return{...s,p};\nconst f=s.fly,sh=shot(f.a,f.v),R=f.v*f.v*Math.sin(2*f.a*D)/G,miss=R-TG[s.ti],hit=Math.abs(miss)<=1.5,hits=s.hits+(hit?1:0);\nreturn{...s,fly:null,p:0,prev:f,shots:s.shots+1,hits,ti:hit&&hits<3?s.ti+1:s.ti,last:{R,miss,hit,T:sh.T,H:sh.vy*sh.vy/(2*G)}}}\nreturn s}\nexport function evaluate({inputs,state}){const s=state,ph=(inputs.angle-90)*D/2,n={},r={shots:s.shots,hits:s.hits};\nn.barrel={quaternion:[0,0,Math.sin(ph),Math.cos(ph)]};\nn.target={position:[TG[s.ti],0,0],visible:s.hits<3};\nif(s.fly){const sh=shot(s.fly.a,s.fly.v);n.ball={visible:true,position:pt(sh,sh.T*s.p)};n.trail={visible:true,points:arc(s.fly,s.p)}}\nelse{n.trail={visible:false,points:[]};n.ball=s.last?{visible:true,position:[s.last.R,BR,0]}:{visible:false}}\nn.ghost=s.prev?{visible:true,points:arc(s.prev,1)}:{visible:false,points:[]};\nconst L=s.last;if(L){r.range=L.R;r.miss=Math.abs(L.miss);r.side=L.hit?'hit':(L.miss<0?'short':'long');r.ftime=L.T;r.height=L.H}\nlet g;if(s.hits>=3)g={status:'won',message:'All 3 targets hit in '+s.shots+' launches!'};\nelse if(s.shots>=10)g={status:'lost',message:'Out of launches: '+s.hits+' of 3 targets hit.'};\nelse g={status:'playing',message:(L?(L.hit?'Hit! ':'Missed '+(L.miss<0?'short':'long')+' by '+Math.abs(L.miss).toFixed(1)+' m. '):'')+'Target at '+TG[s.ti]+' m. Launches left: '+(10-s.shots)+'.'};\nreturn{nodes:n,readouts:r,goal:g}}"
  }
