  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.14,H=2,LIM=8,N=40,S=2,G=2,ST=[0.3,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=(n,q)=>{const s=Math.sin(n*12.9898+q*78.233+1.7)*43758.5453;return s-Math.floor(s);};\nconst gauss=(n,q)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n,q))))*Math.cos(2*Math.PI*rnd(n+0.5,q));\nconst noiseSd=b=>S*Math.sqrt(Math.max(0,64-b)/(63*b));\nconst cl=(v,m)=>Math.max(-m,Math.min(m,v));\nfunction next(s,inp,q){const k=s.run*1000+s.step*2+1,sd=noiseSd(Number(inp.batchSize)),lr=inp.learningRate;return [-lr*(A*s.x+sd*gauss(k,q)),-lr*(C*s.z+sd*gauss(k+1,q))];}\nconst bad=(x,z)=>!(loss(x,z)<=LIM)||Math.abs(x)>H||Math.abs(z)>H;\nconst word=s=>s.div?'diverged':s.step>=N?'finished':'running';\nconst over=s=>s.div||s.step>=N;\nfunction adv(s,inp,q){if(over(s))return s;const [dx,dz]=next(s,inp,q),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,div:bad(x,z),path:s.path.concat([[x,z]]).slice(-N)};}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,run,div:false,path:[],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\n if(e.type==='step')return e.tick%6?s:adv(s,inputs,seed||0);\n if(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.path.length?s.path:s.kept);\n return s;\n}\nconst lift=p=>{const x=cl(p[0],H),z=cl(p[1],H);return [x,Math.min(K*loss(x,z),4)+0.05,z];};\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\n const s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed||0),lr=inputs.learningRate;\n const x=cl(s.x,2.2),z=cl(s.z,2.2),gx=K*A*x,gz=K*C*z;\n return {nodes:{\n  ball:{position:[x,Math.min(K*loss(x,z),4)+R*Math.sqrt(1+gx*gx+gz*gz),z]},\n  stepArrow:aim(G*dx,G*dz,live),\n  trueArrow:aim(-G*lr*A*s.x,-G*lr*C*s.z,live&&inputs.showTrueGradient),\n  trail:{points:s.path.map(lift)},\n  ghost:{points:s.kept.map(lift)}},\n  readouts:{steps:s.step,loss:L,stepLen:Math.hypot(dx,dz),status:word(s)}};\n}\n"
  },
  "seed": 7,
  "camera": {
