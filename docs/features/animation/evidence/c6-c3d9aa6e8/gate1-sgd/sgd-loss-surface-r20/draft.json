  "program": {
    "source": "const A=3,C=1,K=0.4,R=0.12,LIM=8,MAX=40,S0=2,X0=-1.2,Z0=1.6;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=(n,sd)=>{const s=Math.sin(n*12.9898+sd*78.233+1.7)*43758.5453;return s-Math.floor(s);};\nconst gauss=(n,sd)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n,sd))))*Math.cos(2*Math.PI*rand(n+0.5,sd));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=MAX?'finished':s.on?'running':'paused';\nconst over=s=>s.step>=MAX||loss(s.x,s.z)>LIM;\nfunction next(s,inp,sd){const b=Math.round(inp.batchSize),sig=S0*Math.sqrt(Math.max(0,(64-b)/(63*b))),k=s.run*1009+s.step*2+1,lr=inp.learningRate;\nreturn [-lr*(A*s.x+sig*gauss(k,sd)),-lr*(C*s.z+sig*gauss(k+0.25,sd))];}\nfunction advance(s,inp,sd){if(over(s))return s;const [dx,dz]=next(s,inp,sd),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]]).slice(-MAX)};}\nconst fresh=(run,kept)=>({x:X0,z:Z0,step:0,run,on:false,path:[],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='play')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return {...fresh(s.run+1,s.step>0?s.path:s.kept),on:true};\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),3.2)+0.05,p[1]];\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate;\nconst gx=K*A*s.x,gz=K*C*s.z;\nreturn {nodes:{ball:{position:[s.x,K*L+R*Math.sqrt(1+gx*gx+gz*gz),s.z]},stepArrow:aim(dx,dz,live),trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,arrowLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
