  "program": {
    "source": "const A=4,C=1,K=0.25,R=0.12,H=2,LIM=8,N=40,S0=2,ST=[1.3,1.7],AS=2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gs=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sd=b=>S0*Math.sqrt(Math.max(0,64-b)/(63*b));\nconst off=s=>loss(s.x,s.z)>LIM||Math.abs(s.x)>H||Math.abs(s.z)>H;\nconst word=s=>off(s)?'diverged':s.n>=N?'finished':'running';\nfunction next(s,i,seed){const d=sd(i.batchSize),k=s.k*2+(seed||0)*101+1;return[-i.learningRate*(A*s.x+d*gs(k)),-i.learningRate*(C*s.z+d*gs(k+0.5))];}\nconst fresh=(k,kept)=>({x:ST[0],z:ST[1],n:0,k,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step'){if(word(s)!=='running'||e.tick%6)return s;const[dx,dz]=next(s,inputs,seed),x=s.x+dx,z=s.z+dz;return{...s,x,z,n:s.n+1,k:s.k+1,path:s.path.concat([[x,z]]).slice(-41)};}\nif(e.type==='action'&&e.action==='newRun')return fresh(s.k,s.n>0?s.path:s.kept);\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),2.5)+0.04,p[1]];\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l*AS,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=word(s)==='running',[dx,dz]=next(s,inputs,seed);\nreturn{nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(dx,dz,live),trueArrow:aim(-inputs.learningRate*A*s.x,-inputs.learningRate*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.n,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
