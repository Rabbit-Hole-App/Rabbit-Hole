  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.12,S=2,MAXS=40,LIM=8,X0=1,Z0=1.6;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gau=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n+0.1))))*Math.cos(2*Math.PI*rnd(n+0.6));\nconst sd=b=>2*Math.sqrt(Math.max(0,64-b)/(63*b));\nconst cl=v=>Math.max(-2,Math.min(2,v));\nfunction est(s,i,seed){const d=sd(Number(i.batchSize)),k=2*s.n+(seed||0)*101;return[-i.learningRate*(A*s.x+d*gau(k)),-i.learningRate*(C*s.z+d*gau(k+1))];}\nconst fresh=(n,kept)=>({x:X0,z:Z0,step:0,n,word:'running',path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[]);}\nfunction advance(s,i,seed){if(s.word!=='running')return s;const[dx,dz]=est(s,i,seed),x=s.x+dx,z=s.z+dz,step=s.step+1;\nconst word=loss(x,z)>LIM?'diverged':step>=MAXS?'finished':'running';\nreturn{...s,x,z,step,n:s.n+1,word,path:s.path.concat([[x,z]])};}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return e.tick%6?s:advance(s,inputs,seed);\nif(e.type==='action'&&e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept);\nreturn s;}\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return[x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz)*S,h=Math.SQRT1_2;\nreturn on&&l>1e-6?{visible:true,quaternion:[dz*S/l*h,0,-dx*S/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),live=s.word==='running',[dx,dz]=est(s,inputs,seed),x=cl(s.x),z=cl(s.z);\nconst gx=K*A*x,gz=K*C*z;\nreturn{nodes:{ball:{position:[x,K*loss(x,z)+R*Math.sqrt(1+gx*gx+gz*gz),z]},\nstepArrow:aim(dx,dz,live),\nslopeArrow:aim(-inputs.learningRate*A*s.x,-inputs.learningRate*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:loss(s.x,s.z),arrowLen:live?Math.hypot(dx,dz):0,status:s.word}};}\n"
  },
