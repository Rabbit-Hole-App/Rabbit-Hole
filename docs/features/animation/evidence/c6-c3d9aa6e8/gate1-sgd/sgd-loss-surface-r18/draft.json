  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.14,N=64,MAXS=40,LIM=10,S0=[0.8,1.7],SIG=1.5;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst sdOf=b=>SIG*Math.sqrt(Math.max(0,(N-b)/((N-1)*b)));\nfunction next(s,inp,seed){const sd=sdOf(Number(inp.batchSize)),k=(seed||0)*7919+s.run*1009+s.step*2+1,lr=inp.learningRate;return[-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+0.5))];}\nconst word=s=>s.bad?'diverged':s.step>=MAXS?'finished':s.step===0?'ready':'running';\nconst over=s=>s.bad||s.step>=MAXS;\nfunction advance(s,inp,seed){const[dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,bad:loss(x,z)>LIM,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:S0[0],z:S0[1],step:0,t:0,run,bad:false,path:[S0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step'){if(over(s))return s;const t=s.t+1;return s.t%6?{...s,t}:advance({...s,t},inputs,seed);}\nif(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>[cl(p[0]),Math.min(K*loss(p[0],p[1]),4)+0.04,cl(p[1])];\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate;\nconst gx=K*A*s.x,gz=K*C*s.z,len=live?Math.hypot(dx,dz):0;\nreturn{nodes:{\nball:{position:[cl(s.x),Math.min(K*L,4)+R*Math.sqrt(1+gx*gx+gz*gz),cl(s.z)]},\nbatchArrow:aim(dx,dz,live),\nfullArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},\nghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:len,status:word(s)}};}\n"
  },
