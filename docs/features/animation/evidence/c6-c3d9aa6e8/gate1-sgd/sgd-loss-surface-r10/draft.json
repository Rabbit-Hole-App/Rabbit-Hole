  "assumptions": [
    "Illustration: a made-up two-setting loss bowl with simulated batch noise, not a real model trained on real data.",
    "Loss = (3x² + z²)/2, drawn at half height over x, z from -2 to 2. It is 3 times steeper in x, so in x a learning rate above 2/3 overshoots more each step and diverges.",
    "Each update is: step = -learning rate × (true slope + noise). The noise is Gaussian with sd 2·√((64−b)/(63·b)) for batch size b, so it is exactly 0 at b = 64. Noise comes from a fixed seed, run number and step number.",
    "Orange arrow: the mini-batch step, the way the ball moves. Grey arrow: the full-data step (−learning rate × true slope). Both are drawn at 2.5 times their true length. The step-length readout gives the true length.",
    "One update every 3 host clock ticks, so 10 updates a second at speed 1. A run ends after 40 updates (finished), or as diverged when the loss goes above 6 or the ball leaves the bowl.",
    "Trails show the start point plus up to 40 landings. When a run diverges, the ball is drawn at the bowl's rim, and the loss readout keeps its true value."
  ],
  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.16,H=2,LIM=6,N=40,SC=2.5,ST=[0.6,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gs=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(6.283185*rnd(n+0.37));\nconst sd=b=>2*Math.sqrt(Math.max(0,64-b)/(63*b));\nfunction stepOf(s,inp,seed){const k=(seed||0)*7919+s.run*1009+s.step*2+1,d=sd(Number(inp.batchSize)),lr=inp.learningRate;return{m:[-lr*(A*s.x+d*gs(k)),-lr*(C*s.z+d*gs(k+0.5))],t:[-lr*A*s.x,-lr*C*s.z]};}\nconst over=s=>s.div||s.step>=N;\nconst word=s=>s.div?'diverged':s.step>=N?'finished':'running';\nfunction adv(s,inp,seed){if(over(s))return s;const{m}=stepOf(s,inp,seed),x=s.x+m[0],z=s.z+m[1];return{...s,x,z,step:s.step+1,div:loss(x,z)>LIM||Math.abs(x)>H||Math.abs(z)>H,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,run,div:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return e.tick%3?s:adv(s,inputs,seed);\nif(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),4)+0.05,p[1]];\nfunction aim(v,show){const dx=v[0]*SC,dz=v[1]*SC,l=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),{m,t}=stepOf(s,inputs,seed);\nreturn{nodes:{ball:{position:[s.x,K*L+R,s.z]},mArrow:aim(m,live),tArrow:aim(t,live&&!!inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:Math.hypot(m[0],m[1]),status:word(s)}};}\n"
  }
}