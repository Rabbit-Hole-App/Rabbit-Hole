  "program": {
    "source": "const A=4,C=1,K=0.3,R=0.12,S=0.15,LIM=8,MAX=40,X0=0.9,Z0=1.7;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gs=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sdv=b=>2*Math.sqrt((64-b)/(63*b));\nfunction est(s,inputs,seed){const sd=sdv(Number(inputs.batchSize)),k=seed*101+s.n*2+1;return [A*s.x+sd*gs(k),C*s.z+sd*gs(k+0.5)];}\nconst div=s=>loss(s.x,s.z)>LIM;\nconst over=s=>div(s)||s.step>=MAX;\nconst word=s=>div(s)?'diverged':s.step>=MAX?'finished':s.on?'running':'paused';\nfunction adv(s,inputs,seed){if(over(s))return s;const g=est(s,inputs,seed),lr=inputs.learningRate,x=s.x-lr*g[0],z=s.z-lr*g[1];const t={...s,x,z,step:s.step+1,n:s.n+1,path:s.path.concat([[x,z]])};return over(t)?{...t,on:false}:t;}\nconst fresh=(n,kept,on)=>({x:X0,z:Z0,step:0,n,on,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs,seed}){\n if(e.type==='step')return !s.on||over(s)||e.tick%6?s:adv(s,inputs,seed);\n if(e.type!=='action')return s;\n if(e.action==='run')return over(s)?s:{...s,on:true};\n if(e.action==='pause')return {...s,on:false};\n if(e.action==='stepOnce')return adv({...s,on:false},inputs,seed);\n if(e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept,true);\n return s;\n}\nconst cl=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return [x,Math.min(K*loss(x,z),3)+0.04,z];};\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\n const s=state||initialState(),live=!over(s),g=est(s,inputs,seed),bx=cl(s.x),bz=cl(s.z);\n const r={steps:s.step,loss:loss(s.x,s.z),status:word(s)};\n if(live)r.arrowLen=Math.hypot(g[0],g[1]);\n return {nodes:{\n  ball:{position:[bx,K*loss(bx,bz)+R,bz]},\n  miniArrow:aim(-S*g[0],-S*g[1],live),\n  trueArrow:aim(-S*A*s.x,-S*C*s.z,live&&inputs.showTrueGradient),\n  trail:{points:s.path.map(lift)},\n  ghost:{points:s.kept.map(lift)}},\n  readouts:r};\n}\n"
  },
