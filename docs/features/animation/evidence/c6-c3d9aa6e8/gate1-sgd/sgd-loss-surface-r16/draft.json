  "program": {
    "source": "const A=4,C=1,K=0.4,R=0.14,H=2,LIM=12,MAX=40,S=2,X0=1.2,Z0=1.6;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=(n,sd)=>{const v=Math.sin(n*12.9898+sd*78.233+1.7)*43758.5453;return v-Math.floor(v);};\nconst gauss=(n,sd)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n,sd))))*Math.cos(2*Math.PI*rnd(n+0.5,sd));\nconst noiseSd=b=>S*Math.sqrt(Math.max(0,64-b)/(63*b));\nconst div=s=>Math.abs(s.x)>H||Math.abs(s.z)>H||loss(s.x,s.z)>LIM;\nconst ended=s=>div(s)||s.step>=MAX;\nconst word=s=>div(s)?'diverged':s.step>=MAX?'finished':s.on?'running':'paused';\nfunction next(s,inp,seed){const sd=noiseSd(inp.batchSize),lr=inp.learningRate;return [-lr*(A*s.x+sd*gauss(s.n,seed)),-lr*(C*s.z+sd*gauss(s.n+0.25,seed))];}\nfunction advance(s,inp,seed){if(ended(s))return {...s,on:false};const [dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;const t={...s,x,z,step:s.step+1,n:s.n+1,path:s.path.concat([[x,z]]).slice(-MAX)};return ended(t)?{...t,on:false}:t;}\nconst fresh=(n,kept)=>({x:X0,z:Z0,step:0,n,on:false,path:[],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nconst sd=seed||7;\nif(e.type==='step')return !s.on||e.tick%6?s:advance(s,inputs,sd);\nif(e.type!=='action')return s;\nif(e.action==='run')return ended(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,sd);\nif(e.action==='newRun')return {...fresh(s.n,s.path.length?s.path:s.kept),on:true};\nreturn s;}\nconst c=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>[c(p[0]),Math.min(K*loss(p[0],p[1]),4)+0.04,c(p[1])];\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!ended(s),[dx,dz]=next(s,inputs,seed||7),lr=inputs.learningRate;\nconst r={loss:L,steps:s.step,status:word(s)};\nif(live)r.stepLen=Math.hypot(dx,dz);\nreturn {nodes:{ball:{position:[c(s.x),Math.min(K*L,4)+R,c(s.z)]},stepArrow:aim(dx,dz,live),slopeArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
  "seed": 7,
