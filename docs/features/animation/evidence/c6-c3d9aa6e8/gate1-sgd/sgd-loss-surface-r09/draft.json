  "program": {
    "source": "const A=3,C=0.5,K=0.4,R=0.16,H=2,LIM=6,MAXS=40,S0=1.5,SC=2,ST=[1,1.8];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s)};\nconst gau=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.5));\nconst sd=b=>b>=64?0:S0*Math.sqrt((64-b)/(63*b));\nfunction next(s,i,seed){const lr=i.learningRate,d=sd(Number(i.batchSize)),k=(seed||0)*7919+s.n*2+1;return[-lr*(A*s.x+d*gau(k+0.13)),-lr*(C*s.z+d*gau(k+0.71))]}\nconst div=s=>loss(s.x,s.z)>LIM;\nconst over=s=>div(s)||s.step>=MAXS;\nconst word=s=>div(s)?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nfunction advance(s,i,seed){if(over(s))return{...s,on:false};const[dx,dz]=next(s,i,seed);const t={...s,x:s.x+dx,z:s.z+dz,n:s.n+1,step:s.step+1};t.path=s.path.concat([[t.x,t.z]]);if(over(t))t.on=false;return t}\nconst fresh=(n,kept,on)=>({x:ST[0],z:ST[1],step:0,n,on,path:[ST],kept});\nexport function initialState(){return fresh(0,[],false)}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return!s.on||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept,true);\nreturn s}\nconst cl=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return[x,K*loss(x,z)+0.04,z]};\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,SC*l,1]}:{visible:false}}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed),x=cl(s.x),z=cl(s.z);\nconst lr=inputs.learningRate;\nreturn{nodes:{ball:{position:[x,K*loss(x,z)+R,z]},stepArrow:aim(dx,dz,live),slopeArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{loss:L,steps:s.step,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}}}\n"
  },
