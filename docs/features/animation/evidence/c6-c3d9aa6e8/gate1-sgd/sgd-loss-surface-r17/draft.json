  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.12,N=64,MAXS=40,LIM=8,S0=[-1.2,1.5];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gau=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(6.283185*rnd(n+0.5));\nconst over=s=>s.div||s.step>=MAXS;\nconst word=s=>s.div?'diverged':s.step>=MAXS?'finished':'running';\nconst cl=v=>Math.max(-2,Math.min(2,v));\nfunction next(s,i,seed){const b=Number(i.batchSize),sd=b>=N?0:2*Math.sqrt((N-b)/(b*(N-1))),k=s.run*997+s.step*2+1+(seed||0)*13;\nreturn [-i.learningRate*(A*s.x+sd*gau(k)),-i.learningRate*(C*s.z+sd*gau(k+0.25))];}\nfunction adv(s,i,seed){if(over(s))return s;const [dx,dz]=next(s,i,seed),x=s.x+dx,z=s.z+dz,L=loss(x,z);\nreturn {...s,x,z,step:s.step+1,div:!(L<=LIM),path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:S0[0],z:S0[1],step:0,run,div:false,path:[S0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return e.tick%4?s:adv(s,inputs,seed);\nif(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return [x,Math.min(K*loss(x,z),4)+0.05,z];};\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;\nreturn on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed),x=cl(s.x),z=cl(s.z);\nreturn {nodes:{ball:{position:[x,Math.min(K*loss(x,z),4)+R,z]},\nstepArrow:aim(dx,dz,live),\ntrueArrow:aim(-inputs.learningRate*A*s.x,-inputs.learningRate*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
