  "program": {
    "source": "const A=4,C=1,K=0.4,R=0.16,N=64,MX=40,LIM=10,S0=2,ST=[0.7,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=MX?'finished':'running';\nfunction next(s,inp,seed){const B=inp.batchSize,lr=inp.learningRate,sd=B>=N?0:S0*Math.sqrt((N-B)/((N-1)*B)),k=(seed||0)*7.31+s.run*1009+s.step*2+1;\nreturn [-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+0.5))];}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,run,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step'){if(word(s)!=='running')return s;const[dx,dz]=next(s,inputs,seed),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nif(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-2.2,Math.min(2.2,v));\nconst lift=p=>[cl(p[0]),Math.min(K*loss(p[0],p[1]),4)+0.05,cl(p[1])];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=word(s)==='running',[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate;\nconst gx=K*A*s.x,gz=K*C*s.z,r={loss:L,steps:s.step,status:word(s)};\nif(live)r.stepLen=Math.hypot(dx,dz);\nreturn{nodes:{ball:{position:[cl(s.x),K*L+R*Math.sqrt(1+gx*gx+gz*gz),cl(s.z)]},\nstepArrow:aim(dx,dz,live),trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
