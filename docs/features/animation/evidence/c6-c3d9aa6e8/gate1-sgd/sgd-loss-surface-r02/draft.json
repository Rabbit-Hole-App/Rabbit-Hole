  "program": {
    "source": "const A=4,C=1,K=0.4,R=0.13,S=3,N=40,LIM=8,ST=[0.4,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>b>=64?0:2*Math.sqrt((64-b)/(63*b));\nconst out=s=>Math.abs(s.x)>2||Math.abs(s.z)>2||loss(s.x,s.z)>LIM;\nconst over=s=>out(s)||s.step>=N;\nconst word=s=>out(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction next(s,inp,seed){const n=sd(Number(inp.batchSize)),k=(seed||0)*7919+s.run*1009+s.step*2+1,lr=inp.learningRate;return [-lr*(A*s.x+n*gauss(k)),-lr*(C*s.z+n*gauss(k+0.25))];}\nfunction advance(s,inp,seed){if(over(s))return s;const [dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept,on)=>({x:ST[0],z:ST[1],step:0,run,on,path:[ST],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst cl=v=>Math.max(-2.3,Math.min(2.3,v));\nconst lift=p=>[cl(p[0]),Math.min(K*loss(p[0],p[1]),4)+0.05,cl(p[1])];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,S*l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate;\nreturn {nodes:{ball:{position:[cl(s.x),K*L+R,cl(s.z)]},stepArrow:aim(dx,dz,live),trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
