  "program": {
    "source": "const A = 4, B = 1, K = 0.25, R = 0.12, LIM = 8, MAX = 40, S = 2, SIG = 3, START = [0.5, 1.7];\nconst loss = (x, z) => 0.5 * (A * x * x + B * z * z);\nconst rand = n => { const s = Math.sin(n * 12.9898 + 78.233) * 43758.5453; return s - Math.floor(s); };\nconst gauss = n => Math.sqrt(-2 * Math.log(Math.max(1e-9, rand(n)))) * Math.cos(2 * Math.PI * rand(n + 0.37));\nconst diverged = s => loss(s.x, s.z) > LIM;\nconst over = s => diverged(s) || s.step >= MAX;\nconst word = s => diverged(s) ? 'diverged' : s.step >= MAX ? 'finished' : s.on ? 'running' : 'paused';\nfunction next(s, inputs, seed) {\n  const b = Math.round(inputs.batchSize), sd = SIG * Math.sqrt(Math.max(0, 64 - b) / (63 * b)), k = seed * 31 + s.run * 1009 + s.step * 2 + 1, lr = inputs.learningRate;\n  return [-lr * (A * s.x + sd * gauss(k)), -lr * (B * s.z + sd * gauss(k + 0.5))];\n}\nfunction advance(s, inputs, seed) {\n  if (over(s)) return s;\n  const [dx, dz] = next(s, inputs, seed), x = s.x + dx, z = s.z + dz;\n  return { ...s, x, z, step: s.step + 1, path: s.path.concat([[x, z]]) };\n}\nconst fresh = (run, kept) => ({ x: START[0], z: START[1], step: 0, run, on: false, path: [START], kept });\nexport function initialState() { return fresh(0, []); }\nexport function reduce({ state: s, event: e, inputs, seed }) {\n  if (e.type === 'step') return !s.on || over(s) || e.tick % 6 ? s : advance(s, inputs, seed);\n  if (e.type !== 'action') return s;\n  if (e.action === 'run') return over(s) ? s : { ...s, on: true };\n  if (e.action === 'pause') return { ...s, on: false };\n  if (e.action === 'stepOnce') return advance({ ...s, on: false }, inputs, seed);\n  if (e.action === 'newRun') return { ...fresh(s.run + 1, s.step > 0 ? s.path : s.kept), on: true };\n  return s;\n}\nconst lift = p => [p[0], Math.min(K * loss(p[0], p[1]), 2.6) + 0.04, p[1]];\nfunction aim(dx, dz, shown) {\n  const l = Math.hypot(dx, dz), h = Math.SQRT1_2;\n  return shown && l > 1e-6 ? { visible: true, quaternion: [dz / l * h, 0, -dx / l * h, h], scale: [1, S * l, 1] } : { visible: false };\n}\nexport function evaluate({ inputs, state, seed }) {\n  const s = state || initialState(), L = loss(s.x, s.z), live = !over(s), [dx, dz] = next(s, inputs, seed);\n  const gx = K * A * s.x, gz = K * B * s.z, lr = inputs.learningRate;\n  const r = { status: word(s), steps: s.step, loss: L };\n  if (live) r.stepLen = Math.hypot(dx, dz);\n  return {\n    nodes: {\n      ball: { position: [s.x, K * L + R * Math.sqrt(1 + gx * gx + gz * gz), s.z] },\n      stepArrow: aim(dx, dz, live),\n      trueArrow: aim(-lr * A * s.x, -lr * B * s.z, live && inputs.showTrueGradient),\n      trail: { points: s.path.map(lift) },\n      ghost: { points: s.kept.map(lift) }\n    },\n    readouts: r\n  };\n}\n"
  },
  "seed": 7,
