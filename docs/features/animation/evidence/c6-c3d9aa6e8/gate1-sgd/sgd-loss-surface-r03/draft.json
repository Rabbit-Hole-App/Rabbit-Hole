  "assumptions": [
    "Illustration: a made-up two-setting loss bowl with simulated batch noise, not a real model trained on real data.",
    "Loss = (4x² + z²)/2, drawn at 0.4 × loss. It is steeper along x, so overshoot shows there first: with no noise, x swings grow once the learning rate is above 0.5.",
    "Each step = −learning rate × (true slope + noise). Noise has spread 3·√((64−b)/(63b)) for batch size b: largest at 1, exactly zero at 64. The noise is centred on the true slope.",
    "The orange arrow is the next mini-batch step and the grey arrow the full-data step (−learning rate × true slope), both at 2× their true length.",
    "Status: running, finished (40 steps) or diverged (loss above 10, the top of the drawn bowl). The noise comes from a fixed seed, so Reset replays the same sequence. Each new run uses new noise values.",
    "There are 5 updates per second at 1× speed. Changing a setting mid-run affects the following steps. A diverged ball is drawn held at the bowl's edge, and the Loss readout keeps the true value."
  ],
  "program": {
    "source": "const A=4,C=1,K=0.4,R=0.15,N=40,LIM=10,S0=3,G=2,START=[0.9,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=N?'finished':'running';\nfunction next(s,inp,seed){const b=inp.batchSize,sd=S0*Math.sqrt(Math.max(0,64-b)/(63*b)),k=s.run*1009+s.step*2+1+(seed||0)*79,lr=inp.learningRate;return [-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+0.5))];}\nfunction advance(s,inp,seed){if(word(s)!=='running')return s;const [dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]]).slice(-N)};}\nconst fresh=(run,kept)=>({x:START[0],z:START[1],step:0,run,path:[],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\n if(e.type==='step')return e.tick%6?s:advance(s,inputs,seed);\n if(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.path.length?s.path:s.kept);\n return s;}\nconst cl=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return [x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,G*l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\n const s=state||initialState(),L=loss(s.x,s.z),w=word(s),live=w==='running',[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate;\n const x=cl(s.x),z=cl(s.z);\n const r={steps:s.step,loss:L,status:w};\n if(live)r.stepLen=Math.hypot(dx,dz);\n return {nodes:{ball:{position:[x,K*loss(x,z)+R,z]},stepArrow:aim(dx,dz,live),trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  }
}