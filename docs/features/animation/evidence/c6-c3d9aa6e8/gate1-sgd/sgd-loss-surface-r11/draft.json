  "program": {
    "source": "const A=2.5,C=1,K=0.4,TOP=2.8,HALF=2,LIM=5,N=40,S0=1.5,START=[1.2,1.8],D=2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst sd=b=>b>=64?0:S0*Math.sqrt((64-b)/(63*b));\nfunction steps(s,inp){const lr=inp.learningRate,k=7+s.run*1009+s.step*2,e=sd(Number(inp.batchSize));const tx=A*s.x,tz=C*s.z;return{m:[-lr*(tx+e*gauss(k)),-lr*(tz+e*gauss(k+0.5))],t:[-lr*tx,-lr*tz]};}\nconst word=s=>s.div?'diverged':s.step>=N?'finished':s.step>0?'running':'ready';\nconst done=s=>s.div||s.step>=N;\nfunction advance(s,inp){if(done(s))return s;const[dx,dz]=steps(s,inp).m,x=s.x+dx,z=s.z+dz;const div=loss(x,z)>LIM||Math.abs(x)>HALF||Math.abs(z)>HALF;return{...s,x,z,div,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:START[0],z:START[1],step:0,run,div:false,path:[START],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return e.tick%6?s:advance(s,inputs);\nif(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-2.2,Math.min(2.2,v));\nconst lift=p=>[cl(p[0]),Math.min(K*loss(p[0],p[1]),TOP)+0.04,cl(p[1])];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz)*D,h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz*D/l*h,0,-dx*D/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){const s=state||initialState(),L=loss(s.x,s.z),live=!done(s),st=steps(s,inputs);\nreturn{nodes:{ball:{position:[s.x,K*L+0.13,s.z]},stepArrow:aim(st.m[0],st.m[1],live),slopeArrow:aim(st.t[0],st.t[1],live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(st.m[0],st.m[1]):0,status:word(s)}};}\n"
  },
