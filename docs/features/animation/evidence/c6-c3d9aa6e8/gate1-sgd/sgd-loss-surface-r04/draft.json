  "program": {
    "source": "const A=3,C=1,K=0.4,R=0.16,N=64,MAXS=40,LIM=6,S0=2.5,AS=2,START=[1.2,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst sd=b=>S0*Math.sqrt(Math.max(0,(N-b)/((N-1)*b)));\nfunction grads(s,inp,seed){const b=Math.round(Number(inp.batchSize)),k=(seed||0)*31+s.run*997+s.step*2+1,gx=A*s.x,gz=C*s.z;return [gx,gz,gx+sd(b)*gauss(k),gz+sd(b)*gauss(k+0.5)];}\nconst word=s=>s.div?'diverged':s.step>=MAXS?'finished':'running';\nfunction advance(s,inp,seed){if(word(s)!=='running')return s;const g=grads(s,inp,seed),lr=inp.learningRate,x=s.x-lr*g[2],z=s.z-lr*g[3];return {...s,x,z,step:s.step+1,div:loss(x,z)>LIM,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:START[0],z:START[1],step:0,run,div:false,path:[START],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){if(e.type==='step')return e.tick%3?s:advance(s,inputs,seed);if(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);return s;}\nconst cl=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return [x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l*AS,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){const s=state||initialState(),live=word(s)==='running',g=grads(s,inputs,seed),lr=inputs.learningRate,bx=-lr*g[2],bz=-lr*g[3],x=cl(s.x),z=cl(s.z);const r={steps:s.step,loss:loss(s.x,s.z),status:word(s)};if(live)r.stepLen=Math.hypot(bx,bz);return {nodes:{ball:{position:[x,K*loss(x,z)+R,z]},batchArrow:aim(bx,bz,live),fullArrow:aim(-lr*g[0],-lr*g[1],live&&!!inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
