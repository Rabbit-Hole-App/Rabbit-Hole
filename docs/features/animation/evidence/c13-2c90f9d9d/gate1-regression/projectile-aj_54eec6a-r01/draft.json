  "program": {
    "source": "const G=9.8,TG=[30,45,18],N=60,BR=1.2;\nfunction shot(a,v){const r=a*Math.PI/180;const vx=v*Math.cos(r),vy=v*Math.sin(r),T=2*vy/G;return{vx,vy,T,R:vx*T,H:vy*vy/(2*G)};}\nfunction pts(c,p){const k=shot(c.a,c.v);const n=Math.round(p*N);const o=[];for(let i=0;i<=n;i++){const t=i/N*k.T;o.push([k.vx*t,Math.max(0,k.vy*t-G*t*t/2)+BR,0]);}return o;}\nexport function initialState(){return{hits:0,shots:0,ti:0,fly:false,p:0,cur:null,prev:null,res:null};}\nexport function reduce({state,event,inputs}){const s={...state};\nif(event.type==='action'&&event.action==='launch'){if(s.fly||s.hits>=3||s.shots>=10)return state;s.prev=s.cur;s.cur={a:inputs.angle,v:inputs.speed};s.fly=true;s.p=0;return s;}\nif(event.type==='step'&&s.fly){s.p=Math.min(1,s.p+1/N);if(s.p>=1){s.fly=false;const k=shot(s.cur.a,s.cur.v);const m=k.R-TG[s.ti];const hit=Math.abs(m)<=1.5;s.shots++;s.res={R:k.R,m,T:k.T,H:k.H,hit};if(hit){s.hits++;s.ti++;}}return s;}\nreturn state;}\nexport function evaluate({inputs,state}){const s=state;const th=(inputs.angle-90)*Math.PI/180;\nconst nodes={pivot:{quaternion:[0,0,Math.sin(th/2),Math.cos(th/2)]}};\nif(s.cur){const P=pts(s.cur,s.p);nodes.trail={points:P,visible:true};nodes.ball={position:P[P.length-1]};}else{nodes.trail={visible:false,points:[]};nodes.ball={position:[0,BR,0]};}\nif(s.prev){nodes.ghost={points:pts(s.prev,1),visible:true};}else nodes.ghost={visible:false,points:[]};\nconst won=s.hits>=3,lost=!won&&s.shots>=10&&!s.fly;\nnodes.target={position:[TG[Math.min(s.ti,2)],0,0],visible:!won};\nconst ro={used:s.shots,hits:s.hits};\nif(s.res){const r=s.res;ro.dist=r.R;ro.miss=Math.abs(r.m);ro.side=r.hit?'hit':(r.m<0?'short':'long');ro.ftime=r.T;ro.hmax=r.H;}\nlet msg;if(won)msg='You hit all 3 targets in '+s.shots+' launches!';else if(lost)msg='Out of launches: '+s.hits+' of 3 targets hit. Press Reset to try again.';else{msg='Target at '+TG[s.ti]+' m. Launches left: '+(10-s.shots)+'.';if(s.res&&!s.fly)msg=(s.res.hit?'Hit! ':'Missed '+(s.res.m<0?'short':'long')+' by '+Math.abs(s.res.m).toFixed(1)+' m. ')+msg;}\nreturn{nodes,readouts:ro,goal:{status:won?'won':lost?'lost':'playing',message:msg}};}"
  }
