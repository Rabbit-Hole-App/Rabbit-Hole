  "assumptions": [
    "Simplified simulation: no air resistance, and the ball starts at ground level on flat ground.",
    "Gravity is 9.8 m/s² straight down; horizontal speed stays constant and only vertical speed changes. Landing distance = speed² × sin(2 × angle) ÷ 9.8, computed exactly.",
    "The ball is a point for the physics; it is drawn with its bottom on the flight path's height so it rests on the ground when it lands.",
    "A hit is a landing within 1.5 m of the target centre, both edges counted. Targets come in a fixed order (30, 45, 18 m); Reset clears score, trails and settings.",
    "Each flight is played back in about two seconds whatever its real flight time, so screen time differs from the flight-time readout. The faded line is your previous shot.",
    "Longest possible shot is about 63.8 m (25 m/s at 45°). Real balls slowed by air land shorter."
  ],
  "program": {
    "source": "const G=9.8,R=1.4,TG=[30,45,18],N=40;\nfunction arc(a,v,f){const T=2*v*Math.sin(a)/G,p=[];for(let i=0;i<=N;i++){const t=T*f*i/N;p.push([v*Math.cos(a)*t,v*Math.sin(a)*t-G*t*t/2+R,0]);}return p;}\nfunction over(s){return s.hits>=3||s.used>=10;}\nexport function initialState(){return{mode:'ready',tau:0,shot:null,prev:null,used:0,hits:0,ti:0,last:null};}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='action'&&e.action==='launch'){if(s.mode==='flying'||over(s))return s;return{...s,mode:'flying',tau:0,prev:s.shot,shot:{a:inputs.angle*Math.PI/180,v:inputs.speed}};}\nif(e.type==='step'&&s.mode==='flying'){const tau=Math.min(1,s.tau+1/60);if(tau<1)return{...s,tau};\nconst{a,v}=s.shot,d=v*v*Math.sin(2*a)/G,tgt=TG[s.ti],m=d-tgt,hit=Math.abs(m)<=1.5+1e-9,T=2*v*Math.sin(a)/G,h=Math.pow(v*Math.sin(a),2)/(2*G);\nreturn{...s,tau:1,mode:'ready',used:s.used+1,hits:s.hits+(hit?1:0),ti:s.ti+(hit?1:0),last:{d,m,tgt,hit,T,h}};}\nreturn s;}\nexport function evaluate({inputs,state:s}){\nconst th=(inputs.angle-90)*Math.PI/180,nodes={pivot:{quaternion:[0,0,Math.sin(th/2),Math.cos(th/2)]},target:{position:[TG[Math.min(s.ti,2)],0,0]}};\nif(s.shot){const p=arc(s.shot.a,s.shot.v,s.tau);nodes.trail={points:p,visible:true};nodes.ballN={position:p[p.length-1]};}else{nodes.trail={points:[],visible:false};nodes.ballN={position:[0,R,0]};}\nif(s.prev)nodes.ghostN={visible:true,points:arc(s.prev.a,s.prev.v,1)};else nodes.ghostN={visible:false,points:[]};\nconst ro={used:s.used,hits:s.hits},L=s.last;\nif(L){ro.dist=L.d;ro.miss=Math.abs(L.m);ro.side=L.hit?'hit':(L.m<0?'short':'long');ro.tof=L.T;ro.hmax=L.h;}\nlet status='playing',msg;const left=10-s.used;\nif(s.hits>=3){status='won';msg='All 3 targets hit in '+s.used+' launches!';}\nelse if(s.used>=10){status='lost';msg='Out of launches: '+s.hits+' of 3 targets hit.';}\nelse if(s.mode==='flying')msg='Ball in flight...';\nelse{const pre=L?(L.hit?'Hit! ':'Missed by '+Math.abs(L.m).toFixed(1)+' m ('+(L.m<0?'short':'long')+'). '):'';msg=pre+'Target at '+TG[s.ti]+' m. Launches left: '+left+'.';}\nreturn{nodes,readouts:ro,goal:{status,message:msg}};}"
  }
