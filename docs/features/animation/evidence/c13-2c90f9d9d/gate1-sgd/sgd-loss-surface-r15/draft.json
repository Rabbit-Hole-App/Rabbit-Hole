  "program": {
    "source": "const A=2.5,C=0.5,K=0.4,R=0.14,N=64,G0=1.5,SC=2.5,LMAX=6,MAXS=40,X0=0.6,Z0=1.7;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gau=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sd=b=>G0*Math.sqrt(Math.max(0,(N-b)/((N-1)*b)));\nfunction steps(s,inp){const r=inp.learningRate,e=sd(Number(inp.batchSize)),gx=A*s.x,gz=C*s.z;return{full:[-r*gx,-r*gz],mb:[-r*(gx+e*gau(2*s.k+1)),-r*(gz+e*gau(2*s.k+2))]};}\nfunction adv(s,inp){if(s.done)return s;const m=steps(s,inp).mb,x=s.x+m[0],z=s.z+m[1],n=s.n+1,L=loss(x,z),done=L>LMAX?'diverged':n>=MAXS?'finished':null;return{...s,x,z,n,k:s.k+1,path:s.path.concat([[x,z]]),done,on:s.on&&!done};}\nconst fresh=(k,kept)=>({x:X0,z:Z0,n:0,k,on:false,done:null,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return !s.on||s.done||e.tick%6?s:adv(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return s.done?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return adv({...s,on:false},inputs);\nif(e.action==='newRun')return{...fresh(s.k,s.n>0?s.path:s.kept),on:true};\nreturn s;}\nconst rim=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return[x,K*loss(x,z)+0.04,z];};\nfunction aim(d,show){const v=Math.hypot(d[0],d[1]),h=Math.SQRT1_2;if(!show||!(v>0))return{visible:false};const ux=d[0]/v,uz=d[1]/v;return{visible:true,position:[ux*R,0,uz*R],quaternion:[uz*h,0,-ux*h,h],scale:[1,v*SC,1]};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!s.done,st=steps(s,inputs);\nconst ro={loss:L,status:s.done||(s.on?'running':'paused'),steps:s.n};\nif(live)ro.stepLen=Math.hypot(st.mb[0],st.mb[1]);\nreturn{nodes:{ball:{position:[s.x,K*L+R,s.z]},mbArrow:aim(st.mb,live),fullArrow:aim(st.full,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:ro};}\n"
  },
