  "program": {
    "source": "const A=2.4,C=0.6,K=0.5,R=0.16,S=1.2,SC=4,N=40,LIM=6,X0=[0.4,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gs=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sd=b=>b>=64?0:S*Math.sqrt((64-b)/(63*b));\nconst out=s=>Math.abs(s.x)>2||Math.abs(s.z)>2||loss(s.x,s.z)>LIM;\nconst done=s=>out(s)||s.step>=N;\nconst word=s=>out(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction delta(s,inp,noisy){const d=noisy?sd(Number(inp.batchSize)):0,r=inp.learningRate;return[-r*(A*s.x+d*gs(2*s.n+1)),-r*(C*s.z+d*gs(2*s.n+2))];}\nfunction advance(s,inp){if(done(s))return{...s,on:false};const[dx,dz]=delta(s,inp,true);const t={...s,x:s.x+dx,z:s.z+dz,n:s.n+1,step:s.step+1};t.path=s.path.concat([[t.x,t.z]]);if(done(t))t.on=false;return t;}\nconst fresh=(n,kept,on)=>({x:X0[0],z:X0[1],step:0,n,on,path:[X0],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return!s.on||e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return done(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst rim=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return[x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,show){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&v>1e-6?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!done(s),[dx,dz]=delta(s,inputs,true),[fx,fz]=delta(s,inputs,false),x=rim(s.x),z=rim(s.z);\nreturn{nodes:{ball:{position:[x,K*loss(x,z)+R,z]},stepArrow:aim(dx,dz,live),fullArrow:aim(fx,fz,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
