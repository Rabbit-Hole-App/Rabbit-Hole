  "program": {
    "source": "const A=2.5,C=0.6,K=0.4,R=0.12,N=40,LIM=5,S0=[1,1.7],SIG=1.5,SC=3,H=2;\nconst L=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=(n,sd)=>{const s=Math.sin(n*12.9898+sd*78.233+1.7)*43758.5453;return s-Math.floor(s);};\nconst gau=(n,sd)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n,sd))))*Math.cos(6.2832*rnd(n+0.37,sd));\nconst sdv=b=>b>=64?0:SIG*Math.sqrt((64-b)/(63*b));\nfunction next(s,inp){const sd=sdv(Number(inp.batchSize)),r=inp.learningRate;return[-r*(A*s.x+sd*gau(s.k,s.seed)),-r*(C*s.z+sd*gau(s.k+1,s.seed))];}\nconst word=s=>L(s.x,s.z)>LIM?'diverged':s.n>=N?'finished':'running';\nconst over=s=>word(s)!=='running';\nfunction advance(s,inp){if(over(s))return s;const[dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;return{...s,x,z,n:s.n+1,k:s.k+2,path:s.path.concat([[x,z]])};}\nconst fresh=(seed,k,kept)=>({x:S0[0],z:S0[1],n:0,k,seed,path:[S0],kept});\nexport function initialState({seed}){return fresh(seed||0,0,[]);}\nexport function reduce({state:s,event:e,inputs}){\n if(e.type==='step')return e.tick%6?s:advance(s,inputs);\n if(e.type==='action'&&e.action==='newRun')return fresh(s.seed,s.k,s.n>0?s.path:s.kept);\n return s;}\nconst cl=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return[x,K*L(x,z)+0.03,z];};\nfunction aim(dx,dz,show){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&v>1e-9?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\n const s=state||initialState({seed:7}),live=!over(s),[dx,dz]=next(s,inputs),r=inputs.learningRate;\n const bx=cl(s.x),bz=cl(s.z);\n return{nodes:{ball:{position:[bx,K*L(bx,bz)+R,bz]},stepArrow:aim(dx,dz,live),fullArrow:aim(-r*A*s.x,-r*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\n readouts:{steps:s.n,loss:L(s.x,s.z),stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
