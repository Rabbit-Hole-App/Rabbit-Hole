  "program": {
    "source": "const A=2.4,C=0.5,K=0.5,R=0.16,HALF=2,LIMIT=4.8,MAXS=40,START=[0.4,1.8],SCALE=6,LONG=3;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst sdOf=b=>b>=64?0:Math.sqrt((64-b)/(63*b));\nfunction grads(s,inputs,seed){const sd=sdOf(Math.round(inputs.batchSize)),k=(seed||0)*7919+s.run*1009+s.step*2+1,gx=A*s.x,gz=C*s.z;return [gx,gz,gx+sd*gauss(k),gz+sd*gauss(k+0.5)];}\nconst out=s=>loss(s.x,s.z)>LIMIT||Math.abs(s.x)>HALF||Math.abs(s.z)>HALF;\nconst over=s=>out(s)||s.step>=MAXS;\nconst word=s=>out(s)?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nfunction advance(s,inputs,seed){if(over(s))return {...s,on:false};const g=grads(s,inputs,seed),r=inputs.learningRate,x=s.x-r*g[2],z=s.z-r*g[3];const n={...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};return over(n)?{...n,on:false}:n;}\nconst fresh=(run,kept,on)=>({x:START[0],z:START[1],step:0,run,on,path:[START],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst rim=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,shown){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&v>1e-6?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,Math.min(v*SCALE,LONG),1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),g=grads(s,inputs,seed),r=inputs.learningRate,sx=-r*g[2],sz=-r*g[3];\nconst p=lift([s.x,s.z]);\nreturn {nodes:{ball:{position:[s.x,p[1]+R,s.z]},stepArrow:aim(sx,sz,live),fullArrow:aim(-r*g[0],-r*g[1],live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(sx,sz):0,status:word(s)}};}\n"
  },
