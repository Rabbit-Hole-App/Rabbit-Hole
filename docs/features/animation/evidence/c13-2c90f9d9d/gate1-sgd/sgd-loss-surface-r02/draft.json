  ],
  "program": {
    "source": "const A=2.4,C=0.5,K=0.5,R=0.15,HALF=2,MAXS=40,LIM=5,S0=[0.5,1.7],SC=5,NS=1;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=(n,sd)=>{const s=Math.sin((n+sd*101)*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gs=(n,sd)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n,sd))))*Math.cos(2*Math.PI*rnd(n+0.5,sd));\nconst dev=b=>b>=64?0:NS*Math.sqrt((64-b)/(63*b));\nfunction next(s,inp,sd){const r=inp.learningRate,d=dev(Number(inp.batchSize)),gx=A*s.x,gz=C*s.z;return{bx:-r*(gx+d*gs(2*s.n,sd)),bz:-r*(gz+d*gs(2*s.n+1,sd)),fx:-r*gx,fz:-r*gz};}\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.k>=MAXS?'finished':s.on?'running':'paused';\nconst over=s=>{const w=word(s);return w==='diverged'||w==='finished';};\nfunction adv(s,inp,sd){if(over(s))return s;const t=next(s,inp,sd),x=s.x+t.bx,z=s.z+t.bz;return{...s,x,z,k:s.k+1,n:s.n+1,path:s.path.concat([[x,z]])};}\nconst fresh=(n,kept,on)=>({x:S0[0],z:S0[1],k:0,n,on,path:[S0],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs,seed}){\n if(e.type==='step')return !s.on||over(s)||e.tick%6?s:adv(s,inputs,seed);\n if(e.type!=='action')return s;\n if(e.action==='run')return over(s)?s:{...s,on:true};\n if(e.action==='pause')return{...s,on:false};\n if(e.action==='stepOnce')return adv({...s,on:false},inputs,seed);\n if(e.action==='newRun')return fresh(s.n,s.k>0?s.path:s.kept,true);\n return s;\n}\nconst rim=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=(p,h)=>{const x=rim(p[0]),z=rim(p[1]);return[x,K*loss(x,z)+h,z];};\nfunction aim(dx,dz,show){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;if(!show||v<1e-9)return{visible:false};return{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]};}\nexport function evaluate({inputs,state,seed}){\n const s=state||initialState(),L=loss(s.x,s.z),live=!over(s),t=next(s,inputs,seed);\n const ro={loss:L,steps:s.k,status:word(s)};\n if(live)ro.stepLen=Math.hypot(t.bx,t.bz);\n return{nodes:{ball:{position:lift([s.x,s.z],R)},stepArrow:aim(t.bx,t.bz,live),fullArrow:aim(t.fx,t.fz,live&&inputs.showTrueGradient),trail:{points:s.path.map(p=>lift(p,0.04))},ghost:{points:s.kept.map(p=>lift(p,0.04))}},readouts:ro};\n}\n"
  },
