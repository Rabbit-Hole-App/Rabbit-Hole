  "program": {
    "source": "const A=2.4,C=0.6,K=0.4,R=0.16,HALF=2,LIMIT=4.8,MAXS=40,START=[0.6,1.6],SCALE=3,NOISE=0.8;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>NOISE*Math.sqrt(Math.max(0,64-b)/(63*b));\nfunction next(s,i,seed){const d=sd(Number(i.batchSize)),k=s.n*2+(seed||0)*31+3;return [-i.learningRate*(A*s.x+d*gauss(k)),-i.learningRate*(C*s.z+d*gauss(k+1000.7))];}\nconst bad=s=>loss(s.x,s.z)>LIMIT||Math.abs(s.x)>HALF||Math.abs(s.z)>HALF;\nconst over=s=>bad(s)||s.step>=MAXS;\nconst word=s=>bad(s)?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nfunction advance(s,i,seed){if(over(s))return s;const [dx,dz]=next(s,i,seed),x=s.x+dx,z=s.z+dz,t={...s,x,z,step:s.step+1,n:s.n+1,path:s.path.concat([[x,z]])};return over(t)?{...t,on:false}:t;}\nconst fresh=(n,kept)=>({x:START[0],z:START[1],step:0,n,on:false,path:[START],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return {...fresh(s.n,s.step>0?s.path:s.kept),on:true};\nreturn s;}\nconst rim=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,shown){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&v>1e-9?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SCALE,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),live=!over(s),[dx,dz]=next(s,inputs,seed),bx=rim(s.x),bz=rim(s.z);\nreturn {nodes:{ball:{position:[bx,K*loss(bx,bz)+R,bz]},stepArrow:aim(dx,dz,live),fullArrow:aim(-inputs.learningRate*A*s.x,-inputs.learningRate*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:loss(s.x,s.z),stepLen:Math.hypot(dx,dz),status:word(s)}};}\n"
  },
