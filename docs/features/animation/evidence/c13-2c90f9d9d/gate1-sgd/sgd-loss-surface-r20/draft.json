  "program": {
    "source": "const A=2.4,C=0.6,K=0.4,R=0.16,HALF=2,MAXS=40,LIMIT=6,SIG=1.5,SCALE=5,START=[0.6,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>b>=64?0:SIG*Math.sqrt((64-b)/(63*b));\nfunction noisy(s,inp,seed){const d=sd(Number(inp.batchSize)),k=s.run*1009+s.step*2+(seed||0)*7+3;return [A*s.x+d*gauss(k),C*s.z+d*gauss(k+1)];}\nconst over=s=>s.div||s.step>=MAXS;\nconst word=s=>s.div?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nfunction advance(s,inp,seed){if(over(s))return s;const g=noisy(s,inp,seed),r=inp.learningRate,x=s.x-r*g[0],z=s.z-r*g[1],div=!(loss(x,z)<=LIMIT),n=s.step+1;return {...s,x,z,step:n,div,on:div||n>=MAXS?false:s.on,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:START[0],z:START[1],step:0,run,on:false,div:false,path:[START],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst rim=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,show){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&v>1e-9?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SCALE,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),r=inputs.learningRate,g=noisy(s,inputs,seed),dx=-r*g[0],dz=-r*g[1];\nconst p=lift([s.x,s.z]);\nconst ro={steps:s.step,loss:L,status:word(s)};\nif(live)ro.stepLen=Math.hypot(dx,dz);\nreturn {nodes:{ball:{position:[p[0],p[1]+R,p[2]]},stepArrow:aim(dx,dz,live),fullArrow:aim(-r*A*s.x,-r*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:ro};}\n"
  },
