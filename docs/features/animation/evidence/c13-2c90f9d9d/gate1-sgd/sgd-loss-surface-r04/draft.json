  "program": {
    "source": "const A=2.4,C=0.6,K=0.4,R=0.13,HALF=2,LIMIT=5,MAXS=40,SCALE=3,START=[0.6,1.8];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>Math.sqrt(Math.max(0,64-b)/(63*b));\nfunction next(s,inp){const n=sd(Number(inp.batchSize)),k=s.run*1009+s.step*2+3,r=inp.learningRate;return [-r*(A*s.x+n*gauss(k)),-r*(C*s.z+n*gauss(k+0.37))];}\nconst word=s=>(loss(s.x,s.z)>LIMIT||Math.abs(s.x)>HALF||Math.abs(s.z)>HALF?'diverged':s.step>=MAXS?'finished':'running');\nconst over=s=>word(s)!=='running';\nfunction advance(s,inp){if(over(s))return s;const [dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]]).slice(-MAXS)};}\nconst fresh=(run,kept)=>({x:START[0],z:START[1],step:0,run,path:[],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){if(e.type==='step')return e.tick%6?s:advance(s,inputs);if(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);return s;}\nconst rim=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,shown){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&v>1e-6?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SCALE,1]}:{visible:false};}\nexport function evaluate({inputs,state}){const s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),r=inputs.learningRate;\nreturn {nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(dx,dz,live),fullArrow:aim(-r*A*s.x,-r*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
