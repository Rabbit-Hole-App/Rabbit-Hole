  "program": {
    "source": "const A=2.5,C=0.5,K=0.4,R=0.14,HALF=2,MAXS=40,LIMIT=5,SIG=1.5,SCALE=3,START=[0.6,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst sd=b=>b>=64?0:SIG*Math.sqrt((64-b)/(63*b));\nfunction grads(s,inp){const q=sd(Math.round(inp.batchSize)),k=s.run*997+s.step*3+11;return{tx:A*s.x,tz:C*s.z,nx:A*s.x+q*gauss(k),nz:C*s.z+q*gauss(k+1.5)};}\nconst div=s=>loss(s.x,s.z)>LIMIT||Math.abs(s.x)>HALF||Math.abs(s.z)>HALF;\nconst over=s=>div(s)||s.step>=MAXS;\nconst word=s=>div(s)?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nfunction advance(s,inp){if(over(s))return s;const g=grads(s,inp),lr=inp.learningRate,x=s.x-lr*g.nx,z=s.z-lr*g.nz;return{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept,on)=>({x:START[0],z:START[1],step:0,run,on,path:[START],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst rim=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return[x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,show){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;if(!show||v<1e-9)return{visible:false};const ux=dx/v,uz=dz/v;return{visible:true,position:[ux*R,0,uz*R],quaternion:[uz*h,0,-ux*h,h],scale:[1,v*SCALE,1]};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),d=div(s),g=grads(s,inputs),lr=inputs.learningRate;\nconst dx=-lr*g.nx,dz=-lr*g.nz,bx=rim(s.x),bz=rim(s.z);\nreturn{nodes:{ball:{position:[bx,K*loss(bx,bz)+R,bz]},stepArrow:aim(dx,dz,!d),fullArrow:aim(-lr*g.tx,-lr*g.tz,!d&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLength:d?0:Math.hypot(dx,dz),status:word(s)}};}\n"
  },
