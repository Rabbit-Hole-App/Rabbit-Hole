  "program": {
    "source": "const A=2.5,C=0.5,K=0.4,R=0.12,H=2,N=40,S=1.5,SC=5,LIM=5,START=[0.6,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst bad=s=>loss(s.x,s.z)>LIM||Math.abs(s.x)>H||Math.abs(s.z)>H;\nconst over=s=>bad(s)||s.step>=N;\nconst word=s=>bad(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction next(s,inp,seed){const b=Number(inp.batchSize),sd=S*Math.sqrt(Math.max(0,64-b)/(63*b)),k=s.run*1009+s.step*3+(seed||0),r=inp.learningRate;return [-r*(A*s.x+sd*gauss(k)),-r*(C*s.z+sd*gauss(k+1.7))];}\nfunction advance(s,inp,seed){if(over(s))return s;const [dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:START[0],z:START[1],step:0,run,on:false,path:[START],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,shown){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&v>1e-9?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed),r=inputs.learningRate,x=rim(s.x),z=rim(s.z);\nreturn {nodes:{ball:{position:[x,K*loss(x,z)+R,z]},stepArrow:aim(dx,dz,live),fullArrow:aim(-r*A*s.x,-r*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{loss:L,steps:s.step,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
