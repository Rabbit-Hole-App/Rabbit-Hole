  "assumptions": [
    "Illustration: a made-up two-setting loss bowl with simulated batch noise, not a real model trained on real data.",
    "Loss = (2.4 x^2 + 0.6 z^2)/2, drawn at height 0.4 x loss. It is steeper along x (left-right), so overshoot shows there first; x swings grow when learning rate x 2.4 > 2, i.e. above about 0.83.",
    "Each step moves the ball by -rate x (slope + noise). The noise is Gaussian, centred on zero, with size sqrt((64-b)/(63 b)) per component, like sampling b of 64 points; it is exactly zero at 64. A step lowers the loss only on average.",
    "Both arrows are steps drawn 4 times their true length (one scale for both): mini-batch = the step this batch takes, full-data = -rate x true slope. The step length readout is in true units.",
    "A run ends after 40 steps (finished) or when the loss exceeds 5 (diverged). Noise comes from a fixed seed; Reset replays it, while a new run continues the sequence.",
    "Points beyond the drawn square are shown at its rim; the Loss readout keeps the true value."
  ],
  "program": {
    "source": "const A=2.4,C=0.6,K=0.4,H=2,MAXS=40,LIM=5,SC=4,X0=0.5,Z0=1.8;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s)};\nconst gau=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nfunction next(s,i,seed){const b=Number(i.batchSize),sd=b>=64?0:Math.sqrt((64-b)/(63*b)),n=s.k*2+(seed||0)*101+3;return [-i.learningRate*(A*s.x+sd*gau(n)),-i.learningRate*(C*s.z+sd*gau(n+1))];}\nconst word=s=>s.div?'diverged':s.n>=MAXS?'finished':s.on?'running':'paused';\nconst over=s=>s.div||s.n>=MAXS;\nfunction advance(s,i,seed){if(over(s))return s;const d=next(s,i,seed),x=s.x+d[0],z=s.z+d[1];return {...s,x,z,n:s.n+1,k:s.k+1,div:loss(x,z)>LIM,path:s.path.concat([[x,z]])};}\nconst fresh=(k,kept)=>({x:X0,z:Z0,n:0,k,on:false,div:false,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.k,s.n>0?s.path:s.kept);\nreturn s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,on){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&v>1e-6?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),live=!over(s),d=next(s,inputs,seed),x=rim(s.x),z=rim(s.z);\nconst r={loss:loss(s.x,s.z),steps:s.n,status:word(s)};\nif(live)r.stepLen=Math.hypot(d[0],d[1]);\nreturn {nodes:{ball:{position:[x,K*loss(x,z),z]},miniArrow:aim(d[0],d[1],live),fullArrow:aim(-inputs.learningRate*A*s.x,-inputs.learningRate*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  }
}