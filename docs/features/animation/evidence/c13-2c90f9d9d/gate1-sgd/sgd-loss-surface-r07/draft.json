  "program": {
    "source": "const A=2.4,C=0.5,K=0.5,R=0.14,H=2,N=40,LIM=6,S=1.2,SC=2.5,ST=[0.8,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gs=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(6.2832*rnd(n+0.37));\nconst sd=b=>S*Math.sqrt(Math.max(0,(64-b)/(63*b)));\nfunction grad(s,inp,seed){const e=sd(Number(inp.batchSize)),k=(seed||0)*7919+s.run*1009+s.step*2+3;return [A*s.x+e*gs(k),C*s.z+e*gs(k+1)];}\nconst over=s=>s.div||s.step>=N;\nconst word=s=>s.div?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction advance(s,inp,seed){if(over(s))return s;const g=grad(s,inp,seed),r=inp.learningRate,x=s.x-r*g[0],z=s.z-r*g[1];return {...s,x,z,step:s.step+1,div:loss(x,z)>LIM,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,run,on:true,div:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%4?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nreturn s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,show){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&v>1e-6?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),r=inputs.learningRate,g=grad(s,inputs,seed);\nconst dx=-r*g[0],dz=-r*g[1],bx=rim(s.x),bz=rim(s.z);\nreturn {nodes:{ball:{position:[bx,K*loss(bx,bz)+R,bz]},stepArrow:aim(dx,dz,live),fullArrow:aim(-r*A*s.x,-r*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
