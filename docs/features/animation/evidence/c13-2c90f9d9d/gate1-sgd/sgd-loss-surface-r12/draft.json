  "assumptions": [
    "Illustration: a made-up two-setting loss bowl with simulated batch noise, not a real model trained on real data.",
    "Loss = (2.5 x^2 + 0.4 z^2) / 2, steeper along x. The surface is drawn at height 0.4 x loss. Plain steps along x overshoot when the rate is above 0.8 and swings grow; along z the ball creeps.",
    "Each step moves the ball by -rate x (true slope + noise). Noise is Gaussian on both slopes with spread sqrt((64-b)/(63 b)): largest at batch 1, exactly zero at 64. It does not fade near the bottom, so small batches keep wandering.",
    "Both arrows are steps drawn at 5 times their real length, one scale for both. Mini-batch step is the move the ball will make next; Full-data step is the move with no noise. A step only lowers the loss on average.",
    "Diverged: the loss goes past 5 (the ball leaves the bowl along x) or |z| passes 2; the run stops and points off the bowl are drawn at its rim. Finished: 40 steps taken.",
    "The trail holds the start plus one point per step (at most 41); the ghost keeps the last run. New run takes the next noise values; Reset replays the fixed-seed noise from the start. Changed settings apply from the next step."
  ],
  "program": {
    "source": "const A=2.5,C=0.4,H=0.4,LIM=5,MAXS=40,R=0.13,SC=5,ST=[0.3,1.8];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>b>=64?0:Math.sqrt((64-b)/(b*63));\nfunction grad(s,inp,seed){const d=sd(Number(inp.batchSize)),k=s.n*2.37+(seed||0)*31+1;return[A*s.x+d*gauss(k),C*s.z+d*gauss(k+500)];}\nconst done=s=>s.div||s.step>=MAXS;\nconst word=s=>s.div?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nfunction advance(s,inp,seed){if(done(s))return s;const g=grad(s,inp,seed),r=inp.learningRate,x=s.x-r*g[0],z=s.z-r*g[1];return{...s,x,z,n:s.n+1,step:s.step+1,div:loss(x,z)>LIM||Math.abs(z)>2,path:s.path.concat([[x,z]])};}\nconst fresh=(n,kept,on)=>({x:ST[0],z:ST[1],n,step:0,div:false,on,path:[ST],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||done(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return done(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst rim=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return[x,H*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,shown){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&v>1e-6?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!done(s),g=grad(s,inputs,seed),r=inputs.learningRate,len=live?r*Math.hypot(g[0],g[1]):0;\nreturn{nodes:{ball:{position:[rim(s.x),H*L+R,rim(s.z)]},\nstepArrow:aim(-r*g[0],-r*g[1],live),\nfullArrow:aim(-r*A*s.x,-r*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:len,status:word(s)}};}\n"
  }
}