  "program": {
    "source": "const A=2.4,C=0.4,K=0.5,R=0.14,HALF=2,LIM=4.8,N=40,SIG=0.8,S0=[0.3,1.7],SC=4;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst bad=s=>loss(s.x,s.z)>LIM||Math.abs(s.z)>HALF;\nconst done=s=>bad(s)||s.step>=N;\nconst word=s=>bad(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction est(s,inputs,seed){const b=Number(inputs.batchSize),sd=b>=64?0:SIG*Math.sqrt((64-b)/(63*b)),k=(seed||0)*7919+s.run*1009+s.step*2+1;return [A*s.x+sd*gauss(k),C*s.z+sd*gauss(k+500.37)];}\nfunction advance(s,inputs,seed){if(done(s))return s;const g=est(s,inputs,seed),r=inputs.learningRate,x=s.x-r*g[0],z=s.z-r*g[1];return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]]).slice(-N)};}\nconst fresh=(run,kept)=>({x:S0[0],z:S0[1],step:0,run,on:false,path:[],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||done(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return done(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return {...fresh(s.run+1,s.path.length?s.path:s.kept),on:true};\nreturn s;}\nconst rim=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,show){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&v>1e-9?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),r=inputs.learningRate,L=loss(s.x,s.z),live=!bad(s),g=est(s,inputs,seed),x=rim(s.x),z=rim(s.z);\nconst ro={steps:s.step,loss:L,status:word(s)};\nif(live)ro.stepLen=r*Math.hypot(g[0],g[1]);\nreturn {nodes:{ball:{position:[x,K*loss(x,z)+R,z]},stepArrow:aim(-r*g[0],-r*g[1],live),fullArrow:aim(-r*A*s.x,-r*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:ro};}\n"
  },
