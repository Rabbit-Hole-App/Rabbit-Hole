  "program": {
    "source": "const A=2.4,C=0.6,K=0.4,R=0.12,LIM=5,N=40,SIG=1.2,SC=4,S0=[0.5,1.8],H=2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gs=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sdv=b=>b>=64?0:SIG*Math.sqrt((64-b)/(63*b));\nfunction next(s,i,seed){const sd=sdv(Number(i.batchSize)),k=s.run*1009+s.step*2+(seed||0)*31,lr=i.learningRate;return[-lr*(A*s.x+sd*gs(k)),-lr*(C*s.z+sd*gs(k+1))];}\nconst div=s=>loss(s.x,s.z)>LIM;\nconst over=s=>div(s)||s.step>=N;\nconst word=s=>div(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction advance(s,i,seed){if(over(s))return s;const[dx,dz]=next(s,i,seed),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept,on)=>({x:S0[0],z:S0[1],step:0,run,on,path:[S0],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step'){if(!s.on||over(s)||e.tick%6)return s;const n=advance(s,inputs,seed);return over(n)?{...n,on:false}:n;}\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return[x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,sh){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;if(!sh||v<1e-9)return{visible:false};return{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate;\nreturn{nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(dx,dz,live),fullArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:Math.hypot(dx,dz),status:word(s)}};}\n"
  },
