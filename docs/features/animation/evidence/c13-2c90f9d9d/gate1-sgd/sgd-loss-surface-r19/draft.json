  "program": {
    "source": "const A=2.5,C=0.5,K=0.4,R=0.15,HALF=2,N=64,MAXS=40,LIMIT=5,S=1,SCALE=4,START=[0.6,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst sd=b=>b>=N?0:S*Math.sqrt((N-b)/((N-1)*b));\nfunction steps(s,inputs,seed){const lr=inputs.learningRate,d=sd(Number(inputs.batchSize)),k=seed*7919+s.run*1009+s.step*2+1,gx=A*s.x,gz=C*s.z;return{full:[-lr*gx,-lr*gz],mini:[-lr*(gx+d*gauss(k)),-lr*(gz+d*gauss(k+0.5))]};}\nconst word=s=>s.div?'diverged':s.step>=MAXS?'finished':'running';\nfunction advance(s,inputs,seed){if(word(s)!=='running')return s;const m=steps(s,inputs,seed).mini,x=s.x+m[0],z=s.z+m[1],L=loss(x,z);return{...s,x,z,step:s.step+1,div:!(L<=LIMIT),path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:START[0],z:START[1],step:0,run,div:false,path:[START],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){if(e.type==='step')return e.tick%6?s:advance(s,inputs,seed);if(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);return s;}\nconst rim=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return[x,K*loss(x,z)+0.04,z];};\nfunction aim(d,shown){const v=Math.hypot(d[0],d[1]),h=Math.SQRT1_2;return shown&&v>1e-9?{visible:true,quaternion:[d[1]/v*h,0,-d[0]/v*h,h],scale:[1,v*SCALE,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){const s=state||initialState(),L=loss(s.x,s.z),live=word(s)==='running',st=steps(s,inputs,seed||0),x=rim(s.x),z=rim(s.z);const r={steps:s.step,loss:L,status:word(s)};if(live)r.stepLen=Math.hypot(st.mini[0],st.mini[1]);return{nodes:{ball:{position:[x,K*loss(x,z)+R,z]},miniArrow:aim(st.mini,live),fullArrow:aim(st.full,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
