  "program": {
    "source": "const A=2.4,C=0.4,K=0.3,H=3,R=0.15,LIM=8,N=40,S0=[0.6,2.4],SC=4;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst g=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(6.2832*rnd(n+0.37));\nconst sd=b=>b>=64?0:Math.sqrt((64-b)/(63*b));\nfunction next(s,inp){const lr=inp.learningRate,d=sd(Math.round(inp.batchSize)),k=s.seed*7919+s.run*1009+s.step*2+1;return [-lr*(A*s.x+d*g(k)),-lr*(C*s.z+d*g(k+1))];}\nconst over=s=>s.div||s.step>=N;\nfunction advance(s,inp){if(over(s))return s;const [dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,div:loss(x,z)>LIM,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept,seed)=>({x:S0[0],z:S0[1],step:0,run,div:false,path:[S0],kept,seed});\nexport function initialState({seed}){return fresh(0,[],seed||0);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='stepOnce')return advance(s,inputs);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,s.seed);\nreturn s;}\nconst rim=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return [x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,show){const v=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&v>1e-6?{visible:true,quaternion:[dz/v*h,0,-dx/v*h,h],scale:[1,v*SC,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState({seed:0}),live=!over(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\nconst bx=rim(s.x),bz=rim(s.z);\nreturn {nodes:{ball:{position:[bx,K*loss(bx,bz)+R,bz]},stepArrow:aim(dx,dz,live),fullArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:loss(s.x,s.z),stepLen:live?Math.hypot(dx,dz):0,status:s.div?'diverged':s.step>=N?'finished':'running'}};}\n"
  },
