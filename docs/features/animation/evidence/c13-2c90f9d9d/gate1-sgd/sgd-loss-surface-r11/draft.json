  "program": {
    "source": "const A=2.4,C=0.6,K=0.5,R=0.13,HALF=2,MAXS=40,LIMIT=5,SIG=1.2,SC=4,X0=0.6,Z0=1.7;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(2*Math.PI*rnd(n+0.37));\nconst sd=b=>b>=64?0:SIG*Math.sqrt((64-b)/(63*b));\nconst over=s=>s.div||s.step>=MAXS;\nconst word=s=>s.div?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nfunction next(s,inp){const r=inp.learningRate,d=sd(Number(inp.batchSize)),k=s.run*1009+s.step*3+11;return[-r*(A*s.x+d*gauss(k)),-r*(C*s.z+d*gauss(k+1.5))];}\nfunction advance(s,inp){if(over(s))return s;const[dx,dz]=next(s,inp),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,div:loss(x,z)>LIMIT||Math.abs(x)>HALF||Math.abs(z)>HALF,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept,on)=>({x:X0,z:Z0,step:0,run,on,div:false,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return!s.on||over(s)||e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst rim=v=>Math.max(-HALF,Math.min(HALF,v));\nconst lift=p=>{const x=rim(p[0]),z=rim(p[1]);return[x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,x,z,show){const v=Math.hypot(dx,dz);if(!show||v<1e-9)return{visible:false};const dh=K*(A*x*dx+C*z*dz),m=Math.hypot(dx,dh,dz),ux=dx/m,uy=dh/m,uz=dz/m,w=1+uy,n=Math.hypot(uz,ux,w);return{visible:true,quaternion:[uz/n,0,-ux/n,w/n],scale:[1,v*SC,1]};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),r=inputs.learningRate,x=rim(s.x),z=rim(s.z);\nreturn{nodes:{ball:{position:[x,K*loss(x,z)+R,z]},stepArrow:aim(dx,dz,x,z,live),fullArrow:aim(-r*A*s.x,-r*C*s.z,x,z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
