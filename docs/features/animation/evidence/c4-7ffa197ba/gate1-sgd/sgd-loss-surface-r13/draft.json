  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.12,TOP=4,LIM=8,N=64,MAXS=40,S0=1.5,START=[0.6,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst sd=b=>b>=N?0:S0*Math.sqrt((N-b)/(b*(N-1)));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nconst over=s=>{const w=word(s);return w==='diverged'||w==='finished';};\nfunction next(s,inp,seed){const d=sd(Number(inp.batchSize)),k=(seed||0)*7919+s.run*1009+s.step*2+1,lr=inp.learningRate;\nreturn[-lr*(A*s.x+d*gauss(k)),-lr*(C*s.z+d*gauss(k+0.5))];}\nfunction advance(s,inp,seed){if(over(s))return s;const[dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;\nreturn{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:START[0],z:START[1],step:0,run,on:false,path:[START],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),TOP)+0.05,p[1]];\nfunction aim(dx,dz,shown){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;\nreturn shown&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate;\nconst gx=K*A*s.x,gz=K*C*s.z,ro={status:word(s),loss:L,steps:s.step};\nif(live)ro.arrowLen=Math.hypot(dx,dz);\nreturn{nodes:{ball:{position:[s.x,K*L+R*Math.sqrt(1+gx*gx+gz*gz),s.z]},\nstepArrow:aim(dx,dz,live),fullArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:ro};}\n"
  },
