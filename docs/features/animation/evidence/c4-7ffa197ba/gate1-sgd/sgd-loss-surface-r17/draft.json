  "program": {
    "source": "const A=4,C=1,K=0.25,R=0.13,H=2.4,LMAX=12,N=40,S=2,X0=1,Z0=2;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst bad=s=>loss(s.x,s.z)>LMAX||Math.abs(s.x)>H||Math.abs(s.z)>H;\nconst over=s=>bad(s)||s.step>=N;\nconst word=s=>bad(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction next(s,inp,seed){const b=inp.batchSize,lr=inp.learningRate,sd=S*Math.sqrt(Math.max(0,64-b)/(63*b)),n=seed*31.7+s.k*2.13;return[-lr*(A*s.x+sd*gauss(n)),-lr*(C*s.z+sd*gauss(n+1.07))];}\nfunction advance(s,inp,seed){if(over(s))return s;const[dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,k:s.k+1,path:s.path.concat([[x,z]])};}\nconst fresh=(k,kept,on)=>({x:X0,z:Z0,step:0,k,on,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.k,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst cl=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return[x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,shown){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed||0),lr=inputs.learningRate;\nconst x=cl(s.x),z=cl(s.z),gx=K*A*x,gz=K*C*z;\nconst r={steps:s.step,loss:L,status:word(s)};if(live)r.arrowLen=Math.hypot(dx,dz);\nreturn{nodes:{ball:{position:[x,K*loss(x,z)+R*Math.sqrt(1+gx*gx+gz*gz),z]},stepArrow:aim(dx,dz,live),slopeArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
