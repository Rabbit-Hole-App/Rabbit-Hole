  "program": {
    "source": "const A=2.5,C=0.6,K=0.4,R=0.16,N=64,M=40,LIM=8,S=2,P0=[1.5,1.5];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>1.5*Math.sqrt(Math.max(0,N-b)/(b*(N-1)));\nconst div=s=>loss(s.x,s.z)>LIM;\nconst over=s=>div(s)||s.step>=M;\nconst word=s=>div(s)?'diverged':s.step>=M?'finished':s.on?'running':'paused';\nfunction next(s,i){const d=sd(Number(i.batchSize)),k=s.run*997+s.step*2+1,lr=i.learningRate;return[-lr*(A*s.x+d*gauss(k)),-lr*(C*s.z+d*gauss(k+0.37))];}\nfunction advance(s,i){if(over(s))return s;const[dx,dz]=next(s,i),x=s.x+dx,z=s.z+dz;return{...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept,on)=>({x:P0[0],z:P0[1],step:0,run,on,path:[P0],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst c=v=>Math.max(-2.2,Math.min(2.2,v));\nconst lift=p=>[c(p[0]),Math.min(K*loss(p[0],p[1]),2.6)+0.05,c(p[1])];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;if(!on||l<1e-6)return{visible:false};const ux=dx/l,uz=dz/l;return{visible:true,position:[ux*R,0,uz*R],quaternion:[uz*h,0,-ux*h,h],scale:[1,l*S,1]};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),lr=inputs.learningRate;\nreturn{nodes:{ball:{position:[c(s.x),K*L+R,c(s.z)]},stepArrow:aim(dx,dz,live),trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
