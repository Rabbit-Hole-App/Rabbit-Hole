  "program": {
    "source": "const A=2.5,C=0.5,K=0.5,R=0.16,N=40,LIM=6,S0=1.5,AS=3,ST=[0.5,1.8];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.37));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=N?'finished':'running';\nconst over=s=>word(s)!=='running';\nfunction est(s,inp,seed){const B=inp.batchSize,sd=S0*Math.sqrt(Math.max(0,64-B)/(63*B)),k=(seed||0)*7919+s.run*1009+s.step*2+1;return [A*s.x+sd*gauss(k),C*s.z+sd*gauss(k+0.5)];}\nfunction advance(s,inp,seed){const g=est(s,inp,seed),x=s.x-inp.learningRate*g[0],z=s.z-inp.learningRate*g[1];return {...s,x,z,t:0,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:ST[0],z:ST[1],step:0,t:0,run,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step'){if(over(s))return s;const t=s.t+1;return t<6?{...s,t}:advance(s,inputs,seed);}\nif(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>[cl(p[0]),Math.min(K*loss(p[0],p[1]),3)+0.04,cl(p[1])];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{p:{quaternion:[dz/l*h,0,-dx/l*h,h]},a:{visible:true,scale:[1,AS*l,1]}}:{p:{},a:{visible:false}};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),lr=inputs.learningRate,g=est(s,inputs,seed);\nconst st=aim(-lr*g[0],-lr*g[1],live),tr=aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient);\nconst ro={steps:s.step,loss:L,status:word(s)};if(live)ro.stepLen=lr*Math.hypot(g[0],g[1]);\nreturn {nodes:{ball:{position:[cl(s.x),Math.min(K*L,3)+R,cl(s.z)]},stepPivot:st.p,stepArrow:st.a,truePivot:tr.p,trueArrow:tr.a,trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:ro};}\n"
  },
