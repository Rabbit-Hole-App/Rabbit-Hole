  "stepped": true,
  "program": {
    "source": "const A=4,C=1,K=0.25,R=0.12,H=2,LIM=10,MAX=40,S0=2,N=64,P0=[1,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst out=s=>Math.abs(s.x)>H||Math.abs(s.z)>H||loss(s.x,s.z)>LIM;\nconst over=s=>out(s)||s.step>=MAX;\nconst word=s=>out(s)?'diverged':s.step>=MAX?'finished':s.on?'running':'paused';\nfunction next(s,i){const b=Math.round(i.batchSize),sd=S0*Math.sqrt(Math.max(0,N-b)/((N-1)*b)),k=s.seed*31+s.run*1009+s.step*2+1,lr=i.learningRate;\nreturn [-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+0.25))];}\nfunction advance(s,i){if(over(s))return s;const [dx,dz]=next(s,i),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept,seed)=>({x:P0[0],z:P0[1],step:0,run,on:false,path:[P0],kept,seed});\nexport function initialState({seed}){return fresh(0,[],seed||0);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step'){if(!s.on||e.tick%6)return s;const n=advance(s,inputs);return over(n)?{...n,on:false}:n;}\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,s.seed);\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),2.5)+0.04,p[1]];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState({seed:7}),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs),gx=K*A*s.x,gz=K*C*s.z,lr=inputs.learningRate;\nreturn {nodes:{ball:{position:[s.x,K*L+R*Math.sqrt(1+gx*gx+gz*gz),s.z]},stepArrow:aim(dx,dz,live),slopeArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,arrowLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
