  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.16,LIM=6,N=40,S0=[0.3,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sd=b=>2*Math.sqrt(Math.max(0,64-b)/(63*b));\nfunction moves(s,inp){const lr=inp.learningRate,d=sd(Number(inp.batchSize)),k=s.run*1009+s.step*2+1,gx=A*s.x,gz=C*s.z;\nreturn{b:[-lr*(gx+d*gauss(k)),-lr*(gz+d*gauss(k+0.37))],t:[-lr*gx,-lr*gz]};}\nconst word=s=>s.dead?'diverged':s.step>=N?'finished':'running';\nfunction advance(s,inp){if(word(s)!=='running')return s;const[dx,dz]=moves(s,inp).b,x=s.x+dx,z=s.z+dz;\nreturn{...s,x,z,step:s.step+1,dead:loss(x,z)>LIM,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:S0[0],z:S0[1],step:0,run,dead:false,path:[S0],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return e.tick%6?s:advance(s,inputs);\nif(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return[x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;\nreturn on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=word(s)==='running',m=moves(s,inputs);\nconst gx=K*A*s.x,gz=K*C*s.z,y=Math.min(K*L,4)+R*Math.sqrt(1+gx*gx+gz*gz);\nconst r={status:word(s),loss:L,steps:s.step};if(live)r.stepLen=Math.hypot(m.b[0],m.b[1]);\nreturn{nodes:{ball:{position:[s.x,y,s.z]},batchArrow:aim(m.b[0],m.b[1],live),trueArrow:aim(m.t[0],m.t[1],live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
