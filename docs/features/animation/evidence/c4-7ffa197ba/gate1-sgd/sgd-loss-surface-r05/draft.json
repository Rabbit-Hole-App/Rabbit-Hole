  "program": {
    "source": "const A=4,C=1,K=0.5,R=0.16,H=2,LIM=8,N=40,S=2,SIG=1.5,ST=[0.5,1.8];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst u=(n,sd)=>{let t=Math.imul(n+1,0x9e3779b1)^Math.imul(sd+7,0x85ebca6b);t^=t>>>15;t=Math.imul(t,0x2c1b3c6d);t^=t>>>12;t=Math.imul(t,0x297a2d39);t^=t>>>15;return((t>>>0)+0.5)/4294967296;};\nconst g=(n,sd)=>Math.sqrt(-2*Math.log(u(2*n,sd)))*Math.cos(2*Math.PI*u(2*n+1,sd));\nconst bad=s=>Math.abs(s.x)>H||Math.abs(s.z)>H||loss(s.x,s.z)>LIM;\nconst over=s=>bad(s)||s.step>=N;\nconst word=s=>bad(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction est(s,i,sd){const b=Math.min(64,Math.max(1,Math.round(i.batchSize))),n=SIG*Math.sqrt((64-b)/(63*b));return[A*s.x+n*g(s.k,sd),C*s.z+n*g(s.k+500000,sd)];}\nfunction adv(s,i,sd){if(over(s))return s;const[gx,gz]=est(s,i,sd),x=s.x-i.learningRate*gx,z=s.z-i.learningRate*gz;return{...s,x,z,step:s.step+1,k:s.k+1,path:[...s.path,[x,z]]};}\nconst fresh=(k,kept)=>({x:ST[0],z:ST[1],step:0,k,on:false,path:[ST],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs:i,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:adv(s,i,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return adv({...s,on:false},i,seed);\nif(e.action==='newRun')return fresh(s.k,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-2.2,Math.min(2.2,v));\nconst lift=p=>[cl(p[0]),Math.min(K*loss(p[0],p[1]),5)+0.05,cl(p[1])];\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,S*l,1]}:{visible:false};}\nexport function evaluate({inputs:i,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),lr=i.learningRate,[gx,gz]=est(s,i,seed||0);\nconst dx=-lr*gx,dz=-lr*gz,len=live?Math.hypot(dx,dz):0;\nreturn{nodes:{\nball:{position:[cl(s.x),Math.min(K*L,5)+R,cl(s.z)]},\nstepArrow:aim(dx,dz,live),\ntrueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&i.showTrueGradient),\ntrail:{points:s.path.map(lift)},\nghost:{points:s.kept.map(lift)}},\nreadouts:{status:word(s),steps:s.step,loss:L,arrowLen:len}};}\n"
  },
