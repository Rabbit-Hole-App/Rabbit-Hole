  "program": {
    "source": "const A=4,C=1,K=0.25,R=0.12,H=2,LIM=10,N=40,S0=[1.2,1.6],SD=1.5;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sdOf=b=>SD*Math.sqrt(Math.max(0,64-b)/(63*b));\nconst word=s=>s.div?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nconst over=s=>s.div||s.step>=N;\nfunction next(s,inp,seed){const lr=inp.learningRate,sd=sdOf(Number(inp.batchSize)),k=(seed||0)*7919+s.run*1009+s.step*2+1,gx=A*s.x,gz=C*s.z;\nreturn{d:[-lr*(gx+sd*gauss(k)),-lr*(gz+sd*gauss(k+0.25))],t:[-lr*gx,-lr*gz]};}\nfunction advance(s,inp,seed){if(over(s))return s;const{d}=next(s,inp,seed),x=s.x+d[0],z=s.z+d[1];\nconst div=Math.abs(x)>H||Math.abs(z)>H||loss(x,z)>LIM;\nreturn{...s,x,z,div,step:s.step+1,on:div||s.step+1>=N?false:s.on,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept,on)=>({x:S0[0],z:S0[1],step:0,run,on,div:false,path:[S0],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return!s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst cl=v=>Math.max(-H,Math.min(H,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return[x,K*loss(x,z)+0.04,z];};\nfunction aim(dx,dz,shown){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;\nreturn shown&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),{d,t}=next(s,inputs,seed);\nconst x=cl(s.x),z=cl(s.z),gx=K*A*x,gz=K*C*z;\nconst r={steps:s.step,loss:L,status:word(s)};if(live)r.stepLen=Math.hypot(d[0],d[1]);\nreturn{nodes:{ball:{position:[x,K*loss(x,z)+R*Math.sqrt(1+gx*gx+gz*gz),z]},\nstepArrow:aim(d[0],d[1],live),trueArrow:aim(t[0],t[1],live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
