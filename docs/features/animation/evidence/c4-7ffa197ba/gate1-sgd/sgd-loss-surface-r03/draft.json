  "stepped": true,
  "program": {
    "source": "const A=3,C=1,K=0.5,R=0.14,N=64,MAXS=40,LIM=6,S=2,AR=2,X0=0.8,Z0=1.7;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sdOf=b=>S*Math.sqrt(Math.max(0,N-b)/((N-1)*b));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nconst over=s=>{const w=word(s);return w==='diverged'||w==='finished';};\nfunction grads(s,inputs){const sd=sdOf(Number(inputs.batchSize)),k=s.n*2+1,gx=A*s.x,gz=C*s.z;return{gx,gz,nx:gx+sd*gauss(k),nz:gz+sd*gauss(k+0.25)};}\nfunction advance(s,inputs){if(over(s))return s;const g=grads(s,inputs),lr=inputs.learningRate,x=s.x-lr*g.nx,z=s.z-lr*g.nz;return{...s,x,z,step:s.step+1,n:s.n+1,path:s.path.concat([[x,z]])};}\nconst fresh=(n,kept)=>({x:X0,z:Z0,step:0,n,on:false,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs);\nif(e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>[cl(p[0]),Math.min(K*loss(p[0],p[1]),4)+0.06,cl(p[1])];\nfunction aim(dx,dz,shown){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l*AR,1]}:{visible:false};}\nexport function evaluate({inputs,state}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),g=grads(s,inputs),lr=inputs.learningRate,sx=-lr*g.nx,sz=-lr*g.nz;\nconst ro={steps:s.step,loss:L,status:word(s)};\nif(live)ro.stepLen=Math.hypot(sx,sz);\nreturn{nodes:{ball:{position:[cl(s.x),Math.min(K*L,4)+R,cl(s.z)]},stepArrow:aim(sx,sz,live),trueArrow:aim(-lr*g.gx,-lr*g.gz,live&&!!inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:ro};}\n"
  },
