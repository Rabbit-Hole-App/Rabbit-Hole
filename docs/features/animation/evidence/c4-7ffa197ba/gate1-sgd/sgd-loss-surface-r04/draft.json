  "program": {
    "source": "const A=2.5,C=0.5,K=0.5,R=0.12,LIM=8,N=40,S0=1.5,G=2,X0=1.5,Z0=1.6;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s)};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n))))*Math.cos(6.2832*rnd(n+0.37));\nconst sd=b=>S0*Math.sqrt(Math.max(0,64-b)/(63*b));\nconst word=s=>loss(s.x,s.z)>LIM?'diverged':s.step>=N?'finished':'running';\nfunction next(s,i,seed){const k=(seed||0)*31+s.run*977+s.step*2+1,d=sd(i.batchSize),lr=i.learningRate;return [-lr*(A*s.x+d*gauss(k)),-lr*(C*s.z+d*gauss(k+0.5))];}\nfunction advance(s,i,seed){if(word(s)!=='running')return s;const [dx,dz]=next(s,i,seed),x=s.x+dx,z=s.z+dz;return {...s,x,z,step:s.step+1,path:s.path.concat([[x,z]]).slice(-N)};}\nconst fresh=(run,kept)=>({x:X0,z:Z0,step:0,run,path:[],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\n if(e.type==='step')return e.tick%6?s:advance(s,inputs,seed);\n if(e.type==='action'&&e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\n return s;\n}\nconst cap=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>{const x=cap(p[0]),z=cap(p[1]);return [x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,on){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return on&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,G*l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\n const s=state||initialState(),L=loss(s.x,s.z),w=word(s),live=w==='running',[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate;\n const x=cap(s.x),z=cap(s.z);\n return {nodes:{\n  ball:{position:[x,K*loss(x,z)+R,z]},\n  stepArrow:aim(dx,dz,live),\n  trueArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),\n  trail:{points:s.path.map(lift)},\n  ghost:{points:s.kept.map(lift)}},\n  readouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:w}};\n}\n"
  },
