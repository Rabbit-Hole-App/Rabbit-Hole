  "program": {
    "source": "const A=4,C=1,K=0.3,R=0.16,LIM=8,N=40,S0=2,START=[0.5,1.7];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=n=>{const s=Math.sin(n*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=n=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n))))*Math.cos(2*Math.PI*rand(n+0.5));\nconst sdOf=b=>S0*Math.sqrt(Math.max(0,64-b)/(63*b));\nconst over=s=>s.div||s.step>=N;\nconst word=s=>s.div?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction next(s,inp,seed){const lr=inp.learningRate,sd=sdOf(Math.round(inp.batchSize)),k=(seed||0)*7919+s.run*1009+s.step*2+1;return[-lr*(A*s.x+sd*gauss(k)),-lr*(C*s.z+sd*gauss(k+0.37))];}\nfunction advance(s,inp,seed){if(over(s))return s;const[dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz;const div=loss(x,z)>LIM||Math.abs(x)>2||Math.abs(z)>2;return{...s,x,z,div,on:div?false:s.on,step:s.step+1,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:START[0],z:START[1],step:0,run,on:false,div:false,path:[START],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return{...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.run+1,s.step>0?s.path:s.kept);\nreturn s;}\nconst cl=v=>Math.max(-2,Math.min(2,v));\nconst lift=p=>{const x=cl(p[0]),z=cl(p[1]);return[x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,shown){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed);\nconst x=cl(s.x),z=cl(s.z),gx=K*A*x,gz=K*C*z;\nreturn{nodes:{\nball:{position:[x,K*loss(x,z)+R*Math.sqrt(1+gx*gx+gz*gz),z]},\nstepArrow:aim(dx,dz,live),\ntrueArrow:aim(-inputs.learningRate*A*s.x,-inputs.learningRate*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},\nghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
