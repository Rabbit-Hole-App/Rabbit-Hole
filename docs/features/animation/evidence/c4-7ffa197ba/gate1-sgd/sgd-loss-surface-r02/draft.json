  "program": {
    "source": "const A=4,C=1,K=0.4,R=0.16,S0=3,N=40,LIM=6,ST=[1.2,1.6];\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=(n,q)=>{const s=Math.sin(n*91.7+q*13.1+1.3)*43758.5453;return s-Math.floor(s);};\nconst gauss=(n,q)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n,q))))*Math.cos(6.2832*rnd(n+0.37,q));\nconst bad=s=>loss(s.x,s.z)>LIM||Math.abs(s.x)>2||Math.abs(s.z)>2;\nconst over=s=>bad(s)||s.step>=N;\nconst word=s=>bad(s)?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction steps(s,inp,q){const b=inp.batchSize,lr=inp.learningRate,sd=S0*Math.sqrt(Math.max(0,64-b)/(63*b)),gx=A*s.x,gz=C*s.z;return{n:[-lr*(gx+sd*gauss(s.k,q)),-lr*(gz+sd*gauss(s.k+0.5,q))],t:[-lr*gx,-lr*gz]};}\nfunction advance(s,inp,q){if(over(s))return s;const d=steps(s,inp,q).n,x=s.x+d[0],z=s.z+d[1];return{...s,x,z,step:s.step+1,k:s.k+1,path:s.path.concat([[x,z]])};}\nconst fresh=(k,kept,on)=>({x:ST[0],z:ST[1],step:0,k,on,path:[ST],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.k,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst lift=p=>[p[0],Math.min(K*loss(p[0],p[1]),4)+0.05,p[1]];\nfunction aim(d,show){const l=Math.hypot(d[0],d[1]),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[d[1]/l*h,0,-d[0]/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),st=steps(s,inputs,seed),len=Math.hypot(st.n[0],st.n[1]);\nconst r={loss:L,steps:s.step,status:word(s)};if(live)r.arrowLen=len;\nreturn{nodes:{ball:{position:[s.x,K*L+R,s.z]},stepArrow:aim(st.n,live),trueArrow:aim(st.t,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},readouts:r};}\n"
  },
