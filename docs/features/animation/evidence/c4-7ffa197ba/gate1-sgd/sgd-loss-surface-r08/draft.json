  "program": {
    "source": "const A=4,C=1,K=0.4,R=0.12,LIM=10,MAXS=40,S0=1.5,START=[0.9,1.7],CAP=2.6;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rand=(n,sd)=>{const s=Math.sin(n*12.9898+sd*78.233+1.3)*43758.5453;return s-Math.floor(s);};\nconst gauss=(n,sd)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rand(n,sd))))*Math.cos(2*Math.PI*rand(n+0.5,sd));\nconst sdev=b=>b>=64?0:S0*Math.sqrt((64-b)/(63*b));\nconst over=s=>s.div||s.step>=MAXS;\nconst word=s=>s.div?'diverged':s.step>=MAXS?'finished':s.on?'running':'paused';\nfunction next(s,inp,seed){const sd=sdev(Math.round(inp.batchSize)),lr=inp.learningRate,k=s.n*2+1;return [-lr*(A*s.x+sd*gauss(k,seed)),-lr*(C*s.z+sd*gauss(k+0.25,seed))];}\nfunction advance(s,inp,seed){if(over(s))return s;const [dx,dz]=next(s,inp,seed),x=s.x+dx,z=s.z+dz,div=loss(x,z)>LIM,step=s.step+1;return {...s,x,z,step,div,n:s.n+1,on:s.on&&!div&&step<MAXS,path:s.path.concat([[x,z]])};}\nconst fresh=(n,kept,on)=>({x:START[0],z:START[1],step:0,n,on,div:false,path:[START],kept});\nexport function initialState(){return fresh(0,[],false);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||over(s)||e.tick%6?s:advance(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return over(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return advance({...s,on:false},inputs,seed);\nif(e.action==='newRun')return fresh(s.n,s.step>0?s.path:s.kept,true);\nreturn s;}\nconst cl=v=>Math.max(-CAP,Math.min(CAP,v));\nconst lift=p=>[cl(p[0]),Math.min(K*loss(p[0],p[1]),4)+0.04,cl(p[1])];\nfunction aim(dx,dz,shown){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return shown&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!over(s),[dx,dz]=next(s,inputs,seed),lr=inputs.learningRate;\nreturn {nodes:{\nball:{position:[cl(s.x),K*L+R,cl(s.z)]},\nstepArrow:aim(dx,dz,live),\nslopeArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),\ntrail:{points:s.path.map(lift)},\nghost:{points:s.kept.map(lift)}},\nreadouts:{steps:s.step,loss:L,arrowLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
