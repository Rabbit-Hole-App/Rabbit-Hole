      "id": "status",
      "label": "Status",
      "kind": "text"
    }
  ],
  "program": {
    "source": "const A=3,C=1,K=0.3,R=0.28,LIM=6,N=40,S0=2,X0=1.2,Z0=2.5;\nconst loss=(x,z)=>0.5*(A*x*x+C*z*z);\nconst rnd=(n,q)=>{const s=Math.sin((n+q*7.31)*12.9898+78.233)*43758.5453;return s-Math.floor(s);};\nconst gauss=(n,q)=>Math.sqrt(-2*Math.log(Math.max(1e-9,rnd(n,q))))*Math.cos(2*Math.PI*rnd(n+0.5,q));\nconst ended=s=>s.div||s.step>=N;\nconst word=s=>s.div?'diverged':s.step>=N?'finished':s.on?'running':'paused';\nfunction move(s,inp,q){const b=inp.batchSize,sd=S0*Math.sqrt(Math.max(0,64-b)/(63*b)),k=s.run*997+s.step*2+1,lr=inp.learningRate;return [-lr*(A*s.x+sd*gauss(k,q)),-lr*(C*s.z+sd*gauss(k+0.25,q))];}\nfunction adv(s,inp,q){if(ended(s))return s;const [dx,dz]=move(s,inp,q),x=s.x+dx,z=s.z+dz,div=loss(x,z)>LIM,step=s.step+1;return {...s,x,z,step,div,on:s.on&&!div&&step<N,path:s.path.concat([[x,z]])};}\nconst fresh=(run,kept)=>({x:X0,z:Z0,step:0,run,on:false,div:false,path:[[X0,Z0]],kept});\nexport function initialState(){return fresh(0,[]);}\nexport function reduce({state:s,event:e,inputs,seed}){\nif(e.type==='step')return !s.on||ended(s)||e.tick%6?s:adv(s,inputs,seed);\nif(e.type!=='action')return s;\nif(e.action==='run')return ended(s)?s:{...s,on:true};\nif(e.action==='pause')return {...s,on:false};\nif(e.action==='stepOnce')return adv({...s,on:false},inputs,seed);\nif(e.action==='newRun')return {...fresh(s.run+1,s.step>0?s.path:s.kept),on:true};\nreturn s;}\nconst cl=(v,m)=>Math.max(-m,Math.min(m,v));\nconst lift=p=>{const x=cl(p[0],2),z=cl(p[1],3.5);return [x,K*loss(x,z)+0.05,z];};\nfunction aim(dx,dz,show){const l=Math.hypot(dx,dz),h=Math.SQRT1_2;return show&&l>1e-6?{visible:true,quaternion:[dz/l*h,0,-dx/l*h,h],scale:[1,l,1]}:{visible:false};}\nexport function evaluate({inputs,state,seed}){\nconst s=state||initialState(),L=loss(s.x,s.z),live=!ended(s),[dx,dz]=move(s,inputs,seed),lr=inputs.learningRate,bx=cl(s.x,2),bz=cl(s.z,3.5);\nreturn {nodes:{ball:{position:[bx,K*loss(bx,bz)+R,bz]},stepArrow:aim(dx,dz,live),slopeArrow:aim(-lr*A*s.x,-lr*C*s.z,live&&inputs.showTrueGradient),trail:{points:s.path.map(lift)},ghost:{points:s.kept.map(lift)}},\nreadouts:{loss:L,steps:s.step,stepLen:live?Math.hypot(dx,dz):0,status:word(s)}};}\n"
  },
