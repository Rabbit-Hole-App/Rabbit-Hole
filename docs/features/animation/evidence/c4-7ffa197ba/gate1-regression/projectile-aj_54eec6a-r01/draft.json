  "program": {
    "source": "const G=9.8,TG=[30,45,18],R=Math.PI/180;\nfunction pt(a,v,t){return[v*Math.cos(a*R)*t,Math.max(0,v*Math.sin(a*R)*t-G*t*t/2)+1,0];}\nfunction ft(a,v){return 2*v*Math.sin(a*R)/G;}\nfunction arc(a,v,n,u){const T=ft(a,v),p=[];for(let i=0;i<=n;i++)p.push(pt(a,v,T*u*i/n));return p;}\nexport function initialState(){return{u:0,fly:false,a:45,v:15,prev:null,res:null,hits:0,n:0,ti:0};}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='action'&&e.action==='launch'){if(s.fly||s.hits>=3||s.n>=10)return s;return{...s,fly:true,u:0,a:inputs.angle,v:inputs.speed,n:s.n+1,prev:s.res?{a:s.a,v:s.v}:s.prev};}\nif(e.type==='step'&&s.fly){const u=Math.min(1,s.u+1/60);if(u<1)return{...s,u};\nconst T=ft(s.a,s.v),Rg=s.v*s.v*Math.sin(2*s.a*R)/G,m=Rg-TG[s.ti],hit=Math.abs(m)<=1.5+1e-9,vy=s.v*Math.sin(s.a*R);\nreturn{...s,u:1,fly:false,res:{R:Rg,m,hit,T,H:vy*vy/(2*G)},hits:s.hits+(hit?1:0),ti:hit?Math.min(s.ti+1,2):s.ti};}\nreturn s;}\nexport function evaluate({inputs,state:s}){\nconst th=(inputs.angle-90)*R/2,nodes={pivot:{quaternion:[0,0,Math.sin(th),Math.cos(th)]},target:{position:[TG[s.ti],0,0]}};\nconst shot=s.fly||s.res;\nif(shot){const p=arc(s.a,s.v,Math.max(1,Math.round(s.u*60)),s.u);nodes.trail={visible:true,points:p};nodes.ball={position:pt(s.a,s.v,ft(s.a,s.v)*s.u)};}\nelse{nodes.trail={visible:false,points:[]};nodes.ball={position:[0,1,0]};}\nnodes.ghost=s.prev?{visible:true,points:arc(s.prev.a,s.prev.v,50,1)}:{visible:false,points:[]};\nconst ro={used:s.n,hitsR:s.hits};let msg;\nif(s.res){ro.range=s.res.R;ro.miss=Math.abs(s.res.m);ro.side=s.res.hit?'hit':(s.res.m<0?'short':'long');ro.ftime=s.res.T;ro.peak=s.res.H;}\nlet st='playing';\nif(s.hits>=3){st='won';msg='All 3 targets hit in '+s.n+' launches!';}\nelse if(s.n>=10&&!s.fly){st='lost';msg='Out of launches: '+s.hits+' of 3 hit.';}\nelse if(s.fly)msg='Ball in flight...';\nelse if(s.res)msg=(s.res.hit?'Hit! ':'Missed ('+ro.side+'). ')+'Target at '+TG[s.ti]+' m. '+(10-s.n)+' launches left.';\nelse msg='Target at '+TG[s.ti]+' m. Set angle and speed, then Launch.';\nreturn{nodes,readouts:ro,goal:{status:st,message:msg}};}"
  }
