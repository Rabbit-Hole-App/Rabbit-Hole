{
  "title": "Projectile Target Challenge: Pick Angle and Speed",
  "description": "A launcher sits at the left end of a flat 70 m field with marks every 10 m. A red target zone 3 m wide with a flag sits down the field. Set the launch angle (the barrel tilts) and speed, then press Launch: an orange ball flies its arc, leaving a trail. Your previous arc stays as a faded grey dashed line. Readouts give landing distance, miss and side, flight time, peak height, launches used and targets hit. Hit targets at 30 m, 45 m and 18 m within 10 launches.",
  "experience": "game",
  "behavior": "rules",
  "controlProfile": "inspect",
  "stepped": true,
  "game": {
    "objective": "Hit three targets in turn (30 m, 45 m, then 18 m), landing within 1.5 m of each centre, using no more than 10 launches.",
    "hint": "With the same speed, angles that add up to 90° (like 30° and 60°) land at the same distance, and 45° goes farthest. Doubling the speed makes the shot go four times as far."
  },
  "parameters": [
    {
      "type": "number",
      "id": "angle",
      "label": "Launch angle",
      "unit": "°",
      "min": 10,
      "max": 80,
      "step": 1,
      "default": 45
