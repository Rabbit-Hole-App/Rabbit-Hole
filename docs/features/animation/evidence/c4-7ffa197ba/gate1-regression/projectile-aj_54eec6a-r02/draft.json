{
  "title": "Projectile Target Challenge: Pick Angle and Speed",
  "description": "A launcher sits at the left end of a flat 70 m field with marks every 10 m. A blue target disc with a yellow flag sits down the field. Set the launch angle and speed, then press Launch. The red ball flies along its arc and leaves a trail. The previous shot's arc stays as a faded line. Readouts show the landing distance, the miss and whether it fell short or long, the flight time, the highest point, launches used and targets hit.",
  "experience": "game",
  "behavior": "rules",
  "controlProfile": "inspect",
  "stepped": true,
  "game": {
    "objective": "Hit 3 targets (30 m, 45 m, then 18 m) using no more than 10 launches. A hit lands within 1.5 m of the target centre, edges included.",
    "hint": "At the same speed, angles that add up to 90° (like 30° and 60°) land at the same spot, and 45° goes farthest. Doubling the speed makes the shot go 4 times as far."
  },
  "parameters": [
    {
      "type": "number",
      "id": "angle",
      "label": "Launch angle",
      "unit": "°",
      "min": 10,
      "max": 80,
      "step": 1,
      "default": 45
    },
    {
      "type": "number",
      "id": "speed",
      "label": "Launch speed",
      "unit": "m/s",
      "min": 5,
      "max": 25,
      "step": 0.5,
      "default": 15
    }
