  "program": {
    "source": "const G=9.8,N=60,TG=[30,45,18],HR=1.5,BR=1.4;\nfunction pt(a,v,f){const r=a*Math.PI/180,T=2*v*Math.sin(r)/G,t=T*f;return [v*Math.cos(r)*t,v*Math.sin(r)*t-G*t*t/2+BR,0];}\nfunction pts(a,v,k){const o=[];for(let i=0;i<=k;i++)o.push(pt(a,v,i/N));return o;}\nfunction over(s){return !s.fly&&(s.h>=3||s.n>=10);}\nexport function initialState(){return {fly:false,k:0,a:45,v:15,n:0,h:0,ti:0,last:null,prev:null};}\nexport function reduce({state:s,event:e,inputs}){\nif(e.type==='action'&&e.action==='launch'){if(s.fly||over(s))return s;return {...s,fly:true,k:0,a:inputs.angle,v:inputs.speed,n:s.n+1,prev:s.last?{a:s.last.a,v:s.last.v}:null};}\nif(e.type==='step'&&s.fly){const k=s.k+1;if(k<N)return {...s,k};\nconst r=s.a*Math.PI/180,d=s.v*s.v*Math.sin(2*r)/G,tg=TG[s.ti],m=d-tg,hit=Math.abs(m)<=HR;\nreturn {...s,fly:false,k:N,h:s.h+(hit?1:0),ti:hit?Math.min(s.ti+1,2):s.ti,last:{a:s.a,v:s.v,d,m,hit,tg,T:2*s.v*Math.sin(r)/G,H:Math.pow(s.v*Math.sin(r),2)/(2*G)}};}\nreturn s;}\nexport function evaluate({inputs,state:s}){\nconst th=(inputs.angle-90)*Math.PI/180,nodes={gun:{quaternion:[0,0,Math.sin(th/2),Math.cos(th/2)]}};\nconst L=s.last;let bp=[0,BR,0];\nif(s.fly){bp=pt(s.a,s.v,s.k/N);nodes.trail={visible:true,points:pts(s.a,s.v,s.k)};}\nelse if(L){bp=[L.d,BR,0];nodes.trail={visible:true,points:pts(L.a,L.v,N)};}\nelse nodes.trail={visible:false,points:[]};\nnodes.ball={position:bp};\nnodes.prev=s.prev?{visible:true,points:pts(s.prev.a,s.prev.v,N)}:{visible:false,points:[]};\nconst won=s.h>=3;nodes.target={position:[TG[s.ti],0,0],visible:!won||s.fly};\nconst ro={used:s.n,hits:s.h};\nif(L){ro.dist=L.d;ro.miss=Math.abs(L.m);ro.side=L.hit?'Hit':(L.m<0?'Short':'Long');ro.ftime=L.T;ro.hmax=L.H;}\nlet st='playing',msg='Target at '+TG[s.ti]+' m. Set angle and speed, then Launch.';\nif(L&&!s.fly)msg=(L.hit?'Hit! ':'Missed '+Math.abs(L.m).toFixed(1)+' m '+(L.m<0?'short. ':'long. '))+msg;\nif(s.fly)msg='In flight...';\nif(!s.fly&&won){st='won';msg='You hit all 3 targets in '+s.n+' launches!';}\nelse if(over(s)){st='lost';msg='Out of launches: '+s.h+' of 3 targets hit.';}\nreturn {nodes,readouts:ro,goal:{status:st,message:msg}};}\n"
  }
