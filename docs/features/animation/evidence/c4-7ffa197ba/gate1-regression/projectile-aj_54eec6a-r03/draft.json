  "assumptions": [
    "Simplified simulation: no air resistance, and the ball starts at ground level on flat ground.",
    "Gravity is 9.8 m/s² straight down; the sideways speed stays constant and only the vertical speed changes. Landing distance = speed² × sin(2 × angle) ÷ 9.8.",
    "The ball is a point for the physics; it is drawn as a 1.4 m sphere resting on that point so it can be seen, and its trail follows the sphere's centre.",
    "Every flight is shown over 2 seconds whatever its real flight time, so screen time does not match the flight-time readout.",
    "Targets come in a fixed order (30 m, 45 m, 18 m). Reset starts the same challenge again and clears the score and trails."
  ],
  "program": {
    "source": "const G=9.8,TG=[30,45,18],N=60,R0=1.4,D=Math.PI/180;\nfunction kin(c){const r=c.a*D,vx=c.v*Math.cos(r),vy=c.v*Math.sin(r);return{vx,vy,T:2*vy/G}}\nfunction pt(c,f){const k=kin(c),t=k.T*f;return[k.vx*t,Math.max(0,k.vy*t-G*t*t/2)+R0,0]}\nfunction arc(c,f){const n=Math.max(2,Math.ceil(60*f)),p=[];for(let i=0;i<=n;i++)p.push(pt(c,f*i/n));return p}\nexport function initialState(){return{phase:'ready',f:0,shots:0,hits:0,cur:null,prev:null,res:null}}\nexport function reduce({state,event,inputs}){const s=state;\nif(event.type==='action'&&event.action==='launch'){if(s.phase!=='ready')return s;return{...s,phase:'flying',f:0,shots:s.shots+1,prev:s.cur,cur:{a:inputs.angle,v:inputs.speed}}}\nif(event.type==='step'&&s.phase==='flying'){const f=Math.min(1,s.f+1/N);if(f<1)return{...s,f};\nconst c=s.cur,k=kin(c),R=c.v*c.v*Math.sin(2*c.a*D)/G,tg=TG[Math.min(s.hits,2)],m=R-tg,hit=Math.abs(m)<=1.5,hits=s.hits+(hit?1:0);\nconst res={R,m,hit,T:k.T,H:k.vy*k.vy/(2*G),tg};\nreturn{...s,f:1,hits,res,phase:hits>=3?'won':s.shots>=10?'lost':'ready'}}\nreturn s}\nexport function evaluate({inputs,state}){const s=state,th=-(90-inputs.angle)*D;\nconst nodes={pivot:{quaternion:[0,0,Math.sin(th/2),Math.cos(th/2)]},tgt:{position:[TG[Math.min(s.hits,2)],0,0]}};\nnodes.ballN={position:s.cur?pt(s.cur,s.f):[0,R0,0]};\nnodes.trail=s.cur?{visible:true,points:arc(s.cur,s.f)}:{visible:false};\nnodes.ghost=s.prev?{visible:true,points:arc(s.prev,1)}:{visible:false};\nconst ro={shots:s.shots,hits:s.hits};let msg='Set angle and speed, then press Launch. Target at '+TG[Math.min(s.hits,2)]+' m.';\nif(s.res){const r=s.res;ro.dist=r.R;ro.miss=Math.abs(r.m);ro.side=r.hit?'hit':(r.m<0?'short':'long');ro.ftime=r.T;ro.hmax=r.H;\nif(s.phase!=='flying')msg=(r.hit?'Hit! ':'Missed the '+r.tg+' m target: '+Math.abs(r.m).toFixed(1)+' m '+(r.m<0?'short. ':'long. '))+(s.phase==='ready'?'Next target at '+TG[Math.min(s.hits,2)]+' m. '+(10-s.shots)+' launches left.':'')}\nif(s.phase==='flying')msg='Ball in flight...';\nlet status='playing';if(s.phase==='won'){status='won';msg='All 3 targets hit in '+s.shots+' launches!'}else if(s.phase==='lost'){status='lost';msg+=' Out of launches: '+s.hits+' of 3 targets hit.'}\nreturn{nodes,readouts:ro,goal:{status,message:msg}}}"
  }
