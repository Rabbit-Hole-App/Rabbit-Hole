  "source": "const ph=(s,t)=>s.p0+(t-s.t0)*s.rate/60;\nconst Q=a=>[0,0,Math.sin(a/2),Math.cos(a/2)];\nexport function initialState({inputs}){return {p0:0,t0:0,rate:inputs.pedalRate,sel:null};}\nexport function reduce({state,event,inputs,time}){\nif(event.type==='parameter'){if(inputs.pedalRate!==state.rate)return {...state,p0:ph(state,time),t0:time,rate:inputs.pedalRate};return state;}\nif(event.type==='select'){const id=event.nodeId??event.node??event.id??null;return {...state,sel:id};}\nreturn state;}\nexport function evaluate({inputs,time,state}){\nconst F=inputs.frontTeeth,R=inputs.rearTeeth,D=inputs.wheelDiameter;\nconst rf=F*0.012,rr=R*0.012,rw=D/100*1.2;\nconst turns=ph(state,time),ratio=F/R,wt=turns*ratio;\nconst ap=-2*Math.PI*turns,aw=-2*Math.PI*wt;\nconst dx=2.2,dy=rf-rr,len=Math.hypot(dx,dy),ang=Math.atan2(dy,dx);\nconst L=inputs.showLabels,s=state.sel;\nreturn {nodes:{\nring:{quaternion:Q(ap)},ringDisc:{scale:[rf,0.06,rf]},\nspr:{quaternion:Q(aw)},sprDisc:{scale:[rr,0.06,rr]},sprMark:{position:[0,rr*0.7,0.04]},\nwheel:{quaternion:Q(aw)},wheelDisc:{scale:[rw,0.03,rw]},spoke:{position:[0,rw/2,0.03],scale:[0.04,rw,0.03]},\nchainTop:{position:[-1.1,(rf+rr)/2,0],quaternion:Q(ang),scale:[len,0.03,0.03]},\nchainBot:{position:[-1.1,-(rf+rr)/2,0],quaternion:Q(-ang),scale:[len,0.03,0.03]},\naRing:{position:[rf+0.05,0,0.3],visible:L},tRing:{text:s==='ringDisc'?F+' teeth':'Front chainring',visible:L},\naSpr:{position:[-2.2,-rr-0.03,0.3],visible:L},tSpr:{text:s==='sprDisc'?R+' teeth':'Rear sprocket',visible:L},\naWheel:{position:[-2.2,rw+0.03,0.2],visible:L},tWheel:{text:s==='wheelDisc'?D+' cm wheel':'Back wheel',visible:L}},\nreadouts:{ratio:ratio,wheelPerPedal:ratio,distPerPedal:ratio*Math.PI*D/100,pedalTurns:turns,wheelTurns:wt},\nselection:s};}",
