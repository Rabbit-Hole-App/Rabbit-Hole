  "source": "const G={earth:9.81,moon:1.62,mars:3.71};\nexport function evaluate({inputs,time}){\nconst L=Number(inputs.length)||1;\nconst g=G[inputs.gravity]||9.81;\nconst T=2*Math.PI*Math.sqrt(L/g);\nconst a0=(Number(inputs.amplitude)||10)*Math.PI/180;\nconst th=a0*Math.cos(2*Math.PI*time/T);\nconst h=th/2;\nreturn{nodes:{pend:{quaternion:[0,0,Math.sin(h),Math.cos(h)]},str:{position:[0,-L/2,0],scale:[1,L,1]},lenLabel:{position:[0.02,-L/2,0]},bobNode:{position:[0,-L,0]}},readouts:{period:T,len:L,angle:th*180/Math.PI}};\n}",
