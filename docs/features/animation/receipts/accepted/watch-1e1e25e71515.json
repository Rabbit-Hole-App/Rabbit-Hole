  "source": "const D=12;\nexport function evaluate({time}){\n  const t=((time%D)+D)%D;\n  const a=2*Math.PI*2*t/D;\n  const h=a/2;\n  const amp=0.15;\n  const c=amp*Math.sin(2*Math.PI*t/4);\n  const hc=c/2;\n  let deg=(a*180/Math.PI)%360;\n  return {\n    nodes:{\n      rotor:{quaternion:[0,Math.sin(h),0,Math.cos(h)]},\n      chainPivot:{quaternion:[0,0,Math.sin(hc),Math.cos(hc)]}\n    },\n    readouts:{bladeAngle:deg,chainAngle:c*180/Math.PI}\n  };\n}\n",
