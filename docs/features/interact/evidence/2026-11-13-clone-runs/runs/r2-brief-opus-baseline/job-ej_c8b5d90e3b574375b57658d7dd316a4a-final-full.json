        "source": "export function evaluate({ inputs, time }) {\n  const g = 9.8;\n  const u = sdk.clamp(Number(inputs.launchSpeed), 2, 5);\n  const tEnd = 2 * u / g;\n  const t = sdk.clamp(Number(time) || 0, 0, tEnd);\n  const apexTime = u / g;\n  const apexHeight = u * u / (2 * g);\n  const velocity = u - g * t;\n  const height = Math.max(0, u * t - g * t * t / 2);\n  const W = 640, H = 420;\n  const axisX = 100, baseY = 340, axisLen = 290, hMax = 1.4;\n  const px = axisLen / hMax;\n  const ballX = 230;\n  const ballY = baseY - height * px;\n  const still = Math.abs(velocity) < 0.05;\n  const state = still ? 'Still for an instant' : (velocity > 0 ? 'Moving up' : 'Moving down');\n  const code = still ? 0 : (velocity > 0 ? 1 : -1);\n  const objs = [];\n  objs.push(sdk.axis('heightAxis', { x: axisX, y: baseY, length: axisLen, orientation: 'y', min: 0, max: hMax, label: 'Height above launch', unit: 'm' }));\n  objs.push(...sdk.groundMark('launchGuide', 380, baseY, 500, 'Launch height'));\n  objs.push(sdk.circle('ball', ballX, ballY, 24, { role: 'neutral' }));\n  const vMag = still ? 0 : Math.abs(velocity);\n  if (vMag > 0) {\n    objs.push(...sdk.vector('motionArrow', { x: ballX - 32, y: ballY }, { value: vMag, direction: velocity > 0 ? 'up' : 'down' }, { scale: 10, label: 'Motion', role: 'input' }));\n  }\n  objs.push(...sdk.vector('gravityArrow', { x: ballX + 32, y: ballY }, { value: g, direction: 'down' }, { scale: 5, label: 'Gravity', role: 'warning' }));\n  const cy = sdk.clamp(ballY - 40, 40, 280);\n  objs.push(...sdk.callout(ballX + 90, cy, [state, 'Gravity pulls down'], { id: 'stateCallout', role: 'neutral' }));\n  return {\n    frame: { width: W, height: H, objects: objs, readouts: [ { id: 'motionState', value: state }, { id: 'gravityState', value: 'Gravity pulls down' } ] },\n    quantities: { launchSpeed: u, gravity: g, apexTime: apexTime, apexHeight: apexHeight, velocity: velocity, height: height, motionState: code, gravityState: -g }\n  };\n}\n",
