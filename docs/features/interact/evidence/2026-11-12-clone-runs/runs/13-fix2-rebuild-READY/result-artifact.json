    "source": "export function evaluate({ inputs, time }) {\n  const g = 9.8;\n  const u = Number(inputs && inputs.launchSpeed != null ? inputs.launchSpeed : 3);\n  const show = !(inputs && inputs.showArrows === 'off');\n  const tA = u / g;\n  const tEnd = 2 * u / g;\n  const t = sdk.clamp(Number(time) || 0, 0, tEnd);\n  let v = u - g * t;\n  if (Math.abs(v) < 1e-9) v = 0;\n  let h = u * t - g * t * t / 2;\n  if (Math.abs(h) < 1e-12) h = 0;\n  const a = -g;\n  const hTop = u * u / (2 * g);\n  const released = t >= tA - 1e-9;\n  const dtr = released ? Math.max(0, t - tA) : 0;\n  let vh = released ? -g * dtr : 0;\n  if (Math.abs(vh) < 1e-9) vh = 0;\n  const hh = released ? -g * dtr * dtr / 2 : 0;\n\n  const S = 110;\n  const launchY = 200;\n  const yOf = (m) => launchY - m * S;\n  const xT = 240, xH = 460, axisX = 60;\n  const off = 45;\n  const objs = [];\n\n  objs.push(sdk.text('axisTitle', axisX - 30, 28, 'height (m), up +', { align: 'start' }));\n  objs.push(sdk.line('axis', axisX, yOf(1.35), axisX, yOf(-1.35)));\n  [-1, 0, 1].forEach((m) => {\n    const id = m < 0 ? 'm1' : (m === 0 ? 'z0' : 'p1');\n    objs.push(sdk.line('tick_' + id, axisX - 6, yOf(m), axisX + 6, yOf(m)));\n    objs.push(sdk.text('tickL_' + id, axisX - 14, yOf(m) + 5, String(m), { align: 'middle' }));\n  });\n\n  objs.push(sdk.text('nameT', xT, 28, 'Tossed ball', { align: 'middle' }));\n  objs.push(sdk.text('nameH', xH, 28, 'Held ball', { align: 'middle' }));\n\n  objs.push(...sdk.groundMark('launch', xT, launchY + 13, 60));\n  objs.push(sdk.text('launchText', axisX + 14, launchY + 18, 'Launch mark', { align: 'start' }));\n\n  const yTop = yOf(hTop);\n  objs.push({ kind: 'line', id: 'apexLine', from: { x: xT - 32, y: yTop }, to: { x: xT + 32, y: yTop }, role: 'neutral', opacity: 0.5 });\n  objs.push(sdk.text('apexText', xT + 60, yTop + 5, 'top ' + sdk.format(hTop, 3) + ' m', { align: 'start' }));\n\n  objs.push(...sdk.gate('gate', xH, launchY + 13, { open: released }));\n  objs.push(sdk.text('gateText', xH + 62, launchY + 18, 'Release gate', { align: 'start' }));\n\n  const yT = yOf(h);\n  const yH = yOf(hh);\n  objs.push(sdk.circle('ballT', xT, yT, 24, { role: 'input' }));\n  objs.push(sdk.circle('ballH', xH, yH, 24, { role: 'observed' }));\n\n  if (show) {\n    objs.push(sdk.circle('vDotT', xT - off, yT, 6, { role: 'output' }));\n    objs.push(...sdk.vector('vT', { x: xT - off, y: yT }, { value: Math.abs(v), direction: v >= 0 ? 'up' : 'down' }, { scale: 10, label: 'v', role: 'output' }));\n    objs.push(...sdk.vector('aT', { x: xT + off, y: yT }, { value: Math.abs(a), direction: 'down' }, { scale: 4.5, label: 'a', role: 'warning' }));\n    objs.push(sdk.circle('vDotH', xH - off, yH, 6, { role: 'output' }));\n    objs.push(...sdk.vector('vH', { x: xH - off, y: yH }, { value: Math.abs(vh), direction: vh >= 0 ? 'up' : 'down' }, { scale: 10, label: 'v', role: 'output' }));\n    if (released) {\n      objs.push(...sdk.vector('aH', { x: xH + off, y: yH }, { value: g, direction: 'down' }, { scale: 4.5, label: 'a', role: 'warning' }));\n    }\n  }\n\n  const readouts = [\n    { id: 'tossedHeight', value: h },\n    { id: 'tossedVelocity', value: v },\n    { id: 'tossedAcceleration', value: a }\n  ];\n  return {\n    frame: { width: 640, height: 420, objects: objs, readouts: readouts },\n    quantities: {\n      launchSpeed: u, gravity: g, velocity: v, acceleration: a, apexTime: tA, height: h,\n      tossedHeight: h, tossedVelocity: v, tossedAcceleration: a\n    }\n  };\n}\n",
