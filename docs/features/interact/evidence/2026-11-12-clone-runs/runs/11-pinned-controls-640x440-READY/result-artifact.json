    "source": "const G = 9.8, S = 100, Y0 = 190, VS = 18, AS = 4;\nconst XT = 230, XH = 430;\nfunction fx(v) { const r = Math.abs(v) < 0.005 ? 0 : v; return sdk.format(r, 2); }\nexport function evaluate({ inputs, time }) {\n  let u = Number(inputs && inputs.launchSpeed);\n  if (!isFinite(u)) u = 3;\n  u = sdk.clamp(u, 3, 5);\n  const show = !(inputs && inputs.showArrows === 'off');\n  const T = u / G, end = 2 * T;\n  const t = sdk.clamp(Number(time) || 0, 0, end);\n  const h = u * t - G * t * t / 2;\n  const v = u - G * t;\n  const a = -G;\n  const released = t >= T;\n  const td = Math.max(0, t - T);\n  const hh = -G * td * td / 2;\n  const hv = released ? -G * td : 0;\n  const ha = released ? -G : 0;\n  const apexH = u * u / (2 * G);\n  const yT = Y0 - h * S, yH = Y0 - hh * S, yA = Y0 - apexH * S;\n  const o = [];\n  o.push(sdk.line('axis', 90, 40, 90, 425, { role: 'neutral' }));\n  o.push(sdk.text('axisLabel', 90, 30, 'height', { align: 'middle' }));\n  [[1, 'm1'], [0, 'z0'], [-1, 'n1']].forEach(([m, k]) => {\n    const y = Y0 - m * S;\n    o.push(sdk.line('tick' + k, 84, y, 96, y, { role: 'neutral' }));\n    o.push(sdk.text('tickL' + k, 44, y + 5, m + ' m'));\n  });\n  o.push(sdk.line('launchLine', 100, Y0, 470, Y0, { role: 'neutral', opacity: 0.6 }));\n  o.push(sdk.text('launchLabel', 105, Y0 - 8, 'launch'));\n  o.push(sdk.line('apexLine', XT + 32, yA, XT + 100, yA, { role: 'success', opacity: 0.8 }));\n  o.push(sdk.text('apexLabel', XT + 106, yA + 5, 'top: ' + sdk.format(apexH, 2) + ' m, ' + sdk.format(T, 2) + ' s'));\n  o.push(sdk.text('titleT', XT, 24, 'Tossed ball', { align: 'middle' }));\n  o.push(sdk.text('titleH', XH, 24, 'Held ball', { align: 'middle' }));\n  const PX = XH + 46;\n  if (released) {\n    o.push(sdk.line('gate', PX, Y0 + 12, PX, Y0 + 46, { role: 'warning' }));\n  } else {\n    o.push(sdk.line('gate', XH - 14, Y0 + 12, PX, Y0 + 12, { role: 'warning' }));\n  }\n  o.push(sdk.box('gatePivot', PX - 4, Y0 + 8, 8, 8, { role: 'warning' }));\n  o.push(sdk.text('gateLabel', PX + 8, Y0 + 32, released ? 'gate open' : 'gate'));\n  o.push(sdk.circle('tossedBall', XT, yT, 22, { role: 'observed' }));\n  o.push(sdk.circle('heldBall', XH, yH, 22, { role: 'input' }));\n  function arrows(p, x, y, vel, acc) {\n    const L = vel * VS;\n    if (Math.abs(L) < 4) {\n      o.push(sdk.circle(p + 'vDot', x - 20, y, 8, { role: 'output' }));\n      o.push(sdk.text(p + 'vL', x - 20, y - 12, 'v', { align: 'middle' }));\n    } else {\n      o.push(sdk.arrow(p + 'v', x - 20, y, x - 20, y - L, { role: 'output' }));\n      o.push(sdk.text(p + 'vL', x - 42, y - L / 2 + 5, 'v'));\n    }\n    if (acc !== 0) {\n      const A = acc * AS;\n      o.push(sdk.arrow(p + 'a', x + 20, y, x + 20, y - A, { role: 'warning' }));\n      o.push(sdk.text(p + 'aL', x + 26, y - A / 2 + 5, 'a'));\n    }\n  }\n  if (show) { arrows('t', XT, yT, v, a); arrows('h', XH, yH, hv, ha); }\n  const X = 500;\n  o.push(sdk.text('valT', X, 70, 'Tossed'));\n  o.push(sdk.text('valTh', X, 94, 'h = ' + fx(h) + ' m'));\n  o.push(sdk.text('valTv', X, 118, 'v = ' + fx(v) + ' m/s'));\n  o.push(sdk.text('valTa', X, 142, 'a = ' + fx(a) + ' m/s²'));\n  o.push(sdk.text('valH', X, 270, released ? 'Held (falling)' : 'Held (on gate)'));\n  o.push(sdk.text('valHv', X, 294, 'v = ' + fx(hv) + ' m/s'));\n  o.push(sdk.text('valHa', X, 318, 'a = ' + fx(ha) + ' m/s²'));\n  const readouts = [\n    { id: 'tossedHeight', value: h },\n    { id: 'tossedVelocity', value: v },\n    { id: 'tossedAcceleration', value: a }\n  ];\n  return {\n    frame: { width: 640, height: 440, objects: o, readouts },\n    quantities: {\n      launchSpeed: u, gravity: G, velocity: v, acceleration: a, apexTime: T, height: h,\n      tossedHeight: h, tossedVelocity: v, tossedAcceleration: a,\n      heldHeight: hh, heldVelocity: hv, heldAcceleration: ha, apexHeight: apexH\n    }\n  };\n}\n",
