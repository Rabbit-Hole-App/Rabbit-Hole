        "source": "const T={\"title\":\"How does a word attend to the others?\",\"start\":2,\"words\":[\"The\",\"cat\",\"sat\",\"on\",\"the\",\"mat\"],\"weights\":[[0.4,0.35,0.1,0.05,0.05,0.05],[0.3,0.4,0.15,0.05,0.04,0.06],[0.05,0.4,0.3,0.1,0.05,0.1],[0.05,0.1,0.35,0.2,0.1,0.2],[0.1,0.05,0.1,0.15,0.2,0.4],[0.05,0.05,0.1,0.25,0.35,0.2]],\"layout\":{\"pictureCount\":\"one\",\"runs\":\"left-to-right\",\"panelRole\":\"none\",\"figureParts\":{\"title\":false,\"caption\":false}},\"values\":[{\"quantity\":\"word\",\"label\":\"Word\",\"role\":\"input\"},{\"quantity\":\"target\",\"label\":\"Attends to\",\"role\":\"warning\"},{\"quantity\":\"weight\",\"label\":\"Weight\",\"role\":\"warning\"}],\"formula\":\"\\\\alpha_j = \\\\mathrm{softmax}_j(q \\\\cdot k_j)\",\"note\":\"{word} looks most at {target}.\",\"geometry\":{\"min\":{\"width\":174,\"height\":238}}},L={\"layout\":\"wide\",\"figure\":{\"at\":[12,12],\"w\":616},\"values\":[{\"quantity\":\"word\",\"label\":\"Word\",\"role\":\"input\",\"box\":[12,320.4,200,28],\"dot\":[26,334.4,10]},{\"quantity\":\"target\",\"label\":\"Attends to\",\"role\":\"warning\",\"box\":[220,320.4,200,28],\"dot\":[234,334.4,10]},{\"quantity\":\"weight\",\"label\":\"Weight\",\"role\":\"warning\",\"box\":[428,320.4,200,28],\"dot\":[442,334.4,10]}],\"formulaAt\":[138,372.8],\"noteBox\":[272,358.8,356,28]};\nconst largest=(row9) => row9.reduce((best2, weight2, k4) => weight2 > row9[best2] ? k4 : best2, 0);\nexport function evaluate({inputs}){\n  const i=inputs.step===undefined?T.start:inputs.step;\n  if(!Number.isInteger(i)||i<0||i>=T.words.length)throw new RangeError('step outside the words');\n  const row=T.weights[i],j=largest(row),shown={word:T.words[i],target:T.words[j],weight:row[j].toFixed(2)};\n  const spec={version:1,diagram:{kind:'token-links',title:T.title,source:T.words,target:T.words,queries:[{index:i,weights:row}]}};\n  const objects=[sdk.diagram(spec,{x:L.figure.at[0],y:L.figure.at[1],w:L.figure.w})];\n  L.values.forEach((entry,k)=>objects.push(sdk.box('value.'+k,entry.box[0],entry.box[1],entry.box[2],entry.box[3],{role:'neutral',text:entry.label+': '+shown[entry.quantity]}),sdk.circle('chip.'+k,entry.dot[0],entry.dot[1],entry.dot[2],{role:entry.role})));\n  // the formula is a math run with no box: a text object's row sits 0.35 of its font size above the y given, so y is the slot's centre plus 5.25 at 15 px\n  objects.push(sdk.math('formula',L.formulaAt[0],L.formulaAt[1]+5.25,T.formula,{align:'middle',role:'neutral'}));\n  objects.push(sdk.box('note',L.noteBox[0],L.noteBox[1],L.noteBox[2],L.noteBox[3],{role:'neutral',text:T.note.replace('{word}',shown.word).replace('{target}',shown.target)}));\n  return {frame:sdk.frame(objects,{width:640,height:400}),quantities:{}};\n}",
