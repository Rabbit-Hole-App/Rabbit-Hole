        "source": "\nconst EPS = 1e-8;\nconst sg = (v, d) => { const a = Math.abs(v); if (a < 0.5 * Math.pow(10, -d)) return (0).toFixed(d); return (v < 0 ? '−' : '+') + a.toFixed(d); };\nconst snap = x => Math.abs(x) < 1e-9 ? 0 : x;\nconst Q = {\n  \"launchSpeed\": (inputs, t) => { const { launchSpeed } = inputs; return launchSpeed; },\n  \"gravity\": (inputs, t) => { const { launchSpeed } = inputs; return 9.81; },\n  \"apexTime\": (inputs, t) => { const { launchSpeed } = inputs; return (launchSpeed / 9.81); },\n  \"apexHeight\": (inputs, t) => { const { launchSpeed } = inputs; return ((launchSpeed * launchSpeed) / (2 * 9.81)); },\n  \"velocity\": (inputs, t) => { const { launchSpeed } = inputs; return (launchSpeed - (9.81 * t)); },\n  \"height\": (inputs, t) => { const { launchSpeed } = inputs; return ((launchSpeed * t) - ((0.5 * 9.81) * (t * t))); },\n  \"acceleration\": (inputs, t) => { const { launchSpeed } = inputs; return (0 - 9.81); },\n};\nconst quantities = (inputs, time) => { const end = END(inputs), t = Math.min(Math.max(time, 0), end), out = {}; for (const id in Q) out[id] = snap(Q[id](inputs, t)); return out; };\nconst END = inputs => { const { launchSpeed } = inputs; return ((2 * launchSpeed) / 9.81); };\n// One body: heights are read above its launch height (its height at time 0), time is held inside the timeline. The top is where its velocity crosses zero (found by bisection on the plan's own\n// velocity formula, so no quantity has to name it); a body whose velocity never starts positive has its top at time 0.\nconst topOf = (inputs, end) => {\n  const v = Q[\"velocity\"];\n  if (v(inputs, 0) <= 0) return 0;\n  let lo = 0, hi = end;\n  for (let i = 0; i < 60; i++) { const mid = (lo + hi) / 2; if (v(inputs, mid) > 0) lo = mid; else hi = mid; }\n  return (lo + hi) / 2;\n};\nconst motion = (inputs, time) => {\n  const end = END(inputs), t = Math.min(Math.max(time, 0), end), top = topOf(inputs, end), base = Q[\"height\"](inputs, 0);\n  const v = snap(Q[\"velocity\"](inputs, t));\n  return { top, end, t, peak: Q[\"height\"](inputs, top) - base, h: snap(Q[\"height\"](inputs, t) - base), v, a: Q[\"acceleration\"](inputs, t), tau: t - top, launch: t < EPS, ended: t >= end - EPS };\n};\n\nconst W = {\"lane\":\"Vertical Lane\",\"launch\":\"Launch Mark\",\"gravity\":{\"pulls\":\"Gravity pulls down\",\"none\":\"No gravity\"},\"motion\":{\"up\":\"Moving up\",\"top\":\"At the top\",\"down\":\"Moving down\"},\"where\":{\"launch\":\"Thrown from launch\",\"top\":\"At highest point\",\"end\":\"Back at launch height\",\"up\":\"Rising\",\"down\":\"Falling\"},\"readout\":{\"motion\":\"Motion\",\"gravity\":\"Gravity\"}};\nconst READOUTS = [\"motionState\",\"gravityState\"];\nexport function evaluate({ inputs, time }) {\n  const m = motion(inputs, time), atTop = Math.abs(m.tau) < EPS, qs = quantities(inputs, time);\n  const FLOOR = 230, S = 8.3385, X = 200, R = 18, LANE = {\"x\":12,\"y\":34,\"w\":616,\"h\":232}, y = FLOOR - m.h * S, pulls = m.a < 0;\n  const word = atTop ? W.motion.top : m.v > 0 ? W.motion.up : W.motion.down;\n  const where = m.launch ? W.where.launch : atTop ? W.where.top : m.ended ? W.where.end : m.v > 0 ? W.where.up : W.where.down;\n  const objects = [\n    ...sdk.panel({ id: 'lane.toss', x: LANE.x, y: LANE.y, w: LANE.w, h: LANE.h, title: W.lane, state: where }),\n    sdk.line('guide.launch', LANE.x + 18, FLOOR, LANE.x + LANE.w - 18, FLOOR, { opacity: 0.5 }),\n    sdk.text('label.launch', LANE.x + 18, FLOOR + 26, W.launch),\n    sdk.line('guide.toss', X, FLOOR, X, y, { opacity: 0.35 }),\n  ];\n  if (!m.launch) objects.push(sdk.circle('ghost.toss', X, FLOOR, 2 * R, { opacity: 0.35 }));\n  objects.push(sdk.circle('ball.toss', X, y, 2 * R));\n  // A letter keeps 14 px off the ground line (the 8 px label clearance plus half its height): it moves along its arrow, beside it, never onto the line.\n  const clear = parts => { const letter = parts.find(o => o.kind === 'text'); if (letter && Math.abs(letter.y - FLOOR) < 14) letter.y = FLOOR + (letter.y < FLOOR ? -14 : 14); return parts; };\n  if (!atTop) objects.push(...clear(sdk.vector('vec.v', { x: X - 31, y: y }, { value: Math.abs(m.v), direction: m.v > 0 ? 'up' : 'down' }, { scale: 12, minLength: 3, label: 'v', side: m.v > 0 ? 'left' : 'right' })));\n  if (Math.abs(m.a) > 1e-9) objects.push(...clear(sdk.vector('vec.a', { x: X + 31, y: y }, { value: Math.abs(m.a), direction: pulls ? 'down' : 'up' }, { scale: 48 / Math.abs(m.a), label: 'a', side: 'left' })));\n  objects.push(...sdk.callout(X + 61, sdk.clamp(y - 24, 40, FLOOR - 43), [word, pulls ? W.gravity.pulls : W.gravity.none], { id: 'callout.toss' }));\n  const states = { motionState: word, gravityState: pulls ? W.gravity.pulls : W.gravity.none };\n  return {\n    frame: sdk.frame(objects, { width: 640, height: 280, readouts: READOUTS.map(id => ({ id: id, value: id in states ? states[id] : qs[id] })) }),\n    quantities: qs,\n  };\n}",
