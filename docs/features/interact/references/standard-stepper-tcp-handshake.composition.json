  "schemaVersion": 1,
  "status": "reference-proposal",
  "id": "standard-stepper-tcp-handshake",
  "family": "stepper-states",
  "depth": "balanced",
  "canonical": "protocol-between-parties",
  "story": "Client learns Server’s starting sequence number from SYN-ACK. Only the final ACK tells Server its reply arrived. SEQ marks a position; ACK names the next expected position.",
  "aha": {
    "stateId": "confirmed",
    "observation": "Only receiving the final ACK lets Server know its SYN-ACK reached Client."
  },
  "layout": {
    "preset": "protocol-between-parties",
    "width": 640
  },
  "parts": [
    {
      "id": "rail",
      "kind": "step-rail",
      "bind": {
        "items": "variant.states",
        "active": "inputs.step"
      }
    },
    {
      "id": "picture",
      "kind": "fixed-picture",
      "bind": {
        "regions": "variant.regions",
        "links": "variant.links",
        "active": "state.active"
