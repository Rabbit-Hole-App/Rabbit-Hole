{
  "schemaVersion": 1,
  "status": "reference-proposal",
  "id": "standard-stepper-merge-sort",
  "family": "stepper-states",
  "depth": "balanced",
  "canonical": "algorithm-over-collection",
  "story": "Input becomes Left half, Right half, then Singles. Merge left and Merge right create ordered runs for Sorted output. Compare a mixed and an already sorted input: splitting alone does not sort.",
  "aha": {
    "stateId": "finish",
    "observation": "The merge creates order by taking the smaller head from two already ordered runs; splitting alone does not sort."
  },
  "layout": {
    "preset": "algorithm-over-collection",
    "width": 640
  },
  "parts": [
    {
      "id": "rail",
      "kind": "step-rail",
      "bind": {
        "items": "variant.states",
        "active": "inputs.step"
      }
    },
    {
      "id": "picture",
      "kind": "fixed-picture",
      "bind": {
        "regions": "variant.regions",
        "links": "variant.links",
        "active": "state.active"
      }
    },
    {
      "id": "callout",
      "kind": "active-callout",
      "bind": {
        "target": "state.calloutRegion",
        "text": "state.sentence"
      }
    },
    {
      "id": "ghost",
      "kind": "previous-state-ghost",
      "bind": {
        "regions": "previous.active"
      }
    },
    {
      "id": "values",
      "kind": "value-readout",
      "bind": {
        "values": "state.readouts"
      }
    }
  ],
  "controls": [
    {
      "id": "step",
      "kind": "index",
      "presentation": "slider",
      "items": "variant.states",
      "default": 0
    },
    {
      "id": "option",
      "kind": "select",
      "label": "Starting array",
      "options": [
        "Mixed",
        "Already sorted"
      ],
      "default": 0
    },
    {
      "id": "reset",
      "kind": "reset"
    }
  ],
