    "label": "Time",
    "unit": "s"
  },
  "math": {
    "code": "function compute(inputs, t) { var g = 9.81; var L = inputs.length; var m = inputs.mass; var a0Deg = inputs.angle0; var a0 = a0Deg * Math.PI / 180; var omega = Math.sqrt(g / L); var period = 2 * Math.PI / omega; var theta = a0 * Math.cos(omega * t); var dtheta = -a0 * omega * Math.sin(omega * t); var angleDeg = theta * 180 / Math.PI; var bobX = L * Math.sin(theta); var bobY = -L * Math.cos(theta); var vx = L * Math.cos(theta) * dtheta; var vy = L * Math.sin(theta) * dtheta; var speed = Math.abs(L * dtheta); var maxSpeed = L * omega * a0; var velTipX = bobX + 0.3 * vx; var velTipY = bobY + 0.3 * vy; var bobSize = 0.2 + 0.7 * ((m - 0.5) / 4.5); return { period: period, angleDeg: angleDeg, speed: speed, maxSpeed: maxSpeed, bobX: bobX, bobY: bobY, velTipX: velTipX, velTipY: velTipY, bobSize: bobSize, isShort: L <= 0.8, isLong: L >= 1.8 }; }",
    "outputs": [
