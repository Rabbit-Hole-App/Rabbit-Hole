{
  "version": 1,
  "relationship": {
    "statement": "A pendulum's period increases with the square root of its length and is independent of its bob mass and small release angle.",
    "formula": "T = 2\\pi\\sqrt{L/g}",
    "assumptions": [
      "Gravity is fixed at Earth surface value (9.81 m/s^2).",
      "Small-angle approximation: release angle is at most 30 degrees.",
      "Point mass on a massless rigid rod with no air resistance."
    ]
  },
