    "math": {
      "code": "function compute(inputs, t) { var g = 9.81; var L = inputs.length; var m = inputs.mass; var theta0 = inputs.angle0 * Math.PI / 180; var omega = Math.sqrt(g / L); var period = 2 * Math.PI / omega; var theta = theta0 * Math.cos(omega * t); var omegaInst = -theta0 * omega * Math.sin(omega * t); var speed = Math.abs(L * omegaInst); var bobX = L * Math.sin(theta); var bobY = 3 - L * Math.cos(theta); var bobSize = 0.25 + 0.55 * ((m - 0.5) / 4.5); return { period: period, angleDeg: theta * 180 / Math.PI, speed: speed, bobX: bobX, bobY: bobY, bobSize: bobSize, isLong: L >= 1.5, isShort: L <= 0.8 }; }",
