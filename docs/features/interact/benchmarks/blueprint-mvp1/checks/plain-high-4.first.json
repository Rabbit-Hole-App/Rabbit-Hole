    "relationship": {
      "statement": "For small swings, a pendulum's period increases with the square root of its string length and does not depend on bob mass or release angle.",
      "formula": "T = 2\\pi\\sqrt{L / g}",
      "assumptions": [
        "Gravity is fixed at g = 9.81 m/s^2 on Earth.",
        "Small-angle approximation applies (up to 25 degrees).",
        "Air resistance and rod mass are neglected."
      ]
