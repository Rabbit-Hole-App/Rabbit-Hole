    "math": {
      "code": "function compute(inputs, t) { var g = 9.81; var L = inputs.length; var m = inputs.mass; var a0 = inputs.startAngle; var omega = Math.sqrt(g / L); var period = 2 * Math.PI / omega; var testAngle = a0 * Math.cos(omega * t); var thetaRad = testAngle * Math.PI / 180; var testX = 0.9 + L * Math.sin(thetaRad); var testY = -L * Math.cos(thetaRad); var bobSize = 0.15 + 0.16 * m; var weight = m * g; var weightTipY = testY - 0.08 * m; var maxSpeed = L * omega * (a0 * Math.PI / 180); var refL = 1.0; var refA0 = 20; var refOmega = Math.sqrt(g / refL); var refPeriod = 2 * Math.PI / refOmega; var refAngle = refA0 * Math.cos(refOmega * t); var refRad = refAngle * Math.PI / 180; var refX = -0.9 + refL * Math.sin(refRad); var refY = -refL * Math.cos(refRad); var isShorter = L < 0.99; var isLonger = L > 1.01; var isMatchedDiffMassOrAngle = Math.abs(L - 1.0) < 0.01 && (Math.abs(m - 1.0) > 0.01 || Math.abs(a0 - 20) > 0.1); return { period: period, refPeriod: refPeriod, testAngle: testAngle, refAngle: refAngle, testX: testX, testY: testY, refX: refX, refY: refY, bobSize: bobSize, weight: weight, weightTipY: weightTipY, maxSpeed: maxSpeed, isShorter: isShorter, isLonger: isLonger, isMatchedDiffMassOrAngle: isMatchedDiffMassOrAngle }; }",
