    "math": {
      "code": "function compute(inputs, t) { const g = 9.81; const L = inputs.L; const m = inputs.m; const theta0 = inputs.theta0 * Math.PI / 180; const omega = Math.sqrt(g / L); const T = 2 * Math.PI / omega; const f = 1 / T; const theta = theta0 * Math.cos(omega * t); const theta_deg = theta * 180 / Math.PI; const omega_inst = -theta0 * omega * Math.sin(omega * t); const x = L * Math.sin(theta); const y = -L * Math.cos(theta); const vx = L * Math.cos(theta) * omega_inst; const vy = L * Math.sin(theta) * omega_inst; const v_max = theta0 * omega * L; const bob_size = 0.2 + 0.8 * ((m - 0.5) / 4.5); return { T, f, v_max, x, y, vx_end: x + vx * 0.3, vy_end: y + vy * 0.3, theta_deg, bob_size, is_long: L > 2.0, is_short: L < 1.0 }; }",
