    "math": {
      "code": "function compute(inputs, t) { const L = inputs.length; const g = inputs.gravity; const m = inputs.mass; const theta0 = 20 * Math.PI / 180; const omega = Math.sqrt(g / L); const period = 2 * Math.PI / omega; const angle = theta0 * Math.cos(omega * t); const angleDeg = angle * 180 / Math.PI; const bobX = L * Math.sin(angle); const bobY = -L * Math.cos(angle); const speed = Math.abs(L * theta0 * omega * Math.sin(omega * t)); const bobSize = 0.2 + 0.7 * ((m - 0.5) / 4.5); return { period, angleDeg, bobX, bobY, speed, bobSize, isLong: L > 1.5, isShort: L < 0.8, isLowG: g < 5.0 }; }",
