    "math": {
      "code": "function compute(inputs, t) { const mass = 1.0; const L = inputs.length; const g = inputs.gravity; const a0 = inputs.angle0; const omega = Math.sqrt(g / L); const period = 2 * Math.PI / omega; const frequency = 1 / period; const theta0 = a0 * Math.PI / 180; const theta = theta0 * Math.cos(omega * t); const angle = theta * 180 / Math.PI; const angVel = -theta0 * omega * Math.sin(omega * t); const max_speed = theta0 * omega * L; const bobX = L * Math.sin(theta); const bobY = -L * Math.cos(theta); const negLength = -L; const vx = L * angVel * Math.cos(theta); const vy = L * angVel * Math.sin(theta); const velTipX = bobX + 0.4 * vx; const velTipY = bobY + 0.4 * vy; const isSlow = period > 2.8; const isFast = period < 1.3; return { period, frequency, max_speed, angle, bobX, bobY, negLength, velTipX, velTipY, isSlow, isFast }; }",
