    "relationship": {
      "statement": "A simple pendulum's period depends on its length and gravity, not its mass. Longer strings swing slower, stronger gravity swings faster, and for small angles the release angle sets the swing width without changing the period.",
      "formula": "T = 2\\pi \\sqrt{\\frac{L}{g}}",
      "assumptions": [
        "The string is massless and does not stretch.",
        "Air resistance and pivot friction are neglected.",
        "Valid for small release angles (under 20 degrees)."
      ]
    },
