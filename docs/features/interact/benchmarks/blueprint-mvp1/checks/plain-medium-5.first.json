    "math": {
      "code": "function compute(inputs, t) { const g = 9.81; const refL = 1.0; const refA0 = 15; const pivotY = 2.4; const testPivotX = 1.1; const refPivotX = -1.1; const L = inputs.length; const m = inputs.mass; const a0 = inputs.angle0; const period = 2 * Math.PI * Math.sqrt(L / g); const refPeriod = 2 * Math.PI * Math.sqrt(refL / g); const omega = (2 * Math.PI) / period; const refOmega = (2 * Math.PI) / refPeriod; const testAngle = a0 * Math.cos(omega * t); const refAngle = refA0 * Math.cos(refOmega * t); const testRad = (testAngle * Math.PI) / 180; const refRad = (refAngle * Math.PI) / 180; const testX = testPivotX + L * Math.sin(testRad); const testY = pivotY - L * Math.cos(testRad); const refX = refPivotX + refL * Math.sin(refRad); const refY = pivotY - refL * Math.cos(refRad); const bobSize = 0.15 + 0.75 * ((m - 0.5) / 4.5); return { period: period, refPeriod: refPeriod, testAngle: testAngle, refAngle: refAngle, testX: testX, testY: testY, refX: refX, refY: refY, bobSize: bobSize, isLonger: L > refL + 0.05, isShorter: L < refL - 0.05, isSameLen: Math.abs(L - refL) <= 0.05 }; }",
