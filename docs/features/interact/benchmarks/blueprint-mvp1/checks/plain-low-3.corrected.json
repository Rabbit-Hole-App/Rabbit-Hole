    "math": {
      "code": "function compute(inputs, t) { const g = 9.81; const L = inputs.length; const m = inputs.mass; const theta0 = inputs.angle0 * Math.PI / 180; const period = 2 * Math.PI * Math.sqrt(L / g); const omega = 2 * Math.PI / period; const angleRad = theta0 * Math.cos(omega * t); const angleDeg = angleRad * 180 / Math.PI; const bobX = L * Math.sin(angleRad); const bobY = -L * Math.cos(angleRad); const bobSize = 0.25 + 0.15 * m; return { period: period, angleDeg: angleDeg, bobX: bobX, bobY: bobY, bobSize: bobSize, isLong: L >= 1.5, isShort: L <= 0.8 }; }",
