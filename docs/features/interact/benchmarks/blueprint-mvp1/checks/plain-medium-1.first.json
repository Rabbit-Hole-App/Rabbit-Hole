    "math": {
      "code": "function compute(inputs, t) { var g = 9.81; var L = inputs.length; var mass = inputs.mass; var startAngle = inputs.startAngle; var refL = 1.0; var refStart = 15; var omegaTest = Math.sqrt(g / L); var omegaRef = Math.sqrt(g / refL); var period = 2 * Math.PI * Math.sqrt(L / g); var refPeriod = 2 * Math.PI * Math.sqrt(refL / g); var angle = startAngle * Math.cos(omegaTest * t); var refAngle = refStart * Math.cos(omegaRef * t); var testRad = angle * Math.PI / 180; var refRad = refAngle * Math.PI / 180; var testX = 1.2 + L * Math.sin(testRad); var testY = 2.2 - L * Math.cos(testRad); var refX = -1.2 + refL * Math.sin(refRad); var refY = 2.2 - refL * Math.cos(refRad); var bobSize = 0.25 + 0.7 * ((mass - 0.5) / 4.5); return { period: period, refPeriod: refPeriod, angle: angle, refAngle: refAngle, testX: testX, testY: testY, refX: refX, refY: refY, bobSize: bobSize, isSlower: L > 1.05, isFaster: L < 0.95, isMatched: Math.abs(L - 1.0) <= 0.05 }; }",
