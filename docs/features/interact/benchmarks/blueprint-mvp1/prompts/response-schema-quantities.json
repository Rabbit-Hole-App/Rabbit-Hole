{
  "type": "object",
  "properties": {
    "relationship": {
      "type": "object",
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "formula": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "assumptions": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "required": [
        "statement",
        "formula",
        "assumptions"
      ],
      "additionalProperties": false
    },
    "quantities": {
      "minItems": 2,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "unit": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16
          },
          "role": {
            "type": "string",
            "enum": [
              "control",
              "fixed",
              "result"
            ]
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "id",
          "label",
          "unit",
          "role",
          "meaning"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "relationship",
    "quantities"
  ],
  "additionalProperties": false
}
