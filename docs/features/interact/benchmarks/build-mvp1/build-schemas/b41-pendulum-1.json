{
  "version": 1,
  "layout": "side-by-side",
  "pictures": {
    "main": {
      "type": "parts",
      "mapping": {
        "pxPerUnit": 82,
        "originPx": [148, 56]
      },
      "fixedParts": [
        { "id": "support", "from": [-1.3, 0], "to": [1.5, 0] },
        { "id": "refVertical", "from": [-0.8, 0], "to": [-0.8, -1.1] },
        { "id": "testVertical", "from": [0.8, 0], "to": [0.8, -2.1] },
        { "id": "refTrace", "at": ["refX", "refY"] },
        { "id": "refRod", "from": [-0.8, 0], "to": ["refX", "refY"] },
        { "id": "refBob", "at": ["refX", "refY"], "size": "medium" },
        { "id": "bobTrace", "at": ["bobX", "bobY"] },
        { "id": "rod", "from": [0.8, 0], "to": ["bobX", "bobY"] },
        { "id": "velArrow", "from": ["bobX", "bobY"], "to": ["velTipX", "velTipY"] },
        { "id": "bob", "at": ["bobX", "bobY"], "size": "medium" }
      ],
      "labels": [
        { "id": "refLabel", "near": "refVertical", "side": "above", "text": "Fixed 1.0 m" },
        { "id": "testLabel", "near": "testVertical", "side": "above", "text": "Adjustable L" },
        { "id": "velArrow", "near": "velArrow", "side": "below", "text": "v" }
      ],
      "arrows": [
        { "id": "velArrow", "lengthFactor": 1, "startAtEdge": true }
      ],
      "dropped": []
    },
    "panel": {
      "type": "kind",
      "kind": "coordinate-plot",
      "parts": {
        "title": false,
        "legend": "always"
      },
      "texts": {
        "labels": ["Test L", "1 m ref"]
      }
    }
  },
  "texts": {
    "arrangement": "columns",
    "values": [
      { "id": "period", "label": "Period", "decimals": 2 },
      { "id": "frequency", "label": "Freq", "decimals": 2 },
      { "id": "maxSpeed", "label": "Max v", "decimals": 2 }
    ],
    "formula": "T = 2\\pi\\sqrt{L/g}",
    "explanation": {
      "always": ["Fixed: 1 kg bob, 20 deg, 9.81 m/s^2"],
      "cases": [
        { "when": "isShorter", "text": "Shorter rod: faster, shorter period" },
        { "when": "isEqualRef", "text": "At 1.0 m: matches the 1 m reference" },
        { "when": "isLonger", "text": "Longer rod: slower, longer period" }
      ],
      "otherwise": "Adjust length to compare swings"
    }
  },
  "time": {
    "duration": 5
  },
  "changes": [
    "Used side-by-side layout with a 3-row columns text arrangement so the formula and multi-line explanations fit cleanly alongside 3 live values.",
    "Mapped the main pendulum scene at 82 px/m with origin at [148, 56] so the 2 m pendulum, velocity arrow, and top labels stay inside the 3-row stage.",
    "Placed Fixed 1.0 m and Adjustable L labels above their vertical reference lines to stay clear of the support beam, and v below the velocity arrow.",
    "Set velArrow startAtEdge to true so the velocity arrow begins outside the medium pendulum bob circle without overlapping it.",
    "Hid the coordinate-plot title while keeping the legend so the plot fits inside the 260.8 px panel height above the 3-row columns text area.",
    "Shortened Frequency to Freq and Max speed to Max v to fit the 200 px values column, and dropped Angle since it is plotted on the panel."
  ]
}