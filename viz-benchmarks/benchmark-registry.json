{
  "version": 7,
  "rootInstructions": "AGENT-INSTRUCTIONS.md",
  "coreRule": "1:1 conceptual capability, intentionally non-1:1 visual appearance",
  "projects": [
    {
      "id": "illustrated-transformer",
      "status": "ready",
      "source": "https://jalammar.github.io/illustrated-transformer/",
      "generatedFolderRequired": true,
      "humanReviewRequired": true,
      "cases": [
        {
          "id": "01-self-attention-computation-flow",
          "status": "ready",
          "objective": "Teach how a token gains a context-aware representation through self-attention: tokens to Q/K/V to QK scores to softmax weights to weighted V to output.",
          "patterns": [
            "flow",
            "matrix_operation",
            "zoom_drilldown",
            "process_scrubbing"
          ],
          "referenceType": "synthetic_internal"
        },
        {
          "id": "02-qkv-projection",
          "status": "skeleton",
          "objective": "How one token vector becomes separate query, key and value vectors, and why three roles are needed rather than one.",
          "patterns": [
            "flow"
          ],
          "referenceType": "not_captured"
        },
        {
          "id": "03-attention-score-matrix",
          "status": "skeleton",
          "objective": "How comparing every query against every key produces a score matrix, and what a cell in it means.",
          "patterns": [
            "matrix_operation"
          ],
          "referenceType": "not_captured"
        },
        {
          "id": "04-softmax-attention-weights",
          "status": "skeleton",
          "objective": "How raw scores become normalised attention weights, and how those weights select a blend of values.",
          "patterns": [
            "matrix_operation",
            "live_computation"
          ],
          "referenceType": "not_captured"
        },
        {
          "id": "05-causal-masking",
          "status": "skeleton",
          "objective": "How a decoder prevents a position from attending to later positions, and what the masked score matrix looks like.",
          "patterns": [
            "matrix_operation"
          ],
          "referenceType": "not_captured"
        },
        {
          "id": "06-matrix-self-attention",
          "status": "skeleton",
          "objective": "The same computation expressed once over whole matrices instead of per token.",
          "patterns": [
            "matrix_operation",
            "flow"
          ],
          "referenceType": "not_captured"
        },
        {
          "id": "07-multi-head-attention",
          "status": "skeleton",
          "objective": "How several attention heads run in parallel over the same input and are recombined into one output.",
          "patterns": [
            "routing",
            "flow"
          ],
          "referenceType": "not_captured"
        },
        {
          "id": "08-transformer-block",
          "status": "skeleton",
          "objective": "Attention, residual connection, normalisation and feed-forward as one repeating block.",
          "patterns": [
            "flow",
            "graphs"
          ],
          "referenceType": "not_captured"
        },
        {
          "id": "09-encoder-decoder-attention",
          "status": "skeleton",
          "objective": "How the decoder attends to encoder output, and how that differs from self-attention.",
          "patterns": [
            "flow",
            "coordinated_views"
          ],
          "referenceType": "not_captured"
        },
        {
          "id": "10-positional-encoding",
          "status": "skeleton",
          "objective": "How order is injected into a model that is otherwise order-free.",
          "patterns": [
            "live_computation",
            "matrix_operation"
          ],
          "referenceType": "not_captured"
        }
      ],
      "candidatePatterns": [
        "flow",
        "matrix_operation",
        "zoom_drilldown",
        "process_scrubbing"
      ]
    },
    {
      "id": "transformer-explainer",
      "status": "ready",
      "source": "https://poloclub.github.io/transformer-explainer/",
      "generatedFolderRequired": true,
      "humanReviewRequired": true,
      "cases": [
        {
          "id": "01-embedding-and-positional",
          "status": "ready",
          "referenceType": "external_real",
          "objective": "Show text becoming tokens, each token becoming a vector by lookup, and position being added to it.",
          "patterns": [
            "flow",
            "matrix_operation"
          ]
        },
        {
          "id": "02-qkv-projection",
          "status": "ready",
          "referenceType": "external_real",
          "objective": "Show one embedding becoming three different vectors - query, key and value - through learned weights, with each keeping a stable identity.",
          "patterns": [
            "matrix_operation",
            "flow"
          ]
        },
        {
          "id": "03-masked-attention-matrix",
          "status": "ready",
          "referenceType": "external_real",
          "objective": "Show queries compared against keys to fill a score matrix, and that a position can only attend to itself and earlier positions - the matrix is triangular.",
          "patterns": [
            "matrix_operation"
          ]
        },
        {
          "id": "04-multi-head-stacking",
          "status": "ready",
          "referenceType": "external_real",
          "objective": "Show that several heads run the same computation in parallel over the same input, and that one of them is being looked at while the others exist behind it.",
          "patterns": [
            "routing",
            "flow"
          ]
        },
        {
          "id": "05-mlp-expansion",
          "status": "ready",
          "referenceType": "external_real",
          "objective": "Show the representation widening into a larger hidden layer and being compressed back, and why the round trip is not a no-op.",
          "patterns": [
            "flow",
            "matrix_operation"
          ]
        },
        {
          "id": "06-temperature-sampling",
          "status": "blocked",
          "referenceType": "external_real",
          "objective": "Show a learner moving temperature and top-k and the probability distribution responding continuously.",
          "patterns": [
            "parameter_exploration",
            "live_computation"
          ],
          "blocked_by": "input_axis"
        },
        {
          "id": "07-output-probabilities",
          "status": "ready",
          "referenceType": "external_real",
          "objective": "Show the final distribution over candidate next tokens, with magnitude readable before any number is read.",
          "patterns": [
            "live_computation",
            "matrix_operation"
          ]
        },
        {
          "id": "08-architecture-drilldown",
          "status": "blocked",
          "referenceType": "external_real",
          "objective": "Show the whole model at once, then one component expanded, without the learner losing where they were.",
          "patterns": [
            "zoom_drilldown"
          ],
          "blocked_by": "input_axis"
        }
      ],
      "candidatePatterns": [
        "parameter_exploration",
        "coordinated_views",
        "matrix_operation",
        "process_scrubbing"
      ],
      "repository": "https://github.com/poloclub/transformer-explainer",
      "licence": "MIT"
    },
