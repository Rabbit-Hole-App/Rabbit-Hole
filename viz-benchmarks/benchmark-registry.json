  "hierarchy": "project -> case -> mode -> iteration",
  "unitOfEvaluation": "a single case of a single project at one generated iteration, for example illustrated-transformer -> 05-causal-masking -> dynamic -> v003",
  "caseRules": [
    "Every benchmark artifact belongs to a case under the project cases/ directory. A project root holds only project-wide files and shared/.",
    "Static, dynamic and interactive are MODES of one conceptual case, distinguished by filename inside reference/ and generated/latest/, never by separate cases or projects.",
    "A case owns its own reference/, generated/latest/, generated/history/, evaluation/current.json and evaluation/history/.",
    "Archive a useful generated/latest/ to generated/history/vNNN/ before replacing it."
  ],
  "patternsFile": "patterns.json",
  "coverageRule": "The suite is measured by which reusable visualization patterns have a ready case, never by how many cases exist. Start from cases that already have real reference material; add external references one project at a time.",
  "referenceTypes": {
    "external_real": "Captured from an existing published visualization. Tests us against a proven system.",
    "synthetic_internal": "Created by us. Tests our own machinery and guards regression. Never counts as external coverage.",
    "not_captured": "No reference material yet."
  },
  "blockedPatterns": [
    "parameter_exploration",
    "coordinated_views"
  ]
}
