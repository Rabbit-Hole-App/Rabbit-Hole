{
  "manifest": {
    "title": "Which window shows two notes?",
    "summary": "A short window locates the onset. A long window separates two nearby frequencies.",
    "description": "A spectrogram with time in seconds, frequency in hertz and one dB scale for both windows. Both tones begin at 0.40 seconds.",
    "assumptions": [
      "Synthetic 8 kHz signal with two equal-amplitude tones at 440 Hz and 480 Hz from 0.40 s.",
      "Hann windows are centered on each column. Levels use one-sided amplitude in dB re 1 with a −60 dB floor."
    ],
    "capabilities": [
      "select_inputs",
      "heat_grid"
    ],
    "inputs": [
      {
        "id": "window",
        "type": "select",
        "label": "Window length",
        "default": "short",
        "options": [
          {
            "value": "short",
            "label": "20 ms"
          },
          {
            "value": "long",
            "label": "120 ms"
          }
        ]
      }
    ],
    "readouts": []
  },
