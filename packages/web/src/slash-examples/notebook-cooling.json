{"nbformat": 4, "nbformat_minor": 5, "metadata": {"kernelspec": {"name": "python", "display_name": "Python (Pyodide)", "language": "python"}, "language_info": {"name": "python"}}, "cells": [{"id": "cell1", "cell_type": "markdown", "source": "# How a hot coffee cools\nNewton's law of cooling: 90 °C coffee in a 20 °C room.", "metadata": {}}, {"id": "cell2", "cell_type": "code", "metadata": {}, "execution_count": 1, "source": "import numpy as np, matplotlib.pyplot as plt\nminutes = np.arange(61)\ncoffee = 20 + 70 * np.exp(-0.05 * minutes)\nplt.figure(figsize=(5, 1.8)); plt.plot(minutes, coffee)\nplt.xlabel('minutes'); plt.ylabel('°C'); plt.show()\nprint(f'After 30 minutes: {coffee[30]:.1f} °C')", "outputs": [{"output_type": "display_data", "metadata": {}, "data": {"text/plain": "<Figure size 500x180 with 1 Axes>", "image/png": ""}}, {"output_type": "stream", "name": "stdout", "text": "After 30 minutes: 35.6 °C\n"}]}]}