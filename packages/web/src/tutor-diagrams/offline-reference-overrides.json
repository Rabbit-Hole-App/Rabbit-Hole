                "label": "Reference",
                "values": [
                  0.1,
                  0.4,
                  0.4,
                  0.1
                ]
              },
              {
                "label": "Current",
                "values": [
                  0.05,
                  0.15,
                  0.4,
                  0.4
                ]
              }
            ],
            "caption": "Both distributions use the same bin edges. Each set of shares sums to 1."
