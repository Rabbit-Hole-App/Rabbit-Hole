  "ml-recursive-feature-elimination": {
    "version": 1,
    "diagram": {
      "kind": "matrix",
      "layout": "teaching",
      "title": "Recursive feature elimination",
      "columns": [
        "Ranking",
        "Decision"
      ],
      "rows": [
        {
          "id": "fit-4",
          "heading": "Fit 4",
          "cells": [
            "A:0.80, B:0.60, C:0.30, D:0.10",
            "Drop D"
          ]
        },
        {
          "id": "refit-3",
