  "ml-differencing-transformation": {
    "version": 1,
    "diagram": {
      "kind": "transformation",
      "variant": "visual",
      "title": "First-difference a short time series",
      "operation": "Subtract the previous observation to get $\\Delta y_t = y_t - y_{t-1}$",
      "before": {
        "label": "Before",
        "diagram": {
          "kind": "coordinate-plot",
          "title": "Original observations",
          "x": {
            "label": "Time",
            "min": 1,
            "max": 4,
            "scale": "linear"
          },
          "y": {
            "label": "Observed value",
            "min": 0,
            "max": 20,
            "scale": "linear"
          },
          "series": [
            {
              "label": "$y$",
              "kind": "line",
              "points": [
                {
                  "x": 1,
                  "y": 10,
                  "id": "t1",
                  "label": "t1"
                },
                {
                  "x": 2,
                  "y": 13,
                  "id": "t2",
                  "label": "t2"
                },
                {
                  "x": 3,
                  "y": 15,
                  "id": "t3",
                  "label": "t3"
                },
                {
                  "x": 4,
                  "y": 19,
                  "id": "t4",
                  "label": "t4"
                }
              ]
            }
          ]
        }
      },
      "after": {
        "label": "After",
        "diagram": {
          "kind": "coordinate-plot",
          "title": "Consecutive differences",
          "x": {
            "label": "Time",
            "min": 1,
            "max": 4,
            "scale": "linear"
          },
          "y": {
            "label": "Difference",
            "min": 0,
            "max": 5,
            "scale": "linear"
          },
          "series": [
            {
              "label": "$\\Delta y$",
              "kind": "line",
              "points": [
                {
                  "x": 2,
                  "y": 3,
                  "id": "d2",
                  "label": "d2"
                },
                {
                  "x": 3,
                  "y": 2,
                  "id": "d3",
                  "label": "d3"
                },
                {
                  "x": 4,
                  "y": 4,
                  "id": "d4",
                  "label": "d4"
                }
              ]
            }
          ]
        }
      },
      "identity": {
        "mode": "mapped",
        "note": "Each output uses the current and previous observation. The first observation has no earlier value.",
        "mappings": [
          {
            "from": "t1",
            "to": "d2",
            "note": "Subtract 10"
          },
          {
            "from": "t2",
            "to": "d2",
            "note": "$13 - 10 = 3$"
          },
          {
            "from": "t2",
            "to": "d3",
            "note": "Subtract 13"
          },
          {
            "from": "t3",
            "to": "d3",
            "note": "$15 - 13 = 2$"
          },
          {
            "from": "t3",
            "to": "d4",
            "note": "Subtract 15"
          },
          {
            "from": "t4",
            "to": "d4",
            "note": "$19 - 15 = 4$"
          }
        ]
      }
    }
  },
  "ml-soft-vote-probabilities": {
    "version": 1,
    "diagram": {
      "kind": "comparison",
      "variant": "panels",
      "title": "Hard and soft voting can pick different classes",
      "panels": [
        {
          "heading": "Start with three models",
          "diagram": {
            "kind": "matrix",
            "layout": "teaching",
            "title": "Probabilities for the same example",
            "columns": [
              "Class A",
              "Class B"
            ],
            "rows": [
              {
                "id": "model-1",
                "heading": "Model 1",
                "cells": [
                  "55%",
                  "45%"
                ]
              },
              {
                "id": "model-2",
                "heading": "Model 2",
                "cells": [
                  "55%",
                  "45%"
                ]
              },
              {
                "id": "model-3",
                "heading": "Model 3",
                "cells": [
                  "5%",
                  "95%"
                ]
              }
            ],
            "emphasis": {
              "cells": [
                {
                  "row": "model-1",
                  "column": 0
                },
                {
                  "row": "model-2",
                  "column": 0
                },
                {
                  "row": "model-3",
                  "column": 1
                }
              ]
            },
            "caption": "Each model’s two probabilities add to 100%. The hard votes are A, A and B."
          }
        },
        {
          "heading": "Apply the two voting rules",
          "diagram": {
            "kind": "matrix",
            "layout": "teaching",
            "title": "Hard counts and soft averages",
            "columns": [
              "Class A",
              "Class B"
            ],
            "rows": [
              {
                "id": "hard",
                "heading": "Hard",
                "cells": [
                  "2 votes",
                  "1 vote"
                ]
              },
              {
                "id": "soft",
                "heading": "Soft",
                "cells": [
                  "38.33%",
                  "61.67%"
                ]
              }
            ],
            "emphasis": {
              "cells": [
                {
                  "row": "hard",
                  "column": 0
                },
                {
                  "row": "soft",
                  "column": 1
                }
              ]
            },
            "caption": "Hard voting picks A. Soft voting averages $\\frac{55+55+5}{3}$ for A and $\\frac{45+45+95}{3}$ for B. B wins. Averages are rounded."
          }
        }
      ],
      "caption": "Model 3’s strong support for B outweighs the two narrow leads for A when all models have equal weight."
    }
  },
  "ml-adaboost-weight-update": {
    "version": 1,
    "diagram": {
      "kind": "transformation",
      "variant": "visual",
      "title": "AdaBoost gives the missed row more weight",
      "operation": "Multiply by the factor for each row, then normalize",
      "before": {
        "label": "Before the weight update",
        "diagram": {
          "kind": "matrix",
          "layout": "teaching",
          "title": "Equal weight on every row",
          "columns": [
            "Result",
            "Weight"
          ],
          "rows": [
            {
              "id": "r1",
              "heading": "R1",
              "cells": [
                "Correct",
                "$\\frac{1}{4}$"
              ]
            },
            {
              "id": "r2",
              "heading": "R2",
              "cells": [
                "Correct",
                "$\\frac{1}{4}$"
              ]
            },
            {
              "id": "r3",
              "heading": "R3",
              "cells": [
                "Missed",
                "$\\frac{1}{4}$"
              ]
            },
            {
              "id": "r4",
              "heading": "R4",
              "cells": [
                "Correct",
                "$\\frac{1}{4}$"
              ]
            }
          ],
          "emphasis": {
            "rows": [
              "r3"
            ]
          },
          "caption": "Only R3 is missed, so the weighted error is $\\frac{1}{4}$. The binary learner coefficient is $\\alpha=\\ln(3)/2$."
        }
      },
      "after": {
        "label": "After normalization",
        "diagram": {
          "kind": "matrix",
          "layout": "teaching",
          "title": "More weight on the missed row",
          "columns": [
            "Factor",
            "Weight"
          ],
          "rows": [
            {
              "id": "r1",
              "heading": "R1",
              "cells": [
                "$e^{-\\alpha}$",
                "$\\frac{1}{6}$"
              ]
            },
            {
              "id": "r2",
              "heading": "R2",
              "cells": [
                "$e^{-\\alpha}$",
                "$\\frac{1}{6}$"
              ]
            },
            {
              "id": "r3",
              "heading": "R3",
              "cells": [
                "$e^\\alpha$",
                "$\\frac{1}{2}$"
              ]
            },
            {
              "id": "r4",
              "heading": "R4",
              "cells": [
                "$e^{-\\alpha}$",
                "$\\frac{1}{6}$"
              ]
            }
          ],
          "emphasis": {
            "rows": [
              "r3"
            ]
          },
          "caption": "Divide by the sum of the four scaled weights. The next learner uses these weights, which sum to 1."
        }
      },
      "identity": {
        "mode": "preserved",
        "note": "R1–R4 are the same examples in both tables. R3 goes from $\\frac{1}{4}$ to $\\frac{1}{2}$."
      }
    }
  },
