        },
        {
          "heading": "Calculate and add the contributions",
          "diagram": {
            "kind": "matrix",
            "layout": "teaching",
            "title": "One term for each shared bin",
            "columns": [
              "Ref.",
              "Current",
              "PSI part"
            ],
            "rows": [
              {
                "id": "bin-0",
                "heading": "$[0, 1)$",
                "cells": [
                  "10%",
                  "5%",
                  "0.0347"
                ]
              },
              {
                "id": "bin-1",
                "heading": "$[1, 2)$",
                "cells": [
                  "40%",
                  "15%",
                  "0.2452"
                ]
              },
              {
                "id": "bin-2",
                "heading": "$[2, 3)$",
                "cells": [
                  "40%",
                  "40%",
                  "0.0000"
                ]
              },
              {
                "id": "bin-3",
                "heading": "$[3, 4]$",
                "cells": [
                  "10%",
                  "40%",
                  "0.4159"
                ]
              },
              {
                "id": "total",
                "heading": "Total",
                "cells": [
                  "100%",
                  "100%",
                  "0.6958"
                ]
              }
            ],
            "emphasis": {
              "cells": [
                {
                  "row": "bin-3",
                  "column": 2
                }
              ],
              "rows": [
                "total"
              ]
            },
            "caption": "Use $(q-p)\\ln(q/p)$ with reference share $p$ and current share $q$. Sum the unrounded parts, then round the total."
