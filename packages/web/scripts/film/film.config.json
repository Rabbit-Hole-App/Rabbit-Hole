{
  "name": "explain-around-markdown",
  "base": "http://127.0.0.1:5480",
  "dsf": 2,
  "viewport": { "w": 1920, "h": 1080 },
  "app": { "id": "canvas-4d6b2a91", "title": "Decision Trees", "org": "demo-team", "orgName": "Demo", "profileName": "Learner", "emailLocal": "learner", "emailDomain": "example.invalid" },
  "files": { "bank": "bank/bank.json", "markdown": "serve/en.md" },
  "tooltip": { "selector": "[data-ask]" },
  "sticker": { "keys": ["Ctrl", "K"] },
  "ramp": { "fast": 1.8, "trim": 0.8, "rev": 1.8, "dead": 3.0 },
  "checklist": { "skeletonMinMs": 1200, "centreTol": 0.12, "tooltipMinMs": 700, "tooltipDelayMs": 250, "deadMax": 1.2, "stillMax": 2.6, "pollMax": 20 },
  "routes": {
    "settings": { "depth": "balanced" },
    "roadmapDisabled": true,
    "explainJobsDisabled": true,
    "inline": { "route": { "capability": "explain", "outcome": "card" } },
    "ask": { "threadId": "canvaschat-4d6b2a91-film", "answers": [{ "targetKind": "card", "messageRegex": "too many regions", "bank": "qhere" }] },
    "artifacts": { "queue": [["p1", 1900], ["p2", 1900], ["qcard", 1900], ["p3", 1700], ["p4", 1900]] },
    "files": { "store": { "delayMs": 1300, "fileId": "fs_film_md" }, "serve": "markdown" },
    "sourceRefs": true
  },
  "texts": {
    "P1": "how does a decision tree split a two-feature dataset into regions?",
    "P2": "how does a decision tree trace a new point from the root to a prediction?",
    "P4": "how does Gini impurity change as the fraction of one class goes from 0 to 1, compared with entropy?",
    "PASSAGE": "About 63% of the original samples appear in each bootstrap (the rest are out-of-bag samples that can be used for validation)."
  },
  "locators": {
    "pane": "[data-chat-pane]",
    "composer": { "css": "[data-chat-composer]", "within": "@pane" },
    "field": { "css": "[data-chat-composer] textarea, [data-chat-composer] input:not([type=\"file\"])", "within": "@pane", "first": true },
    "slashOption": { "css": "[data-slash-picker] [role=\"option\"]", "first": true },
    "pill": { "css": "[data-command-token]", "within": "@composer" },
    "firstBlock": { "css": "[data-block-id]", "first": true },
    "card1": { "css": "[data-block-id]", "hasText": "Decision Tree Feature Regions", "first": true },
    "card2": { "css": "[data-block-id]", "hasText": "Decision Tree Traversal", "first": true },
    "child": { "css": "[data-block-id]", "hasText": "Searching for the Best Threshold", "first": true },
    "boot": { "css": "[data-block-id]", "hasText": "Bootstrap Coverage Limit", "first": true },
    "gini": { "css": "[data-block-id]", "hasExactText": "Gini Impurity vs Entropy", "first": true },
    "c1q2": { "css": "[data-explanation-suggestion]", "within": "@card1", "nth": 1 },
    "c2q1": { "css": "[data-explanation-suggestion]", "within": "@card2", "nth": 0 },
    "askChat": { "css": "[data-ask=\"here\"]", "within": "@c1q2" },
    "askCard": { "css": "[data-ask=\"card\"]", "within": "@c2q1" },
    "insertMenu": { "role": "menuitem", "name": "Insert", "within": { "role": "menubar" } },
    "uploadItem": { "role": "menuitem", "name": "Upload a file" },
    "fileInput": { "css": "input[type=\"file\"][multiple]:not([data-attach-input])", "first": true },
    "destination": "[data-upload-destination]",
    "destCanvas": { "css": "[data-upload-choice=\"canvas\"]", "within": "@destination" },
    "importDialog": "[data-file-import-dialog]",
    "addToCanvas": { "role": "button", "name": "Add to canvas", "within": "@importDialog" },
    "mdDoc": { "css": "[data-file-doc-md]", "first": true },
    "toolbar": "[data-file-doc-selection-toolbar]",
    "quickAsk": { "css": "[data-quick-ask]", "within": "@toolbar" },
    "inlineAi": "[data-inline-ai]",
    "accept": { "role": "button", "name": "Accept", "within": "@inlineAi" },
    "windowOption": { "css": "[data-inline-ai] [role=\"option\"]", "first": true },
    "windowPill": "[data-inline-ai][data-inline-command]",
    "windowPrompt": "[data-inline-prompt]"
  },
  "beats": [
    { "do": "goto", "url": "{app}" },
    { "do": "wait-for", "on": "@field", "timeout": 30000 },
    { "do": "hold", "ms": 2000 },
    { "do": "blur", "on": "@field" },
    { "do": "start" },
    { "do": "shot", "name": "b0" },
    { "do": "hold", "ms": 900, "note": "B0: an empty canvas" },

    { "do": "stamp", "name": "uploadAt", "note": "B0a: Insert > Upload a file > Add to canvas > Add to canvas (the product's own import of the lesson's en.md; the native dialog never opens)" },
    { "do": "click", "on": "@insertMenu" },
    { "do": "wait-for", "on": "@uploadItem", "timeout": 4000 },
    { "do": "shot", "name": "b0a1" },
    { "do": "hold", "ms": 900, "note": "the menu is read" },
    { "do": "click", "on": "@uploadItem" },
    { "do": "set-files", "on": "@fileInput", "name": "en.md", "mimeType": "text/markdown", "file": "markdown" },
    { "do": "wait-for", "on": "@destination", "timeout": 6000 },
    { "do": "shot", "name": "b0a2" },
    { "do": "hold", "ms": 900, "note": "where the file goes" },
    { "do": "click", "on": "@destCanvas" },
    { "do": "wait-for", "on": "@addToCanvas", "timeout": 6000 },
    { "do": "shot", "name": "b0a3" },
    { "do": "hold", "ms": 900, "note": "how it is added: Markdown card" },
    { "do": "click", "on": "@addToCanvas" },
    { "do": "wait-for", "on": "@mdDoc", "timeout": 20000, "note": "the markdown card lands (its upload shows while the scripted save waits)" },
    { "do": "mark", "kind": "reveal", "from": "uploadAt", "plus": 0.8 },
    { "do": "hold", "ms": 500 },
    { "do": "shot", "name": "b0a4" },
    { "do": "toggle-layout", "card": "@firstBlock", "want": "scrollable", "note": "film only: the product lands a new Markdown card in Full content; the card's own toggle puts it back to the compact scrolling card the film is composed for" },
    { "do": "fit", "ms": 700 },
    { "do": "camera", "on": "@firstBlock", "pad": 40, "ms": 600, "max": 1.5, "free": true, "check": "centred", "name": "markdown card" },
    { "do": "shot", "name": "b0a5" },
    { "do": "hold", "ms": 1400, "note": "the lesson card, read" },

    { "do": "scroll-heading", "text": "What a decision tree does", "note": "B1: P1 at Balanced" },
    { "do": "camera", "on": "@composer", "pad": 30, "ms": 500, "max": 2.1 },
    { "do": "slash-command", "field": "@field", "option": "@slashOption", "pill": "@pill" },
    { "do": "type", "text": "@P1", "delay": 9 },
    { "do": "press", "key": "Enter" },
    { "do": "skeleton" },
    { "do": "shot", "name": "b1sk" },
    { "do": "wait-card", "title": "Decision Tree Feature Regions" },
    { "do": "camera", "on": "@card1", "pad": 30, "ms": 600, "max": 1.6, "free": true, "check": "centred", "name": "card 1" },
    { "do": "shot", "name": "b1" },
    { "do": "hold", "ms": 1800 },

    { "do": "camera", "on": "@composer", "pad": 30, "ms": 500, "max": 2.1, "note": "B2: P2 at Detailed, chosen with the cursor" },
    { "do": "choose-depth", "scope": "@pane", "level": "detailed", "hold": 900 },
    { "do": "slash-command", "field": "@field", "option": "@slashOption", "pill": "@pill" },
    { "do": "type", "text": "@P2", "delay": 9 },
    { "do": "press", "key": "Enter" },
    { "do": "skeleton" },
    { "do": "shot", "name": "b2sk" },
    { "do": "wait-card", "title": "Decision Tree Traversal" },
    { "do": "camera", "on": "@card2", "pad": 30, "ms": 600, "max": 1.6, "free": true, "check": "centred", "name": "card 2" },
    { "do": "shot", "name": "b2" },
    { "do": "hold", "ms": 1500 },

    { "do": "scroll-into-view", "on": "@c1q2", "note": "B3 = Ask in chat on card 1's question 2: the real answer opens in the Chat pane. (The product removes a card's suggestion rows once any Ask has been used on it, so B3 and B4 use different cards.)" },
    { "do": "camera", "full": true, "ms": 450, "max": 1 },
    { "do": "hover", "on": "@c1q2", "ms": 300, "note": "the row reveals its two buttons" },
    { "do": "hover", "on": "@askChat", "ms": 1000, "tooltip": true, "note": "the button and its tooltip (a hold: 1.0x)" },
    { "do": "stamp", "name": "askMark" },
    { "do": "click", "on": "@askChat" },
    { "do": "shot", "name": "b3a" },
    { "do": "hold", "ms": 1800, "note": "the thread streams in the Chat pane, in frame" },
    { "do": "camera", "on": "@pane", "pad": 10, "ms": 600, "max": 1.8, "check": "inframe", "as": "chat", "name": "chat pane" },
    { "do": "hold", "ms": 2000, "note": "title, action, chips are read" },
    { "do": "shot", "name": "b3b" },
    { "do": "mark", "kind": "reveal", "from": "askMark" },

    { "do": "scroll-into-view", "on": "@c2q1", "note": "B4: Ask in a new card on card 2's question 1: skeleton beside the parent, then the child card" },
    { "do": "camera", "on": ["@card2", "@card1"], "pad": 20, "ms": 500, "max": 1.6 },
    { "do": "hover", "on": "@askCard", "ms": 900, "tooltip": true },
    { "do": "shot", "name": "b4tip" },
    { "do": "click", "on": "@askCard" },
    { "do": "skeleton", "near": "@card2", "max": 1.4 },
    { "do": "shot", "name": "b4sk" },
    { "do": "wait-card", "title": "Searching for the Best Threshold" },
    { "do": "camera", "on": ["@card2", "@child"], "pad": 20, "ms": 600, "max": 1.5, "free": true, "check": "centred", "name": "parent + child" },
    { "do": "shot", "name": "b4" },
    { "do": "hold", "ms": 1500 },

    { "do": "blur", "on": "@field", "note": "B5: highlight the Bagging sentence, [Ctrl+K], Enter" },
    { "do": "camera", "full": true, "ms": 400, "max": 1 },
    { "do": "fit", "ms": 800, "note": "the canvas view back on everything: the markdown card fully on screen" },
    { "do": "scroll-heading", "text": "Random forests: the power of ensembles" },
    { "do": "select-text", "container": "[data-file-doc-md]", "text": "@PASSAGE", "toolbar": "@toolbar" },
    { "do": "shot", "name": "b5a" },
    { "do": "hover", "on": "@quickAsk", "ms": 400 },
    { "do": "sticker" },
    { "do": "mouse-press" },
    { "do": "wait-for", "on": "@inlineAi", "timeout": 15000 },
    { "do": "camera", "on": "@inlineAi", "pad": 60, "ms": 450, "max": 2.2, "check": "inframe", "as": "menus", "name": "ctrl+k window" },
    { "do": "shot", "name": "b5b" },
    { "do": "hold", "ms": 1200 },
    { "do": "stamp", "name": "enterAt" },
    { "do": "press", "key": "Enter" },
    { "do": "wait-for", "on": "@accept", "timeout": 25000, "note": "the window previews the card it made: the preview is read, then Accept puts the card on the canvas" },
    { "do": "camera", "on": "@inlineAi", "pad": 60, "ms": 450, "max": 2.2 },
    { "do": "shot", "name": "b5pre" },
    { "do": "hold", "ms": 2200 },
    { "do": "click", "on": "@accept" },
    { "do": "wait-card", "title": "Bootstrap Coverage Limit", "timeout": 15000, "expectSkeleton": false },
    { "do": "mark", "kind": "reveal", "from": "enterAt", "plus": 0.8 },
    { "do": "camera", "on": "@boot", "pad": 30, "ms": 600, "max": 1.6, "free": true, "check": "centred", "name": "Ctrl+K card" },
    { "do": "shot", "name": "b5c" },
    { "do": "hold", "ms": 2000 },

    { "do": "camera", "full": true, "ms": 600, "max": 1.6, "note": "B6: Ctrl+K on the empty canvas, /explain at Brief (the window's own Depth menu)" },
    { "do": "click-empty", "x": 0.4, "y": 0.9 },
    { "do": "sticker" },
    { "do": "press", "key": "Control+k" },
    { "do": "wait-for", "on": "@inlineAi", "timeout": 15000 },
    { "do": "camera", "on": "@inlineAi", "pad": 60, "ms": 450, "max": 2.0, "check": "inframe", "as": "menus", "name": "ctrl+k window" },
    { "do": "type", "text": "/explain", "delay": 30, "after": 300 },
    { "do": "shot", "name": "b6a" },
    { "do": "click", "on": "@windowOption", "note": "the picker's first entry: explain; the pill appears" },
    { "do": "expect", "on": "@windowPill", "as": "pills", "name": "window pill" },
    { "do": "hold", "ms": 400 },
    { "do": "shot", "name": "b6b" },
    { "do": "choose-depth", "scope": "@inlineAi", "level": "brief", "hold": 500 },
    { "do": "click", "on": "@windowPrompt", "note": "the field takes the focus back from the menu before anything is typed" },
    { "do": "type", "text": "@P4", "delay": 9, "expectField": "[data-inline-prompt]" },
    { "do": "stamp", "name": "enter6" },
    { "do": "press", "key": "Enter" },
    { "do": "wait-card", "on": "@gini", "timeout": 25000, "expectSkeleton": false, "note": "a typed command makes its card directly (no preview): the card lands where the window was" },
    { "do": "mark", "kind": "reveal", "from": "enter6", "plus": 0.8 },
    { "do": "camera", "on": "@gini", "pad": 30, "ms": 600, "max": 1.6, "free": true, "check": "centred", "name": "Gini card" },
    { "do": "shot", "name": "b6" },
    { "do": "hold", "ms": 1800 },

    { "do": "camera", "full": true, "ms": 800, "max": 1, "note": "B6b: click and position the cards" },
    { "do": "fit", "ms": 900 },
    { "do": "caption", "text": "Click and drag cards anywhere", "ms": 3800 },
    { "do": "drag-to-free-spot", "card": "@gini" },
    { "do": "hold", "ms": 1000 },

    { "do": "poster", "note": "B7: the whole arrangement, held, the end" },
    { "do": "dump-layout" },
    { "do": "hold", "ms": 2500, "note": "the overview is held, no drift" },
    { "do": "end" }
  ]
}
