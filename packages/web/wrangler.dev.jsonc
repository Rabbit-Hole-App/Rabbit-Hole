{
  "name": "small-cp-dev",
  "main": "dev-worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist-dev",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "services": [{ "binding": "CONTROL_PLANE", "service": "small-cp" }]
}
