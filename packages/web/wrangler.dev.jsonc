{
  "name": "small-cp-dev",
  // rabbit-hole Cloudflare account (P0-B Phase 2B, docs/features/rabbit-hole-dev.md).
  "account_id": "c08d3dbdc53a3afd3cb09a536ac42318",
  // Each uploaded version gets its own <hash>-small-cp-dev URL, so parallel
  // sessions can test without replacing what the shared dev worker serves.
  "preview_urls": true,
  "main": "dev-worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LEARN_VIDEOS",
        "class_name": "LearnVideos"
      },
      {
        "name": "LEARN_SCENES",
        "class_name": "LearnScenes"
      },
      {
        "name": "REPOSITORY_IMPORTS",
        "class_name": "RepositoryImports"
      },
      // Durable file-conversion jobs (control-plane/src/file-jobs.js), dev and parallel only until a release adds prod.
      {
        "name": "FILE_JOBS",
        "class_name": "FileJobs"
      }
    ]
  },
  "migrations": [
    {
      "tag": "learn-videos-1",
      "new_sqlite_classes": [
        "LearnVideos"
      ]
    },
    {
      "tag": "learn-scenes-1",
      "new_sqlite_classes": [
        "LearnScenes"
      ]
    },
    {
      "tag": "repository-imports-1",
      "new_sqlite_classes": [
        "RepositoryImports"
      ]
    },
    {
      "tag": "file-jobs-1",
      "new_sqlite_classes": [
        "FileJobs"
      ]
    }
  ],
  "assets": {
    "directory": "./dist-dev",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html",
        "**/*.py"
      ],
      "fallthrough": true
    }
  ],
  // Browser Run for webpage card captures (control-plane/src/webpage-capture.js).
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [
    // No RUNS: production small-runs is never bound on a dev or review worker
    // (docs/features/dev-prod-write-barrier.md). Run outputs come from CONTROL_PLANE, the dev control
    // plane, which binds no RUNS either (Phase 2B), so run outputs list empty on dev.
    // Dev repository snapshots (Map import/refresh) get their own bucket, never a prefix inside the live
    // small-runs bucket. Production has no such binding (control-plane/test/repositories.test.js).
    {
      "binding": "REPOSITORY_SNAPSHOTS",
      "bucket_name": "rabbit-hole-dev-repositories"
    },
    // Learn media on dev/review: never the production bucket
    // (control-plane/src/learn-storage.js).
    {
      "binding": "LEARN_MEDIA",
      "bucket_name": "rabbit-hole-dev-learn-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rabbit-hole-dev",
      "database_id": "1ad18fef-ccf9-4a2c-86c7-dc7e87b268a2"
    },
    {
      "binding": "BYOC_DB",
      "database_name": "rabbit-hole-byoc-dev",
      "database_id": "cae839e6-6d58-4037-9e92-d47346356c2f"
    },
    {
      "binding": "LEARN_DB",
      "database_name": "rabbit-hole-learn-dev",
      "database_id": "028f800f-ce8e-4461-adb2-827f417492eb"
    }
  ],
  "vars": {
    "LEARN_VIDEO_PROVIDER": "fal-seedance-lite",
    "LEARN_VIDEO_RESOLUTION": "480p",
    "SUBSCRIPTION_ONLY": "false",
    "USAGE_PLATFORM_DAY_USD": "10",
    "AI_MONTHLY_ALLOWANCE_USD": "50",
    "SUBSCRIPTION_OWNER_EMAIL": "yudhisteer.chin@gmail.com",
    "BYOC_REGION": "us-east-1",
    "BYOC_PRINCIPAL_ARN": "arn:aws:iam::637423432890:user/small-byoc-dev",
    "BYOC_TEMPLATE_BUCKET": "small-byoc-installer-637423432890-us-east-1",
    "SCENE_WORKER_URL": "https://rabbit-hole-lesson-renderer-dev.fly.dev",
    // Review-first CAD (docs/features/cad.md). This config binds no CAD_JOBS, so it acts only where CAD is bound.
    "CAD_BRIEF_FIRST": "false",
    // Codebase assessment (owner production GO 2026-10-21): the rubric route for the five codebase goals only, against the cited
    // repository revision. The general TUTOR_RUBRIC_ASSESSMENT_ENABLED and TUTOR_VISUAL_ASSESSMENT_ENABLED stay off.
    "TUTOR_CODEBASE_ASSESSMENT_ENABLED": "true"
  },
  "services": [
    {
      "binding": "CONTROL_PLANE",
      "service": "rabbit-hole-cp-dev"
    }
  ]
}
