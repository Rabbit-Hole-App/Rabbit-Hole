{
  // Rabbit Hole PRODUCTION app Worker: the one public origin, https://digrabbithole.com
  // (docs/features/rabbit-hole-production.md). NOT CREATED YET: every deploy, resource and secret here needs the
  // owner's explicit GO. Deploy only with --config wrangler.rabbit-hole-prod.jsonc.
  "name": "rabbit-hole-app",
  "account_id": "c08d3dbdc53a3afd3cb09a536ac42318",
  // The dev worker's routes with CONTROL_PLANE passed through to rabbit-hole-cp, not the dev barrier.
  "main": "app-worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // The digrabbithole.com zone is ACTIVE in the Rabbit Hole account (checked 2026-10-01). www redirects to the
  // apex with a proxied placeholder record plus a Single Redirect rule, not a second custom domain.
  "routes": [{ "pattern": "digrabbithole.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "LEARN_VIDEOS", "class_name": "LearnVideos" },
      { "name": "LEARN_SCENES", "class_name": "LearnScenes" },
      { "name": "REPOSITORY_IMPORTS", "class_name": "RepositoryImports" },
      { "name": "CAD_JOBS", "class_name": "CadJobs" },
      // /explain v2 jobs (control-plane/src/explain-job.js, EXP-T12); routes off unless EXPLAIN_V2_ENABLED.
      { "name": "EXPLAIN_JOBS", "class_name": "ExplainJobs" },
      // IMG-01 image generation jobs, one object per generation (control-plane/src/image-jobs.js, docs/features/image-jobs.md).
      // Bound even while IMAGE_GENERATE_ENABLED is off, so existing jobs can still be inspected and settled.
      { "name": "IMAGE_JOBS", "class_name": "ImageJobs" },
      // Shared plumbing for file conversion, Ctrl+K image edits and Ctrl+K JavaScript runs (control-plane/src/file-jobs.js,
      // docs/features/file-jobs-production.md). Binding it enables NOTHING: each feature stays off until its own vars and secrets exist.
      { "name": "FILE_JOBS", "class_name": "FileJobs" }
    ]
  },
  "migrations": [
    { "tag": "learn-videos-1", "new_sqlite_classes": ["LearnVideos"] },
    { "tag": "learn-scenes-1", "new_sqlite_classes": ["LearnScenes"] },
    { "tag": "repository-imports-1", "new_sqlite_classes": ["RepositoryImports"] },
    { "tag": "cad-jobs-1", "new_sqlite_classes": ["CadJobs"] },
    { "tag": "explain-jobs-1", "new_sqlite_classes": ["ExplainJobs"] },
    { "tag": "image-jobs-1", "new_sqlite_classes": ["ImageJobs"] },
    { "tag": "file-jobs-1", "new_sqlite_classes": ["FileJobs"] }
  ],
  // dev-worker.js bundles its pages from ./dist-dev; build with the production VITE_* env into that directory.
  "assets": { "directory": "./dist-dev", "binding": "ASSETS", "run_worker_first": true },
  "rules": [{ "type": "Text", "globs": ["**/*.html", "**/*.py"], "fallthrough": true }],
  // Created 2026-10-03 at the owner's production GO (rabbit-hole account).
  "d1_databases": [
    { "binding": "DB", "database_name": "rabbit-hole-prod", "database_id": "ecb90fe5-07f5-4824-b070-38ae76916e37" },
    { "binding": "LEARN_DB", "database_name": "rabbit-hole-learn-prod", "database_id": "f28417c4-d8ce-448e-8687-cc7bc2edf3a8" }
  ],
  // No RUNS: hosted small apps are not part of Rabbit Hole. No BYOC_DB until the owner decides BYOC ships.
  // Browser Run for webpage card captures (control-plane/src/webpage-capture.js).
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [
    { "binding": "LEARN_MEDIA", "bucket_name": "rabbit-hole-prod-learn-media" },
    { "binding": "REPOSITORY_SNAPSHOTS", "bucket_name": "rabbit-hole-prod-repositories" }
  ],
  "services": [{ "binding": "CONTROL_PLANE", "service": "rabbit-hole-cp" }],
  // The one public origin; the control plane sets the same value.
  "vars": {
    // /explain v2 (EXP-T12): switched on at R1 (EXP-T23, owner production GO 2026-10-22; live runs C:/s/spec/explain/renders/r2-live).
    "EXPLAIN_V2_ENABLED": "true",
    // IMG-01 image generation (docs/features/image-jobs.md): PUBLIC generation is off. Only "true" accepts new jobs from everyone.
    // The ONLY exception is the controlled owner-only acceptance path below (owner 2026-10-25): a caller whose verified sign-in identity
    // is listed in IMAGE_ACCEPTANCE_EMAILS may use it under the ordinary admission, hold, settlement and readiness rules, so the
    // production acceptance runs through the real Worker, storage and accounting. It needs OPENAI_API_KEY / GEMINI_API_KEY (secrets).
    "IMAGE_GENERATE_ENABLED": "false",
    // The per-image hold, derived (docs/features/image-jobs.md 6c): the largest priced estimate among the enabled combinations is Nano
    // Banana Pro 1K, US$0.134 + a 4,000-byte prompt bound US$0.008 = US$0.142; the worst real settlement seen for it was US$0.1462
    // (run D). US$0.20 covers both and is a hold, released at settlement; the learner is charged the measured cost or the upper bound.
    "IMAGE_GENERATE_RESERVED_USD": "0.20",
    // Exactly the Motion owner list: the owner's Google application principal (a provider email never becomes a principal) and the Gmail
    // address, compared whole and lower-cased. yudhisteer.chin01@gmail.com is a DIFFERENT account and does not match. Empty = nobody.
    "IMAGE_ACCEPTANCE_EMAILS": "user@dda2350771a4066e3080c605ba092e0a.rabbithole.invalid yudhisteer.chin@gmail.com",
    // A simple request within these goes straight to authoring; missing thresholds would review every request (explain-brief.js).
    "EXPLAIN_BRIEF_THRESHOLDS": "{\"components\":12,\"credits\":400}",
    "PUBLIC_ORIGIN": "https://digrabbithole.com",
    "CAD_PRODUCTION_REQUIRED": "true",
    "CAD_MODEL_REQUIRE_DEDICATED": "true",
    "CAD_PRODUCTION_MONTHLY_MODEL_USD": "10",
    "CAD_EXECUTOR_URL": "https://rabbit-hole-cad-prod.fly.dev",
    "CAD_JOB_ORIGIN": "https://digrabbithole.com",
    "CAD_MAX_CALLS": "2",
    "CAD_MAX_USD": "0.20",
    "CAD_MAX_REPAIRS": "0",
    "CAD_MAX_ARTIFACT_BYTES": "10485760",
    "CAD_MAX_TOTAL_BYTES": "10485760",
    // Review-first CAD (docs/features/cad.md): "true" prepares a brief to approve before any source is generated. Off until
    // the owner-approved dev verification passes; it needs CAD_MAX_CALLS of at least 3 (brief, source, review).
    "CAD_BRIEF_FIRST": "false",
    // File conversion (docs/features/canvas-file-converter.md section 7): Word, slides, audio and STEP through the production converter.
    // It needs the Worker secrets CONVERT_TOKEN and FILE_JOB_SECRET (activation/prod-convert.mjs); without CONVERT_TOKEN conversion is off.
    // MERGE ONLY after rabbit-hole-convert-prod is deployed and healthy. Rollback: prod-convert.mjs rollback L1 (no deploy).
    "CONVERT_URL": "https://rabbit-hole-convert-prod.fly.dev",
    "FILE_JOB_ORIGIN": "https://digrabbithole.com",
    // Repository import: the Rabbit Hole-owned production renderer (Fly org rabbit-hole), never a dev one.
    // Its bearer SCENE_WORKER_TOKEN is a fresh production-only secret set on both sides at the production GO.
    "SCENE_WORKER_URL": "https://rabbit-hole-lesson-renderer-prod.fly.dev",
    // Monthly AI allowance per signed-in user (owner D3 2026-10-16; credits Phase 1 shows it, enforcement comes later).
    "AI_MONTHLY_ALLOWANCE_USD": "25",
    // 2,500 AI credits every month (owner 2026-10-23). Accounts that already used AI keep AI_LEGACY_ALLOWANCE_USD through the
    // months before AI_ALLOWANCE_CUTOVER_PERIOD, then the default (learn-entitlement.js). Not a place to change a granted month.
    "AI_LEGACY_ALLOWANCE_USD": "50",
    "AI_ALLOWANCE_CUTOVER_PERIOD": "2026-11",
    // Codebase assessment (owner production GO 2026-10-21): the rubric route for the five codebase goals only, against the cited
    // repository revision. The general TUTOR_RUBRIC_ASSESSMENT_ENABLED and TUTOR_VISUAL_ASSESSMENT_ENABLED stay off.
    "TUTOR_CODEBASE_ASSESSMENT_ENABLED": "true",
    // /motion (owner activation GO, 2026-10-21): the production orchestrator (its bearer MOTION_ORCHESTRATOR_TOKEN is a secret)
    // and the per-job hold admitted against the learner's allowance before anything starts (motion-deploy-plan.md 2B).
    "MOTION_ORCHESTRATOR_URL": "https://rabbit-hole-motion-orchestrator.fly.dev",
    "MOTION_JOB_RESERVATION_USD": "8.96",
    // The confirmation's estimate (owner message 32: 1 credit = $0.01, shown as "about 100 credits"): the measured actual cost of
    // 6 real jobs on 2026-10-21 was $0.77 to $1.25. The hold above stays internal (owner message 30).
    "MOTION_ESTIMATE_USD": "1.00",
    // EXPANDED MOTION SETTINGS ARE OFF. With the next line absent this Worker's settings are today's exactly: 16:9, 5 to 30 seconds (control-plane
    // motion-ready-policy.js LEGACY_READY_POLICY); the other ratios and 35 to 60 seconds stay visible and are refused with the not-ready line.
    // ACTIVATION is this one line, added ONLY after the renderer, the orchestrator and the job store are deployed and accepted
    // (docs/features/rabbit-hole-motion-v1-harness-spec.md "Deploying Motion without activating it"). The orchestrator carries the same id.
    // "MOTION_RENDERER_CONFIG": "03f2a1efc08e-1.5cpu-3gib-420s",
    // R1 (owner 2026-10-25): PUBLIC Motion is PAUSED on purpose while the new renderer, orchestrator and durable job store are deployed and
    // accepted. "1" refuses every new start; jobs already started still poll, stop, settle and play. The ONLY exception is the controlled
    // owner-only path: a caller whose verified full sign-in email is in MOTION_ACCEPTANCE_EMAILS (below) may still start, under the ordinary
    // admission, hold and settlement rules, so the acceptance job exercises the real renderer, orchestrator, storage and accounting.
    // R2 (activation, a separate release): set this back to "0" and uncomment MOTION_RENDERER_CONFIG above, only after the acceptance job passed.
    "MOTION_GENERATION_PAUSED": "1",
    // The owner path (R1b, owner 2026-10-26): TWO full addresses, space separated, each compared whole and lower-cased against the account's application
    // principal (auth.js: a provider-reported email never becomes a principal). The first is the principal of the owner's Google sign-in (user_id
    // dda2350771a4066e3080c605ba092e0a, read from production D1: user@<id>.rabbithole.invalid); the second admits the Gmail address only for someone who proved
    // that mailbox through the emailed-code sign-in. yudhisteer.chin01@gmail.com is a DIFFERENT account and does not match. Empty = nobody.
    "MOTION_ACCEPTANCE_EMAILS": "user@dda2350771a4066e3080c605ba092e0a.rabbithole.invalid yudhisteer.chin@gmail.com"
  }
  // Secrets (required): ANTHROPIC_API_KEY, ANTHROPIC_WORKSPACE_ID (the key needs the workspace header), TYPESAFE_API_KEY,
  // FISH_AUDIO_API_KEY, ELEVENLABS_API_KEY, SCENE_WORKER_TOKEN. Optional: OPENAI_API_KEY, GEMINI_API_KEY (IMG-01) and the paid-provider keys.
  // Never here: RESEND_API_KEY or OAuth secrets (rabbit-hole-cp only).
  // CAD activation switches CAD_PRODUCTION_ENABLED/CAD_MODEL_ENABLED are managed
  // server bindings: absent means disabled. Do not overwrite them on later releases.
  // Verification scope/caps and dedicated CAD credentials are installed before enabling.
}
