{
  // Rabbit Hole PRODUCTION control plane (docs/features/rabbit-hole-production.md). Private: no route and no
  // workers.dev; only rabbit-hole-app reaches it, through its CONTROL_PLANE service binding, so the request URL,
  // OAuth callbacks and session cookie all stay on https://digrabbithole.com. NOT CREATED YET: every deploy,
  // resource and secret here needs the owner's explicit GO. wrangler.jsonc is the legacy small-cp.
  "name": "rabbit-hole-cp",
  "account_id": "c08d3dbdc53a3afd3cb09a536ac42318",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // No crons: the legacy ticks start Fly machines, purge hosted-app logs and send the weekly Watch email.
  // No assets: the app Worker serves every page.
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "d1_databases": [
    // Brand-new database: bootstrap.sql, then migrations/ (docs/features/rabbit-hole-production.md).
    { "binding": "DB", "database_name": "rabbit-hole-prod", "database_id": "ecb90fe5-07f5-4824-b070-38ae76916e37", "migrations_dir": "migrations" },
    { "binding": "LEARN_DB", "database_name": "rabbit-hole-learn-prod", "database_id": "f28417c4-d8ce-448e-8687-cc7bc2edf3a8" }
  ],
  // No RUNS and no Fly tokens: hosted small apps are not part of Rabbit Hole.
  "r2_buckets": [
    { "binding": "LEARN_MEDIA", "bucket_name": "rabbit-hole-prod-learn-media" },
    { "binding": "REPOSITORY_SNAPSHOTS", "bucket_name": "rabbit-hole-prod-repositories" }
  ],
  "vars": {
    "SMALL_ENV": "production",
    "BASE_URL": "https://digrabbithole.com",
    // Sign-in happens only on this origin (auth.js, feature/rabbit-hole-production-auth).
    "PUBLIC_ORIGIN": "https://digrabbithole.com",
    // Passwordless sign-in sender; digrabbithole.com must be verified in Resend first (RESEND_API_KEY is a secret).
    "EMAIL_FROM": "Rabbit Hole <signin@digrabbithole.com>"
  }
  // Secrets (set at the production GO, fresh values unrelated to dev or small-cp): MASTER_KEY, ANTHROPIC_API_KEY,
  // GOOGLE_CLIENT_ID/SECRET and GITHUB_CLIENT_ID/SECRET from the *_PROD credentials only (never *_DEV),
  // RESEND_API_KEY for email sign-in. Never set here: TEST_BYPASS_SECRET, SMALL_TEST_BYPASS, OAUTH_MOCK, SCENE_WORKER_TOKEN.
}
