    "source": "export function evaluate({ inputs, time }) {\n  const g = 9.8;\n  let u = Number(inputs && inputs.launchSpeed);\n  if (!isFinite(u)) u = 3;\n  u = sdk.clamp(u, 3, 5);\n  const show = !(inputs && inputs.showArrows === \"off\");\n  const tTop = u / g;\n  const tEnd = 2 * u / g;\n  let t = Number(time);\n  if (!isFinite(t)) t = 0;\n  t = sdk.clamp(t, 0, tEnd);\n\n  let v = u - g * t;\n  if (Math.abs(v) < 1e-9) v = 0;\n  let h = u * t - g * t * t / 2;\n  if (Math.abs(h) < 1e-12) h = 0;\n  const a = -g;\n  const apexHeight = u * u / (2 * g);\n\n  const released = t >= tTop - 1e-9;\n  const tr = released ? Math.max(0, t - tTop) : 0;\n  let hv = released ? -g * tr : 0;\n  if (Math.abs(hv) < 1e-9) hv = 0;\n  const hh = -g * tr * tr / 2;\n  const ha = released ? -g : 0;\n\n  const launchY = 190, ppm = 95;\n  const Y = (m) => launchY - m * ppm;\n  const xT = 250, xH = 450;\n  const vScale = 16, aScale = 7;\n\n  const objs = [];\n  objs.push(sdk.line(\"axis\", 100, Y(1.4), 100, Y(-1.4), { role: \"neutral\" }));\n  objs.push(sdk.text(\"axisLabel\", 100, 22, \"Height (m), up +\", { align: \"middle\" }));\n  objs.push(sdk.text(\"tickP1\", 58, Y(1) + 5, \"+1 m\"));\n  objs.push(sdk.text(\"tick0\", 62, Y(0) + 5, \"0 m\"));\n  objs.push(sdk.text(\"tickM1\", 58, Y(-1) + 5, \"-1 m\"));\n  objs.push(sdk.line(\"level\", 110, launchY, 600, launchY, { role: \"neutral\", opacity: 0.25 }));\n  objs.push(sdk.line(\"topLine\", 205, Y(apexHeight), 345, Y(apexHeight), { role: \"neutral\", opacity: 0.45 }));\n  objs.push(sdk.text(\"topText\", 352, Y(apexHeight) + 5, \"Top\"));\n\n  objs.push(...sdk.groundMark(\"launchMark\", xT, launchY + 13, 30));\n  objs.push(sdk.text(\"launchMarkLabel\", 110, launchY + 24, \"Launch mark\"));\n  objs.push(...sdk.gate(\"gate\", xH, launchY + 13, { open: released, w: 40 }));\n  objs.push(sdk.text(\"gateLabel\", 500, launchY + 24, \"Release gate\"));\n\n  objs.push(sdk.text(\"tossedLabel\", xT, 22, \"Tossed ball\", { align: \"middle\" }));\n  objs.push(sdk.text(\"heldLabel\", xH, 22, \"Held ball\", { align: \"middle\" }));\n\n  const yT = Y(h), yH = Y(hh);\n  objs.push(sdk.circle(\"tossedBall\", xT, yT, 24, { role: \"output\" }));\n  objs.push(sdk.circle(\"heldBall\", xH, yH, 24, { role: \"observed\" }));\n\n  if (show) {\n    objs.push(sdk.circle(\"tvDot\", xT - 28, yT, 6, { role: \"output\" }));\n    objs.push(...sdk.vector(\"tossedV\", { x: xT - 28, y: yT }, { value: Math.abs(v), direction: v >= 0 ? \"up\" : \"down\" }, { scale: vScale, label: \"v\", role: \"output\" }));\n    objs.push(...sdk.vector(\"tossedA\", { x: xT + 28, y: yT }, { value: Math.abs(a), direction: \"down\" }, { scale: aScale, label: \"a\", role: \"warning\" }));\n    objs.push(sdk.circle(\"hvDot\", xH - 28, yH, 6, { role: \"observed\" }));\n    objs.push(...sdk.vector(\"heldV\", { x: xH - 28, y: yH }, { value: Math.abs(hv), direction: hv >= 0 ? \"up\" : \"down\" }, { scale: vScale, label: \"v\", role: \"observed\" }));\n    objs.push(...sdk.vector(\"heldA\", { x: xH + 28, y: yH }, { value: Math.abs(ha), direction: \"down\" }, { scale: aScale, label: \"a\", role: \"warning\" }));\n  }\n\n  const readouts = [\n    { id: \"tossedHeight\", value: h },\n    { id: \"tossedVelocity\", value: v },\n    { id: \"tossedAcceleration\", value: a }\n  ];\n  const frame = sdk.frame(objs, { width: 640, height: 440, readouts });\n  return {\n    frame,\n    quantities: {\n      launchSpeed: u,\n      gravity: g,\n      velocity: v,\n      acceleration: a,\n      apexTime: tTop,\n      height: h,\n      tossedHeight: h,\n      tossedVelocity: v,\n      tossedAcceleration: a,\n      heldHeight: hh,\n      heldVelocity: hv,\n      heldAcceleration: ha\n    }\n  };\n}\n",
