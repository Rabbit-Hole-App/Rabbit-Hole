{
  "name": "small-cp",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  // every-minute due-job tick + daily 3am request_logs purge (7-day retention)
  "triggers": { "crons": ["* * * * *", "0 3 * * *"] },
  // Web dashboard (packages/web) builds into ../web/dist; same origin so the session cookie works.
  // run_worker_first: the Worker owns routing — it delegates only /static/* + favicon to ASSETS.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // the SPA shell is bundled into the worker (imported as text) — workers.dev's edge
  // cache for the asset store proved sticky across deploys; hashed chunks stay on ASSETS
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "small",
      "database_id": "3a9cc077-4dc8-4fbd-8bf7-8ed3b971af8b"
    }
  ],
  // run input/output files, keyed runs/<run_id>/{inputs,outputs}/<name>
  "r2_buckets": [
    {
      "binding": "RUNS",
      "bucket_name": "small-runs"
    }
  ],
  "vars": {
    "FLY_ORG_SLUG": "personal",
    "FLY_ORG_ID": "yw2NK09lG62eytyo75jV2OwzbVT8K410y",
    "BASE_URL": "https://small-cp.zeroshothq.workers.dev", // scheduled() has no request URL; runner needs SMALL_API
    "AWS_PRINCIPAL_ARN": "arn:aws:iam::637423432890:user/small-cp" // shown in the [aws] deploy error's trust policy — not a secret
  }
  // secrets (wrangler secret put): MASTER_KEY, FLY_ORG_TOKEN (machine/app ops), FLY_API_TOKEN (minting only),
  // RESEND_API_KEY (optional), TEST_BYPASS_SECRET (test envs only), EMAIL_FROM (optional),
  // ANTHROPIC_API_KEY (optional — enables deploy review; if identity-linked, also set ANTHROPIC_WORKSPACE_ID)
}
