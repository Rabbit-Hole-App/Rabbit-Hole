{
  "name": "small-cp",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "small",
      "database_id": "3a9cc077-4dc8-4fbd-8bf7-8ed3b971af8b"
    }
  ],
  "vars": {
    "FLY_ORG_SLUG": "personal"
  }
  // secrets (wrangler secret put): MASTER_KEY, FLY_API_TOKEN, RESEND_API_KEY (optional), TEST_BYPASS_SECRET (test envs only), EMAIL_FROM (optional), ANTHROPIC_API_KEY (optional — enables deploy review)
}
