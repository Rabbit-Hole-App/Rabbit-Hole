{
  "brief": {
    "title": "Cylinder",
    "units": "mm",
    "object": "A solid right circular cylinder",
    "requirements": ["Radius and height adjustable"],
    "assumptions": ["Radius 15 mm, height 40 mm"],
    "missing": [],
    "unsupported": [],
    "contextUsed": [],
    "controls": {
      "schema": "cad-params/1",
      "parameters": [
        { "id": "radius", "label": "Radius", "role": "input", "type": "length", "unit": "mm", "value": 15, "min": 1, "max": 100, "step": 0.5, "precision": 1, "slider": true, "priority": 0, "check": "rim_d" },
        { "id": "height", "label": "Height", "role": "input", "type": "length", "unit": "mm", "value": 40, "min": 1, "max": 300, "step": 1, "slider": true, "priority": 1, "check": "size_z" },
        { "id": "diameter", "label": "Diameter", "role": "computed", "type": "length", "unit": "mm", "dependsOn": ["radius"], "priority": 5 }
      ],
      "constraints": []
    }
  },
  "checks": [
    { "id": "size_x", "kind": "bounds_mm", "axis": "x", "expression": "2*radius", "tolerance": 0.001 },
    { "id": "size_y", "kind": "bounds_mm", "axis": "y", "expression": "2*radius", "tolerance": 0.001 },
    { "id": "size_z", "kind": "bounds_mm", "axis": "z", "expression": "height", "tolerance": 0.001 },
    { "id": "volume", "kind": "volume_mm3", "expression": "pi*radius*radius*height", "tolerance": 0.05 },
    { "id": "rim_d", "kind": "circular_diameter_mm", "expression": "2*radius", "tolerance": 0.001 },
    { "id": "one_solid", "kind": "solid_count", "value": 1, "tolerance": 0 }
  ]
}
