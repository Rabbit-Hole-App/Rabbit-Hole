{
  "name": "learn-render",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Renders Learn lectures to MP4: rough.js whiteboard scenes in Remotion, Fish Audio voice.",
  "scripts": {
    "render": "node scripts/render.mjs",
    "tts": "node scripts/tts.mjs",
    "stills": "node scripts/stills.mjs",
    "test": "node scripts/test.mjs",
    "studio": "remotion studio src/index.js",
    "motion:prove": "node scripts/motion.mjs prove",
    "motion:test": "node --test \"motion/*.test.mjs\" \"motion/service/*.test.mjs\""
  },
  "dependencies": {
    "@babel/parser": "7.24.1",
    "@hyperframes/producer": "0.8.137",
    "@remotion/bundler": "^4.0.246",
    "@remotion/cli": "^4.0.246",
    "@remotion/media-utils": "^4.0.246",
    "@remotion/renderer": "^4.0.246",
    "linkedom": "0.18.13",
    "music-metadata": "^11.0.0",
    "pngjs": "^7.0.0",
    "postcss": "8.5.28",
    "remotion": "^4.0.246",
    "roughjs": "^4.6.6"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.28.1"
  }
}
