    {
      "screen": 4,
      "voice": "The whole algorithm is seven lines: sort by score, keep the best, filter the rest.",
      "caption": "The whole algorithm: sort by score, keep the best, filter the rest.",
      "strokes": [
        { "type": "rect", "x": 190, "y": 150, "w": 890, "h": 520, "color": "#37352F", "width": 3, "at": 0.2, "dur": 1.0 },
        { "type": "code", "x": 240, "y": 200, "size": 38, "color": "#37352F", "at": 1.3, "dur": 4.3, "text": "boxes.sort(by=score, desc=True)\nkeep = []\nwhile boxes:\n    best = boxes.pop(0)\n    keep.append(best)\n    boxes = [b for b in boxes\n             if iou(best, b) < 0.5]" }
