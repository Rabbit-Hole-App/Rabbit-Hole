  "evidence": [
    {
      "source_ref_id": "S1",
      "excerpt": "    def generate(self, idx, max_new_tokens, temperature=1.0, top_k=None):"
    },
    {
      "source_ref_id": "S2",
      "excerpt": "        for _ in range(max_new_tokens):"
    },
    {
      "source_ref_id": "S3",
      "excerpt": "            idx_cond = idx if idx.size(1) <= self.config.block_size else idx[:, -self.config.block_size:]"
    },
    {
      "source_ref_id": "S4",
      "excerpt": "            logits, _ = self(idx_cond)"
    },
    {
      "source_ref_id": "S5",
      "excerpt": "            logits = logits[:, -1, :] / temperature"
    },
    {
      "source_ref_id": "S6",
      "excerpt": "            if top_k is not None:\n                v, _ = torch.topk(logits, min(top_k, logits.size(-1)))\n                logits[logits < v[:, [-1]]] = -float('Inf')"
    },
    {
      "source_ref_id": "S7",
      "excerpt": "            probs = F.softmax(logits, dim=-1)"
    },
    {
      "source_ref_id": "S8",
      "excerpt": "            idx_next = torch.multinomial(probs, num_samples=1)"
    },
    {
      "source_ref_id": "S9",
      "excerpt": "            idx = torch.cat((idx, idx_next), dim=1)"
    }
  ],
  "implementation_conditions": [
    {
      "id": "K1",
      "condition": "top_k is not None (the signature default is top_k=None)",
      "branches": [
        {
          "when": "true",
          "runs": "torch.topk finds the k-th largest logit and every logit below it is set to -inf (S6)"
        },
        {
          "when": "false",
          "runs": "the top-k block is skipped; all logits go to softmax unchanged (S6)"
        }
