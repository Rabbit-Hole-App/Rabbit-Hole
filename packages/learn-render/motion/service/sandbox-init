#!/bin/sh
# Runs as root INSIDE the new namespaces made by motion-sandbox, then becomes the render child.
# Installed root-owned at /usr/local/lib/motion/sandbox-init. Nothing here reaches the host:
# every mount is private to this mount namespace and vanishes with it.
set -eu
ID=$1
JOB=/var/motion/jobs/$ID

# Network: a fresh namespace has only loopback, down. Bring it up for Remotion's local bundle
# server; there is no route anywhere else.
ip link set lo up

# Filesystem: nothing propagates back to the host.
mount --make-rprivate /
# Private, size-capped scratch (Chromium's profile and temp files, the bundle, the frames).
mount -t tmpfs -o size=1536m,mode=1777,nosuid,nodev tmpfs /tmp
mount -t tmpfs -o size=256m,mode=1777,nosuid,nodev tmpfs /dev/shm
# Only this job's directory is re-exposed, at /tmp/job; the service's job tree, the homes and
# Fly's own directory are replaced by empty mounts.
mkdir /tmp/job
mount --bind "$JOB" /tmp/job
mount -t tmpfs -o size=1m,mode=755 tmpfs /var/motion
mount -t tmpfs -o size=1m,mode=755 tmpfs /home
mount -t tmpfs -o size=1m,mode=700 tmpfs /root
if [ -d /.fly ]; then mount -t tmpfs -o size=1m,mode=700 tmpfs /.fly; fi
# The renderer (code, node_modules, Chrome, fonts) is read-only for the child.
mount --bind /app /app
mount -o remount,bind,ro /app

# Preflight, before any job code runs: the workspace has exactly the ownership the render user
# needs (group motion, setgid 2770 directories, a 0640 job input), and nothing of the service
# is readable to it. A failure is the job's result; the child never starts.
asrender() { setpriv --reuid=motion-render --regid=motion --clear-groups -- "$@"; }
preflight_fail() {
  printf '{"status":"failed","error":"workspace_preflight_failed","detail":"%s"}\n' "$1" > /tmp/job/out/result.json
  echo "sandbox-init: workspace preflight failed: $1" >&2
  exit 65
}
for d in /tmp/job /tmp/job/out; do
  [ "$(stat -c %G "$d")" = motion ] || preflight_fail "$d is not group motion"
  [ "$(stat -c %a "$d")" = 2770 ] || preflight_fail "$d is not mode 2770 (setgid, group motion only)"
done
[ "$(stat -c %G /tmp/job/job.json)" = motion ] || preflight_fail "job.json is not group motion"
[ "$(stat -c %a /tmp/job/job.json)" = 640 ] || preflight_fail "job.json is not mode 0640 (group-readable, never world-readable)"
asrender test -r /tmp/job/job.json || preflight_fail "motion-render cannot read job.json"
asrender test -w /tmp/job/out || preflight_fail "motion-render cannot write out/"
[ -z "$(asrender ls -A /var/motion 2>/dev/null)" ] || preflight_fail "the service job tree is visible"
[ -z "$(asrender ls -A /home 2>/dev/null)" ] || preflight_fail "home directories are visible"
if asrender test -r /etc/sudoers.d/motion; then preflight_fail "service configuration is readable"; fi

# The child: the motion-render user (group motion, so the service can remove what it writes),
# no supplementary groups, no capabilities, no new privileges, an empty environment, a 64 MB
# per-file write limit, bounded open files and at most 1024 tasks for the user (RLIMIT_NPROC,
# on top of the job cgroup's pids.max set by motion-sandbox).
umask 007
exec setpriv --reuid=motion-render --regid=motion --clear-groups --no-new-privs --inh-caps=-all --bounding-set=-all -- \
  env -i HOME=/tmp TMPDIR=/tmp PATH=/usr/local/bin:/usr/bin:/bin NODE_ENV=production MOTION_SANDBOX=linux \
  prlimit --fsize=67108864 --nofile=4096 --nproc=1024 -- \
  /usr/local/bin/node /app/packages/learn-render/motion/service/child.mjs /tmp/job
