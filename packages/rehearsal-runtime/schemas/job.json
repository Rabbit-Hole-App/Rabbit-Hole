{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rabbit-hole.local/rehearsal/job.json",
  "title": "Rehearsal job request (POST /rehearsals)",
  "description": "Sent by the control plane. `readme` and `files` come from the repository snapshot so discovery can start before the sandbox clones. The sandbox clones the real repository at `commit` and verifies `git rev-parse HEAD`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "repo", "commit", "hardware", "timeBudgetMin", "readme", "files", "version"],
  "properties": {
    "key": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "sha256 of app|commit|hardware" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "hardware": { "enum": ["cpu"] },
    "timeBudgetMin": { "type": "integer", "minimum": 1, "maximum": 240 },
    "readme": { "type": "string", "maxLength": 400000 },
    "files": { "type": "array", "maxItems": 20000, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
    "version": { "const": "rehearsal-1" }
  }
}
