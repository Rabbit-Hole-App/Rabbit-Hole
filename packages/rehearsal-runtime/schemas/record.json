{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rabbit-hole.local/rehearsal/record.json",
  "title": "Rehearsal record: execution evidence for one (repository, commit, hardware class)",
  "description": "A superset of rehearse-nanogpt.py's record. Written by the controller (never the sandbox), so it survives the sandbox's deadline. `traps[].failsAsExpected` is `rc != 0`; a trap with failsAsExpected false is a finding, not a failure of the run. `knobsVerified[0]` is scored against the fixture's knobVerification object. `modelCalls[]` makes `modelSpendUsd` computed, not estimated.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repo", "commit", "hardware", "provider", "sandboxId", "terminated", "image", "model", "startedUtc", "finishedUtc", "wallSec", "environment", "route", "attempts", "fixes", "steps", "traps", "knobsVerified", "allChecksPassed", "modelCalls", "modelSpendUsd", "sandboxSpendNote", "draftPlan", "gaveUp"],
  "properties": {
    "version": { "const": "rehearsal-1" },
    "routeId": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "the catalogue route this record is for; one record per (repo, commit, routeId, hardware). R2: rehearsal-<routeId>-<hardware>.json. Absent on records made before the catalogue." },
    "repo": { "type": "string" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "hardware": { "enum": ["cpu"] },
    "provider": { "const": "modal" },
    "sandboxId": { "type": "string", "minLength": 1 },
    "terminated": { "type": "boolean", "description": "terminate(wait=True) confirmed" },
    "sandboxesLeftAfter": { "type": "integer", "minimum": 0, "description": "Sandbox.list(app_id, tags={job: key}) after termination; must be 0" },
    "image": {
      "type": "object", "additionalProperties": false, "required": ["ref", "digest"],
      "properties": { "ref": { "type": "string" }, "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
    },
    "model": { "type": "string", "description": "the model that produced the record (the config's REHEARSAL_MODEL); per-call models are in modelCalls" },
    "startedUtc": { "type": "string" },
    "finishedUtc": { "type": "string" },
    "wallSec": { "type": "number", "minimum": 0, "description": "job wall time, EXCLUDING the one-time image build" },
    "imageBuildSec": { "type": "number", "minimum": 0, "description": "present only on the run that built the image; reported separately from wallSec" },
    "environment": {
      "type": "object", "additionalProperties": false, "required": ["python", "cpu", "memGiB", "packagesAfter"],
      "properties": {
        "python": { "type": "string" },
        "cpu": { "type": "integer", "minimum": 1 },
        "memGiB": { "type": "number", "minimum": 0 },
        "packagesAfter": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "route": { "$ref": "route.json", "description": "the route as finally run (install may carry trimmedFrom)" },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["step", "n", "cmd", "rc", "sec", "stderrTail", "log"],
        "properties": {
          "step": { "type": "string" }, "n": { "type": "integer", "minimum": 1 }, "cmd": { "type": "string" },
          "rc": { "type": "integer" }, "sec": { "type": "number", "minimum": 0 },
          "stderrTail": { "type": "string" }, "log": { "type": "string", "description": "logs/<step>-<n>.log inside the artifact zip" }
        }
      }
    },
    "fixes": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["n", "step", "kind", "change", "evidence", "modelCalls"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 }, "step": { "type": "string" },
          "kind": { "enum": ["install_package", "add_flag", "set_env", "edit_command", "add_step_before", "allow_domain"] },
          "change": { "type": "string", "minLength": 1, "description": "for allow_domain: the domain added (the sandbox is re-created with it)" },
          "evidence": { "type": "string", "minLength": 1, "description": "a file:line or a log line" },
          "modelCalls": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "cmd", "rc", "sec", "checks", "files", "log", "warnings"],
        "properties": {
          "id": { "type": "string" }, "cmd": { "type": "string" }, "rc": { "type": "integer" }, "sec": { "type": "number", "minimum": 0 },
          "startedSec": { "type": "number", "minimum": 0, "description": "longRunning steps: seconds to the first successful probe" },
          "failed": { "type": "boolean", "description": "the step the repair loop gave up on: recorded with its last attempt, marked, so the Run card still appears with the steps that passed" },
          "error": { "type": "string", "maxLength": 300, "description": "failed steps: the error in one line, plain words, no stack trace" },
          "tried": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "description": "failed steps: what the repair loop tried, one short phrase each" },
          "checks": {
            "type": "array",
            "items": {
              "type": "object", "required": ["type", "passed"],
              "properties": { "type": { "type": "string" }, "passed": { "type": "boolean" }, "first": { "type": "number" }, "last": { "type": "number" } }
            }
          },
          "files": {
            "type": "object",
            "description": "files the step produced, by repository-relative path; copied into the artifact zip when the total is <= 50 MB, else listed only",
            "additionalProperties": {
              "type": "object", "additionalProperties": false, "required": ["bytes", "sha256"],
              "properties": { "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
            }
          },
          "log": { "type": "string" },
          "stdoutHead": { "type": "string", "maxLength": 2000, "description": "the first lines of the step output (Run card shows it as what a real run produced)" },
          "stdoutTail": { "type": "string", "maxLength": 2000, "description": "the last lines of the step output" },
          "warnings": { "type": "array", "maxItems": 10, "items": { "type": "string" } }
        }
      }
    },
    "traps": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "cmd", "rc", "sec", "stderrTail", "failsAsExpected", "log"],
        "properties": {
          "id": { "type": "string" }, "cmd": { "type": "string" }, "rc": { "type": "integer" }, "sec": { "type": "number", "minimum": 0 },
          "stderrTail": { "type": "string", "description": "last 20 lines" },
          "failsAsExpected": { "type": "boolean", "description": "rc != 0" },
          "log": { "type": "string", "description": "logs/trap-<id>.log" }
        }
      }
    },
    "knobsVerified": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["cmd", "rc", "startsWithPrompt"],
        "properties": {
          "cmd": { "type": "string" }, "rc": { "type": "integer" }, "sec": { "type": "number", "minimum": 0 },
          "startsWithPrompt": { "type": "boolean" }, "separators": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "snapshotImage": { "type": "string", "pattern": "^im-[A-Za-z0-9]+$", "description": "Modal image id from sb.snapshot_filesystem() taken at the end of the job (clone, install and produced files in place); Run card sessions start from it. Absent when the snapshot failed." },
    "network": {
      "type": "object", "additionalProperties": false, "required": ["outboundDomainAllowlist", "outboundCidrAllowlist", "allowDomainFixes"],
      "description": "what the sandbox could reach (spec 8a); allowDomainFixes lists the domains added by allow_domain fixes",
      "properties": {
        "outboundDomainAllowlist": { "type": "array", "items": { "type": "string" } },
        "outboundCidrAllowlist": { "type": "array", "items": { "type": "string" } },
        "allowDomainFixes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "allChecksPassed": { "type": "boolean" },
    "modelCalls": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["role", "model", "inputTokens", "outputTokens", "usd"],
        "properties": {
          "role": { "enum": ["discovery", "repair", "plan"] }, "model": { "type": "string" },
          "inputTokens": { "type": "integer", "minimum": 0 }, "outputTokens": { "type": "integer", "minimum": 0 }, "usd": { "type": "number", "minimum": 0 }
        }
      }
    },
    "modelSpendUsd": { "type": "number", "minimum": 0 },
    "sandboxSpendNote": { "type": "string", "description": "measured from the Modal usage page (value, date) after the run, or 'not yet read'" },
    "draftPlan": { "oneOf": [{ "$ref": "plan.json" }, { "type": "null" }] },
    "gaveUp": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["step", "reason"], "properties": { "step": { "type": "string" }, "reason": { "type": "string", "minLength": 1 } } }
      ]
    }
  }
}
