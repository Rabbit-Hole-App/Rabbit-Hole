{
  "repo": "karpathy/nanoGPT",
  "commit": "3adf61e154c3fe3fca428ad6bc3818b27a3b8291",
  "hardware": "cpu",
  "timeBudgetMin": 20,
  "totalMin": 18,
  "steps": [
    {
      "n": 1,
      "pattern": "see",
      "title": "See the map",
      "minutes": 2,
      "check": null
    },
    {
      "n": 2,
      "pattern": "predict",
      "title": "Predict the output",
      "minutes": 1,
      "check": {
        "type": "recorded"
      }
    },
    {
      "n": 3,
      "pattern": "run",
      "title": "Prepare the data",
      "minutes": 1,
      "cmd": "python data/shakespeare_char/prepare.py",
      "measuredSec": 4.1,
      "check": {
        "type": "files_exist",
        "paths": [
          "data/shakespeare_char/train.bin",
          "data/shakespeare_char/val.bin",
          "data/shakespeare_char/meta.pkl"
        ]
      }
    },
    {
      "n": 4,
      "pattern": "run",
      "title": "Train a small model",
      "minutes": 5,
      "cmd": "python train.py config/train_shakespeare_char.py --device=cpu --compile=False --eval_iters=20 --log_interval=1 --block_size=64 --batch_size=12 --n_layer=4 --n_head=4 --n_embd=128 --max_iters=2000 --lr_decay_iters=2000 --dropout=0.0",
      "measuredSec": 214.3,
      "check": {
        "type": "metric_decreased",
        "pattern": "^iter \\d+: loss ([\\d.]+)"
      }
    },
    {
      "n": 5,
      "pattern": "run",
      "title": "Generate text",
      "minutes": 1,
      "cmd": "python sample.py --out_dir=out-shakespeare-char --device=cpu",
      "measuredSec": 9.8,
      "check": {
        "type": "stdout_matches",
        "pattern": "---------------"
      }
    },
    {
      "n": 6,
      "pattern": "explain",
      "title": "Explain what you did",
      "minutes": 3,
      "check": {
        "type": "answers",
        "count": 3
      }
    },
    {
      "n": 7,
      "pattern": "change",
      "title": "Make it yours",
      "minutes": 5,
      "cmd": "python sample.py --out_dir=out-shakespeare-char --device=cpu --start=ROMEO: --temperature=0.5 --num_samples=1",
      "check": {
        "type": "stdout_matches",
        "pattern": "^ROMEO:"
      }
    },
    {
      "n": 8,
      "pattern": "comeback",
      "title": "Next week",
      "minutes": 5,
      "check": {
        "type": "unaided_repeat"
      }
    }
  ],
  "install": [
    "pip install torch numpy requests tiktoken"
  ],
  "trapsToWarn": [
    "--temperature must be a float: 1.0 not 1",
    "--start cannot contain ="
  ]
}
