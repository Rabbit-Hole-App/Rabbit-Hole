{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rabbit-hole.local/rehearsal/plan.json",
  "title": "Draft plan in the six-step pattern (See it, Predict, Run it, Explain it back, Change it, Come back)",
  "description": "Filled from the record. `totalMin` counts today's steps (every pattern except `comeback`) and must be <= `timeBudgetMin`. A `run` step's minutes must not be shorter than its `measuredSec`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["repo", "commit", "hardware", "timeBudgetMin", "totalMin", "steps", "install", "trapsToWarn"],
  "properties": {
    "repo": { "type": "string" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "hardware": { "enum": ["cpu"] },
    "timeBudgetMin": { "type": "integer", "minimum": 1 },
    "totalMin": { "type": "number", "minimum": 0 },
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["n", "pattern", "title", "minutes", "check"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "pattern": { "enum": ["see", "predict", "run", "explain", "change", "comeback"] },
          "title": { "type": "string", "minLength": 1 },
          "minutes": { "type": "number", "minimum": 0 },
          "cmd": { "type": "string" },
          "measuredSec": { "type": "number", "minimum": 0 },
          "check": {
            "oneOf": [
              { "type": "null" },
              { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["recorded", "exit_zero", "files_exist", "stdout_matches", "metric_decreased", "metric_below", "answers", "unaided_repeat"] } } }
            ]
          }
        }
      }
    },
    "install": { "type": "array", "items": { "type": "string" } },
    "trapsToWarn": { "type": "array", "items": { "type": "string" } }
  }
}
