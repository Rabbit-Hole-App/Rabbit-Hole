# Motion render fixtures are hashed byte-for-byte into recorded provenance (learn-render motion tests). A Windows
# checkout with core.autocrlf=true wrote them as CRLF and broke those hashes on every fresh worktree; keep them LF.
packages/learn-render/motion/fixtures/** text eol=lf
# File-import fixtures are real files whose exact bytes are the test (CRLF, BOMs, UTF-16, binary): never convert them.
packages/web/test/fixtures/file-imports/** -text
# The telemetry feature registry: adapters each add one import line and one list entry; keep both sides' additions.
packages/control-plane/src/telemetry-events/index.js merge=union
# The golden SGD artifact is a frozen identity hashed by its bytes (FX-AN-075): a Windows checkout must not turn it into CRLF.
packages/web/src/animation3d/testdata/sgd-golden.json text eol=lf
docs/features/explain-on-canvas/handoff/figure-briefs export-ignore
