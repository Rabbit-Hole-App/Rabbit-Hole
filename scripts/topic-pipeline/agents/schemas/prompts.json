{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic",
    "toyData",
    "prompts"
  ],
  "properties": {
    "topic": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "toyData": {
      "type": "object",
      "required": [
        "rows",
        "features",
        "label",
        "usedBy"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "features": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        },
        "label": {
          "type": "string"
        },
        "usedBy": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": false
    },
    "extraData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "features",
        "label",
        "usedBy"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "features": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        },
        "label": {
          "type": "string"
        },
        "usedBy": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "prompts": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "prompt",
          "kind",
          "content",
          "keywords",
          "data",
          "why",
          "origin"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "prompt": {
            "type": "string",
            "minLength": 2,
            "maxLength": 140,
            "pattern": "\\?$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "flow",
              "comparison",
              "timeline",
              "sequence",
              "matrix",
              "layers",
              "cycle",
              "figure",
              "tree",
              "relationship",
              "transformation",
              "argument",
              "number-line",
              "coordinate-plot",
              "bar-chart",
              "t-account",
              "waterfall",
              "heatmap",
              "sample-set",
              "histogram",
              "box-plot",
              "tensor",
              "token-links",
              "block-stack"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "keywords": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:[ -][a-z0-9]+){0,2}$"
            }
          },
          "data": {
            "enum": [
              "toy-exact",
              "illustrative"
            ]
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "enum": [
              "lesson",
              "learner",
              "owner"
            ]
          },
          "lesson": {
            "type": "string",
            "pattern": "^\\d{2}$"
          }
        }
      }
    }
  }
}
