{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic",
    "cards"
  ],
  "properties": {
    "topic": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "verdict",
          "reason",
          "layer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "ship",
              "regenerate",
              "hold"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "enum": [
              "reference",
              "selector",
              "server",
              "author-prose",
              "renderer"
            ]
          }
        }
      }
    }
  }
}
