{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic",
    "figures"
  ],
  "properties": {
    "topic": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "verdict",
          "reasons",
          "layer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "ship",
              "fix"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "layer": {
            "enum": [
              "reference",
              "data",
              "label"
            ]
          }
        }
      }
    }
  }
}
